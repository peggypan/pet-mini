# 云开发环境 ID（与 chongwu/apps/wxapp/config/cloud-env.js 的 envId 一致）
VITE_TCB_ENV=cloud1-d8gnokqshc15dc3ae

# 强烈建议（SDK 3.x Admin）：Publishable Key，配置后一般无需开控制台「匿名登录」
# 云开发 → 环境 → API Key → Publishable Key
# VITE_TCB_ACCESS_KEY=

# 可选，默认 ap-shanghai
# VITE_TCB_REGION=ap-shanghai

# --- 文件用法 ---
# 本地开发: 复制为 .env.local
# 生产构建: 复制为 .env.production（勿提交含真实 Key 的文件）
# 详见 docs/DEPLOY.md

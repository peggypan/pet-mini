page {
  /* 温馨粉橙配色 - 充满爱与生活感 */
  --primary: #FF8B7B;
  --primary-light: #FFB5A8;
  --primary-dark: #E67365;
  --primary-bg: rgba(255, 139, 123, 0.12);
  --secondary: #7EC8A3;
  --secondary-bg: rgba(126, 200, 163, 0.12);
  --accent: #FFD27D;
  --accent-bg: rgba(255, 210, 125, 0.15);
  --danger: #FF6B8A;
  --danger-bg: rgba(255, 107, 138, 0.12);
  --success: #7EC8A3;
  --warning: #FFB347;
  --text-primary: #2C2C2C;
  --text-secondary: #7A7A7A;
  --text-muted: #AAAAAA;
  --text-light: #C5C5C5;
  --bg-primary: #F8F6F3;
  --bg-white: #FFFEFB;
  --bg-card: #FFFEFB;
  --bg-warm: #FFF9F5;
  --border-color: #F5F0EB;
  --border-light: #EDE8E3;
  --shadow-soft: 0 4rpx 20rpx rgba(255, 139, 123, 0.08);
  --shadow-card: 0 8rpx 32rpx rgba(199, 180, 168, 0.12);
  --shadow-float: 0 12rpx 40rpx rgba(255, 139, 123, 0.15);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: var(--bg-primary);
}

page::-webkit-scrollbar {
  display: none;
}

.container {
  padding: 20rpx;
  background-color: var(--bg-primary);
  min-height: 100vh;
}

.card {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-soft);
  border: 1rpx solid var(--border-color);
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  border-radius: 56rpx;
  padding: 28rpx 56rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  box-shadow: 0 6rpx 20rpx rgba(255, 139, 123, 0.3);
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.96);
}

.btn-secondary {
  background: var(--bg-warm);
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: 56rpx;
  padding: 26rpx 52rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-secondary::after {
  border: none;
}

.btn-small {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  border-radius: 36rpx;
  padding: 14rpx 28rpx;
  font-size: 24rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(255, 139, 123, 0.25);
}

.btn-small::after {
  border: none;
}

.text-primary {
  color: var(--primary);
}

.text-secondary {
  color: var(--secondary);
}

.text-danger {
  color: var(--danger);
}

.text-muted {
  color: var(--text-muted);
}

.flex {
  display: flex;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 温馨空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  background: var(--bg-warm);
  border-radius: 28rpx;
  border: 2rpx dashed var(--border-light);
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.7;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: var(--text-muted);
}

.empty-action {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  border-radius: 56rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  margin-top: 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 139, 123, 0.3);
}

/* 温馨标签 */
.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  background: var(--primary-bg);
  color: var(--primary);
  font-weight: 500;
}

.tag-secondary {
  background: var(--secondary-bg);
  color: var(--secondary);
}

.tag-warm {
  background: var(--accent-bg);
  color: #E6A028;
}

/* 徽章 */
.badge {
  background: var(--danger);
  color: white;
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 24rpx;
  margin-left: 8rpx;
  min-width: 36rpx;
  text-align: center;
  font-weight: 500;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--border-color);
  margin: 24rpx 0;
}

/* 加载状态 */
.loading {
  display: flex;
  justify-content: center;
  padding: 40rpx;
  color: var(--text-muted);
  font-size: 26rpx;
}

.no-more {
  text-align: center;
  padding: 40rpx;
  color: var(--text-light);
  font-size: 24rpx;
}

/* 温馨卡片 */
.warm-card {
  background: linear-gradient(135deg, #FFFEFB 0%, #FFF9F5 100%);
  border-radius: 28rpx;
  padding: 32rpx;
  border: 2rpx solid var(--border-color);
  box-shadow: var(--shadow-card);
}

/* 爱心装饰 */
.heart-accent::before {
  content: '♥';
  color: var(--primary);
  font-size: 24rpx;
  margin-right: 8rpx;
  opacity: 0.6;
}

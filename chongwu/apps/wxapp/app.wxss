page {
  /* Soft mint glass design tokens */
  --primary: #6FCF97;
  --primary-light: #A8E6C3;
  --primary-dark: #4DB87A;
  --primary-bg: rgba(111, 207, 151, 0.14);
  --secondary: #FF9B7A;
  --secondary-bg: rgba(255, 155, 122, 0.14);
  --accent: #F5C26B;
  --accent-bg: rgba(245, 194, 107, 0.16);
  --mint: #7ED6A8;
  --mint-deep: #5BBF88;
  --cream: #EEF4FA;
  --cream-deep: #E2EBF4;
  --glass: rgba(255, 255, 255, 0.72);
  --glass-strong: rgba(255, 255, 255, 0.88);
  --danger: #FF6B8A;
  --danger-bg: rgba(255, 107, 138, 0.12);
  --success: #6FCF97;
  --warning: #FFB347;
  --text-primary: #2A2A2A;
  --text-secondary: #6B6B6B;
  --text-muted: #9A9A9A;
  --text-light: #C5C5C5;
  --bg-primary: #EEF4FA;
  --bg-white: #FFFEFB;
  --bg-card: #FFFEFB;
  --bg-warm: #F5F9FC;
  --border-color: #E3EBF3;
  --border-light: #D8E3EE;
  --shadow-soft: 0 8rpx 28rpx rgba(42, 42, 42, 0.05);
  --shadow-card: 0 12rpx 40rpx rgba(42, 42, 42, 0.06);
  --shadow-float: 0 16rpx 48rpx rgba(111, 207, 151, 0.22);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  background-color: var(--bg-primary);
  color: var(--text-primary);
}

page::-webkit-scrollbar {
  display: none;
}

.container {
  padding: 20rpx;
  background-color: var(--bg-primary);
  min-height: 100vh;
}

.card {
  background: var(--bg-card);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-soft);
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  border-radius: 56rpx;
  padding: 28rpx 56rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(111, 207, 151, 0.35);
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.96);
}

.btn-secondary {
  background: var(--bg-warm);
  color: var(--primary-dark);
  border: 2rpx solid var(--primary);
  border-radius: 56rpx;
  padding: 26rpx 52rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-secondary::after {
  border: none;
}

.btn-small {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  border-radius: 36rpx;
  padding: 14rpx 28rpx;
  font-size: 24rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(111, 207, 151, 0.3);
}

.btn-small::after {
  border: none;
}

.text-primary {
  color: var(--primary);
}

.text-secondary {
  color: var(--secondary);
}

.text-danger {
  color: var(--danger);
}

.text-muted {
  color: var(--text-muted);
}

.flex {
  display: flex;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  background: var(--bg-warm);
  border-radius: 28rpx;
  border: 2rpx dashed var(--border-light);
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.7;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: var(--text-muted);
}

.empty-action {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  border-radius: 56rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  margin-top: 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(111, 207, 151, 0.3);
}

.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  background: var(--primary-bg);
  color: var(--primary-dark);
  font-weight: 500;
}

.tag-secondary {
  background: var(--secondary-bg);
  color: var(--secondary);
}

.tag-warm {
  background: var(--accent-bg);
  color: #E6A028;
}

.badge {
  background: var(--danger);
  color: white;
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 24rpx;
  margin-left: 8rpx;
  min-width: 36rpx;
  text-align: center;
  font-weight: 500;
}

.divider {
  height: 1rpx;
  background: var(--border-color);
  margin: 24rpx 0;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 40rpx;
  color: var(--text-muted);
  font-size: 26rpx;
}

.no-more {
  text-align: center;
  padding: 40rpx;
  color: var(--text-light);
  font-size: 24rpx;
}

.warm-card {
  background: linear-gradient(135deg, #FFFEFB 0%, #F3FBF6 100%);
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

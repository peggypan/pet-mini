page {
  --primary: #4DA7F8;
  --primary-bright: #7EC8FF;
  --primary-mint: #A8D8FF;
  --primary-light: #B8DCFF;
  --primary-dark: #1E88E5;
  --primary-bg: rgba(77, 167, 248, 0.12);
  --primary-bg-soft: rgba(126, 200, 255, 0.28);
  --secondary: #FFB87A;
  --cream: #F5F8FC;
  --text-primary: #1A1A1A;
  --text-secondary: #666666;
  --text-muted: #999999;
  --bg-primary: #F5F8FC;
  --bg-white: #FFFFFF;
  --bg-card: #FFFFFF;
  --bg-gradient: linear-gradient(180deg, #E8F4FF 0%, #F5F8FC 360rpx);
  --border-color: #E3EEF8;
  --shadow-soft: 0 4rpx 24rpx rgba(30, 136, 229, 0.06);
  --shadow-card: 0 8rpx 32rpx rgba(30, 136, 229, 0.08);
  --shadow-primary: 0 8rpx 28rpx rgba(77, 167, 248, 0.32);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  background-color: var(--bg-primary);
  color: var(--text-primary);
}

page::-webkit-scrollbar {
  display: none;
}

.city-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 16rpx rgba(30, 136, 229, 0.06);
}

.city-bar-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.city-bar-text {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.city-bar-arrow {
  font-size: 22rpx;
  color: var(--primary-dark);
  font-weight: 600;
}

.container {
  padding: 20rpx;
  background-color: var(--bg-primary);
  min-height: 100vh;
}

.card {
  background: var(--bg-card);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-soft);
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary-bright) 0%, var(--primary) 100%);
  color: #FFFFFF;
  border-radius: 56rpx;
  padding: 28rpx 56rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-primary);
  line-height: 1;
  height: auto;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.96);
}

.btn-secondary {
  background: var(--bg-white);
  color: var(--text-primary);
  border: 2rpx solid var(--border-color);
  border-radius: 56rpx;
  padding: 26rpx 52rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  height: auto;
}

.btn-secondary::after {
  border: none;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
  padding: 0;
  box-sizing: border-box;
  overflow: visible;
}

button::after {
  border: none;
}

.btn-small {
  background: linear-gradient(135deg, var(--primary-bright) 0%, var(--primary) 100%);
  color: #FFFFFF;
  border-radius: 36rpx;
  padding: 14rpx 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
  box-shadow: var(--shadow-primary);
}

.btn-small::after {
  border: none;
}

.text-primary {
  color: var(--primary-dark);
}

.text-secondary {
  color: var(--secondary);
}

.text-muted {
  color: var(--text-muted);
}

.flex {
  display: flex;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  background: var(--bg-white);
  border-radius: 32rpx;
  border: 2rpx dashed var(--border-color);
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.7;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: var(--text-muted);
}

.empty-action {
  background: linear-gradient(135deg, var(--primary-bright) 0%, var(--primary) 100%);
  color: #FFFFFF;
  border-radius: 56rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 32rpx;
  box-shadow: var(--shadow-primary);
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: var(--primary-bg-soft);
  color: var(--primary-dark);
  font-weight: 600;
}

.badge {
  background: #FF4D4F;
  color: white;
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 24rpx;
  margin-left: 8rpx;
  min-width: 36rpx;
  text-align: center;
  font-weight: 500;
}

.divider {
  height: 1rpx;
  background: var(--border-color);
  margin: 24rpx 0;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 40rpx;
  color: var(--text-muted);
  font-size: 26rpx;
}

.no-more {
  text-align: center;
  padding: 40rpx;
  color: var(--text-muted);
  font-size: 24rpx;
}

.warm-card {
  background: var(--bg-white);
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

/* 通用 Tab 下划线样式 */
.tab-underline {
  display: inline-block;
  padding: 16rpx 28rpx 20rpx;
  margin-right: 8rpx;
  font-size: 28rpx;
  color: var(--text-muted);
  position: relative;
  background: transparent;
}

.tab-underline.on {
  color: var(--text-primary);
  font-weight: 700;
}

.tab-underline.on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  transform: translateX(-50%);
  width: 48rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--primary);
}

/* 页面顶区渐变（与导航栏衔接） */
.page-sky-bg {
  background: var(--bg-gradient);
}

/* 表单控件基线 — 防止 input / picker 文字上下被裁切 */
input {
  box-sizing: border-box;
  height: 88rpx;
  min-height: 88rpx;
  padding: 26rpx 24rpx;
  font-size: 28rpx;
  line-height: 36rpx;
  color: var(--text-primary);
}

textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 160rpx;
  height: auto;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-primary);
}

.picker {
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  line-height: 1.5;
  color: var(--text-primary);
}

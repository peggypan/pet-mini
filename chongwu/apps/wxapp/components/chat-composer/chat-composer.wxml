<view class="composer-root {{showTools ? 'tools-open' : ''}} {{showEmoji ? 'emoji-open' : ''}}">
  <view class="record-overlay" wx:if="{{recording}}">
    <view class="record-card {{cancelArmed ? 'cancel' : ''}}">
      <view class="record-wave">
        <view class="wave-bar"></view>
        <view class="wave-bar"></view>
        <view class="wave-bar"></view>
        <view class="wave-bar"></view>
      </view>
      <text class="record-tip">{{cancelArmed ? '松开手指，取消发送' : '上滑取消'}}</text>
    </view>
  </view>
  <view class="tool-panel" wx:if="{{showTools}}">
    <view class="tool-item" bindtap="onTool" data-action="photo">
      <view class="tool-icon-box"><text class="tool-glyph">🖼</text></view>
      <text class="tool-label">照片</text>
    </view>
    <view class="tool-item" bindtap="onTool" data-action="camera">
      <view class="tool-icon-box"><text class="tool-glyph">📷</text></view>
      <text class="tool-label">拍摄</text>
    </view>
    <view class="tool-item" wx:if="{{showVideo}}" bindtap="onTool" data-action="video">
      <view class="tool-icon-box"><text class="tool-glyph">▶</text></view>
      <text class="tool-label">发送视频</text>
    </view>
    <view class="tool-item" wx:if="{{showActivity}}" bindtap="onTool" data-action="activity">
      <view class="tool-icon-box"><text class="tool-glyph">📅</text></view>
      <text class="tool-label">活动</text>
    </view>
  </view>

  <view class="emoji-panel" wx:if="{{showEmoji && showEmojiPanel}}">
    <scroll-view scroll-x class="emoji-tabs" enhanced show-scrollbar="{{false}}">
      <view
        class="emoji-tab {{emojiTab === item.id ? 'on' : ''}}"
        wx:for="{{emojiTabs}}"
        wx:key="id"
        data-tab="{{item.id}}"
        bindtap="onEmojiTab"
      >{{item.name}}</view>
    </scroll-view>
    <view class="emoji-grid">
      <view
        class="emoji-cell"
        wx:for="{{emojiList}}"
        wx:key="*this"
        data-emoji="{{item}}"
        bindtap="onPickEmoji"
      >{{item}}</view>
    </view>
  </view>

  <view class="input-bar {{fixed ? 'fixed' : ''}}">
    <slot name="prefix"></slot>
    <view class="icon-btn voice-btn" bindtap="onToggleVoice">
      <text class="icon-glyph">{{voiceMode ? '⌨️' : '🎙'}}</text>
    </view>
    <block wx:if="{{!voiceMode}}">
      <input
        class="text-input"
        placeholder="{{placeholder}}"
        value="{{value}}"
        bindinput="onInput"
        bindfocus="onInputFocus"
        confirm-type="send"
        bindconfirm="onSend"
      />
    </block>
    <view
      wx:else
      class="voice-hold {{recording ? 'recording' : ''}} {{cancelArmed ? 'cancel' : ''}}"
      catchtouchstart="onVoiceStart"
      catchtouchend="onVoiceEnd"
      catchtouchcancel="onVoiceCancel"
      catchtouchmove="onVoiceMove"
    >{{recording ? (cancelArmed ? '松开手指，取消发送' : '松开 结束') : '按住 说话'}}</view>
    <view class="icon-btn emoji-btn" bindtap="onToggleEmoji">
      <text class="icon-glyph">☺</text>
    </view>
    <view class="icon-btn plus-btn" bindtap="onToggleTools">
      <text class="icon-glyph plus-glyph">{{showTools ? '⌄' : '+'}}</text>
    </view>
    <slot name="suffix"></slot>
  </view>
</view>

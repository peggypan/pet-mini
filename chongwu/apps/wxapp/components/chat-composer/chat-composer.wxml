<view class="composer-root {{showTools ? 'tools-open' : ''}} {{showEmoji ? 'emoji-open' : ''}}">
  <view class="record-overlay" wx:if="{{recording}}">
    <view class="record-card {{cancelArmed ? 'cancel' : ''}}">
      <view class="record-wave">
        <view class="wave-bar"></view>
        <view class="wave-bar"></view>
        <view class="wave-bar"></view>
        <view class="wave-bar"></view>
      </view>
      <text class="record-tip">{{cancelArmed ? '松开手指，取消发送' : '上滑取消'}}</text>
    </view>
  </view>

  <view class="tool-panel" wx:if="{{showTools}}">
    <swiper class="tool-swiper">
      <swiper-item>
        <view class="tool-grid">
          <view class="tool-item" bindtap="onTool" data-action="photo">
            <view class="tool-icon-box"><view class="wx-icon wx-album"></view></view>
            <text class="tool-label">相册</text>
          </view>
          <view class="tool-item" bindtap="onTool" data-action="camera">
            <view class="tool-icon-box"><view class="wx-icon wx-camera"></view></view>
            <text class="tool-label">拍摄</text>
          </view>
          <view class="tool-item" wx:if="{{showVideo}}" bindtap="onTool" data-action="video">
            <view class="tool-icon-box"><view class="wx-icon wx-video-file"></view></view>
            <text class="tool-label">发送视频</text>
          </view>
          <view class="tool-item" wx:if="{{showLocation}}" bindtap="onTool" data-action="location">
            <view class="tool-icon-box"><view class="wx-icon wx-location"></view></view>
            <text class="tool-label">位置</text>
          </view>
        </view>
      </swiper-item>
      <swiper-item>
        <view class="tool-grid tool-grid-page2">
          <view class="tool-item" wx:if="{{showAa}}" bindtap="onTool" data-action="aa">
            <view class="tool-icon-box"><view class="wx-icon wx-aa"><text class="wx-aa-text">AA</text></view></view>
            <text class="tool-label">AA收款</text>
          </view>
          <view class="tool-item" wx:if="{{showActivity}}" bindtap="onTool" data-action="activity">
            <view class="tool-icon-box"><view class="wx-icon wx-activity"></view></view>
            <text class="tool-label">活动</text>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <view class="emoji-panel" wx:if="{{showEmoji && showEmojiPanel}}">
    <scroll-view scroll-x class="emoji-tabs" enhanced show-scrollbar="{{false}}">
      <view
        class="emoji-tab {{emojiTab === item.id ? 'on' : ''}}"
        wx:for="{{emojiTabs}}"
        wx:key="id"
        data-tab="{{item.id}}"
        bindtap="onEmojiTab"
      >{{item.name}}</view>
    </scroll-view>
    <view class="emoji-grid">
      <view
        class="emoji-cell"
        wx:for="{{emojiList}}"
        wx:key="*this"
        data-emoji="{{item}}"
        bindtap="onPickEmoji"
      >{{item}}</view>
    </view>
  </view>

  <view class="input-bar {{fixed ? 'fixed' : ''}}">
    <slot name="prefix"></slot>
    <view class="bar-circle-btn" bindtap="onToggleVoice">
      <view class="wx-bar-icon {{voiceMode ? 'wx-keyboard' : 'wx-voice-ring'}}"></view>
    </view>
    <block wx:if="{{!voiceMode}}">
      <view class="input-wrap">
        <input
          class="text-input"
          placeholder="{{placeholder}}"
          value="{{value}}"
          bindinput="onInput"
          bindfocus="onInputFocus"
          confirm-type="send"
          bindconfirm="onSend"
        />
      </view>
    </block>
    <view
      wx:else
      class="voice-hold {{recording ? 'recording' : ''}} {{cancelArmed ? 'cancel' : ''}}"
      catchtouchstart="onVoiceStart"
      catchtouchend="onVoiceEnd"
      catchtouchcancel="onVoiceCancel"
      catchtouchmove="onVoiceMove"
    >{{recording ? (cancelArmed ? '松开手指，取消发送' : '松开 结束') : '按住 说话'}}</view>
    <view class="bar-circle-btn" bindtap="onToggleEmoji">
      <view class="wx-bar-icon wx-smile"></view>
    </view>
    <view class="bar-circle-btn {{showTools ? 'plus-open' : ''}}" bindtap="onToggleTools">
      <view class="wx-bar-icon wx-plus"></view>
    </view>
    <slot name="suffix"></slot>
  </view>
</view>

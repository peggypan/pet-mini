.composer-root.tools-open {
  padding-bottom: 300rpx;
}

.composer-root.emoji-open {
  padding-bottom: 420rpx;
}

.tool-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(104rpx + env(safe-area-inset-bottom));
  background: #ededed;
  border-top: 1rpx solid #dcdcdc;
  z-index: 20;
  height: 280rpx;
  box-sizing: border-box;
}

.tool-swiper {
  height: 100%;
}

.tool-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx 12rpx 8rpx;
  box-sizing: border-box;
}

.tool-grid-page2 {
  padding-top: 28rpx;
}

.tool-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  box-sizing: border-box;
}

.tool-icon-box {
  width: 128rpx;
  height: 128rpx;
  border-radius: 24rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-label {
  font-size: 24rpx;
  color: #888888;
  line-height: 1.2;
}

.wx-icon {
  position: relative;
  width: 62rpx;
  height: 62rpx;
}

/* 相册：黑底 + 山形镂空 */
.wx-album {
  background: #191919;
  border-radius: 8rpx;
}

.wx-album::before {
  content: '';
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-bottom: 22rpx solid #ffffff;
}

.wx-album::after {
  content: '';
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  width: 16rpx;
  height: 16rpx;
  background: #ffffff;
  border-radius: 50%;
}

/* 拍摄：相机侧影 */
.wx-camera {
  background: #191919;
  border-radius: 10rpx;
}

.wx-camera::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 16rpx;
  width: 46rpx;
  height: 32rpx;
  background: #ffffff;
  border-radius: 6rpx;
}

.wx-camera::after {
  content: '';
  position: absolute;
  left: 22rpx;
  top: 24rpx;
  width: 18rpx;
  height: 18rpx;
  border: 5rpx solid #191919;
  background: #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
}

/* 视频通话：摄像机 */
.wx-videocall {
  background: transparent;
}

.wx-videocall::before {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 18rpx;
  width: 34rpx;
  height: 26rpx;
  background: #191919;
  border-radius: 6rpx;
}

.wx-videocall::after {
  content: '';
  position: absolute;
  right: 6rpx;
  top: 22rpx;
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 16rpx solid #191919;
}

/* 发送视频：圆角矩形播放 */
.wx-video-file {
  background: #191919;
  border-radius: 12rpx;
}

.wx-video-file::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-38%, -50%);
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  border-left: 22rpx solid #ffffff;
}

/* 位置 */
.wx-location::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 8rpx;
  width: 32rpx;
  height: 32rpx;
  margin-left: -16rpx;
  background: #191919;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}

.wx-location::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 22rpx;
  width: 12rpx;
  height: 12rpx;
  margin-left: -6rpx;
  background: #ffffff;
  border-radius: 50%;
}

/* 红包 */
.wx-redpack {
  background: #191919;
  border-radius: 8rpx;
}

.wx-redpack::before {
  content: '';
  position: absolute;
  left: 14rpx;
  top: 10rpx;
  width: 34rpx;
  height: 44rpx;
  border: 4rpx solid #ffffff;
  border-radius: 6rpx;
  box-sizing: border-box;
}

.wx-redpack::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 22rpx;
  width: 14rpx;
  height: 14rpx;
  margin-left: -7rpx;
  background: #ffffff;
  border-radius: 50%;
}

/* 礼物 */
.wx-gift {
  background: #191919;
  border-radius: 10rpx;
}

.wx-gift::before {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 14rpx;
  width: 38rpx;
  height: 34rpx;
  border: 4rpx solid #ffffff;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.wx-gift::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 10rpx;
  width: 4rpx;
  height: 42rpx;
  margin-left: -2rpx;
  background: #ffffff;
  box-shadow: -12rpx 4rpx 0 #ffffff, 12rpx 4rpx 0 #ffffff;
}

/* 转账 */
.wx-transfer::before,
.wx-transfer::after {
  content: '';
  position: absolute;
  left: 8rpx;
  width: 46rpx;
  height: 8rpx;
  background: #191919;
  border-radius: 4rpx;
}

.wx-transfer::before {
  top: 20rpx;
  box-shadow: 14rpx -6rpx 0 -2rpx #191919;
  transform: rotate(0deg);
}

.wx-transfer::after {
  bottom: 18rpx;
  box-shadow: -14rpx 6rpx 0 -2rpx #191919;
}

/* 收藏：立方体 */
.wx-favorite {
  background: transparent;
}

.wx-favorite::before {
  content: '';
  position: absolute;
  left: 14rpx;
  top: 18rpx;
  width: 28rpx;
  height: 28rpx;
  background: #191919;
  transform: skewY(-12deg);
}

.wx-favorite::after {
  content: '';
  position: absolute;
  left: 22rpx;
  top: 10rpx;
  width: 28rpx;
  height: 28rpx;
  background: #191919;
  opacity: 0.55;
  transform: skewX(-12deg);
}

.wx-aa {
  display: flex;
  align-items: center;
  justify-content: center;
}

.wx-aa-text {
  font-size: 36rpx;
  font-weight: 900;
  color: #191919;
  letter-spacing: -2rpx;
}

.wx-activity::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 12rpx;
  width: 42rpx;
  height: 38rpx;
  border: 4rpx solid #191919;
  border-radius: 6rpx;
  box-sizing: border-box;
}

.wx-activity::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 24rpx;
  width: 42rpx;
  height: 4rpx;
  background: #191919;
  box-shadow: 0 10rpx 0 #191919;
}

.emoji-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(104rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #ebebeb;
  z-index: 20;
  max-height: 420rpx;
}

.emoji-tabs {
  white-space: nowrap;
  padding: 16rpx 20rpx 8rpx;
}

.emoji-tab {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #999999;
  background: #f5f5f5;
}

.emoji-tab.on {
  background: rgba(126, 200, 255, 0.35);
  color: #1a1a1a;
  font-weight: 700;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 12rpx 20rpx 24rpx;
  max-height: 280rpx;
  overflow-y: auto;
}

.emoji-cell {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border-radius: 12rpx;
  background: #f9f9f9;
}

.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 16rpx calc(14rpx + env(safe-area-inset-bottom));
  background: #f7f7f7;
  border-top: 1rpx solid #e5e5e5;
  box-sizing: border-box;
}

.input-bar.fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
}

.bar-circle-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 1rpx solid #d9d9d9;
  background: #f7f7f7;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.wx-bar-icon {
  position: relative;
  width: 40rpx;
  height: 40rpx;
}

.wx-voice-ring {
  border: 2rpx solid #191919;
  border-radius: 50%;
  box-sizing: border-box;
}

.wx-voice-ring::before,
.wx-voice-ring::after {
  content: '';
  position: absolute;
  border: 2rpx solid #191919;
  border-radius: 50%;
  border-right-color: transparent;
  border-bottom-color: transparent;
}

.wx-voice-ring::before {
  width: 10rpx;
  height: 10rpx;
  left: 14rpx;
  top: 14rpx;
  transform: rotate(-45deg);
}

.wx-voice-ring::after {
  width: 22rpx;
  height: 22rpx;
  left: 8rpx;
  top: 8rpx;
  transform: rotate(-45deg);
}

.wx-keyboard {
  background: #191919;
  border-radius: 6rpx;
}

.wx-keyboard::before {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 9rpx;
  width: 26rpx;
  height: 3rpx;
  background: #ffffff;
  box-shadow: 0 7rpx 0 #ffffff, 0 14rpx 0 #ffffff, 0 21rpx 0 #ffffff;
}

.wx-smile {
  border: 2rpx solid #191919;
  border-radius: 50%;
  box-sizing: border-box;
}

.wx-smile::before {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 12rpx;
  width: 6rpx;
  height: 6rpx;
  background: #191919;
  border-radius: 50%;
  box-shadow: 14rpx 0 0 #191919;
}

.wx-smile::after {
  content: '';
  position: absolute;
  left: 9rpx;
  bottom: 9rpx;
  width: 22rpx;
  height: 10rpx;
  border: 2rpx solid #191919;
  border-top: none;
  border-radius: 0 0 16rpx 16rpx;
  box-sizing: border-box;
}

.wx-plus::before,
.wx-plus::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  background: #191919;
  transform: translate(-50%, -50%);
}

.wx-plus::before {
  width: 26rpx;
  height: 3rpx;
}

.wx-plus::after {
  width: 3rpx;
  height: 26rpx;
}

.bar-circle-btn.plus-open .wx-plus::after {
  display: none;
}

.input-wrap {
  flex: 1;
  min-width: 0;
  position: relative;
}

.text-input {
  width: 100%;
  height: 76rpx;
  padding: 0 24rpx;
  line-height: 76rpx;
  background: #ffffff;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  box-sizing: border-box;
}

.voice-hold {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
}

.voice-hold.recording {
  background: #e8e8e8;
}

.record-overlay {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.record-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 56rpx;
  background: rgba(0, 0, 0, 0.72);
  border-radius: 28rpx;
  color: #ffffff;
}

.record-wave {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 48rpx;
  margin-bottom: 20rpx;
}

.wave-bar {
  width: 8rpx;
  border-radius: 8rpx;
  background: #7EC8FF;
  animation: wave-jump 0.9s ease-in-out infinite;
}

.wave-bar:nth-child(1) { height: 20rpx; }
.wave-bar:nth-child(2) { height: 44rpx; animation-delay: 0.15s; }
.wave-bar:nth-child(3) { height: 32rpx; animation-delay: 0.3s; }
.wave-bar:nth-child(4) { height: 16rpx; animation-delay: 0.45s; }

@keyframes wave-jump {
  0%, 100% { transform: scaleY(0.4); }
  50% { transform: scaleY(1); }
}

.record-card.cancel {
  background: rgba(255, 77, 79, 0.85);
}

.record-card.cancel .wave-bar {
  background: #ffffff;
}

.record-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

.voice-hold.cancel {
  background: rgba(255, 77, 79, 0.15);
  color: #d93a3c;
}

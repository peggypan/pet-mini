<view class="tab-bar-wrap">
  <view class="tab-bar">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'active' : ''}}"
      data-path="{{item.pagePath}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <text class="tab-emoji">{{item.emoji}}</text>
      <text class="tab-label">{{item.label}}</text>
    </view>
  </view>
</view>

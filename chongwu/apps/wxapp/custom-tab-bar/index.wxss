.tab-bar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  padding: 0 36rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.tab-bar {
  position: relative;
  pointer-events: auto;
  height: 116rpx;
  background: rgba(255, 255, 255, 0.42);
  border-radius: 58rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(28px);
  box-shadow:
    0 16rpx 48rpx rgba(80, 120, 160, 0.12),
    0 2rpx 0 rgba(255, 255, 255, 0.85) inset,
    inset 0 -8rpx 24rpx rgba(180, 210, 235, 0.18);
  overflow: hidden;
}

/* 液态玻璃高光层 */
.tab-bar::before {
  content: '';
  position: absolute;
  left: 10%;
  right: 10%;
  top: 0;
  height: 40%;
  border-radius: 0 0 40rpx 40rpx;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.55) 0%,
    rgba(255, 255, 255, 0.08) 100%
  );
  pointer-events: none;
}

.tab-bar::after {
  content: '';
  position: absolute;
  left: 18%;
  right: 18%;
  bottom: 6rpx;
  height: 10rpx;
  border-radius: 10rpx;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.45),
    transparent
  );
  pointer-events: none;
}

.tab-bar-item {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.tab-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}

.tab-icon-wrap.on {
  background: rgba(111, 207, 151, 0.32);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

.tab-icon {
  font-size: 40rpx;
  line-height: 1;
  opacity: 0.5;
}

.tab-icon-wrap.on .tab-icon {
  opacity: 1;
}

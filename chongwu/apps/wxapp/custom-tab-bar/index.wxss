.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: white;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 20rpx rgba(199, 180, 168, 0.15);
  border-top: 1rpx solid #F5F0EB;
  z-index: 9999;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  transition: all 0.2s;
}

.tab-bar-item:active {
  transform: scale(0.95);
}

.tab-icon {
  font-size: 48rpx;
  line-height: 1;
  margin-bottom: 4rpx;
  transition: transform 0.2s;
}

.tab-bar-item.active .tab-icon {
  transform: scale(1.1);
}

.tab-text {
  font-size: 22rpx;
  line-height: 1;
}

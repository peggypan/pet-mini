.tab-bar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  padding: 0 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.tab-bar {
  pointer-events: auto;
  height: 112rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 56rpx;
  display: flex;
  align-items: stretch;
  border: 1rpx solid rgba(91, 191, 136, 0.12);
  box-shadow: 0 12rpx 40rpx rgba(91, 140, 110, 0.14);
  backdrop-filter: blur(20px);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border-radius: 56rpx;
  transition: all 0.2s ease;
}

.tab-item.active {
  background: linear-gradient(180deg, rgba(167, 230, 195, 0.35) 0%, rgba(255, 255, 255, 0) 100%);
}

.tab-emoji {
  font-size: 36rpx;
  line-height: 1;
}

.tab-label {
  font-size: 20rpx;
  color: #9BA89E;
  font-weight: 500;
}

.tab-item.active .tab-label {
  color: #3D8F66;
  font-weight: 700;
}

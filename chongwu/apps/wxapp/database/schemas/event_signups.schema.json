{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "event_signups",
  "description": "活动报名与核销码，对齐 store.addEventSignup / admin EventSignupRow。",
  "type": "object",
  "required": ["openid", "eventId", "ticketCode", "createdAt", "updatedAt"],
  "properties": {
    "_id": { "type": "string" },
    "_openid": { "type": "string" },
    "openid": { "type": "string" },
    "userId": { "type": "string" },
    "userName": { "type": "string" },
    "eventId": { "type": "string" },
    "title": { "type": "string" },
    "eventTitle": { "type": "string" },
    "place": { "type": "string" },
    "placeAddress": { "type": "string" },
    "location": { "type": "object" },
    "locationLat": {},
    "locationLng": {},
    "time": { "type": "string" },
    "fee": { "type": "string" },
    "cover": { "type": "string" },
    "contactName": { "type": "string" },
    "phone": { "type": "string" },
    "petName": { "type": "string" },
    "petBreed": { "type": "string" },
    "ticketCode": { "type": "string" },
    "checkedIn": { "type": "boolean", "default": false },
    "userDeleted": { "type": "boolean", "default": false },
    "status": { "type": "integer", "default": 1 },
    "createdAt": {},
    "updatedAt": {}
  }
}

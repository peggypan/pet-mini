{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "events",
  "description": "活动主表，对齐 event-publish / EventRow。",
  "type": "object",
  "required": ["openid", "title", "auditStatus", "createdAt", "updatedAt"],
  "properties": {
    "_id": { "type": "string" },
    "_openid": { "type": "string" },
    "openid": { "type": "string" },
    "userId": { "type": "string" },
    "title": { "type": "string" },
    "category": { "type": "string" },
    "role": { "type": "string", "enum": ["personal", "merchant"] },
    "eventType": { "type": "string", "enum": ["single", "multi"] },
    "eventSessions": { "type": "array" },
    "place": { "type": "string" },
    "placeAddress": { "type": "string" },
    "location": { "type": "object" },
    "eventDate": { "type": "string" },
    "time": { "type": "string" },
    "city": { "type": "string" },
    "maxPeople": { "type": "number" },
    "remain": { "type": "number" },
    "signupCount": { "type": "number" },
    "seats": { "type": "string" },
    "fee": { "type": "string" },
    "feeText": { "type": "string" },
    "price": { "type": "number" },
    "desc": { "type": "string" },
    "detailContent": { "type": "string" },
    "detailMediaList": { "type": "array" },
    "detailImages": { "type": "array" },
    "mediaList": { "type": "array" },
    "images": { "type": "array" },
    "cover": { "type": "string" },
    "publisherName": { "type": "string" },
    "host": { "type": "string" },
    "hostAvatar": { "type": "string" },
    "signupScope": { "type": "string" },
    "timedSignup": { "type": "boolean" },
    "deadline": { "type": "string" },
    "auditStatus": { "type": "string", "enum": ["pending", "approved", "rejected", "hidden"] },
    "userDeleted": { "type": "boolean" },
    "status": { "type": "string" },
    "createdAt": {},
    "updatedAt": {}
  }
}

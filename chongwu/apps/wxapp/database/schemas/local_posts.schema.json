{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "local_posts",
  "description": "同城寻宠/招领/救助/领养（结构化字段，pet-rescue 本地源）。",
  "type": "object",
  "required": ["openid", "type", "title", "auditStatus", "createdAt", "updatedAt"],
  "properties": {
    "_id": { "type": "string" },
    "_openid": { "type": "string" },
    "openid": { "type": "string" },
    "userId": { "type": "string" },
    "userName": { "type": "string" },
    "type": { "type": "string", "enum": ["lost", "found", "adopt", "rescue"] },
    "title": { "type": "string" },
    "desc": { "type": "string" },
    "contact": { "type": "string" },
    "location": { "type": "string" },
    "geoLocation": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" }
      }
    },
    "city": { "type": "string" },
    "mediaList": { "type": "array" },
    "images": { "type": "array", "items": { "type": "string" } },
    "image": { "type": "string" },
    "auditStatus": { "type": "string", "enum": ["pending", "approved", "rejected", "hidden"], "default": "approved" },
    "userDeleted": { "type": "boolean", "default": false },
    "status": { "type": "integer", "default": 1 },
    "createdAt": {},
    "updatedAt": {}
  }
}

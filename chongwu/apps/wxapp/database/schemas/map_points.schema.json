{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "map_points",
  "description": "友好地图标点，含审核与现场图。",
  "type": "object",
  "required": ["openid", "name", "type", "address", "city", "latitude", "longitude", "auditStatus", "createdAt", "updatedAt"],
  "properties": {
    "_id": { "type": "string" },
    "_openid": { "type": "string" },
    "openid": { "type": "string" },
    "userId": { "type": "string" },
    "userName": { "type": "string" },
    "name": { "type": "string" },
    "type": { "type": "string" },
    "category": { "type": "string" },
    "address": { "type": "string" },
    "city": { "type": "string" },
    "latitude": { "type": "number" },
    "longitude": { "type": "number" },
    "allowPet": { "type": "boolean" },
    "danger": { "type": "boolean" },
    "dangerDesc": { "type": "string" },
    "distance": { "type": "string" },
    "images": { "type": "array", "items": { "type": "string" } },
    "rating": { "type": "number" },
    "auditStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] },
    "rejectReason": { "type": "string" },
    "pointsReward": { "type": "number" },
    "pointsGranted": { "type": "boolean" },
    "userDeleted": { "type": "boolean" },
    "status": { "type": "integer", "default": 1 },
    "createdAt": {},
    "updatedAt": {}
  }
}

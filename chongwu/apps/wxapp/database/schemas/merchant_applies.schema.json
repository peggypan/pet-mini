{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "merchant_applies",
  "description": "商家入驻申请，对齐 admin MerchantApplyRow。",
  "type": "object",
  "required": ["openid", "shopName", "auditStatus", "submittedAt", "createdAt", "updatedAt"],
  "properties": {
    "_id": { "type": "string" },
    "_openid": { "type": "string" },
    "openid": { "type": "string" },
    "userId": { "type": "string" },
    "userName": { "type": "string" },
    "shopName": { "type": "string" },
    "contact": { "type": "string" },
    "phone": { "type": "string" },
    "city": { "type": "string" },
    "companyName": { "type": "string" },
    "licenseNo": { "type": "string" },
    "legalPerson": { "type": "string" },
    "contactPhone": { "type": "string" },
    "licenseImage": { "type": "string" },
    "idFrontImage": { "type": "string" },
    "idBackImage": { "type": "string" },
    "shopFrontImage": { "type": "string" },
    "address": { "type": "string" },
    "intro": { "type": "string" },
    "auditStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] },
    "rejectReason": { "type": "string" },
    "approvedAt": {},
    "merchantId": { "type": "string" },
    "userDeleted": { "type": "boolean" },
    "status": { "type": "integer", "default": 1 },
    "submittedAt": {},
    "createdAt": {},
    "updatedAt": {}
  }
}

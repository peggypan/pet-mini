{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pets",
  "description": "宠物档案。与 pet-form、store、chongwu-admin PetRow 对齐。保存默认 auditStatus=approved。",
  "type": "object",
  "required": ["userId", "openid", "name", "species", "auditStatus", "createdAt", "updatedAt"],
  "properties": {
    "_id": { "type": "string", "description": "文档 ID；对外 id 同 _id" },
    "_openid": { "type": "string", "description": "主人 openid，须等于 users.openid，用于权限" },
    "openid": { "type": "string", "description": "主人 openid 冗余" },
    "userId": { "type": "string", "description": "主人 users._id" },
    "userNickname": { "type": "string", "description": "主人昵称冗余，运营列表用" },
    "ownerPhone": { "type": "string", "description": "主人手机号冗余 users.phone" },
    "name": { "type": "string", "description": "宠物名字" },
    "species": { "type": "integer", "description": "1 猫 2 狗 3 其他（与 pet-form 一致）" },
    "breedName": { "type": "string", "description": "品种" },
    "gender": { "type": "integer", "description": "0 未知 1 公 2 母", "default": 0 },
    "birthday": { "type": "string", "description": "YYYY-MM-DD" },
    "weight": { "type": "number", "description": "体重 kg" },
    "color": { "type": "string", "description": "毛色" },
    "isSterilized": { "type": "boolean", "default": false },
    "microchip": { "type": "string", "description": "芯片号" },
    "personality": { "type": "string", "description": "性格描述" },
    "socialTags": { "type": "array", "items": { "type": "string" }, "description": "社交标签" },
    "remark": { "type": "string", "description": "备注" },
    "avatarUrl": { "type": "string", "description": "头像" },
    "galleryPhotos": { "type": "array", "items": { "type": "string" }, "description": "相册最多 6 张" },
    "vaccineStatus": { "type": "string", "enum": ["immune", "vaccinating", "none"], "default": "none" },
    "vaccineProofUrl": { "type": "string", "description": "免疫证明图" },
    "verified": { "type": "boolean", "description": "是否已核验疫苗（immune 时为 true）" },
    "emergencyContactName": { "type": "string", "description": "紧急联系人" },
    "emergencyContactPhone": { "type": "string", "description": "紧急联系人电话" },
    "activityAreaName": { "type": "string", "description": "常活动区域名称" },
    "activityAreaAddress": { "type": "string", "description": "常活动区域地址" },
    "activityAreaLatitude": { "type": "number" },
    "activityAreaLongitude": { "type": "number" },
    "activityArea": { "type": "string", "description": "展示用：名称或地址拼接，运营端" },
    "healingPet": { "type": "boolean", "description": "是否疗愈宠", "default": false },
    "healingBuddyType": { "type": "string", "description": "疗愈搭子类型" },
    "healingIntro": { "type": "string", "description": "疗愈介绍" },
    "auditStatus": { "type": "string", "enum": ["pending", "approved", "rejected", "hidden"], "default": "approved" },
    "rejectReason": { "type": "string", "default": "" },
    "certPublished": { "type": "boolean", "description": "是否已发布电子宠证快照", "default": false },
    "submittedAt": { "type": "string", "description": "ISO 时间，运营用" },
    "status": { "type": "integer", "description": "1 正常 0 删除", "default": 1 },
    "createdAt": { "description": "serverDate" },
    "updatedAt": { "description": "serverDate" }
  }
}

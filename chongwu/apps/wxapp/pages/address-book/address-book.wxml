<!-- 地址簿页面 -->
<view class="page">
  <!-- 地址列表 -->
  <view class="address-list" wx:if="{{addresses.length > 0}}">
    <view
      class="address-card {{item.isDefault ? 'default' : ''}}"
      wx:for="{{addresses}}"
      wx:key="id"
      bindtap="onSelectAddress"
      data-id="{{item.id}}"
    >
      <view class="address-content">
        <view class="address-header">
          <text class="contact-name">{{item.contactName}}</text>
          <text class="contact-phone">{{item.contactPhone}}</text>
          <text class="default-tag" wx:if="{{item.isDefault}}">默认</text>
        </view>
        <text class="address-text">{{item.address}}</text>
      </view>
      <view class="address-actions" catchtap="onShowActions" data-id="{{item.id}}">
        <text class="action-icon">⋯</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{addresses.length === 0}}">
    <text class="empty-icon">📬</text>
    <text class="empty-text">还没有收货地址</text>
    <text class="empty-tip">添加一个地址，下单更方便哦～</text>
  </view>

  <!-- 添加地址按钮 -->
  <view class="bottom-bar">
    <button class="add-btn" bindtap="onAddAddress">
      <text class="add-icon">+</text>
      <text class="add-text">添加新地址</text>
    </button>
  </view>
</view>

<!-- 地址编辑弹窗 -->
<view class="modal-mask" wx:if="{{showModal}}" bindtap="onCloseModal">
  <view class="modal-content" catchtap="onStopPropagation">
    <view class="modal-header">
      <text class="modal-title">{{editingId ? '编辑地址' : '添加地址'}}</text>
      <text class="modal-close" bindtap="onCloseModal">×</text>
    </view>

    <view class="modal-body">
      <view class="form-group">
        <text class="form-label">收货人</text>
        <input
          class="form-input"
          placeholder="请输入收货人姓名"
          value="{{formData.contactName}}"
          bindinput="onInputChange"
          data-field="contactName"
          maxlength="20"
        />
      </view>

      <view class="form-group">
        <text class="form-label">联系电话</text>
        <input
          class="form-input"
          placeholder="请输入手机号"
          type="number"
          value="{{formData.contactPhone}}"
          bindinput="onInputChange"
          data-field="contactPhone"
          maxlength="11"
        />
      </view>

      <view class="form-group">
        <text class="form-label">详细地址</text>
        <textarea
          class="form-textarea"
          placeholder="请输入详细地址（小区、楼栋、门牌号等）"
          value="{{formData.address}}"
          bindinput="onInputChange"
          data-field="address"
          maxlength="100"
          auto-height
        />
      </view>

      <view class="form-group default-check" bindtap="onToggleDefault">
        <view class="checkbox {{formData.isDefault ? 'checked' : ''}}">
          <text wx:if="{{formData.isDefault}}">✓</text>
        </view>
        <text class="checkbox-label">设为默认地址</text>
      </view>
    </view>

    <view class="modal-footer">
      <button class="modal-btn secondary" bindtap="onCloseModal">取消</button>
      <button class="modal-btn primary" bindtap="onSaveAddress">保存</button>
    </view>
  </view>
</view>

<!-- 操作弹窗 -->
<view class="action-sheet-mask" wx:if="{{showActions}}" bindtap="onCloseActions">
  <view class="action-sheet" catchtap="onStopPropagation">
    <view class="action-sheet-item" bindtap="onEditAddress">
      <text class="action-icon">✏️</text>
      <text class="action-text">编辑</text>
    </view>
    <view class="action-sheet-item" bindtap="onDeleteAddress" wx:if="{{!currentAddress.isDefault || addresses.length > 1}}">
      <text class="action-icon">🗑️</text>
      <text class="action-text delete">删除</text>
    </view>
    <view class="action-sheet-item cancel" bindtap="onCloseActions">
      <text class="action-text">取消</text>
    </view>
  </view>
</view>

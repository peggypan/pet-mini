/* 地址簿页面样式 */

.page {
  min-height: 100vh;
  background: var(--bg-primary);
  padding-bottom: 140rpx;
}

/* 地址列表 */
.address-list {
  padding: 20rpx;
}

.address-card {
  background: var(--bg-white);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid transparent;
  box-shadow: var(--shadow-soft);
  transition: all 0.2s ease;
}

.address-card.default {
  border-color: var(--primary);
  background: linear-gradient(135deg, rgba(111, 207, 151, 0.08) 0%, rgba(255, 255, 255, 1) 100%);
}

.address-content {
  flex: 1;
  min-width: 0;
}

.address-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.contact-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.contact-phone {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.default-tag {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.address-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.address-actions {
  padding: 8rpx 16rpx;
  margin-left: 16rpx;
}

.action-icon {
  font-size: 36rpx;
  color: var(--text-muted);
  font-weight: 300;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 60rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 底部按钮栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-white);
  border-top: 1rpx solid var(--border-color);
  padding: 24rpx 30rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(42, 42, 42, 0.06);
  z-index: 100;
}

.add-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  border-radius: 56rpx;
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(111, 207, 151, 0.35);
}

.add-btn::after {
  border: none;
}

.add-icon {
  font-size: 32rpx;
  font-weight: 300;
}

.add-text {
  font-size: 30rpx;
}

/* 编辑弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.modal-content {
  width: 100%;
  background: var(--bg-white);
  border-radius: 32rpx 32rpx 0 0;
  max-height: 80vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.modal-close {
  font-size: 48rpx;
  color: var(--text-muted);
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
  overflow-y: auto;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.form-input,
.form-textarea {
  width: 100%;
  background: var(--bg-warm);
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.form-input {
  height: 88rpx;
  line-height: 48rpx;
}

.form-textarea {
  min-height: 120rpx;
  line-height: 1.5;
}

.default-check {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: white;
  transition: all 0.2s ease;
}

.checkbox.checked {
  background: var(--primary);
  border-color: var(--primary);
}

.checkbox-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid var(--border-color);
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 56rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.modal-btn::after {
  border: none;
}

.modal-btn.secondary {
  background: var(--bg-warm);
  color: var(--text-secondary);
  border: 2rpx solid var(--border-color);
}

.modal-btn.primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  box-shadow: 0 6rpx 20rpx rgba(111, 207, 151, 0.3);
}

/* 操作弹窗 */
.action-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.action-sheet {
  width: 100%;
  background: var(--bg-white);
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
}

.action-sheet-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 100rpx;
  border-bottom: 1rpx solid var(--border-color);
  font-size: 30rpx;
}

.action-sheet-item:last-child {
  border-bottom: none;
}

.action-sheet-item.cancel {
  margin-top: 16rpx;
  background: var(--bg-warm);
  border-top: 1rpx solid var(--border-color);
}

.action-icon {
  font-size: 36rpx;
}

.action-text {
  font-size: 30rpx;
  color: var(--text-primary);
}

.action-text.delete {
  color: var(--danger);
}

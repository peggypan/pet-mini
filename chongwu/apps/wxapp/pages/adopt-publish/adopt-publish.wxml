<view class="page">
  <view class="card">
    <text class="label">标题 *</text>
    <input data-field="title" value="{{title}}" bindinput="onInput" placeholder="如：寻找爱心领养家庭" />
    <text class="label">详情 *</text>
    <textarea data-field="desc" value="{{desc}}" bindinput="onInput" placeholder="宠物情况、领养要求等"></textarea>
    <text class="label">联系方式</text>
    <input data-field="contact" value="{{contact}}" bindinput="onInput" placeholder="手机号/微信" />
    <button class="submit" bindtap="onSubmit">发布</button>
  </view>
</view>

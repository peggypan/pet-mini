<view class="page" wx:if="{{buddy}}">
  <view class="user-card">
    <image class="avatar" src="{{buddy.avatar}}" mode="aspectFill"></image>
    <view class="info">
      <text class="name">{{buddy.userName}}</text>
      <text class="meta">{{buddy.distance}} · {{buddy.buddyType}}</text>
      <view class="credit" wx:if="{{buddy.creditTags.length}}">
        <text class="credit-tag" wx:for="{{buddy.creditTags}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
    <view class="user-actions">
      <button
        wx:if="{{!isOwner}}"
        size="mini"
        class="head-follow {{followed ? 'followed' : ''}}"
        bindtap="onFollow"
      >{{followed ? '已关注' : '关注'}}</button>
      <button size="mini" class="head-share" open-type="share" bindtap="onShare">
        <image class="head-share-icon" src="/assets/icons/icon-share-forward.png" mode="aspectFit"></image>
      </button>
    </view>
  </view>

  <view class="card pet-card">
    <text class="pet-headline">{{petHeadline}}</text>
    <text class="pet-breed-line" wx:if="{{petBreedLine}}">品种：{{petBreedLine}}</text>
    <text class="verified" wx:if="{{buddy.verified}}">疫苗已核验 ✓</text>
    <view class="pet-tags" wx:if="{{petTags.length}}">
      <text class="pet-tag" wx:for="{{petTags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="card">
    <text class="card-title">找搭子需求</text>
    <view class="media-grid {{buddy.mediaList.length === 1 ? 'single' : ''}}" wx:if="{{buddy.mediaList && buddy.mediaList.length}}">
      <view
        class="media-item aspect-34 {{buddy.mediaList.length === 1 ? '' : 'aspect-34-third'}} {{item.type === 'video' ? 'is-video' : ''}}"
        wx:for="{{buddy.mediaList}}"
        wx:key="index"
        data-index="{{index}}"
        bindtap="onPreviewMedia"
      >
        <image
          wx:if="{{item.type === 'image'}}"
          class="media-thumb"
          src="{{item.url}}"
          mode="aspectFill"
        ></image>
        <view class="media-video-wrap" wx:elif="{{item.type === 'video' && item.videoAutoPlay}}">
          <video
            class="media-thumb cover-video"
            src="{{item.url}}"
            poster="{{item.poster || ''}}"
            object-fit="cover"
            autoplay="{{true}}"
            controls="{{true}}"
            show-center-play-btn="{{true}}"
            enable-progress-gesture="{{true}}"
          ></video>
        </view>
        <view class="media-video-wrap" wx:elif="{{item.type === 'video'}}">
          <image class="media-thumb" src="{{item.poster || item.url}}" mode="aspectFill"></image>
          <view class="video-play-mask">
            <text class="video-play-icon">▶</text>
            <text class="video-play-dur" wx:if="{{item.duration}}">{{item.duration}}秒</text>
          </view>
        </view>
      </view>
    </view>
    <text class="post-title" wx:if="{{buddy.title}}">{{buddy.title}}</text>
    <text class="desc">{{buddy.desc}}</text>
    <view class="expect expect-time {{expectExpired ? 'is-expired' : ''}}">
      <text class="expect-label">期望时间：</text>
      <text class="expect-val">{{buddy.expectTime}}</text>
      <view class="expect-expired-stamp" wx:if="{{expectExpired}}">已过期</view>
    </view>
    <view class="expired-tip" wx:if="{{expectExpired && !isOwner}}">该找搭子已过期望时间，已从广场下线</view>
    <view class="expired-tip owner" wx:if="{{canRenewExpect}}">帖子已失效，可修改期望时间与地点后重新展示</view>
    <view class="expect expect-place-row">
      <text class="expect-label">期望地点：</text>
      <view class="map-loc-row" bindtap="onOpenPlace">
        <view class="map-loc-main">
          <text class="map-loc-name">{{buddy.expectPlace}}</text>
          <text
            class="map-loc-addr"
            wx:if="{{buddy.expectPlaceAddress && buddy.expectPlaceAddress !== buddy.expectPlace}}"
          >{{buddy.expectPlaceAddress}}</text>
        </view>
        <text class="map-loc-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="bottom">
    <button class="btn-secondary btn-danger-text" wx:if="{{isOwner && !canRenewExpect}}" bindtap="onDeleteBuddy">删除</button>
    <button class="btn-primary" wx:if="{{canRenewExpect}}" bindtap="onRenewExpect">修改时间地点</button>
    <button class="btn-secondary btn-danger-text" wx:if="{{canRenewExpect}}" bindtap="onDeleteBuddy">删除</button>
    <button class="btn-secondary" wx:if="{{!isOwner && !expectExpired}}" bindtap="onCollectBuddy">{{collected ? '已收藏' : '收藏搭子'}}</button>
    <button class="btn-secondary" wx:if="{{!isOwner && !expectExpired}}" bindtap="onReport">举报</button>
    <button class="btn-primary" wx:if="{{!isOwner && !expectExpired}}" bindtap="onChat">发起私聊</button>
    <button class="btn-secondary disabled" wx:if="{{!isOwner && expectExpired}}" disabled>已过期</button>
  </view>
</view>

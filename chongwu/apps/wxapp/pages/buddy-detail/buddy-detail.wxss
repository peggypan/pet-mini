page { background: #F5F8FC; }

.btn-danger-text {
  color: #ff2442 !important;
}
.page { padding: 20rpx 28rpx 160rpx; box-sizing: border-box; }
.user-card {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 22rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.info {
  flex: 1;
  min-width: 0;
  padding-right: 8rpx;
}

.user-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  align-self: flex-start;
  gap: 6rpx;
  padding-top: 2rpx;
}

.head-follow {
  margin: 0;
  padding: 0 16rpx !important;
  width: auto !important;
  min-width: 0 !important;
  max-width: none;
  flex: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  line-height: 1;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 999rpx;
  background: #ffffff;
  color: #ff2442;
  border: 2rpx solid #ff2442;
  box-sizing: border-box;
}

.head-follow.followed {
  color: #999999;
  border-color: #e0e0e0;
  background: #fafafa;
}

.head-follow::after {
  border: none;
}

.head-share {
  margin: 0;
  padding: 0;
  width: 48rpx;
  height: 48rpx;
  min-width: 48rpx;
  flex: none;
  border-radius: 50%;
  background: transparent;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.head-share::after {
  border: none;
}

.head-share-icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
}

.name {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #1A1A1A;
  margin-bottom: 6rpx;
  padding-right: 0;
}
.meta { font-size: 24rpx; color: #999999; }
.credit { display: flex; gap: 8rpx; margin-top: 8rpx; flex-wrap: wrap; }
.credit-tag { font-size: 20rpx; color: #E08A5A; background: rgba(224,138,90,0.12); padding: 2rpx 10rpx; border-radius: 6rpx; }
.card { padding: 24rpx; margin-bottom: 16rpx; background: #fff; border-radius: 22rpx; }
.card-title { display: block; font-size: 28rpx; font-weight: 700; color: #1A1A1A; margin-bottom: 12rpx; }
.pet-line { display: block; font-size: 26rpx; color: #5A6F62; margin-bottom: 8rpx; }
.verified { display: block; font-size: 24rpx; color: #4DA7F8; margin-bottom: 8rpx; }
.link { font-size: 22rpx; color: #4DA7F8; }
.desc { display: block; font-size: 28rpx; color: #3A4F42; line-height: 1.6; margin-bottom: 12rpx; }
.media-grid { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 12rpx; margin-bottom: 16rpx; }
.media-grid.single .media-item { width: 100%; flex: none; max-width: none; }
.media-item { border-radius: 14rpx; background: #E8F4FF; min-width: 0; overflow: hidden; }
.media-thumb { background: #E8F4FF; }
.media-video-wrap {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.media-video-wrap .media-thumb,
.media-video-wrap video {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.video-play-mask {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.25);
}
.video-play-icon { font-size: 48rpx; color: #fff; line-height: 1; margin-bottom: 8rpx; }
.video-play-dur { font-size: 22rpx; color: #fff; background: rgba(0,0,0,0.45); padding: 4rpx 12rpx; border-radius: 999rpx; }
.expect {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  margin-bottom: 14rpx;
  line-height: 1.45;
}

.expect-label {
  font-size: 30rpx;
  color: #999999;
}

.expect-val {
  font-size: 30rpx;
  font-weight: 400;
  color: #999999;
}

.expect.expect-place-row {
  align-items: center;
}

.expect-place-row .expect-label {
  flex-shrink: 0;
}

.map-loc-row {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  gap: 8rpx;
  box-sizing: border-box;
  padding: 10rpx 14rpx;
  border-radius: 14rpx;
  background: rgba(126, 200, 255, 0.18);
  border: 2rpx solid rgba(77, 167, 248, 0.28);
}

.map-loc-row:active {
  opacity: 0.82;
}

.map-loc-main {
  flex: 1;
  min-width: 0;
}

.map-loc-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1E88E5;
  line-height: 1.35;
}

.map-loc-addr {
  display: block;
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #666666;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.map-loc-arrow {
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #1E88E5;
  line-height: 1;
}
.bottom { position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 12rpx; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,0.98); box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.04); }
.btn-primary, .btn-secondary { flex: 1; margin: 0; height: 96rpx; padding: 0 12rpx; border-radius: 40rpx; border: none; white-space: nowrap; }
.btn-primary { background: linear-gradient(135deg, #5BB8FF, #4DA7F8); color: #1A1A1A; box-shadow: 0 6rpx 20rpx rgba(77, 167, 248, 0.3); }
.btn-secondary { background: #F5F8FC; color: #1A1A1A; }
.btn-primary::after, .btn-secondary::after { border: none; }

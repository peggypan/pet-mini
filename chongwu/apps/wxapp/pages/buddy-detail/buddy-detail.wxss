page { background: #F5F5F5; }
.page { padding: 20rpx 28rpx 160rpx; box-sizing: border-box; }
.user-card { display: flex; padding: 24rpx; margin-bottom: 16rpx; background: #fff; border-radius: 22rpx; }
.avatar { width: 96rpx; height: 96rpx; border-radius: 50%; margin-right: 18rpx; }
.name { display: block; font-size: 32rpx; font-weight: 800; color: #1A1A1A; }
.meta { font-size: 24rpx; color: #999999; }
.credit { display: flex; gap: 8rpx; margin-top: 8rpx; flex-wrap: wrap; }
.credit-tag { font-size: 20rpx; color: #E08A5A; background: rgba(224,138,90,0.12); padding: 2rpx 10rpx; border-radius: 6rpx; }
.card { padding: 24rpx; margin-bottom: 16rpx; background: #fff; border-radius: 22rpx; }
.card-title { display: block; font-size: 28rpx; font-weight: 700; color: #1A1A1A; margin-bottom: 12rpx; }
.pet-line { display: block; font-size: 26rpx; color: #5A6F62; margin-bottom: 8rpx; }
.verified { display: block; font-size: 24rpx; color: #4CE600; margin-bottom: 8rpx; }
.link { font-size: 22rpx; color: #4CE600; }
.desc { display: block; font-size: 28rpx; color: #3A4F42; line-height: 1.6; margin-bottom: 12rpx; }
.media-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.media-grid.single .media-item { width: 100%; height: 360rpx; }
.media-item { position: relative; width: calc((100% - 24rpx) / 3); height: 200rpx; border-radius: 14rpx; overflow: hidden; }
.media-thumb { width: 100%; height: 100%; background: #E8F8EF; }
.media-video-wrap { position: relative; width: 100%; height: 100%; }
.video-play-mask {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.25);
}
.video-play-icon { font-size: 48rpx; color: #fff; line-height: 1; margin-bottom: 8rpx; }
.video-play-dur { font-size: 22rpx; color: #fff; background: rgba(0,0,0,0.45); padding: 4rpx 12rpx; border-radius: 999rpx; }
.expect { display: block; font-size: 24rpx; color: #999999; margin-bottom: 6rpx; }
.bottom { position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 12rpx; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,0.98); box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.04); }
.btn-primary, .btn-secondary { flex: 1; margin: 0; height: 80rpx; padding: 0 12rpx; border-radius: 40rpx; font-size: 26rpx; font-weight: 600; border: none; white-space: nowrap; }
.btn-primary { background: linear-gradient(135deg, #D4FF00, #4CE600); color: #1A1A1A; box-shadow: 0 6rpx 20rpx rgba(76, 230, 0, 0.3); }
.btn-secondary { background: #F5F5F5; color: #1A1A1A; }
.btn-primary::after, .btn-secondary::after { border: none; }

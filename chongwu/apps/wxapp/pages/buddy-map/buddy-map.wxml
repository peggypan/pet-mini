<view class="page">
  <view class="top-bar">
    <text class="top-count">{{mapPeerCount}} 位{{mapSpeciesFilter === 'all' ? '宠友' : mapSpeciesFilterLabel}}在附近</text>
    <text class="top-tip">地图标签：蓝狗 · 橙猫 · 紫异宠 · 点头像看详情</text>
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="species-scroll">
      <view
        class="species-tab {{mapSpeciesFilter === item.key ? 'on' : ''}}"
        wx:for="{{speciesTabs}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onSpeciesFilter"
      >
        <text>{{item.label}}</text>
        <text class="species-tab-count" wx:if="{{mapSpeciesCounts[item.key] > 0}}">{{mapSpeciesCounts[item.key]}}</text>
      </view>
    </scroll-view>
  </view>
  <view class="map-wrap">
    <map
      class="map"
      longitude="{{mapLongitude}}"
      latitude="{{mapLatitude}}"
      scale="{{mapScale}}"
      markers="{{mapMarkers}}"
      enable-zoom
      enable-scroll
      bindmarkertap="onMapMarkerTap"
    ></map>
  </view>
  <view class="chat-dock" wx:if="{{mapPeers.length}}">
    <text class="chat-dock-title">附近搭子 · 点头像看详情</text>
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="chat-dock-scroll">
      <view
        class="chat-peer"
        wx:for="{{mapPeers}}"
        wx:key="peerId"
        data-index="{{index}}"
        bindtap="onPeerTap"
      >
        <view class="chat-peer-avatar-wrap {{item.speciesDockClass}}">
          <image class="chat-peer-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
          <text class="chat-peer-species">{{item.speciesTag}}</text>
        </view>
        <text class="chat-peer-name">{{item.petName || item.userName}}</text>
      </view>
    </scroll-view>
  </view>
</view>

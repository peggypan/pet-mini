<view class="page">
  <view class="top-bar">
    <text class="top-count">{{mapPeerCount}} 位宠友在附近</text>
    <text class="top-tip">点地图或下方头像进入搭子详情</text>
  </view>
  <view class="map-wrap">
    <map
      class="map"
      longitude="{{mapLongitude}}"
      latitude="{{mapLatitude}}"
      scale="{{mapScale}}"
      markers="{{mapMarkers}}"
      enable-zoom
      enable-scroll
      bindmarkertap="onMapMarkerTap"
    ></map>
  </view>
  <view class="chat-dock" wx:if="{{mapPeers.length}}">
    <text class="chat-dock-title">附近搭子 · 点头像看详情</text>
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="chat-dock-scroll">
      <view
        class="chat-peer"
        wx:for="{{mapPeers}}"
        wx:key="peerId"
        data-index="{{index}}"
        bindtap="onPeerTap"
      >
        <image class="chat-peer-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
        <text class="chat-peer-name">{{item.petName || item.userName}}</text>
      </view>
    </scroll-view>
  </view>
</view>

page {
  height: 100%;
  background: #f5f5f5;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.top-bar {
  flex-shrink: 0;
  padding: 16rpx 28rpx 12rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #eeeeee;
}

.top-count {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #1a1a1a;
}

.top-tip {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #888888;
}

.map-wrap {
  flex: 1;
  position: relative;
  min-height: 0;
  width: 100%;
}

.map {
  width: 100%;
  height: 100%;
}

.chat-dock {
  flex-shrink: 0;
  padding: 16rpx 0 calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.chat-dock-title {
  display: block;
  padding: 0 28rpx 12rpx;
  font-size: 22rpx;
  color: #888888;
}

.chat-dock-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}

.chat-peer {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  margin-right: 8rpx;
  vertical-align: top;
}

.chat-peer-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  border: 4rpx solid rgba(126, 200, 255, 0.5);
  background: #f0f0f0;
}

.chat-peer-name {
  margin-top: 8rpx;
  max-width: 112rpx;
  font-size: 20rpx;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}


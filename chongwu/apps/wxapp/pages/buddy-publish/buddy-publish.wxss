page { background: #F5F8FC; }

.page { padding: 24rpx 28rpx; }

.card {
  padding: 28rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.label {
  display: block;
  font-size: 24rpx;
  color: #666666;
  margin: 16rpx 0 10rpx;
  font-weight: 600;
}

.label:first-child { margin-top: 0; }

.field-input {
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  margin-bottom: 4rpx;
}

.field-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.healing-publish-hint {
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  background: #eefaf3;
  color: #2d6a4f;
  font-size: 24rpx;
  line-height: 1.5;
}

.label-tip {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

input, .picker, textarea {
  width: 100%;
  background: #F5F8FC;
  border-radius: 14rpx;
  box-sizing: border-box;
  margin-bottom: 8rpx;
}

/* iOS 上全局 textarea height:auto 会把输入框撑得很高 */
.field-textarea {
  height: 240rpx;
  min-height: 240rpx;
  max-height: 320rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.time-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.time-picker-wrap {
  flex: 1;
  min-width: 0;
}

.time-picker {
  margin-bottom: 0;
}

.time-picker.is-placeholder {
  color: #999999;
}

.time-preview {
  display: block;
  font-size: 22rpx;
  color: #1E88E5;
  margin-bottom: 8rpx;
}

.tool-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tool-btn {
  flex: 1;
  margin: 0;
  height: 76rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  border: none;
  background: rgba(126, 200, 255, 0.25);
  color: #1A1A1A;
  font-size: 26rpx;
  font-weight: 600;
}

.tool-btn::after { border: none; }

.media-grid {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.media-item {
  border-radius: 16rpx;
  overflow: hidden;
}

.media-thumb {
  background: #E8F4FF;
}

.video-badge {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 12rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
}

.video-icon, .video-dur {
  font-size: 20rpx;
  color: #FFFFFF;
}

.remove-media {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.media-add {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F8FC;
  border-radius: 14rpx;
  border: 2rpx dashed rgba(77, 167, 248, 0.35);
  box-sizing: border-box;
}

.add-icon {
  font-size: 48rpx;
  color: #BBBBBB;
}

.media-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  margin-bottom: 20rpx;
  background: #F5F8FC;
  border-radius: 20rpx;
  border: 2rpx dashed rgba(77, 167, 248, 0.35);
}

.empty-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 24rpx;
  color: #999999;
}

.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 20rpx 0;
  font-size: 26rpx;
  color: #1A1A1A;
}

.submit {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #5BB8FF, #4DA7F8);
  color: #1A1A1A;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(77, 167, 248, 0.3);
}

.submit::after { border: none; }

/* 期望地点 · 地图选点 */
.place-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 16rpx 24rpx;
  background: #F8F8F8;
  border-radius: 16rpx;
}

.place-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.place-value {
  font-size: 28rpx;
  color: #1A1A1A;
}

.place-value.is-placeholder {
  color: #BBBBBB;
}

.place-addr {
  font-size: 22rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.place-arrow {
  margin-left: 12rpx;
  font-size: 32rpx;
  color: #BBBBBB;
  font-weight: 700;
}

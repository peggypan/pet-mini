<view class="page">
  <view class="city-bar" bindtap="onCityTap">
    <text class="city-bar-text">{{city}} · 全国同城</text>
    <text class="city-bar-arrow">切换 ›</text>
  </view>

  <view class="pet-map-section">
    <view class="pet-map-head">
      <view class="pet-map-head-text">
        <text class="pet-map-title">宠友搭子</text>
        <text class="pet-map-sub">点击地图进入宠物友好地图 · 点头像私聊</text>
      </view>
      <view class="pet-map-count">{{mapPeerCount}} 位在附近</view>
    </view>
    <view class="pet-map-wrap">
      <map
        class="pet-map"
        longitude="{{mapLongitude}}"
        latitude="{{mapLatitude}}"
        scale="{{mapScale}}"
        markers="{{mapMarkers}}"
        show-location
        enable-zoom="{{false}}"
        enable-scroll="{{false}}"
      >
        <cover-view class="pet-map-tap-layer" catchtap="onOpenBuddyMap">
          <cover-view class="pet-map-tap-hint">点击进入宠物友好地图</cover-view>
        </cover-view>
      </map>
    </view>
  </view>

  <view class="zone-tabs">
    <view class="zone-tab {{zoneTab === 'normal' ? 'on' : ''}}" data-zone="normal" bindtap="onZoneTab">普通搭子</view>
    <view class="zone-tab {{zoneTab === 'healing' ? 'on' : ''}}" data-zone="healing" bindtap="onZoneTab">疗愈搭子</view>
    <view class="zone-tab {{zoneTab === 'match' ? 'on' : ''}}" data-zone="match" bindtap="onZoneTab">相亲&借配</view>
  </view>
  <view class="match-tip healing-tip" wx:if="{{zoneTab === 'healing'}}">💚 {{healingTip}}</view>
  <view class="match-tip" wx:if="{{zoneTab === 'match'}}">⚠️ {{matchTip}}</view>

  <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="filter-scroll">
    <view class="filter {{filterType === '全部' ? 'on' : ''}}" data-type="全部" bindtap="onFilterType">全部</view>
    <view class="filter {{filterType === item ? 'on' : ''}}" wx:for="{{buddyTypes}}" wx:key="*this" data-type="{{item}}" bindtap="onFilterType">{{item}}</view>
    <view class="filter {{filterVerified ? 'on' : ''}}" bindtap="onToggleVerified">疫苗已核验</view>
  </scroll-view>

  <view class="buddy-plaza-list">
    <view
      class="buddy-plaza-card"
      wx:for="{{list}}"
      wx:key="feedKey"
      bindtap="onCardTap"
      data-id="{{item.id}}"
    >
      <view class="buddy-plaza-cover aspect-34">
        <image
          class="aspect-34-fill"
          src="{{item.coverIsVideo ? (item.coverPoster || item.cover) : item.cover}}"
          mode="aspectFill"
          lazy-load="{{true}}"
        ></image>
        <view class="cover-video-mask" wx:if="{{item.coverIsVideo}}">
          <text class="cover-video-tag">▶</text>
        </view>
        <text class="buddy-plaza-dist">{{item.distanceLabel}}</text>
      </view>
      <view class="buddy-plaza-body">
        <text class="buddy-plaza-name">{{item.cardTitle}}</text>
        <view class="buddy-plaza-score">
          <text class="buddy-plaza-star">★</text>
          <text class="buddy-plaza-score-text" wx:if="{{item.verified}}">已核验</text>
          <text class="buddy-plaza-score-div" wx:if="{{item.verified}}">|</text>
          <text class="buddy-plaza-score-text">{{item.buddyType}}</text>
        </view>
        <text class="buddy-plaza-pet-line" wx:if="{{item.petLine}}">{{item.petLine}}</text>
        <text
          class="buddy-plaza-place place-tap"
          wx:if="{{item.expectPlace}}"
          catchtap="onOpenPlace"
          data-name="{{item.expectPlace}}"
          data-place="{{item.expectPlace}}"
          data-address="{{item.expectPlaceAddress}}"
          data-lat="{{item.placeLat}}"
          data-lng="{{item.placeLng}}"
        >{{item.expectPlace}}</text>
        <view class="buddy-plaza-tags" wx:if="{{item.tags.length}}">
          <text class="buddy-plaza-tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
        </view>
        <text class="buddy-plaza-author">{{item.authorLine}}</text>
        <view class="feed-actions feed-actions-compact" wx:if="{{item.canDelete}}">
          <view
            class="feed-action feed-action-delete"
            catchtap="onDeleteBuddy"
            data-id="{{item.id}}"
          >
            <text>删除</text>
          </view>
        </view>
      </view>
    </view>
    <view class="buddy-plaza-empty" wx:if="{{list.length === 0 && !listLoading}}">
      <text>暂无搭子，来发布第一条吧</text>
    </view>
    <view class="feed-footer" wx:if="{{list.length > 0}}">
      <text wx:if="{{listLoading}}">加载中…</text>
      <text wx:elif="{{listHasMore}}">上拉加载更多</text>
      <text wx:else>— 已经到底啦 —</text>
    </view>
  </view>

  <view class="fab fab-publish" bindtap="onPublish">发布找搭子</view>

  <pet-profile-gate show="{{petProfileBlocked}}" />
</view>

page {
  background: linear-gradient(180deg, #E8F4FF 0%, #F5F8FC 280rpx, #F5F8FC 100%);
}

.page {
  padding: 20rpx 28rpx calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.pet-map-section {
  margin-bottom: 24rpx;
  padding: 20rpx 20rpx 16rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.pet-map-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.pet-map-head-text {
  flex: 1;
  min-width: 0;
}

.pet-map-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #1a1a1a;
  line-height: 1.2;
}

.pet-map-sub {
  display: block;
  font-size: 22rpx;
  color: #888888;
  margin-top: 6rpx;
}

.pet-map-count {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(126, 200, 255, 0.35);
  font-size: 22rpx;
  font-weight: 700;
  color: #1E88E5;
  white-space: nowrap;
}

.pet-map-wrap {
  position: relative;
  height: 360rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 2rpx solid rgba(126, 200, 255, 0.25);
}

.pet-map {
  width: 100%;
  height: 100%;
}

.pet-map-tap-layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.pet-map-tap-hint {
  margin-bottom: 20rpx;
  padding: 14rpx 36rpx;
  border-radius: 999rpx;
  background-color: rgba(255, 255, 255, 0.92);
  font-size: 30rpx;
  font-weight: 700;
  color: #1E88E5;
  line-height: 1.35;
  text-align: center;
}

.zone-tabs {
  display: flex;
  gap: 24rpx;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.zone-tab {
  position: relative;
  padding: 12rpx 4rpx 20rpx;
  font-size: 30rpx;
  color: #999999;
  background: transparent;
}

.zone-tab.on {
  color: #1A1A1A;
  font-weight: 800;
}

.zone-tab.on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 48rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #7EC8FF;
}

.match-tip {
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background: #FFF9E6;
  font-size: 22rpx;
  color: #996600;
  line-height: 1.5;
}

.healing-tip {
  background: #eefaf3;
  color: #2d6a4f;
}

.filter-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.filter {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  font-size: 24rpx;
  color: #666666;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.filter.on {
  background: rgba(126, 200, 255, 0.35);
  color: #1A1A1A;
  font-weight: 700;
}

.cover-video-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.22);
  pointer-events: none;
}

.cover-video-tag {
  font-size: 36rpx;
  color: #ffffff;
  line-height: 1;
}

.buddy-plaza-body {
  padding-bottom: 12rpx;
}

.buddy-plaza-intro {
  margin-bottom: 4rpx;
}

.buddy-plaza-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 8rpx;
}

.buddy-plaza-delete {
  font-size: 22rpx;
  color: #ff2442;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #fff5f5;
  border: 1rpx solid #ffc9c9;
}

.feed-action-delete text {
  font-size: 24rpx;
  font-weight: 600;
  color: #ff2442;
}

.feed-actions-compact {
  padding-top: 10rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid #eef2f6;
}

.feed-actions-compact .feed-action text,
.feed-actions-compact .feed-action-share-btn text {
  font-size: 20rpx;
}

.feed-actions-compact .feed-icon {
  width: 30rpx;
  height: 30rpx;
}

.buddy-plaza-empty {
  width: 100%;
  padding: 80rpx 24rpx;
  text-align: center;
  color: #999999;
  font-size: 26rpx;
}

.feed-footer {
  width: 100%;
  padding: 28rpx 16rpx 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 36rpx;
  height: 96rpx;
  line-height: 1.4;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #5BB8FF 0%, #4DA7F8 100%);
  color: #1A1A1A;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 28rpx rgba(77, 167, 248, 0.4);
  z-index: 20;
}

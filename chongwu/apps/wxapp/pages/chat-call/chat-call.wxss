.call-page {
  min-height: 100vh;
  background: #1A1A1A;
  position: relative;
  overflow: hidden;
}

.remote-view {
  position: relative;
  width: 100%;
  height: 100vh;
}

.remote-avatar {
  width: 100%;
  height: 100%;
  filter: blur(2rpx);
}

.remote-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
}

.remote-name {
  position: absolute;
  top: 120rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  z-index: 2;
}

.call-status {
  position: absolute;
  top: 180rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  z-index: 2;
}

.call-timer {
  position: absolute;
  top: 220rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 32rpx;
  color: #7EC8FF;
  font-weight: 700;
  z-index: 2;
  font-variant-numeric: tabular-nums;
}

.local-view {
  position: absolute;
  top: 160rpx;
  right: 32rpx;
  width: 180rpx;
  height: 240rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  z-index: 3;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
}

.local-avatar {
  width: 100%;
  height: 100%;
}

.local-label {
  position: absolute;
  left: 12rpx;
  bottom: 12rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  background: rgba(0, 0, 0, 0.4);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.controls {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(80rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  align-items: flex-start;
  gap: 80rpx;
  z-index: 4;
}

.ctrl-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.ctrl-btn {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.ctrl-btn.on {
  background: rgba(255, 255, 255, 0.35);
}

.hangup-btn {
  background: #FF4D4F !important;
  transform: rotate(135deg);
}

.ctrl-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.demo-tip {
  position: absolute;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  text-align: center;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  z-index: 4;
}

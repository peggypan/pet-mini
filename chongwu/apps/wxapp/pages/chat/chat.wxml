<view class="page {{panelTools ? 'tools-open' : ''}} {{panelEmoji ? 'emoji-open' : ''}}">
  <view class="peer-bar" wx:if="{{peer}}">
    <image class="peer-avatar" src="{{peerAvatar || peer.avatar}}" mode="aspectFill"></image>
    <view class="peer-info">
      <text class="peer-name">{{peer.userName}} · {{peer.petName}}</text>
      <text class="peer-tip">输入框右侧笑脸可发表情包</text>
    </view>
    <view class="peer-actions">
      <button
        class="peer-follow {{followed ? 'followed' : ''}}"
        size="mini"
        bindtap="onToggleFollow"
      >{{followed ? '已关注' : '关注'}}</button>
      <view
        class="peer-like-btn {{peerLiked ? 'active' : ''}}"
        bindtap="onTogglePeerLike"
      >
        <text class="peer-like-icon">{{peerLiked ? '♥' : '♡'}}</text>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="msg-scroll" scroll-into-view="{{scrollInto}}" scroll-with-animation>
    <view class="chat-limit-tip" wx:if="{{showChatLimitTip}}">
      <text>{{chatLimitTip}}</text>
    </view>
    <view
      class="msg-row {{item.isMe ? 'me' : 'peer'}}"
      wx:for="{{messages}}"
      wx:key="id"
      id="msg-{{index}}"
    >
      <image
        wx:if="{{!item.isMe}}"
        class="msg-avatar"
        src="{{item.displayAvatar || peerAvatar}}"
        mode="aspectFill"
      ></image>

      <view class="msg-body">
      <view class="bubble" wx:if="{{item.type === 'text' || !item.type}}">{{item.content}}</view>

      <view class="bubble share-comment-bubble" wx:if="{{item.type === 'shareComment'}}">
        <text class="share-comment-tag">分享评论</text>
        <text class="share-comment-title">{{item.shareTitle || '分享'}}</text>
        <text class="share-comment-body" wx:if="{{item.content}}">{{item.content}}</text>
      </view>

      <view class="voice-wrap" wx:if="{{item.type === 'voice'}}">
        <view class="voice-text-bubble" wx:if="{{item.voiceText}}">
          <text class="voice-text">{{item.voiceText}}</text>
        </view>
        <view
          class="bubble voice-bubble {{playingId === item.id ? 'playing' : ''}}"
          data-url="{{item.playUrl || item.url}}"
          data-id="{{item.id}}"
          data-index="{{index}}"
          bindtap="onPlayVoice"
          bindlongpress="onVoiceLongPress"
        >
          <view class="voice-bars" wx:if="{{playingId === item.id}}">
            <view class="vbar"></view>
            <view class="vbar"></view>
            <view class="vbar"></view>
          </view>
          <text class="voice-dur">{{item.duration || 1}}"</text>
        </view>
      </view>

      <view class="bubble media-bubble" wx:if="{{item.type === 'image'}}">
        <image
          class="msg-image"
          src="{{item.url}}"
          mode="widthFix"
          data-url="{{item.url}}"
          data-index="{{index}}"
          data-file-id="{{item.fileId}}"
          bindtap="onPreviewImage"
          binderror="onChatImageError"
        ></image>
      </view>

      <view class="bubble media-bubble" wx:if="{{item.type === 'video'}}">
        <view
          class="msg-video"
          data-url="{{item.url}}"
          data-poster="{{item.poster}}"
          bindtap="onPreviewVideo"
        >
          <image class="msg-video-cover" src="{{item.poster || item.url}}" mode="aspectFill"></image>
          <view class="play-icon">▶</view>
        </view>
      </view>

      <view
        class="bubble loc-bubble"
        wx:if="{{item.type === 'location'}}"
        data-lat="{{item.location.latitude}}"
        data-lng="{{item.location.longitude}}"
        data-name="{{item.location.name}}"
        data-address="{{item.location.address}}"
        bindtap="onOpenLocation"
      >
        <text class="loc-name place-tap">{{item.location.name || '位置分享'}}</text>
        <text class="loc-addr">{{item.location.address}}</text>
      </view>

      <view class="bubble event-bubble" wx:if="{{item.type === 'event'}}">
        <text class="event-tag">活动邀请</text>
        <text class="event-title">{{item.eventTitle || item.content}}</text>
        <text class="event-tip">点击查看同城活动</text>
      </view>

      <view class="bubble aa-bubble" wx:if="{{item.type === 'aa'}}">
        <text class="aa-tag">AA</text>
        <text class="aa-amount">¥{{item.aaAmount || item.content}}</text>
        <text class="aa-meta">{{item.aaPeople || 2}} 人参与 · 人均约 ¥{{item.aaPer || '—'}}</text>
        <text class="aa-tip">点击确认参与（演示）</text>
      </view>

      <view class="bubble call-bubble" wx:if="{{item.type === 'call'}}">
        <view class="call-info">
          <text class="call-title">视频通话</text>
          <text class="call-meta" wx:if="{{item.duration}}">时长 {{item.duration}} 秒</text>
          <text class="call-meta" wx:elif="{{item.callStatus === 'missed'}}">未接通</text>
          <text class="call-meta" wx:else>已结束</text>
        </view>
      </view>
      <text class="msg-time" wx:if="{{item.timeLabel}}">{{item.timeLabel}}</text>
      </view>

      <image
        wx:if="{{item.isMe}}"
        class="msg-avatar"
        src="{{item.displayAvatar || myAvatar}}"
        mode="aspectFill"
      ></image>
    </view>

    <view class="msg-empty" wx:if="{{messages.length === 0}}">
      <text>打个招呼，开始聊吧～</text>
    </view>
  </scroll-view>

  <chat-composer
    value="{{inputText}}"
    placeholder="{{composerPlaceholder}}"
    disabled="{{composerDisabled}}"
    show-voice="{{false}}"
    show-plus="{{false}}"
    bind:input="onComposerInput"
    bind:send="onComposerSend"
    bind:tool="onComposerTool"
    bind:voice="onComposerVoice"
    bind:panelchange="onPanelChange"
    bind:blocked="onComposerBlocked"
  />

  <pet-profile-gate show="{{petProfileBlocked}}" />

  <view class="heart-center-layer" wx:if="{{centerHeartAnim}}">
    <view class="heart-center-stage">
      <text class="heart-center-main">♥</text>
      <text class="heart-center-spark hs1">✦</text>
      <text class="heart-center-spark hs2">♥</text>
      <text class="heart-center-spark hs3">✦</text>
      <text class="heart-center-spark hs4">✦</text>
      <text class="heart-center-spark hs5">♥</text>
    </view>
  </view>
</view>


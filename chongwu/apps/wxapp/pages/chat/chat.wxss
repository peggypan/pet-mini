page { background: #F5F8FC; }

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page.tools-open {
  padding-bottom: calc(380rpx + env(safe-area-inset-bottom));
}

.page.emoji-open {
  padding-bottom: calc(540rpx + env(safe-area-inset-bottom));
}

.peer-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid #F0F0F0;
}

.peer-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.peer-info { flex: 1; min-width: 0; }

.peer-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.peer-tip {
  font-size: 22rpx;
  color: #999999;
}

.call-entry {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(126, 200, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.msg-scroll {
  flex: 1;
  height: calc(100vh - 280rpx);
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.msg-row.me { flex-direction: row-reverse; }

.msg-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.msg-row.me .msg-avatar { margin-left: 12rpx; }
.msg-row.peer .msg-avatar { margin-right: 12rpx; }

.bubble {
  max-width: 70%;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-word;
}

.msg-row.peer .bubble {
  background: #fff;
  color: #1A1A1A;
  border-top-left-radius: 6rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.msg-row.me .bubble {
  background: linear-gradient(135deg, #5BB8FF, #4DA7F8);
  color: #1A1A1A;
  border-top-right-radius: 6rpx;
}

.media-bubble { padding: 8rpx; overflow: hidden; }

.msg-image {
  max-width: 360rpx;
  border-radius: 12rpx;
  display: block;
}

.msg-video {
  position: relative;
  width: 320rpx;
  height: 240rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.msg-video-cover {
  width: 100%;
  height: 100%;
  background: #333;
}

.play-icon {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 6rpx;
}

.loc-bubble {
  min-width: 400rpx;
  padding: 20rpx !important;
}

.loc-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.loc-addr {
  display: block;
  font-size: 24rpx;
  opacity: 0.75;
  margin-bottom: 8rpx;
}

.loc-tip {
  display: block;
  font-size: 22rpx;
  color: #1E88E5;
  font-weight: 600;
}

.call-bubble {
  min-width: 280rpx;
}

.call-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
}

.call-meta {
  display: block;
  font-size: 22rpx;
  opacity: 0.7;
  margin-top: 4rpx;
}

.msg-empty {
  padding: 80rpx 0;
  text-align: center;
  color: #999999;
  font-size: 26rpx;
}

.voice-bubble {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 160rpx;
}

.voice-dur {
  font-size: 26rpx;
  font-weight: 600;
}

.event-bubble {
  min-width: 320rpx;
}

.event-tag {
  display: block;
  font-size: 22rpx;
  color: #1E88E5;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.event-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.event-tip {
  display: block;
  font-size: 22rpx;
  opacity: 0.65;
}

.aa-bubble {
  min-width: 300rpx;
  background: #fff7ed !important;
  border: 1rpx solid #fed7aa;
}

.msg-row.me .aa-bubble {
  background: #fff7ed !important;
  color: #1a1a1a;
}

.aa-tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 900;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.aa-amount {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.aa-meta {
  display: block;
  font-size: 22rpx;
  color: #666666;
  margin-bottom: 6rpx;
}

.aa-tip {
  display: block;
  font-size: 20rpx;
  color: #999999;
}

.voice-wrap {
  display: flex;
  flex-direction: column;
  max-width: 70%;
}

.msg-row.peer .voice-wrap { align-items: flex-start; }
.msg-row.me .voice-wrap { align-items: flex-end; }

.voice-bubble.playing {
  background: rgba(126, 200, 255, 0.45);
}

.voice-bars {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 36rpx;
}

.vbar {
  width: 8rpx;
  border-radius: 8rpx;
  background: #1A1A1A;
  transform-origin: center;
  animation: voice-jump 0.8s ease-in-out infinite;
}

.vbar:nth-child(1) { height: 16rpx; animation-delay: 0s; }
.vbar:nth-child(2) { height: 32rpx; animation-delay: 0.15s; }
.vbar:nth-child(3) { height: 22rpx; animation-delay: 0.3s; }

@keyframes voice-jump {
  0%, 100% { transform: scaleY(0.35); }
  50% { transform: scaleY(1); }
}

.voice-text-bubble {
  margin-bottom: 8rpx;
  padding: 16rpx 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  max-width: 100%;
  box-sizing: border-box;
}

.voice-text {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.5;
  word-break: break-all;
}

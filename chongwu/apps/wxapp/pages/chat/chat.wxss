page { background: #F5F5F5; }

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page.tools-open {
  padding-bottom: calc(340rpx + env(safe-area-inset-bottom));
}

.page.emoji-open {
  padding-bottom: calc(540rpx + env(safe-area-inset-bottom));
}

.peer-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid #F0F0F0;
}

.peer-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.peer-info { flex: 1; min-width: 0; }

.peer-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.peer-tip {
  font-size: 22rpx;
  color: #999999;
}

.call-entry {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(197, 255, 74, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.msg-scroll {
  flex: 1;
  height: calc(100vh - 280rpx);
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.msg-row.me { flex-direction: row-reverse; }

.msg-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.msg-row.me .msg-avatar { margin-left: 12rpx; }
.msg-row.peer .msg-avatar { margin-right: 12rpx; }

.bubble {
  max-width: 70%;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-word;
}

.msg-row.peer .bubble {
  background: #fff;
  color: #1A1A1A;
  border-top-left-radius: 6rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.msg-row.me .bubble {
  background: linear-gradient(135deg, #D4FF00, #4CE600);
  color: #1A1A1A;
  border-top-right-radius: 6rpx;
}

.media-bubble { padding: 8rpx; overflow: hidden; }

.msg-image {
  max-width: 360rpx;
  border-radius: 12rpx;
  display: block;
}

.msg-video {
  position: relative;
  width: 320rpx;
  height: 240rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.msg-video-cover {
  width: 100%;
  height: 100%;
  background: #333;
}

.play-icon {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 6rpx;
}

.loc-bubble {
  min-width: 400rpx;
  padding: 20rpx !important;
}

.loc-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.loc-addr {
  display: block;
  font-size: 24rpx;
  opacity: 0.75;
  margin-bottom: 8rpx;
}

.loc-tip {
  display: block;
  font-size: 22rpx;
  color: #2DB300;
  font-weight: 600;
}

.call-bubble {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 280rpx;
}

.call-icon { font-size: 40rpx; }

.call-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
}

.call-meta {
  display: block;
  font-size: 22rpx;
  opacity: 0.7;
  margin-top: 4rpx;
}

.msg-empty {
  padding: 80rpx 0;
  text-align: center;
  color: #999999;
  font-size: 26rpx;
}

.voice-bubble {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 160rpx;
}

.voice-icon {
  font-size: 32rpx;
}

.voice-dur {
  font-size: 26rpx;
  font-weight: 600;
}

.event-bubble {
  min-width: 320rpx;
}

.event-tag {
  display: block;
  font-size: 22rpx;
  color: #2DB300;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.event-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.event-tip {
  display: block;
  font-size: 22rpx;
  opacity: 0.65;
}

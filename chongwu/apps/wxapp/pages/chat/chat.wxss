page { background: #F5F8FC; }

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page.tools-open {
  padding-bottom: calc(380rpx + env(safe-area-inset-bottom));
}

.page.emoji-open {
  padding-bottom: calc(540rpx + env(safe-area-inset-bottom));
}

.peer-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid #F0F0F0;
}

.peer-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.peer-info {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
}

.peer-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  gap: 12rpx;
}

.peer-follow {
  margin: 0;
  padding: 0 20rpx !important;
  width: auto !important;
  min-width: 0 !important;
  height: 52rpx;
  line-height: 52rpx;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 999rpx;
  background: #ffffff;
  color: #ff2442;
  border: 2rpx solid #ff2442;
  box-sizing: border-box;
}

.peer-follow.followed {
  color: #999999;
  border-color: #e0e0e0;
  background: #fafafa;
}

.peer-follow::after {
  border: none;
}

.peer-like-btn {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff5f8;
  border: 2rpx solid #ffd6e3;
  box-sizing: border-box;
}

.peer-like-btn.active {
  background: #ff3d81;
  border-color: #ff3d81;
}

.peer-like-icon {
  font-size: 32rpx;
  line-height: 1;
  color: #ff3d81;
  font-weight: 700;
}

.peer-like-btn.active .peer-like-icon {
  color: #ffffff;
}

.heart-center-layer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1200;
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.heart-center-stage {
  position: relative;
  width: 320rpx;
  height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.heart-center-main {
  font-size: 200rpx;
  line-height: 1;
  color: #ff3d81;
  font-weight: 800;
  text-shadow: 0 12rpx 48rpx rgba(255, 61, 129, 0.45);
  animation: heart-center-pop 0.88s cubic-bezier(0.34, 1.45, 0.64, 1) forwards;
}

.heart-center-spark {
  position: absolute;
  left: 50%;
  top: 50%;
  font-size: 40rpx;
  opacity: 0;
  margin-left: -20rpx;
  margin-top: -20rpx;
}

.heart-center-spark.hs1 {
  color: #ffb800;
  animation: heart-center-fly-1 0.85s ease-out 0.06s forwards;
}

.heart-center-spark.hs2 {
  color: #ff3d81;
  font-size: 52rpx;
  animation: heart-center-fly-2 0.85s ease-out 0.1s forwards;
}

.heart-center-spark.hs3 {
  color: #ff8fab;
  animation: heart-center-fly-3 0.85s ease-out 0.12s forwards;
}

.heart-center-spark.hs4 {
  color: #ffd6e3;
  font-size: 36rpx;
  animation: heart-center-fly-4 0.85s ease-out 0.08s forwards;
}

.heart-center-spark.hs5 {
  color: #ff2442;
  font-size: 44rpx;
  animation: heart-center-fly-5 0.85s ease-out 0.14s forwards;
}

@keyframes heart-center-pop {
  0% {
    opacity: 0;
    transform: scale(0.2);
  }
  28% {
    opacity: 1;
    transform: scale(1.18);
  }
  48% {
    transform: scale(0.96);
  }
  62% {
    opacity: 1;
    transform: scale(1.06);
  }
  100% {
    opacity: 0;
    transform: scale(1.28);
  }
}

@keyframes heart-center-fly-1 {
  0% { opacity: 1; transform: translate(0, 0) scale(0.5); }
  100% { opacity: 0; transform: translate(-140rpx, -120rpx) scale(1.2); }
}

@keyframes heart-center-fly-2 {
  0% { opacity: 1; transform: translate(0, 0) scale(0.5); }
  100% { opacity: 0; transform: translate(0, -180rpx) scale(1.25); }
}

@keyframes heart-center-fly-3 {
  0% { opacity: 1; transform: translate(0, 0) scale(0.5); }
  100% { opacity: 0; transform: translate(150rpx, -100rpx) scale(1.15); }
}

@keyframes heart-center-fly-4 {
  0% { opacity: 1; transform: translate(0, 0) scale(0.5); }
  100% { opacity: 0; transform: translate(-120rpx, 100rpx) scale(1.1); }
}

@keyframes heart-center-fly-5 {
  0% { opacity: 1; transform: translate(0, 0) scale(0.5); }
  100% { opacity: 0; transform: translate(130rpx, 110rpx) scale(1.15); }
}

.peer-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.peer-tip {
  font-size: 22rpx;
  color: #999999;
}

.msg-scroll {
  flex: 1;
  height: calc(100vh - 280rpx);
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.chat-limit-tip {
  padding: 32rpx 24rpx 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999999;
  line-height: 1.55;
}

.share-comment-bubble {
  min-width: 320rpx;
  background: #fff !important;
  color: #1a1a1a;
  border: 1rpx solid #eeeeee;
}

.msg-row.me .share-comment-bubble {
  background: #fff !important;
  color: #1a1a1a;
}

.share-comment-tag {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.share-comment-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.share-comment-body {
  display: block;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-main {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  flex: 1;
  min-width: 0;
  width: 100%;
}

.msg-row.me .msg-main {
  flex-direction: row-reverse;
}

.msg-row.peer .msg-main {
  flex-direction: row;
  justify-content: flex-start;
}

.msg-body {
  display: flex;
  flex-direction: column;
  max-width: calc(100% - 68rpx);
}

.msg-row.me .msg-body {
  align-items: flex-end;
}

.msg-row.peer .msg-body {
  align-items: flex-start;
}

.msg-avatar {
  width: 56rpx;
  height: 56rpx;
  min-width: 56rpx;
  min-height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #eef2f6;
}

.msg-row.me .msg-avatar { margin-left: 12rpx; }
.msg-row.peer .msg-avatar { margin-right: 12rpx; }

.msg-time {
  font-size: 20rpx;
  color: #999999;
  margin-top: 8rpx;
  line-height: 1.2;
}

.bubble {
  max-width: 100%;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-word;
}

.msg-row.peer .bubble {
  background: #fff;
  color: #1A1A1A;
  border-top-left-radius: 6rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.msg-row.me .bubble {
  background: linear-gradient(135deg, #5BB8FF, #4DA7F8);
  color: #1A1A1A;
  border-top-right-radius: 6rpx;
}

.media-bubble { padding: 8rpx; overflow: hidden; }

.msg-image {
  max-width: 360rpx;
  border-radius: 12rpx;
  display: block;
}

.msg-video {
  position: relative;
  width: 320rpx;
  height: 240rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.msg-video-cover {
  width: 100%;
  height: 100%;
  background: #333;
}

.play-icon {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 6rpx;
}

.loc-bubble {
  min-width: 400rpx;
  padding: 20rpx !important;
}

.loc-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.loc-addr {
  display: block;
  font-size: 24rpx;
  opacity: 0.75;
  margin-bottom: 8rpx;
}

.loc-tip {
  display: block;
  font-size: 22rpx;
  color: #1E88E5;
  font-weight: 600;
}

.call-bubble {
  min-width: 280rpx;
}

.call-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
}

.call-meta {
  display: block;
  font-size: 22rpx;
  opacity: 0.7;
  margin-top: 4rpx;
}

.msg-empty {
  padding: 80rpx 0;
  text-align: center;
  color: #999999;
  font-size: 26rpx;
}

.voice-bubble {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 160rpx;
}

.voice-dur {
  font-size: 26rpx;
  font-weight: 600;
}

.event-bubble {
  min-width: 320rpx;
}

.event-tag {
  display: block;
  font-size: 22rpx;
  color: #1E88E5;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.event-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.event-tip {
  display: block;
  font-size: 22rpx;
  opacity: 0.65;
}

.aa-bubble {
  min-width: 300rpx;
  background: #fff7ed !important;
  border: 1rpx solid #fed7aa;
}

.msg-row.me .aa-bubble {
  background: #fff7ed !important;
  color: #1a1a1a;
}

.aa-tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 900;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.aa-amount {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.aa-meta {
  display: block;
  font-size: 22rpx;
  color: #666666;
  margin-bottom: 6rpx;
}

.aa-tip {
  display: block;
  font-size: 20rpx;
  color: #999999;
}

.voice-wrap {
  display: flex;
  flex-direction: column;
  max-width: 100%;
}

.msg-row.peer .voice-wrap { align-items: flex-start; }
.msg-row.me .voice-wrap { align-items: flex-end; }

.voice-bubble.playing {
  background: rgba(126, 200, 255, 0.45);
}

.voice-bars {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 36rpx;
}

.vbar {
  width: 8rpx;
  border-radius: 8rpx;
  background: #1A1A1A;
  transform-origin: center;
  animation: voice-jump 0.8s ease-in-out infinite;
}

.vbar:nth-child(1) { height: 16rpx; animation-delay: 0s; }
.vbar:nth-child(2) { height: 32rpx; animation-delay: 0.15s; }
.vbar:nth-child(3) { height: 22rpx; animation-delay: 0.3s; }

@keyframes voice-jump {
  0%, 100% { transform: scaleY(0.35); }
  50% { transform: scaleY(1); }
}

.voice-text-bubble {
  margin-bottom: 8rpx;
  padding: 16rpx 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  max-width: 100%;
  box-sizing: border-box;
}

.voice-text {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.5;
  word-break: break-all;
}

page { background: #F5F5F5; }

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page.panel-open {
  padding-bottom: calc(480rpx + env(safe-area-inset-bottom));
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, rgba(212, 255, 0, 0.25), rgba(76, 230, 0, 0.12));
}

.header-main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.circle-icon {
  font-size: 52rpx;
  margin-right: 16rpx;
}

.circle-name {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #1A1A1A;
}

.circle-meta {
  font-size: 22rpx;
  color: #666;
}

.header-share {
  margin: 0;
  padding: 0 24rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #2DB300;
  font-size: 24rpx;
  font-weight: 700;
  border: none;
  flex-shrink: 0;
}

.header-share::after { border: none; }

.topic-bar {
  white-space: nowrap;
  padding: 16rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #F0F0F0;
}

.topic-chip {
  display: inline-block;
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #2DB300;
  background: rgba(197, 255, 74, 0.15);
  font-weight: 600;
}

.topic-chip.on {
  background: linear-gradient(135deg, #D4FF00, #4CE600);
  color: #1A1A1A;
}

.msg-scroll {
  flex: 1;
  height: calc(100vh - 360rpx);
  padding: 20rpx 28rpx;
  box-sizing: border-box;
}

.msg-card {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.msg-card.me {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #E8F0F6;
}

.msg-card.me .msg-avatar { margin-left: 12rpx; }
.msg-card:not(.me) .msg-avatar { margin-right: 12rpx; }

.msg-body {
  flex: 1;
  min-width: 0;
  max-width: 78%;
}

.msg-card.me .msg-body {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.msg-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.msg-card.me .msg-head { flex-direction: row-reverse; }

.msg-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.msg-time {
  font-size: 20rpx;
  color: #999;
}

.msg-topic {
  display: inline-block;
  font-size: 22rpx;
  color: #2DB300;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.msg-text {
  display: block;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #1A1A1A;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  word-break: break-word;
}

.msg-card.me .msg-text {
  background: linear-gradient(135deg, #D4FF00, #4CE600);
}

.msg-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.msg-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #E8F0F6;
}

.msg-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}

.msg-card.me .msg-actions { justify-content: flex-end; }

.action {
  font-size: 22rpx;
  color: #666;
  padding: 6rpx 12rpx;
  background: #F5F5F5;
  border-radius: 999rpx;
}

.share-action {
  margin: 0;
  padding: 6rpx 12rpx;
  line-height: 1.4;
  background: #F5F5F5;
  color: #666;
  font-size: 22rpx;
  border: none;
}

.share-action::after { border: none; }

.pending-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 12rpx;
  padding: 12rpx 28rpx;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #F0F0F0;
  z-index: 20;
}

.pending-item {
  position: relative;
}

.pending-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
}

.pending-remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  text-align: center;
  line-height: 36rpx;
  font-size: 24rpx;
}

.topic-panel,
.tool-panel,
.emoji-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #F0F0F0;
  z-index: 18;
}

.panel-title {
  display: block;
  padding: 20rpx 28rpx 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #666;
}

.topic-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 12rpx 28rpx 24rpx;
}

.topic-cell {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(197, 255, 74, 0.2);
  color: #1A1A1A;
  font-size: 26rpx;
  font-weight: 600;
}

.tool-panel {
  display: flex;
  justify-content: space-around;
  padding: 28rpx 40rpx;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #666;
}

.tool-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.tool-icon.green { background: rgba(197, 255, 74, 0.3); }

.emoji-panel { max-height: 380rpx; }

.emoji-tabs {
  white-space: nowrap;
  padding: 16rpx 20rpx 8rpx;
}

.emoji-tab {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #999;
  background: #F5F5F5;
}

.emoji-tab.on {
  background: rgba(197, 255, 74, 0.35);
  color: #1A1A1A;
  font-weight: 700;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 12rpx 20rpx 24rpx;
  max-height: 240rpx;
  overflow-y: auto;
}

.emoji-cell {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  font-size: 36rpx;
  border-radius: 12rpx;
  background: #F9F9F9;
}

.composer-extra {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(96rpx + env(safe-area-inset-bottom));
  z-index: 29;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #F0F0F0;
}

.topic-entry {
  margin-top: 4rpx;
}

.topic-entry-btn {
  display: inline-block;
  font-size: 24rpx;
  color: #2DB300;
  font-weight: 700;
  background: rgba(197, 255, 74, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.composer-tags {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.selected-topic {
  font-size: 24rpx;
  color: #2DB300;
  font-weight: 700;
  background: rgba(197, 255, 74, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.clear-topic {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #999;
  padding: 0 8rpx;
}

.composer-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.composer-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.composer-btn.hash {
  font-weight: 800;
  color: #2DB300;
}

.composer-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: #F5F5F5;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.composer-send {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 1.4;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #D4FF00, #4CE600);
  color: #1A1A1A;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}

page { background: #F5F5F5; }

.page {
  padding: 20rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  height: 80rpx;
  min-height: 80rpx;
  padding: 22rpx 0;
  line-height: 36rpx;
  font-size: 28rpx;
}

.search-clear {
  font-size: 36rpx;
  color: #999;
  padding: 0 8rpx;
}

.locate-card {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  margin-bottom: 28rpx;
  background: linear-gradient(135deg, rgba(212, 255, 0, 0.25), rgba(76, 230, 0, 0.12));
  border-radius: 24rpx;
  border: 2rpx solid rgba(76, 230, 0, 0.25);
}

.locate-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.locate-info {
  flex: 1;
  min-width: 0;
}

.locate-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 6rpx;
}

.locate-desc {
  display: block;
  font-size: 22rpx;
  color: #666;
}

.locate-arrow {
  font-size: 36rpx;
  color: #2DB300;
}

.section-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #666;
  margin: 20rpx 0 16rpx;
}

.province-block:first-child .section-title {
  margin-top: 0;
}

.city-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.city-cell {
  width: calc(33.33% - 12rpx);
  padding: 20rpx 0;
  text-align: center;
  background: #fff;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #333;
  box-sizing: border-box;
}

.city-cell.on {
  background: linear-gradient(135deg, #D4FF00, #4CE600);
  color: #1A1A1A;
  font-weight: 700;
}

.empty {
  padding: 60rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

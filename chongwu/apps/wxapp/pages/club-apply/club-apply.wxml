<view class="page">
  <view class="banner {{apply ? 'ok' : ''}}" wx:if="{{apply}}">
    <view class="banner-left">
      <text class="banner-title">{{apply.status === 'approved' ? '✓ 已成为主理人' : '⏳ 入驻申请审核中'}}</text>
      <text class="banner-desc">{{apply.status === 'approved' ? '你的俱乐部已上线，可在「我的俱乐部」管理' : '提交后 1-3 个工作日内完成审核'}}</text>
    </view>
    <text class="banner-action" bindtap="onReset">撤回</text>
  </view>

  <view class="card">
    <text class="card-title">填写入驻信息</text>
    <text class="card-sub">成为俱乐部主理人，组织同城宠友活动</text>

    <view class="form-row">
      <text class="row-label">*俱乐部名称</text>
      <input
        class="row-input"
        value="{{name}}"
        bindinput="onInput"
        data-field="name"
        placeholder="如：周末遛狗俱乐部"
        placeholder-class="row-ph"
        maxlength="20"
      />
    </view>

    <view class="form-row" bindtap="onPickCity">
      <text class="row-label">*所在城市</text>
      <view class="row-tail">
        <text class="row-value {{city ? '' : 'ph'}}">{{city || '选择城市'}}</text>
        <text class="row-arrow">›</text>
      </view>
    </view>

    <view class="form-block">
      <text class="row-label">*俱乐部介绍</text>
      <textarea
        class="row-textarea"
        value="{{intro}}"
        bindinput="onInput"
        data-field="intro"
        placeholder="俱乐部所在区域、活动频率、适合的宠物类型等"
        placeholder-class="row-ph"
        maxlength="300"
      ></textarea>
    </view>

    <view class="form-row">
      <text class="row-label">*联系方式</text>
      <input
        class="row-input"
        value="{{contact}}"
        bindinput="onInput"
        data-field="contact"
        placeholder="手机号或微信号"
        placeholder-class="row-ph"
      />
    </view>

    <view class="identity-head">
      <text class="section-title">身份信息</text>
      <text class="section-tip">平台审核主理人资质，信息仅用于入驻审核</text>
    </view>

    <view class="entity-row">
      <view
        class="entity-pill {{entityType === 'personal' ? 'on' : ''}}"
        data-type="personal"
        bindtap="onSwitchEntity"
      >对私（个人）</view>
      <view
        class="entity-pill {{entityType === 'corporate' ? 'on' : ''}}"
        data-type="corporate"
        bindtap="onSwitchEntity"
      >对公（企业/组织）</view>
    </view>

    <view class="identity-block" wx:if="{{entityType === 'personal'}}">
      <text class="block-label">对私身份信息</text>
      <view class="form-row">
        <text class="row-label">*真实姓名</text>
        <input
          class="row-input"
          value="{{realName}}"
          bindinput="onInput"
          data-field="realName"
          placeholder="与身份证一致"
          placeholder-class="row-ph"
          maxlength="20"
        />
      </view>
      <view class="form-row">
        <text class="row-label">*身份证号</text>
        <input
          class="row-input"
          value="{{idCard}}"
          bindinput="onInput"
          data-field="idCard"
          placeholder="18位身份证号"
          placeholder-class="row-ph"
          maxlength="18"
        />
      </view>
      <text class="upload-label">*身份证人像面</text>
      <view class="id-upload-row">
        <view class="id-upload" bindtap="onPickIdImage" data-field="idFrontImage" wx:if="{{!idFrontImage}}">
          <text class="id-upload-icon">📷</text>
          <text class="id-upload-text">上传正面</text>
        </view>
        <image class="id-preview" wx:if="{{idFrontImage}}" src="{{idFrontImage}}" mode="aspectFill" bindtap="onPreviewImage" data-url="{{idFrontImage}}"></image>
        <view class="id-upload" bindtap="onPickIdImage" data-field="idBackImage" wx:if="{{!idBackImage}}">
          <text class="id-upload-icon">📷</text>
          <text class="id-upload-text">上传反面</text>
        </view>
        <image class="id-preview" wx:if="{{idBackImage}}" src="{{idBackImage}}" mode="aspectFill" bindtap="onPreviewImage" data-url="{{idBackImage}}"></image>
      </view>
    </view>

    <view class="identity-block" wx:if="{{entityType === 'corporate'}}">
      <text class="block-label">对公营业执照</text>
      <view class="form-row">
        <text class="row-label">*企业名称</text>
        <input
          class="row-input"
          value="{{companyName}}"
          bindinput="onInput"
          data-field="companyName"
          placeholder="营业执照上的名称"
          placeholder-class="row-ph"
          maxlength="40"
        />
      </view>
      <view class="form-row">
        <text class="row-label">*信用代码</text>
        <input
          class="row-input"
          value="{{licenseNo}}"
          bindinput="onInput"
          data-field="licenseNo"
          placeholder="18位统一社会信用代码"
          placeholder-class="row-ph"
          maxlength="18"
        />
      </view>
      <view class="form-row">
        <text class="row-label">*法人姓名</text>
        <input
          class="row-input"
          value="{{legalPerson}}"
          bindinput="onInput"
          data-field="legalPerson"
          placeholder="法定代表人"
          placeholder-class="row-ph"
          maxlength="20"
        />
      </view>
      <text class="upload-label">*营业执照照片</text>
      <view class="license-upload" bindtap="onPickIdImage" data-field="licenseImage" wx:if="{{!licenseImage}}">
        <text class="id-upload-icon">📄</text>
        <text class="id-upload-text">上传营业执照</text>
      </view>
      <image class="license-preview" wx:if="{{licenseImage}}" src="{{licenseImage}}" mode="aspectFill" bindtap="onPreviewImage" data-url="{{licenseImage}}"></image>
    </view>

    <view class="cover-block">
      <text class="row-label">*俱乐部封面</text>
      <view class="cover-box" bindtap="onChooseCover">
        <block wx:if="{{cover}}">
          <image class="cover-img" src="{{cover}}" mode="aspectFill"></image>
          <view class="cover-mask" catchtap="onChooseCover">更换封面</view>
        </block>
        <view class="cover-empty" wx:else>
          <text class="cover-icon">＋</text>
          <text class="cover-text">上传封面图</text>
        </view>
      </view>
    </view>

    <view class="rule-box">
      <text class="rule-item">· 主理人需年满 18 周岁，同城常住</text>
      <text class="rule-item">· 平台将对提交信息进行审核，虚假信息将驳回</text>
      <text class="rule-item">· 成为主理人后可发起活动、管理成员与动态</text>
    </view>

    <button class="submit" bindtap="onSubmit">提交审核</button>
  </view>
</view>

<view class="page">
  <view class="banner {{apply ? 'ok' : ''}}" wx:if="{{apply}}">
    <view class="banner-left">
      <text class="banner-title">{{apply.status === 'approved' ? '✓ 已成为主理人' : '⏳ 入驻申请审核中'}}</text>
      <text class="banner-desc">{{apply.status === 'approved' ? '你的俱乐部已上线，可在「我的俱乐部」管理' : '提交后 1-3 个工作日内完成审核'}}</text>
    </view>
    <text class="banner-action" bindtap="onReset">撤回</text>
  </view>

  <view class="card">
    <text class="card-title">填写入驻信息</text>
    <text class="card-sub">成为俱乐部主理人，组织同城宠友活动</text>

    <view class="form-row">
      <text class="row-label">*俱乐部名称</text>
      <input
        class="row-input"
        value="{{name}}"
        bindinput="onInput"
        data-field="name"
        placeholder="如：周末遛狗俱乐部"
        placeholder-class="row-ph"
        maxlength="20"
      />
    </view>

    <view class="form-row" bindtap="onPickCity">
      <text class="row-label">*所在城市</text>
      <view class="row-tail">
        <text class="row-value {{city ? '' : 'ph'}}">{{city || '选择城市'}}</text>
        <text class="row-arrow">›</text>
      </view>
    </view>

    <view class="form-block">
      <text class="row-label">*俱乐部介绍</text>
      <textarea
        class="row-textarea"
        value="{{intro}}"
        bindinput="onInput"
        data-field="intro"
        placeholder="俱乐部定位、活动频率、适合的宠物类型等"
        placeholder-class="row-ph"
        maxlength="300"
      ></textarea>
    </view>

    <view class="form-row">
      <text class="row-label">联系方式</text>
      <input
        class="row-input"
        value="{{contact}}"
        bindinput="onInput"
        data-field="contact"
        placeholder="微信号或手机号"
        placeholder-class="row-ph"
      />
    </view>

    <view class="cover-block">
      <text class="row-label">*俱乐部封面</text>
      <view class="cover-box" bindtap="onChooseCover">
        <block wx:if="{{cover}}">
          <image class="cover-img" src="{{cover}}" mode="aspectFill"></image>
          <view class="cover-mask" catchtap="onChooseCover">更换封面</view>
        </block>
        <view class="cover-empty" wx:else>
          <text class="cover-icon">＋</text>
          <text class="cover-text">上传封面图</text>
        </view>
      </view>
    </view>

    <view class="rule-box">
      <text class="rule-item">· 主理人需年满 18 周岁，同城常住</text>
      <text class="rule-item">· 平台将对提交信息进行审核，虚假信息将驳回</text>
      <text class="rule-item">· 成为主理人后可发起活动、管理成员与动态</text>
    </view>

    <button class="submit" bindtap="onSubmit">提交审核</button>
  </view>
</view>

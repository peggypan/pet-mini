page { background: #F5F8FC; }

.page { padding: 24rpx; }

.banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  background: #FFF7E0;
  border-radius: 24rpx;
}

.banner.ok {
  background: #E8F4FF;
}

.banner-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.banner-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
}

.banner-action {
  font-size: 24rpx;
  color: #1E88E5;
  font-weight: 600;
}

.card {
  padding: 32rpx 28rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
}

.card-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #1A1A1A;
}

.card-sub {
  display: block;
  margin: 8rpx 0 12rpx;
  font-size: 24rpx;
  color: #999999;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.form-block {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.row-label {
  width: 180rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.row-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1A1A1A;
  text-align: right;
}

.row-ph { color: #BBBBBB; }

.row-tail {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.row-value { font-size: 28rpx; color: #1A1A1A; }
.row-value.ph { color: #BBBBBB; }
.row-arrow { margin-left: 10rpx; font-size: 30rpx; color: #BBBBBB; font-weight: 700; }

.row-textarea {
  width: 100%;
  height: 120rpx;
  min-height: 120rpx;
  max-height: 120rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: #1A1A1A;
  background: #F8F8F8;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.identity-head {
  padding: 28rpx 0 12rpx;
  border-top: 1rpx solid #F0F0F0;
  margin-top: 8rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #1A1A1A;
}

.section-tip {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
  line-height: 1.5;
}

.entity-row {
  display: flex;
  gap: 16rpx;
  margin: 20rpx 0 8rpx;
}

.entity-pill {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #666666;
  background: #F5F8FC;
  font-weight: 600;
}

.entity-pill.on {
  background: rgba(126, 200, 255, 0.35);
  color: #1A1A1A;
  font-weight: 800;
}

.identity-block {
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.block-label {
  display: block;
  margin: 16rpx 0 4rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #1E88E5;
}

.upload-label {
  display: block;
  margin: 20rpx 0 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.id-upload-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.id-upload,
.license-upload {
  flex: 1;
  min-height: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F8F8F8;
  border-radius: 16rpx;
  border: 1rpx dashed #CCCCCC;
  box-sizing: border-box;
}

.license-upload {
  width: 100%;
  margin-bottom: 16rpx;
}

.id-upload-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.id-upload-text {
  font-size: 22rpx;
  color: #999999;
}

.id-preview {
  flex: 1;
  height: 160rpx;
  border-radius: 16rpx;
  background: #E8F4FF;
}

.license-preview {
  width: 100%;
  height: 200rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: #E8F4FF;
}

.cover-block {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.cover-box {
  position: relative;
  margin-top: 16rpx;
  width: 320rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.cover-img { width: 100%; height: 100%; }

.cover-mask {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  padding: 8rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #FFFFFF;
  background: rgba(0, 0, 0, 0.45);
}

.cover-empty {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F5F8FC;
  border: 1rpx dashed #CCCCCC;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.cover-icon { font-size: 48rpx; color: #BBBBBB; }
.cover-text { margin-top: 8rpx; font-size: 22rpx; color: #999999; }

.rule-box { padding: 24rpx 0; }

.rule-item {
  display: block;
  font-size: 22rpx;
  color: #999999;
  line-height: 1.8;
}

.submit {
  margin-top: 8rpx;
  background: linear-gradient(135deg, #5BB8FF, #4DA7F8);
  color: #1A1A1A;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(77, 167, 248, 0.3);
}

.submit::after { border: none; }

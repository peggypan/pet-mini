page { background: #F5F8FC; }

.page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.cover-wrap {
  width: 100%;
  background: #e8eef5;
}

.cover {
  width: 100%;
  height: 100%;
  display: block;
}

.audit-banner {
  margin: -8rpx -28rpx 20rpx;
  padding: 16rpx 20rpx;
  background: #fff7e6;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #b8860b;
  font-weight: 600;
  display: flex;
  align-items: center;
  min-height: 72rpx;
  box-sizing: border-box;
}

.card {
  margin: -40rpx 24rpx 0;
  padding: 32rpx 28rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 2;
}

.name {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.meta {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.section {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.intro {
  display: block;
  font-size: 28rpx;
  color: #444;
  line-height: 1.65;
  white-space: pre-wrap;
}

.bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.btn-primary,
.btn-secondary {
  flex: 1;
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #5BB8FF, #4DA7F8);
  color: #1a1a1a;
}

.btn-secondary {
  background: #f5f8fc;
  color: #1a1a1a;
}

.btn-primary::after,
.btn-secondary::after {
  border: none;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

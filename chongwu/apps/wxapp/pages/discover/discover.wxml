<view class="page">
  <view class="hero">
    <view class="hero-glow"></view>
    <text class="hero-title">发现同城宠友</text>
    <text class="hero-sub">借宠物相识，找到性格合拍的小伙伴</text>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">热门话题</text>
    </view>
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="topic-scroll">
      <view
        class="topic-pill {{item.hot ? 'hot' : ''}}"
        wx:for="{{topics}}"
        wx:key="id"
        bindtap="onTopicTap"
        data-name="{{item.name}}"
      >
        <text class="topic-name">{{item.name}}</text>
        <text class="topic-count">{{item.posts}} 讨论</text>
      </view>
    </scroll-view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">同城约局</text>
      <text class="section-more" bindtap="onEventTap" data-id="{{events[0].id}}">查看 ›</text>
    </view>
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="event-scroll">
      <view
        class="event-card"
        wx:for="{{events}}"
        wx:key="id"
        bindtap="onEventTap"
        data-id="{{item.id}}"
      >
        <image class="event-cover" src="{{item.cover}}" mode="aspectFill"></image>
        <view class="event-body">
          <text class="event-tag">{{item.tag}}</text>
          <text class="event-title">{{item.title}}</text>
          <text class="event-meta">{{item.place}} · {{item.fee}}</text>
          <text class="event-seats">{{item.seats}} 已报名</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">附近宠友</text>
    </view>
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="filter-scroll">
      <view
        class="filter-pill {{filter === item.id ? 'on' : ''}}"
        wx:for="{{filters}}"
        wx:key="id"
        bindtap="onFilter"
        data-id="{{item.id}}"
      >{{item.name}}</view>
    </scroll-view>

    <view class="friend-list">
      <view class="friend-card" wx:for="{{friends}}" wx:key="id" bindtap="onCardTap" data-id="{{item.id}}">
        <image class="friend-cover" src="{{item.cover}}" mode="aspectFill"></image>
        <view class="friend-body">
          <view class="friend-top">
            <image class="friend-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
            <view class="friend-info">
              <view class="friend-name-row">
                <text class="friend-name">{{item.userName}} · {{item.petName}}</text>
                <text class="online-dot" wx:if="{{item.online}}"></text>
              </view>
              <text class="friend-breed">{{item.breed}} · {{item.distance}}</text>
            </view>
          </view>
          <text class="friend-personality">性格：{{item.personality}} · 想约：{{item.wantMeet}}</text>
          <view class="tag-row">
            <text class="tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
          </view>
          <view class="friend-actions">
            <button
              class="btn-follow {{item.followed ? 'followed' : ''}}"
              catchtap="onFollowTap"
              data-id="{{item.id}}"
            >{{item.followed ? '已关注' : '+ 关注'}}</button>
            <button class="btn-chat" catchtap="onChatTap" data-id="{{item.id}}">打招呼</button>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

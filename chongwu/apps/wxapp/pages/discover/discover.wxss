page {
  background: #F7FAF5;
}

.page {
  min-height: 100vh;
  padding: 0 28rpx calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  position: relative;
  margin: 16rpx 0 28rpx;
  padding: 36rpx 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #E8F8EF 0%, #FFF9F3 100%);
  overflow: hidden;
}

.hero-glow {
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 180, 140, 0.25);
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #2D4A38;
  margin-bottom: 8rpx;
}

.hero-sub {
  display: block;
  font-size: 24rpx;
  color: #6B8575;
  line-height: 1.5;
}

.section {
  margin-bottom: 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D4A38;
}

.section-more {
  font-size: 24rpx;
  color: #5BBF88;
}

.topic-scroll,
.event-scroll,
.filter-scroll {
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.topic-pill {
  display: inline-flex;
  flex-direction: column;
  padding: 16rpx 22rpx;
  margin-right: 14rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(91, 140, 110, 0.08);
  vertical-align: top;
}

.topic-pill.hot {
  background: linear-gradient(135deg, #FFF3E8, #fff);
  border: 1rpx solid rgba(255, 155, 122, 0.25);
}

.topic-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #2D4A38;
  margin-bottom: 4rpx;
}

.topic-count {
  font-size: 20rpx;
  color: #9BA89E;
}

.event-card {
  display: inline-flex;
  width: 480rpx;
  margin-right: 16rpx;
  padding: 14rpx;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(91, 140, 110, 0.08);
  vertical-align: top;
  box-sizing: border-box;
}

.event-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #E8F0EA;
}

.event-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.event-tag {
  font-size: 20rpx;
  color: #5BBF88;
  margin-bottom: 6rpx;
}

.event-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #2D4A38;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-meta,
.event-seats {
  font-size: 20rpx;
  color: #8A9A90;
}

.filter-pill {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 28rpx;
  background: #fff;
  font-size: 24rpx;
  color: #6B8575;
}

.filter-pill.on {
  background: rgba(91, 191, 136, 0.18);
  color: #2D4A38;
  font-weight: 600;
}

.friend-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.friend-card {
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(91, 140, 110, 0.08);
}

.friend-cover {
  width: 100%;
  height: 220rpx;
  background: #E8F0EA;
}

.friend-body {
  padding: 20rpx 22rpx 24rpx;
}

.friend-top {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.friend-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  border: 3rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.friend-info {
  flex: 1;
  min-width: 0;
}

.friend-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.friend-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #2D4A38;
}

.online-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #5BBF88;
}

.friend-breed {
  font-size: 22rpx;
  color: #9BA89E;
}

.friend-personality {
  display: block;
  font-size: 24rpx;
  color: #5A6F62;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.tag {
  font-size: 20rpx;
  color: #5BBF88;
  background: rgba(91, 191, 136, 0.12);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.friend-actions {
  display: flex;
  gap: 12rpx;
}

.btn-follow,
.btn-chat {
  flex: 1;
  margin: 0;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
}

.btn-follow {
  background: rgba(91, 191, 136, 0.14);
  color: #3D8F66;
}

.btn-follow.followed {
  background: #F0F4F1;
  color: #9BA89E;
}

.btn-chat {
  background: linear-gradient(135deg, #7ED6A8, #5BBF88);
  color: #fff;
}

.btn-follow::after,
.btn-chat::after {
  border: none;
}

page { background: #F5F8FC; }

.page { padding-bottom: 160rpx; }

.cover {
  width: 100%;
  height: 420rpx;
  background: #E8F4FF;
}

.card {
  margin: -40rpx 28rpx 0;
  padding: 32rpx 28rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  color: #4DA7F8;
  background: rgba(126, 200, 255, 0.25);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.desc {
  display: block;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  padding: 14rpx 0;
  border-top: 1rpx solid #EEF2EE;
}

.info-label {
  width: 100rpx;
  font-size: 24rpx;
  color: #999999;
  flex-shrink: 0;
}

.info-val {
  flex: 1;
  font-size: 26rpx;
  color: #1A1A1A;
}

.info-val.warn {
  color: #E08A5A;
}

.host-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #F5F8FC;
}

.host-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.host-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.host-tip {
  font-size: 22rpx;
  color: #999999;
}

.bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.btn-primary,
.btn-secondary {
  flex: 1;
  margin: 0;
  height: 88rpx;
  padding: 0 12rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  white-space: nowrap;
}

.btn-primary {
  background: linear-gradient(135deg, #5BB8FF, #4DA7F8);
  color: #1A1A1A;
  box-shadow: 0 6rpx 20rpx rgba(77, 167, 248, 0.3);
}

.btn-primary[disabled] {
  background: #E0E8E2;
  color: #999999;
}

.btn-secondary {
  background: #F5F8FC;
  color: #1A1A1A;
}

.btn-primary::after,
.btn-secondary::after {
  border: none;
}

<view class="page">
  <view class="role-row">
    <view class="role {{role === 'personal' ? 'on' : ''}}" data-role="personal" bindtap="onSwitchRole">个人发布</view>
    <view class="role {{role === 'merchant' ? 'on' : ''}}" data-role="merchant" bindtap="onSwitchRole">商家发布</view>
  </view>

  <view class="card">
    <!-- 活动相册 -->
    <text class="label-tip">头图轮播 · {{mediaLimitHint}}（{{mediaSummary}}）</text>
    <view class="media-grid" wx:if="{{mediaList.length}}">
      <view
        class="media-item aspect-34 aspect-34-third"
        wx:for="{{mediaList}}"
        wx:key="index"
        data-index="{{index}}"
        bindtap="onPreviewMedia"
      >
        <image
          class="media-thumb"
          src="{{item.type === 'image' ? item.url : (item.poster || item.url)}}"
          mode="aspectFill"
        ></image>
        <view class="video-badge" wx:if="{{item.type === 'video'}}">
          <text class="video-icon">▶</text>
          <text class="video-dur" wx:if="{{item.duration}}">{{item.duration}}s</text>
        </view>
        <view class="remove-media" data-index="{{index}}" catchtap="onRemoveMedia">×</view>
      </view>
      <view class="media-add" wx:if="{{mediaCanAdd}}" bindtap="onChooseMedia">
        <text class="add-icon">＋</text>
      </view>
    </view>
    <view class="media-empty" wx:elif="{{mediaCanAdd}}" bindtap="onChooseMedia">
      <text class="empty-icon">📷</text>
      <text class="empty-text">添加活动现场图片或视频</text>
    </view>

    <!-- 单次 / 多场次 -->
    <view class="type-tabs">
      <view class="type-tab {{eventType === 'single' ? 'on' : ''}}" data-type="single" bindtap="onEventType">
        <text class="type-name">单次活动</text>
        <text class="type-sub">单场次，适合临时组局</text>
      </view>
      <view class="type-tab {{eventType === 'multi' ? 'on' : ''}}" data-type="multi" bindtap="onEventType">
        <text class="type-name">多场次活动</text>
        <text class="type-sub">适合周期性举办的活动</text>
      </view>
    </view>

    <!-- 行式表单 -->
    <picker mode="selector" range="{{categories}}" value="{{categoryIndex >= 0 ? categoryIndex : 0}}" bindchange="onCategoryChange">
      <view class="form-row form-row-tap" hover-class="form-row-hover">
        <text class="row-label">*活动分类</text>
        <view class="row-tail">
          <text class="row-value {{category ? '' : 'ph'}}">{{category || '请选择活动类型'}}</text>
          <text class="row-arrow">›</text>
        </view>
      </view>
    </picker>

    <view class="form-row">
      <text class="row-label">*活动名称</text>
      <input
        class="row-input"
        value="{{title}}"
        bindinput="onInput"
        data-field="title"
        placeholder="点击输入，20字内"
        placeholder-class="row-ph"
        maxlength="20"
      />
    </view>

    <view class="form-row" wx:if="{{eventType === 'single'}}">
      <text class="row-label">*活动时间</text>
      <view class="row-value-group">
        <picker
          mode="date"
          value="{{eventDate}}"
          start="{{today}}"
          bindchange="onDateChange"
        >
          <view class="row-value picker-hit {{eventDate ? '' : 'ph'}}">{{eventDate || '选择日期'}}</view>
        </picker>
        <picker
          mode="time"
          value="{{eventTime}}"
          bindchange="onTimeChange"
        >
          <view class="row-value picker-hit {{eventTime ? '' : 'ph'}}">{{eventTime || '选择时间'}}</view>
        </picker>
      </view>
    </view>

    <view class="sessions-block" wx:if="{{eventType === 'multi'}}">
      <view class="sessions-head">
        <text class="sessions-title">*场次时间</text>
        <text class="sessions-add" bindtap="onAddSession">+ 添加场次</text>
      </view>
      <view class="session-row" wx:for="{{eventSessions}}" wx:key="id">
        <text class="session-index">第{{index + 1}}场</text>
        <view class="row-value-group session-pickers">
          <picker mode="date" value="{{item.date}}" start="{{today}}" data-index="{{index}}" bindchange="onSessionDateChange">
            <view class="row-value picker-hit {{item.date ? '' : 'ph'}}">{{item.date || '日期'}}</view>
          </picker>
          <picker mode="time" value="{{item.time}}" data-index="{{index}}" bindchange="onSessionTimeChange">
            <view class="row-value picker-hit {{item.time ? '' : 'ph'}}">{{item.time || '时间'}}</view>
          </picker>
        </view>
        <text class="session-remove" wx:if="{{eventSessions.length > 1}}" data-index="{{index}}" catchtap="onRemoveSession">删除</text>
      </view>
    </view>

    <view class="form-row form-row-tap" hover-class="form-row-hover" bindtap="onChoosePlace">
      <text class="row-label">*活动地点</text>
      <view class="row-tail">
        <text class="row-value {{place ? '' : 'ph'}}">{{place || '点击跳转地图选点'}}</text>
        <text class="row-arrow">›</text>
      </view>
    </view>
    <view class="sub-addr" wx:if="{{placeAddress && placeAddress !== place}}">{{placeAddress}}</view>

    <view class="form-row">
      <text class="row-label">*活动人数</text>
      <input
        class="row-input"
        type="number"
        value="{{maxPeople}}"
        bindinput="onInput"
        data-field="maxPeople"
        placeholder="最多支持100人"
        placeholder-class="row-ph"
      />
    </view>

    <view class="form-row">
      <text class="row-label">报名截止</text>
      <view class="row-value-group">
        <picker mode="date" value="{{deadlineDate}}" start="{{today}}" bindchange="onDeadlineDate">
          <view class="row-value {{deadlineDate ? '' : 'ph'}}">{{deadlineDate || '选择日期'}}</view>
        </picker>
        <picker mode="time" value="{{deadlineTime}}" bindchange="onDeadlineTime">
          <view class="row-value {{deadlineTime ? '' : 'ph'}}">{{deadlineTime || '选择时间'}}</view>
        </picker>
      </view>
    </view>

    <view class="form-row" bindtap="onPickScope">
      <text class="row-label">报名范围</text>
      <view class="row-tail">
        <text class="row-value">{{signupScope}}</text>
        <text class="row-arrow">›</text>
      </view>
    </view>

    <view class="form-row" bindtap="onToggleTimed">
      <text class="row-label">定时报名</text>
      <view class="row-tail">
        <text class="row-value {{timedSignup ? '' : 'ph'}}">{{timedLabel}}</text>
        <text class="row-arrow">›</text>
      </view>
    </view>
    <view class="timed-row" wx:if="{{timedSignup}}">
      <picker mode="date" value="{{timedDate}}" start="{{today}}" bindchange="onTimedDate">
        <view class="row-value {{timedDate ? '' : 'ph'}}">{{timedDate || '开始日期'}}</view>
      </picker>
      <picker mode="time" value="{{timedTime}}" bindchange="onTimedTime">
        <view class="row-value {{timedTime ? '' : 'ph'}}">{{timedTime || '开始时间'}}</view>
      </picker>
    </view>

    <view class="form-block">
      <text class="row-label">一句话简介</text>
      <textarea
        class="row-textarea row-textarea-sm"
        value="{{desc}}"
        bindinput="onInput"
        data-field="desc"
        placeholder="列表与头图下方展示的短介绍"
        placeholder-class="row-ph"
        maxlength="120"
        fixed
        disable-default-padding
        cursor-spacing="24"
      ></textarea>
    </view>

    <view class="form-block detail-form-block">
      <text class="row-label">详情页图文</text>
      <text class="label-tip block-tip">下方内容展示在详情页下拉「活动详情」卡片；配图最多 6 张，可左滑浏览</text>
      <textarea
        class="row-textarea"
        value="{{detailContent}}"
        bindinput="onInput"
        data-field="detailContent"
        placeholder="活动流程、注意事项、装备要求等，可分段换行"
        placeholder-class="row-ph"
        maxlength="2000"
        fixed
        disable-default-padding
        cursor-spacing="24"
      ></textarea>
      <text class="label-tip detail-media-tip">{{detailMediaLimitHint}}（{{detailMediaSummary}}）</text>
      <view class="media-grid detail-media-grid" wx:if="{{detailMediaList.length}}">
        <view
          class="media-item aspect-34 aspect-34-third"
          wx:for="{{detailMediaList}}"
          wx:key="index"
          data-index="{{index}}"
          bindtap="onPreviewDetailMedia"
        >
          <image class="media-thumb" src="{{item.url}}" mode="aspectFill"></image>
          <view class="remove-media" data-index="{{index}}" catchtap="onRemoveDetailMedia">×</view>
        </view>
        <view class="media-add" wx:if="{{detailMediaCanAdd}}" bindtap="onChooseDetailMedia">
          <text class="add-icon">＋</text>
        </view>
      </view>
      <view class="media-empty detail-media-empty" wx:elif="{{detailMediaCanAdd}}" bindtap="onChooseDetailMedia">
        <text class="empty-icon">🖼</text>
        <text class="empty-text">添加详情配图（最多 6 张）</text>
      </view>
    </view>

    <view class="rule-box">
      <text class="rule-title">发布说明</text>
      <text class="rule-item">· 个人与商家均可免费发布活动，用户可免费报名</text>
      <text class="rule-item">· 发布成功后立即上线，并自动生成分享海报</text>
      <text class="rule-item">· 线下活动请注意人身与宠物安全，与平台无关</text>
    </view>

    <view class="event-safety-tip">{{eventSafetyTip}}</view>

    <view class="submit-bar">
      <button class="submit ghost" bindtap="onDraft">存草稿</button>
      <button class="submit main" bindtap="onSubmit">发布活动</button>
    </view>
  </view>

  <pet-profile-gate show="{{petProfileBlocked}}" />
</view>

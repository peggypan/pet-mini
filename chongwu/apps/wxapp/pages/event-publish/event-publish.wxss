page { background: #F5F8FC; }

.page { padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }

.role-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.role {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: #fff;
  font-size: 28rpx;
  color: #666;
}

.role.on {
  background: linear-gradient(135deg, #5BB8FF, #4DA7F8);
  color: #1A1A1A;
  font-weight: 700;
}

.qualify-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: #FFF8E1;
  border: 2rpx solid rgba(255, 193, 7, 0.35);
}

.qualify-banner.ok {
  background: rgba(126, 200, 255, 0.2);
  border-color: rgba(77, 167, 248, 0.35);
}

.banner-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 6rpx;
}

.banner-desc {
  display: block;
  font-size: 22rpx;
  color: #666;
  line-height: 1.4;
}

.banner-action {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #1E88E5;
  font-weight: 600;
}

.card.disabled {
  opacity: 0.72;
}

.rule-box {
  margin: 24rpx 0 8rpx;
  padding: 20rpx;
  background: #F9F9F9;
  border-radius: 16rpx;
}

.rule-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 10rpx;
}

.rule-item {
  display: block;
  font-size: 22rpx;
  color: #777;
  line-height: 1.6;
  margin-bottom: 4rpx;
}

.card {
  padding: 28rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.label {
  display: block;
  font-size: 24rpx;
  color: #666666;
  margin: 14rpx 0 8rpx;
  font-weight: 600;
}

.label-tip {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

input, textarea, .picker {
  width: 100%;
  background: #F5F8FC;
  border-radius: 14rpx;
  box-sizing: border-box;
}

textarea {
  min-height: 160rpx;
  margin-bottom: 8rpx;
}

.tool-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tool-btn {
  flex: 1;
  margin: 0;
  height: 76rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  border: none;
  background: rgba(126, 200, 255, 0.25);
  color: #1A1A1A;
  font-size: 26rpx;
  font-weight: 600;
}

.tool-btn::after { border: none; }

.tool-btn:active {
  background: rgba(126, 200, 255, 0.45);
}

.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.media-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.media-thumb {
  width: 100%;
  height: 100%;
  background: #E8F4FF;
}

.video-badge {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 12rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
}

.video-icon {
  font-size: 20rpx;
  color: #FFFFFF;
}

.video-dur {
  font-size: 20rpx;
  color: #FFFFFF;
}

.remove-media {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.media-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  margin-bottom: 24rpx;
  background: #F5F8FC;
  border-radius: 20rpx;
  border: 2rpx dashed rgba(77, 167, 248, 0.35);
}

.empty-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 24rpx;
  color: #999999;
}

.submit {
  margin-top: 8rpx;
  background: linear-gradient(135deg, #5BB8FF, #4DA7F8);
  color: #1A1A1A;
  border-radius: 44rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 20rpx rgba(77, 167, 248, 0.3);
}

.submit::after { border: none; }

/* 行式表单 */
.form-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.form-block {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.row-label {
  width: 180rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.row-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1A1A1A;
  text-align: right;
}

.row-tail {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.row-value {
  font-size: 28rpx;
  color: #1A1A1A;
}

.row-value.ph {
  color: #BBBBBB;
}

.row-ph {
  color: #BBBBBB;
}

.row-arrow {
  margin-left: 10rpx;
  font-size: 30rpx;
  color: #BBBBBB;
  font-weight: 700;
}

.row-value-group {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 40rpx;
}

.row-textarea {
  width: 100%;
  min-height: 160rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #1A1A1A;
  background: #F8F8F8;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.sub-addr {
  padding: 8rpx 0 16rpx 180rpx;
  font-size: 22rpx;
  color: #999999;
}

/* 相册追加按钮 */
.media-add {
  width: 152rpx;
  height: 152rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F8FC;
  border-radius: 16rpx;
  border: 1rpx dashed #CCCCCC;
  box-sizing: border-box;
}

.add-icon {
  font-size: 48rpx;
  color: #BBBBBB;
}

/* 底部双按钮 */
.submit-bar {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.submit-bar .submit {
  flex: 1;
}

.submit.ghost {
  background: #F5F8FC;
  color: #666666;
  box-shadow: none;
}

/* 单次 / 多场次 */
.type-tabs {
  display: flex;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.type-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 24rpx;
  position: relative;
}

.type-tab.on .type-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #1A1A1A;
  border-bottom: 6rpx solid #7EC8FF;
  padding-bottom: 6rpx;
}

.type-tab:not(.on) .type-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #666666;
}

.type-tab:not(.on) .type-sub {
  color: #999999;
}

.type-sub {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #999999;
}

.form-row-tap:active,
.form-row-hover {
  background: rgba(126, 200, 255, 0.12);
}

.picker-hit {
  min-width: 120rpx;
  text-align: right;
}

.sessions-block {
  padding: 16rpx 0 8rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.sessions-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.sessions-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.sessions-add {
  font-size: 26rpx;
  color: #1E88E5;
  font-weight: 600;
}

.session-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #F5F5F5;
}

.session-index {
  flex-shrink: 0;
  width: 88rpx;
  font-size: 24rpx;
  color: #666;
}

.session-pickers {
  flex: 1;
  justify-content: flex-end;
}

.session-remove {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #999;
  padding: 8rpx;
}

/* 价格行 */
.price-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.price-input {
  width: 180rpx;
  text-align: right;
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.price-unit {
  margin-left: 8rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 600;
}

/* 定时报名子行 */
.timed-row {
  display: flex;
  align-items: center;
  gap: 48rpx;
  padding: 8rpx 0 20rpx 180rpx;
}

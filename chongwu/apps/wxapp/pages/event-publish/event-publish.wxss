page { background: #F5F5F5; }

.page { padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }

.role-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.role {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: #fff;
  font-size: 28rpx;
  color: #666;
}

.role.on {
  background: linear-gradient(135deg, #D4FF00, #4CE600);
  color: #1A1A1A;
  font-weight: 700;
}

.qualify-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: #FFF8E1;
  border: 2rpx solid rgba(255, 193, 7, 0.35);
}

.qualify-banner.ok {
  background: rgba(197, 255, 74, 0.2);
  border-color: rgba(76, 230, 0, 0.35);
}

.banner-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 6rpx;
}

.banner-desc {
  display: block;
  font-size: 22rpx;
  color: #666;
  line-height: 1.4;
}

.banner-action {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #2DB300;
  font-weight: 600;
}

.card.disabled {
  opacity: 0.72;
}

.rule-box {
  margin: 24rpx 0 8rpx;
  padding: 20rpx;
  background: #F9F9F9;
  border-radius: 16rpx;
}

.rule-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 10rpx;
}

.rule-item {
  display: block;
  font-size: 22rpx;
  color: #777;
  line-height: 1.6;
  margin-bottom: 4rpx;
}

.card {
  padding: 28rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.label {
  display: block;
  font-size: 24rpx;
  color: #666666;
  margin: 14rpx 0 8rpx;
  font-weight: 600;
}

.label-tip {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

input, textarea, .picker {
  width: 100%;
  background: #F5F5F5;
  border-radius: 14rpx;
  box-sizing: border-box;
}

textarea {
  min-height: 160rpx;
  margin-bottom: 8rpx;
}

.tool-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tool-btn {
  flex: 1;
  margin: 0;
  height: 76rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  border: none;
  background: rgba(197, 255, 74, 0.25);
  color: #1A1A1A;
  font-size: 26rpx;
  font-weight: 600;
}

.tool-btn::after { border: none; }

.tool-btn:active {
  background: rgba(197, 255, 74, 0.45);
}

.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.media-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.media-thumb {
  width: 100%;
  height: 100%;
  background: #E8F8EF;
}

.video-badge {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 12rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
}

.video-icon {
  font-size: 20rpx;
  color: #FFFFFF;
}

.video-dur {
  font-size: 20rpx;
  color: #FFFFFF;
}

.remove-media {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.media-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  margin-bottom: 24rpx;
  background: #F5F5F5;
  border-radius: 20rpx;
  border: 2rpx dashed rgba(76, 230, 0, 0.35);
}

.empty-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 24rpx;
  color: #999999;
}

.submit {
  margin-top: 8rpx;
  background: linear-gradient(135deg, #D4FF00, #4CE600);
  color: #1A1A1A;
  border-radius: 44rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 20rpx rgba(76, 230, 0, 0.3);
}

.submit::after { border: none; }

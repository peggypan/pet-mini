page {
  background: linear-gradient(180deg, #E8F4FF 0%, #F5F8FC 280rpx, #F5F8FC 100%);
}

.page {
  padding: 20rpx 28rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.city-bar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.city-bar-icon {
  font-size: 24rpx;
}

.city-bar-text {
  flex: 1;
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.city-bar-arrow {
  font-size: 22rpx;
  color: #999999;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.act-btn {
  flex: 1;
  margin: 0;
  height: 96rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #5BB8FF 0%, #4DA7F8 100%);
  color: #1A1A1A;
  font-weight: 700;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(77, 167, 248, 0.3);
}

.act-btn.outline {
  background: #FFFFFF;
  color: #1A1A1A;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  font-weight: 600;
}

.act-btn::after {
  border: none;
}

.event-card {
  display: flex;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.event-plaza-filter-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.event-plaza-filter {
  display: inline-block;
  padding: 12rpx 26rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #ffffff;
  font-size: 24rpx;
  color: #666666;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.event-plaza-filter.on {
  background: rgba(126, 200, 255, 0.35);
  color: #1a1a1a;
  font-weight: 700;
}

.event-plaza-filter.healing.on {
  background: rgba(232, 250, 241, 0.95);
  color: #2d6a4f;
}

.event-healing-tip {
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background: #eefaf3;
  font-size: 22rpx;
  color: #2d6a4f;
  line-height: 1.5;
}

.cover-wrap {
  position: relative;
  margin-right: 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.event-healing-badge {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  z-index: 1;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(45, 106, 79, 0.92);
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
}

.event-empty {
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
}

.cover {
  background: #e8eef5;
}

.source {
  font-size: 20rpx;
  color: #1E88E5;
  font-weight: 600;
}

.title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin: 6rpx 0;
}

.meta {
  display: block;
  font-size: 22rpx;
  color: #999999;
}

.event-safety-tip {
  margin-top: 32rpx;
  padding: 20rpx 24rpx;
  font-size: 22rpx;
  line-height: 1.65;
  color: #999999;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

<view class="page">
  <view class="hero">
    <text class="hero-title">意见反馈</text>
    <text class="hero-sub">描述问题或建议，可附图便于我们跟进（一般 1–3 个工作日内回复）</text>
  </view>

  <view class="card">
    <text class="label">反馈类型</text>
    <view class="type-row">
      <view
        class="type-chip {{category === item.id ? 'on' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCategoryTap"
      >{{item.name}}</view>
    </view>

    <text class="label">反馈内容 *</text>
    <textarea
      class="textarea"
      placeholder="请详细描述遇到的问题、期望的功能或改进建议…"
      maxlength="2000"
      value="{{content}}"
      bindinput="onInput"
      data-field="content"
      show-confirm-bar="{{false}}"
    ></textarea>
    <text class="counter">{{content.length}}/2000</text>

    <text class="label">截图 / 照片</text>
    <text class="hint">选填 · 最多 {{maxImages}} 张（{{imageSummary}}）</text>
    <view class="img-grid" wx:if="{{images.length}}">
      <view
        class="img-item"
        wx:for="{{images}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="onPreviewImage"
      >
        <image class="img-thumb" src="{{item}}" mode="aspectFill"></image>
        <view class="img-remove" data-index="{{index}}" catchtap="onRemoveImage">×</view>
      </view>
      <view class="img-add" wx:if="{{canAddImage}}" bindtap="onChooseImage">
        <text class="add-icon">＋</text>
      </view>
    </view>
    <view class="img-empty" wx:elif="{{canAddImage}}" bindtap="onChooseImage">
      <text class="empty-icon">📷</text>
      <text class="empty-text">上传截图或现场照片</text>
    </view>

    <text class="label">联系方式</text>
    <text class="hint">选填 · 手机号或微信号，方便回访</text>
    <input
      class="input"
      placeholder="手机号 / 微信号"
      value="{{contact}}"
      bindinput="onInput"
      data-field="contact"
      maxlength="40"
    />

    <button class="submit" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">
      提交反馈
    </button>
  </view>
</view>

<view class="page">
  <view class="amap-badge" wx:if="{{amapReady}}">高德地图</view>
  <view class="amap-badge mock" wx:else>演示模式 · 配置 Key 后启用高德</view>

  <!-- 搜索 -->
  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="搜索地点、地址、宠物友好场所"
      placeholder-class="search-ph"
      confirm-type="search"
      bindinput="onSearchInput"
    />
    <text class="search-clear" wx:if="{{keyword}}" bindtap="onClearSearch">×</text>
  </view>
  <view class="search-tips" wx:if="{{tips.length}}">
    <view
      class="tip-row"
      wx:for="{{tips}}"
      wx:key="index"
      data-index="{{index}}"
      bindtap="onPickTip"
    >
      <text class="tip-name">{{item.name}}</text>
      <text class="tip-addr">{{item.address}}</text>
    </view>
  </view>

  <map
    id="friendlyMap"
    class="map"
    longitude="{{longitude}}"
    latitude="{{latitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    show-location
    enable-zoom
    enable-scroll
    bindmarkertap="onMarkerTap"
    bindregionchange="onRegionChange"
  ></map>

  <view class="toolbar">
    <view class="tool-btn" bindtap="onRelocate">我的位置</view>
    <view class="tool-btn primary" bindtap="onSubmitPoint">＋ 新增点位</view>
  </view>

  <pet-map-fab
    class="pet-fab-slot"
    value="{{petFilter}}"
    expanded="{{fabOpen}}"
    bind:toggle="onFabToggle"
    bind:change="onPetFabChange"
  />

  <view class="point-card {{selectedPoint.danger ? 'danger' : ''}}" wx:if="{{selectedPoint}}">
    <view class="card-head">
      <text class="point-name">{{selectedPoint.name}}</text>
      <text class="point-close" bindtap="onCloseCard">×</text>
    </view>
    <text class="point-badge {{selectedPointBadge}}">{{selectedPointBadgeText}}</text>
    <text class="point-type">{{selectedPoint.type}}</text>
    <text class="point-addr">{{selectedPoint.address}}</text>
    <text class="point-meta" wx:if="{{selectedPoint.distance}}">距您约 {{selectedPoint.distance}}</text>
    <text class="point-warn" wx:if="{{selectedPoint.danger}}">⚠️ {{selectedPoint.dangerDesc || '危险区域，请远离'}}</text>
    <text class="point-allow {{selectedPoint.allowPet ? 'ok' : 'no'}}" wx:else>
      {{selectedPoint.allowPet ? '✓ 允许携宠' : '✗ 禁止携宠'}}
    </text>
    <button class="nav-btn" wx:if="{{!selectedPoint.danger}}" bindtap="onNav">导航一下</button>
  </view>

  <view class="loading" wx:if="{{loading}}">加载地图中…</view>
</view>

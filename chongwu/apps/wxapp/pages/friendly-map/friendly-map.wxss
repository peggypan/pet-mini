page {
  height: 100%;
  background: #F5F5F5;
}

.page {
  position: relative;
  height: 100vh;
}

.map {
  width: 100%;
  height: 100%;
}

.amap-badge {
  position: absolute;
  top: 20rpx;
  left: 24rpx;
  z-index: 10;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(0, 160, 233, 0.92);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.amap-badge.mock {
  background: rgba(0, 0, 0, 0.55);
}

.toolbar {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  z-index: 10;
}

.tool-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.tool-btn.primary {
  background: linear-gradient(135deg, #0091FF, #0066CC);
  color: #fff;
}

.point-card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  z-index: 11;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.point-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #1A1A1A;
}

.point-close {
  font-size: 36rpx;
  color: #999;
  padding: 0 8rpx;
}

.point-type {
  display: block;
  font-size: 24rpx;
  color: #0091FF;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.point-addr {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.point-allow {
  display: block;
  font-size: 22rpx;
  margin-bottom: 16rpx;
}

.point-allow.ok { color: #2DB300; }
.point-allow.no { color: #E65100; }

.nav-btn {
  background: linear-gradient(135deg, #0091FF, #0066CC);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
}

.nav-btn::after { border: none; }

.loading {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  padding: 20rpx 32rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  z-index: 20;
}

/* 分类筛选条（悬浮在地图顶部） */
.filter-bar {
  position: absolute;
  left: 0;
  right: 0;
  top: 168rpx;
  z-index: 10;
  white-space: nowrap;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 14rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #4A6B5C;
  border: 2rpx solid #E2EDE6;
}

.chip.on {
  background: #2E7D5B;
  border-color: #2E7D5B;
  color: #FFFFFF;
  font-weight: 700;
}

/* 搜索栏（悬浮顶部） */
.search-bar {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 76rpx;
  z-index: 12;
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 59, 47, 0.12);
  box-sizing: border-box;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #1A1A1A;
}

.search-ph {
  color: #BBBBBB;
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #999999;
}

.search-tips {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 164rpx;
  z-index: 12;
  max-height: 420rpx;
  overflow-y: auto;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 12rpx 32rpx rgba(30, 59, 47, 0.16);
}

.tip-row {
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #F2F2F2;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.tip-row:last-child { border-bottom: none; }

.tip-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.tip-addr {
  font-size: 22rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 危险点位卡片 */
.point-card.danger {
  border: 2rpx solid #E5484D;
}

.point-card.danger .point-name {
  color: #E5484D;
}

.point-warn {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #E5484D;
  line-height: 1.5;
}

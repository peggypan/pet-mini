page {
  height: 100%;
  background: #F5F5F5;
}

.page {
  position: relative;
  height: 100vh;
}

.map {
  width: 100%;
  height: 100%;
}

.amap-badge {
  position: absolute;
  top: 20rpx;
  left: 24rpx;
  z-index: 10;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(0, 160, 233, 0.92);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.amap-badge.mock {
  background: rgba(0, 0, 0, 0.55);
}

.toolbar {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  z-index: 10;
}

.tool-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.tool-btn.primary {
  background: linear-gradient(135deg, #0091FF, #0066CC);
  color: #fff;
}

.point-card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  z-index: 11;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.point-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #1A1A1A;
}

.point-close {
  font-size: 36rpx;
  color: #999;
  padding: 0 8rpx;
}

.point-type {
  display: block;
  font-size: 24rpx;
  color: #0091FF;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.point-addr {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.point-allow {
  display: block;
  font-size: 22rpx;
  margin-bottom: 16rpx;
}

.point-allow.ok { color: #2DB300; }
.point-allow.no { color: #E65100; }

.nav-btn {
  background: linear-gradient(135deg, #0091FF, #0066CC);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
}

.nav-btn::after { border: none; }

.loading {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  padding: 20rpx 32rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  z-index: 20;
}

<view class="container">
  <!-- 宠物信息 -->
  <view class="card pet-header" wx:if="{{pet}}">
    <image src="{{pet.avatarUrl || '/assets/default-pet.png'}}" class="pet-avatar-large"></image>
    <view class="pet-detail">
      <text class="pet-name">{{pet.name}}</text>
      <view class="pet-meta">
        <text>{{pet.species === 1 ? '猫' : '狗'}} · {{pet.breedName || '未知品种'}}</text>
        <text wx:if="{{pet.birthday}}"> · {{pet.birthday}}</text>
        <text wx:if="{{pet.weight}}"> · {{pet.weight}}kg</text>
      </view>
    </view>
  </view>

  <!-- 记录列表 -->
  <view wx:if="{{mode === 'view'}}">
    <view class="card">
      <view class="section-header flex-between">
        <text class="section-title">健康记录</text>
        <button class="btn-small" bindtap="onAddRecord">+添加</button>
      </view>
      
      <view class="record-list">
        <view class="record-item" wx:for="{{records}}" wx:key="id">
          <view class="record-header">
            <text class="record-type">{{recordTypeOptions[item.recordType - 1]}}</text>
            <text class="record-date">{{item.doneAt}}</text>
          </view>
          <text class="record-name">{{item.itemName}}</text>
          <view class="record-footer">
            <text wx:if="{{item.clinicName}}">{{item.clinicName}}</text>
            <text wx:if="{{item.validUntil}}" class="valid-date">有效期至: {{item.validUntil}}</text>
            <text wx:if="{{item.cost}}" class="cost">¥{{item.cost}}</text>
          </view>
        </view>
      </view>

      <view class="empty-state" wx:if="{{records.length === 0}}">
        <text>暂无健康记录</text>
      </view>
    </view>
  </view>

  <!-- 添加记录表单 -->
  <view wx:if="{{mode === 'add'}}">
    <view class="card">
      <view class="section-title">添加健康记录</view>
      
      <form bindsubmit="onSubmitRecord">
        <view class="form-item">
          <text class="label">记录类型</text>
          <picker name="recordType" range="{{recordTypeOptions}}">
            <view class="picker">
              <text class="placeholder">请选择记录类型</text>
            </view>
          </picker>
        </view>

        <view class="form-item">
          <text class="label">项目名称</text>
          <input name="itemName" placeholder="如：狂犬疫苗" />
        </view>

        <view class="form-item">
          <text class="label">品牌/批次</text>
          <input name="itemBrand" placeholder="请输入品牌（可选）" />
        </view>

        <view class="form-item">
          <text class="label">完成日期</text>
          <picker mode="date" name="doneAt">
            <view class="picker">
              <text class="placeholder">请选择完成日期</text>
            </view>
          </picker>
        </view>

        <view class="form-item">
          <text class="label">有效期至</text>
          <picker mode="date" name="validUntil">
            <view class="picker">
              <text class="placeholder">请选择有效期（可选）</text>
            </view>
          </picker>
        </view>

        <view class="form-item">
          <text class="label">医院/机构</text>
          <input name="clinicName" placeholder="请输入医院名称（可选）" />
        </view>

        <view class="form-item">
          <text class="label">费用</text>
          <input name="cost" type="digit" placeholder="请输入费用（可选）" />
        </view>

        <view class="form-item">
          <text class="label">备注</text>
          <textarea name="remark" placeholder="请输入备注（可选）" />
        </view>

        <view class="form-actions">
          <button class="btn-secondary" bindtap="onCancel">取消</button>
          <button class="btn-primary" formType="submit">保存</button>
        </view>
      </form>
    </view>
  </view>
</view>

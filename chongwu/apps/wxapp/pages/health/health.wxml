<view class="container">
  <!-- 顶部欢迎语 -->
  <view class="page-header">
    <text class="page-icon">💗</text>
    <view class="header-content">
      <text class="page-title">健康档案</text>
      <text class="page-subtitle">记录毛孩子的每一次成长</text>
    </view>
  </view>

  <!-- Tab切换 -->
  <view class="tabs">
    <view class="tab {{activeTab === 'pets' ? 'active' : ''}}" bindtap="onTabTap" data-tab="pets">
      <text class="tab-icon">🐾</text>
      <text class="tab-text">我的宠物</text>
    </view>
    <view class="tab {{activeTab === 'reminders' ? 'active' : ''}}" bindtap="onTabTap" data-tab="reminders">
      <text class="tab-icon">🔔</text>
      <view class="tab-content">
        <text class="tab-text">到期提醒</text>
        <text class="badge" wx:if="{{reminders.length > 0}}">{{reminders.length}}</text>
      </view>
    </view>
  </view>

  <!-- 宠物列表 -->
  <view wx:if="{{activeTab === 'pets'}}">
    <view class="pet-list" wx:if="{{pets.length > 0}}">
      <view class="pet-card" wx:for="{{pets}}" wx:key="id" bindtap="onPetTap" data-id="{{item.id}}">
        <image src="{{item.avatarUrl || '/assets/default-pet.png'}}" class="pet-avatar"></image>
        <view class="pet-info">
          <text class="pet-name">{{item.name}}</text>
          <view class="pet-tags">
            <text class="tag">{{item.species === 1 ? '🐱 猫咪' : '🐶 狗狗'}}</text>
            <text class="tag" wx:if="{{item.gender === 1}}">♂ 男生</text>
            <text class="tag" wx:if="{{item.gender === 2}}">♀ 女生</text>
            <text class="tag" wx:if="{{item.isSterilized}}">💕 已绝育</text>
          </view>
          <text class="pet-birthday" wx:if="{{item.birthday}}">🎂 生日: {{item.birthday}}</text>
        </view>
        <view class="pet-actions">
          <button class="btn-small" bindtap="onAddRecord" data-pet-id="{{item.id}}">+记录</button>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{pets.length === 0}}">
      <text class="empty-icon">🐕</text>
      <text class="empty-text">还没有添加宠物</text>
      <text class="empty-tip">点击下方按钮添加你的第一只毛孩子</text>
      <text class="empty-hint">记录从遇见它的第一天开始~</text>
    </view>
  </view>

  <!-- 提醒列表 -->
  <view wx:if="{{activeTab === 'reminders'}}">
    <view class="reminder-list" wx:if="{{reminders.length > 0}}">
      <view class="reminder-card" wx:for="{{reminders}}" wx:key="id">
        <view class="reminder-header">
          <image src="{{item.pet.avatarUrl || '/assets/default-pet.png'}}" class="reminder-pet-avatar"></image>
          <view class="reminder-info">
            <text class="pet-name">{{item.pet.name}}</text>
            <text class="item-name">{{item.itemName}} 即将到期</text>
          </view>
        </view>
        <view class="reminder-footer">
          <text class="expire-date">📅 {{item.validUntil}}</text>
          <text class="days-left">还有 {{item.daysLeft}} 天</text>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{reminders.length === 0}}">
      <text class="empty-icon">✨</text>
      <text class="empty-text">暂无到期提醒</text>
      <text class="empty-tip">疫苗、驱虫到期时会在这里提醒你</text>
      <text class="empty-hint">细心呵护，健康相伴~</text>
    </view>
  </view>

  <!-- 添加宠物按钮 -->
  <view class="fab" bindtap="onAddPet" wx:if="{{activeTab === 'pets'}}">
    <text class="fab-icon">➕</text>
  </view>
</view>

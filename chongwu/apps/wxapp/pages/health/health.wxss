.page {
  min-height: 100vh;
  padding: 8rpx 28rpx 200rpx;
  box-sizing: border-box;
  background:
    radial-gradient(ellipse 80% 40% at 10% -10%, rgba(111, 207, 151, 0.22), transparent 55%),
    radial-gradient(ellipse 60% 35% at 100% 0%, rgba(126, 180, 220, 0.18), transparent 50%),
    #EEF4FA;
}

/* Hero */
.hero {
  position: relative;
  overflow: hidden;
  border-radius: 28rpx;
  margin-bottom: 22rpx;
  background: linear-gradient(135deg, #8FD9B0 0%, #6FCF97 48%, #5BBF88 100%);
  box-shadow: 0 16rpx 40rpx rgba(91, 191, 136, 0.28);
}

.hero-orb {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
}

.hero-orb-a {
  width: 180rpx;
  height: 180rpx;
  right: -40rpx;
  top: -50rpx;
}

.hero-orb-b {
  width: 120rpx;
  height: 120rpx;
  right: 80rpx;
  bottom: -50rpx;
  background: rgba(255, 255, 255, 0.1);
}

.hero-inner {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
}

.hero-mark {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.hero-mark-icon {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

.hero-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
  margin-bottom: 6rpx;
}

.hero-sub {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
}

/* Segmented control */
.seg {
  display: flex;
  padding: 6rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 8rpx 24rpx rgba(42, 42, 42, 0.04);
}

.seg-item {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #7A8A82;
  position: relative;
}

.seg-item.on {
  background: #fff;
  color: #2A2A2A;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(111, 207, 151, 0.18);
}

.seg-badge {
  margin-left: 8rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #FF6B8A;
  color: #fff;
  font-size: 18rpx;
  text-align: center;
  font-weight: 600;
}

/* Quick entry */
.quick-row {
  margin-bottom: 20rpx;
}

.quick-card {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(111, 207, 151, 0.22);
  box-shadow: 0 8rpx 24rpx rgba(42, 42, 42, 0.04);
}

.quick-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  margin-right: 18rpx;
}

.quick-icon.diet {
  background: rgba(111, 207, 151, 0.2);
  color: #3FA06C;
}

.quick-body {
  flex: 1;
  min-width: 0;
}

.quick-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2A2A2A;
  margin-bottom: 4rpx;
}

.quick-desc {
  display: block;
  font-size: 22rpx;
  color: #8A9A90;
}

.quick-arrow {
  font-size: 36rpx;
  color: #B0BEC5;
  font-weight: 300;
}

/* Pet cards */
.pet-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pet-card {
  display: flex;
  align-items: center;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 10rpx 28rpx rgba(42, 42, 42, 0.05);
}

.pet-card:active {
  transform: scale(0.985);
}

.pet-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 28rpx;
  background: #E8F0F6;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.pet-main {
  flex: 1;
  min-width: 0;
}

.pet-top {
  display: flex;
  align-items: baseline;
  margin-bottom: 10rpx;
}

.pet-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-right: 12rpx;
}

.pet-species {
  font-size: 22rpx;
  color: #5BBF88;
  background: rgba(111, 207, 151, 0.16);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.pet-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.chip {
  font-size: 20rpx;
  color: #5A6A62;
  background: #F0F5F2;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
}

.chip.soft {
  color: #4DB87A;
  background: rgba(111, 207, 151, 0.14);
}

.chip.mute {
  color: #9A9A9A;
  background: #F5F7F8;
}

.pet-btn {
  margin: 0 0 0 12rpx;
  padding: 0 26rpx;
  height: 64rpx;
  line-height: 1;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  background: #6FCF97;
  border-radius: 32rpx;
  border: none;
  flex-shrink: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(111, 207, 151, 0.35);
}

.pet-btn::after {
  border: none;
}

/* Notify */
.notify-bar {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 24rpx rgba(42, 42, 42, 0.04);
}

.notify-text {
  flex: 1;
  min-width: 0;
}

.notify-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2A2A2A;
  margin-bottom: 4rpx;
}

.notify-desc {
  display: block;
  font-size: 22rpx;
  color: #8A9A90;
}

.notify-switch {
  width: 84rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #D8E0E6;
  position: relative;
  transition: background 0.2s ease;
  flex-shrink: 0;
}

.notify-switch.on {
  background: #6FCF97;
}

.notify-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
  transition: left 0.2s ease;
}

.notify-switch.on .notify-knob {
  left: 40rpx;
}

/* Reminders */
.reminder-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.reminder-card {
  display: flex;
  align-items: center;
  padding: 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 24rpx rgba(42, 42, 42, 0.04);
}

.reminder-card.urgent {
  background: linear-gradient(90deg, rgba(255, 155, 122, 0.12) 0%, rgba(255, 255, 255, 0.95) 40%);
  border: 1rpx solid rgba(255, 155, 122, 0.28);
}

.reminder-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: #E8F0F6;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.reminder-main {
  flex: 1;
  min-width: 0;
}

.reminder-pet {
  display: block;
  font-size: 24rpx;
  color: #5BBF88;
  margin-bottom: 4rpx;
}

.reminder-item {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2A2A2A;
  margin-bottom: 4rpx;
}

.reminder-date {
  display: block;
  font-size: 22rpx;
  color: #9A9A9A;
}

.reminder-side {
  text-align: right;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.days {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #4DB87A;
  line-height: 1.1;
}

.days.warn {
  color: #E07A4A;
}

.days-label {
  display: block;
  font-size: 20rpx;
  color: #9A9A9A;
  margin-top: 2rpx;
}

/* Empty */
.empty {
  margin-top: 40rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 2rpx dashed #D0DDE8;
}

.empty-ring {
  width: 88rpx;
  height: 88rpx;
  line-height: 80rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: rgba(111, 207, 151, 0.16);
  color: #4DB87A;
  font-size: 48rpx;
  font-weight: 300;
}

.empty-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2A2A2A;
  margin-bottom: 8rpx;
}

.empty-desc {
  display: block;
  font-size: 24rpx;
  color: #8A9A90;
  line-height: 1.5;
}

.empty-btn {
  margin: 28rpx auto 0;
  width: 280rpx;
  height: 72rpx;
  line-height: 1;
  padding: 0;
  background: #6FCF97;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 36rpx;
  border: none;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-btn::after {
  border: none;
}

/* FAB */
.fab {
  position: fixed;
  right: 36rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #8FD9B0, #4DB87A);
  box-shadow: 0 12rpx 32rpx rgba(77, 184, 122, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.fab:active {
  transform: scale(0.94);
}

.fab-plus {
  font-size: 52rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

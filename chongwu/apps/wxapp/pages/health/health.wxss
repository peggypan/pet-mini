/* 页面头部 */
.page-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 20rpx;
  background: linear-gradient(135deg, #FFE8D6 0%, #FFD6C6 100%);
  border-radius: 24rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 139, 123, 0.15);
}

.page-icon {
  font-size: 64rpx;
}

.header-content {
  flex: 1;
}

.page-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 温馨Tab切换 */
.tabs {
  display: flex;
  background: var(--bg-white);
  border-radius: 24rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
  box-shadow: var(--shadow-soft);
  border: 1rpx solid var(--border-color);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 0;
  color: var(--text-secondary);
  transition: all 0.3s ease;
  position: relative;
}

.tab.active {
  color: var(--primary);
  font-weight: 600;
  background: linear-gradient(135deg, var(--primary-bg) 0%, transparent 100%);
}

.tab-icon {
  font-size: 36rpx;
}

.tab-text {
  font-size: 26rpx;
}

.tab-content {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.badge {
  display: inline-block;
  background: var(--danger);
  color: white;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
  font-weight: 500;
}

/* 宠物列表 */
.pet-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.pet-card {
  background: var(--bg-white);
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: var(--shadow-soft);
  border: 1rpx solid var(--border-color);
  transition: all 0.3s ease;
}

.pet-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-card);
}

.pet-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--bg-primary);
  border: 3rpx solid rgba(255, 139, 123, 0.2);
}

.pet-info {
  flex: 1;
}

.pet-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.pet-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--bg-primary);
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  border: 1rpx solid var(--border-color);
}

.pet-birthday {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
  display: block;
}

.pet-actions {
  display: flex;
  gap: 12rpx;
}

.btn-small {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  font-size: 24rpx;
  padding: 14rpx 24rpx;
  border-radius: 36rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(255, 139, 123, 0.25);
}

.btn-small::after {
  border: none;
}

/* 提醒列表 */
.reminder-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.reminder-card {
  background: var(--bg-white);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-soft);
  border: 1rpx solid var(--border-color);
}

.reminder-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.reminder-pet-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--bg-primary);
  border: 3rpx solid rgba(255, 139, 123, 0.15);
}

.reminder-info {
  flex: 1;
}

.reminder-info .pet-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
  color: var(--text-primary);
}

.item-name {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.reminder-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color);
}

.expire-date {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.days-left {
  font-size: 28rpx;
  color: var(--danger);
  font-weight: 500;
  padding: 10rpx 24rpx;
  background: var(--danger-bg);
  border-radius: 28rpx;
}

/* 温馨空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  background: var(--bg-warm);
  border-radius: 28rpx;
  border: 2rpx dashed var(--border-light);
}

.empty-icon {
  font-size: 140rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 22rpx;
  color: var(--text-light);
}

/* 温馨浮动按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-float);
  transition: all 0.3s ease;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  z-index: 9998;
}

.fab:active {
  transform: scale(0.9);
}

.fab-icon {
  font-size: 48rpx;
}

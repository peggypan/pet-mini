<view class="page">
  <view class="card">
    <text class="label">需求标题 *</text>
    <input data-field="title" value="{{title}}" bindinput="onInput" placeholder="如：出差三天求上门喂猫" />
    <text class="label">详情 *</text>
    <textarea data-field="desc" value="{{desc}}" bindinput="onInput" placeholder="时间、地址、报酬等"></textarea>
    <text class="label">联系方式</text>
    <input data-field="contact" value="{{contact}}" bindinput="onInput" />
    <button class="submit" bindtap="onSubmit">发布</button>
  </view>
</view>

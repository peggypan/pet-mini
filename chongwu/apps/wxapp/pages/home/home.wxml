<view class="page">
  <view class="top">
    <view class="search-row">
      <view class="search" bindtap="onSearch">
        <text class="search-icon">🔍</text>
        <text class="search-ph">搜搭子、活动、友好点位、商家</text>
      </view>
      <view class="city" bindtap="onCityTap">
        <text>{{city}}</text>
        <text> ▾</text>
      </view>
    </view>
  </view>

  <view class="banner-wrap aspect-169">
    <swiper
      class="banner"
      autoplay
      circular
      indicator-dots
      indicator-color="rgba(255,255,255,0.4)"
      indicator-active-color="#fff"
    >
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <view
          class="banner-item {{item.type === 'mapPointsCampaign' ? 'banner-campaign' : ''}}"
          bindtap="onBannerTap"
          data-id="{{item.id}}"
        >
          <block wx:if="{{item.type === 'mapPointsCampaign'}}">
            <image class="banner-img banner-img-dim" src="{{item.cover}}" mode="aspectFill"></image>
            <view class="banner-campaign-overlay"></view>
            <view class="banner-campaign-body">
              <text class="banner-campaign-tag">{{item.tag}}</text>
              <text class="banner-campaign-title">{{item.title}}</text>
              <text class="banner-campaign-sub" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
              <text class="banner-campaign-cta">去标记地点 ›</text>
            </view>
          </block>
          <block wx:else>
            <image class="banner-img" src="{{item.cover}}" mode="aspectFill"></image>
            <text class="banner-title">{{item.title}}</text>
          </block>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 服务宫格 · 高饱和色块 + 右侧插画 -->
  <view class="service-board">
    <view class="service-row">
      <view
        class="service-card theme-svc-blue service-card-text-only"
        bindtap="onFeatureTap"
        data-id="buddy"
      >
        <view class="svc-copy">
          <text class="svc-title">{{tiles.buddy.name}}</text>
          <text class="svc-sub">{{tiles.buddy.subtitle}}</text>
        </view>
      </view>
      <view
        class="service-card theme-svc-orange service-card-text-only"
        bindtap="onFeatureTap"
        data-id="map"
      >
        <view class="svc-copy">
          <text class="svc-title">{{tiles.map.name}}</text>
          <text class="svc-sub">{{tiles.map.subtitle}}</text>
        </view>
      </view>
    </view>
    <view
      class="service-card service-card-wide theme-svc-warm service-card-text-only"
      bindtap="onFeatureTap"
      data-id="rescue"
    >
      <view class="svc-copy">
        <text class="svc-title">{{tiles.rescue.name}}</text>
        <text class="svc-sub">{{tiles.rescue.subtitle}}</text>
      </view>
    </view>
  </view>

  <view class="section buddy-plaza-section">
    <view class="section-head">
      <text class="section-title">宠物搭子广场</text>
      <text class="section-more" bindtap="onMoreBuddy">更多 ›</text>
    </view>
    <view class="buddy-plaza-list">
      <view
        class="buddy-plaza-card"
        wx:for="{{buddyPlaza}}"
        wx:key="feedKey"
        bindtap="onBuddyTap"
        data-id="{{item.id}}"
      >
        <view class="buddy-plaza-cover aspect-34">
          <image
            class="aspect-34-fill"
            src="{{item.coverIsVideo ? (item.coverPoster || item.cover) : item.cover}}"
            mode="aspectFill"
          ></image>
          <view class="cover-video-mask" wx:if="{{item.coverIsVideo}}">
            <text class="cover-video-tag">▶</text>
          </view>
          <text class="buddy-plaza-dist">{{item.distanceLabel}}</text>
        </view>
        <view class="buddy-plaza-body">
          <text class="buddy-plaza-name">{{item.cardTitle}}</text>
          <view class="buddy-plaza-score">
            <text class="buddy-plaza-star">★</text>
            <text class="buddy-plaza-score-text" wx:if="{{item.verified}}">已核验</text>
            <text class="buddy-plaza-score-div" wx:if="{{item.verified}}">|</text>
            <text class="buddy-plaza-score-text">{{item.buddyType}}</text>
          </view>
          <text class="buddy-plaza-pet-line" wx:if="{{item.petLine}}">{{item.petLine}}</text>
          <text class="buddy-plaza-place" wx:if="{{item.expectPlace}}">{{item.expectPlace}}</text>
          <view class="buddy-plaza-tags" wx:if="{{item.tags.length}}">
            <text class="buddy-plaza-tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
          </view>
          <text class="buddy-plaza-author">{{item.authorLine}}</text>
        </view>
      </view>
    </view>
    <view class="buddy-load-more" wx:if="{{buddyHasMore}}" bindtap="onLoadMoreBuddy">
      <text class="buddy-load-more-text">继续下滑或点击加载更多搭子</text>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">近期活动</text>
      <text class="section-more" bindtap="onMoreEvents">全部 ›</text>
    </view>
    <view class="event-card-v2" wx:for="{{events}}" wx:key="id" bindtap="onEventTap" data-id="{{item.id}}">
      <view class="event-card-media aspect-34">
        <image class="event-card-cover" src="{{item.cover}}" mode="aspectFill"></image>
        <view class="event-card-media-shade"></view>
        <view class="event-card-media-foot">
          <view class="event-card-avatars">
            <image
              class="event-card-av"
              wx:for="{{item.cardAvatars}}"
              wx:for-item="av"
              wx:key="*this"
              src="{{av}}"
              mode="aspectFill"
            ></image>
          </view>
          <text class="event-card-stat">{{item.cardInterest}}人关注 · {{item.cardJoined}}人已报名</text>
        </view>
      </view>
      <view class="event-card-main">
        <view class="event-card-dateline">
          <text class="event-card-date">{{item.cardDateMD}}</text>
          <text class="event-card-time">{{item.cardTimeHint}}</text>
        </view>
        <text class="event-card-title">{{item.title}}</text>
        <view class="event-card-loc">
          <text class="event-card-loc-icon">📍</text>
          <text class="event-card-loc-text">{{item.cardDistance}} {{item.cardLocationLine}}</text>
        </view>
        <view class="event-card-host">
          <image class="event-card-host-av" src="{{item.hostAvatar}}" mode="aspectFill"></image>
          <text class="event-card-host-name">{{item.host}}</text>
        </view>
        <view class="event-card-foot">
          <text class="event-card-tag">{{item.cardCategory}}</text>
          <text class="event-card-desc">{{item.desc}}</text>
        </view>
        <text class="event-card-seats">剩余 {{item.remain}} 名额 · {{item.fee}}</text>
      </view>
    </view>
    <view class="event-load-more" wx:if="{{eventHasMore}}" bindtap="onLoadMoreEvents">
      <text class="event-load-more-text">继续下滑或点击加载更多活动</text>
    </view>
  </view>

  <view class="risk-tip">⚠️ {{riskTip}}</view>
</view>

page {
  background: linear-gradient(180deg, #E8F4FF 0%, #F5F8FC 360rpx, #F5F8FC 100%);
}

.page {
  padding: 16rpx 28rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.top {
  margin-bottom: 20rpx;
}

.search-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.search {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 28rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 28rpx;
  opacity: 0.5;
}

.search-ph {
  font-size: 26rpx;
  color: #999999;
}

.city {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #1A1A1A;
  font-weight: 600;
  white-space: nowrap;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.city-locate {
  font-size: 22rpx;
}

.banner {
  height: 300rpx;
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.banner-item {
  position: relative;
  height: 100%;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-title {
  position: absolute;
  left: 28rpx;
  bottom: 28rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

/* —— 布丁 Pudding 风格 bento 宫格 —— */
.pudding-board {
  margin-bottom: 28rpx;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(69, 180, 255, 0.08);
  background-image:
    linear-gradient(rgba(69, 180, 255, 0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(69, 180, 255, 0.04) 1px, transparent 1px);
  background-size: 40rpx 40rpx;
}

.pudding-row {
  display: flex;
  gap: 12rpx;
}

.pudding-row-main {
  margin-bottom: 12rpx;
  align-items: stretch;
}

.pudding-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.pudding-mini-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  flex: 1;
}

.pudding-tile {
  position: relative;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.pudding-tile:active {
  transform: scale(0.98);
  opacity: 0.94;
}

.tile-large {
  width: 48%;
  min-height: 232rpx;
  padding: 20rpx 20rpx 18rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.tile-wide {
  flex: 1;
  min-height: 108rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
}

.tile-small {
  min-width: 0;
  min-height: 112rpx;
  padding: 16rpx 14rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.tile-half {
  flex: 1;
  min-height: 108rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
}

.tile-full {
  width: 100%;
  min-height: 108rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
}

.theme-blue {
  background: linear-gradient(145deg, #45B4FF 0%, #6EC5FF 42%, #A8DCFF 100%);
}

.theme-yellow {
  background: linear-gradient(145deg, #FFF4D0 0%, #FFF9E8 55%, #FFFFFF 100%);
}

.theme-green {
  background: linear-gradient(145deg, #B8DCFF 0%, #D8ECFF 55%, #FFFFFF 100%);
}

.theme-pink {
  background: linear-gradient(145deg, #FFD6D6 0%, #FFECEC 55%, #FFFFFF 100%);
}

.theme-cyan {
  background: linear-gradient(145deg, #B8E8F0 0%, #DCF3F8 55%, #FFFFFF 100%);
}

.theme-gold {
  background: linear-gradient(145deg, #FFE9B8 0%, #FFF5DC 55%, #FFFFFF 100%);
}

.tile-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.tile-glow-blue {
  width: 200rpx;
  height: 200rpx;
  right: -40rpx;
  top: -40rpx;
  background: rgba(255, 255, 255, 0.22);
}

.tile-copy {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
}

.tile-copy-light .tile-title,
.tile-copy-light .tile-sub {
  color: #FFFFFF;
}

.tile-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
  margin-bottom: 4rpx;
}

.tile-title-dark {
  color: #3D3028;
  font-size: 28rpx;
}

.tile-small .tile-copy {
  width: 100%;
  min-width: 0;
}

.tile-small .tile-title-dark {
  font-size: 24rpx;
  white-space: nowrap;
  letter-spacing: 0;
}

.tile-sub {
  display: block;
  font-size: 20rpx;
  line-height: 1.4;
  opacity: 0.92;
}

.tile-copy-light .tile-sub {
  opacity: 0.88;
  font-size: 20rpx;
}

.tile-sub-dark {
  color: #7A6A5A;
  font-size: 20rpx;
}

.tile-small .tile-sub-dark {
  font-size: 18rpx;
}

.tile-thumbs {
  position: relative;
  z-index: 2;
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
}

.tile-thumb {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}

.section {
  margin-bottom: 28rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1A1A1A;
}

.section-more {
  font-size: 24rpx;
  color: #999999;
}

.h-scroll {
  white-space: nowrap;
}

.buddy-card {
  display: inline-block;
  width: 260rpx;
  margin-right: 16rpx;
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  vertical-align: top;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.buddy-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
}

.buddy-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.buddy-meta {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin: 6rpx 0 10rpx;
}

.buddy-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 20rpx;
  color: #1E88E5;
  background: rgba(126, 200, 255, 0.25);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.tag.soft {
  color: #999999;
  background: #F5F8FC;
  font-weight: 500;
}

.event-card-v2 {
  display: flex;
  align-items: stretch;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.08);
}

.event-card-media {
  position: relative;
  width: 240rpx;
  flex-shrink: 0;
  min-height: 300rpx;
  background: #e8eef5;
}

.event-card-cover {
  width: 100%;
  height: 100%;
  min-height: 300rpx;
}

.event-card-media-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 55%;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.72) 100%);
  pointer-events: none;
}

.event-card-media-foot {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 14rpx 18rpx;
  z-index: 1;
}

.event-card-avatars {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.event-card-av {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.95);
  margin-left: -12rpx;
  background: #ddd;
}

.event-card-av:first-child {
  margin-left: 0;
}

.event-card-stat {
  display: block;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.35;
  font-weight: 600;
}

.event-card-main {
  flex: 1;
  min-width: 0;
  padding: 20rpx 22rpx 18rpx 20rpx;
  display: flex;
  flex-direction: column;
}

.event-card-dateline {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.event-card-date {
  font-size: 40rpx;
  font-weight: 800;
  color: #2b2b2b;
  line-height: 1;
  letter-spacing: -1rpx;
}

.event-card-time {
  font-size: 24rpx;
  color: #9aa3ad;
  font-weight: 600;
}

.event-card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #111111;
  line-height: 1.35;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.event-card-loc {
  display: flex;
  align-items: flex-start;
  gap: 6rpx;
  margin-bottom: 12rpx;
}

.event-card-loc-icon {
  font-size: 22rpx;
  line-height: 1.4;
  flex-shrink: 0;
}

.event-card-loc-text {
  font-size: 22rpx;
  color: #9aa3ad;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-card-host {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.event-card-host-av {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #eee;
}

.event-card-host-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #1fb896;
}

.event-card-foot {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: auto;
}

.event-card-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  background: #22c55e;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.5;
}

.event-card-desc {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #333333;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.event-card-seats {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #b0b8c0;
}

.community-card {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.community-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.community-icon {
  font-size: 44rpx;
  margin-right: 14rpx;
}

.community-info {
  flex: 1;
  min-width: 0;
}

.community-name {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #1A1A1A;
}

.community-meta {
  font-size: 22rpx;
  color: #1E88E5;
  font-weight: 600;
}

.community-preview {
  display: block;
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
  margin-bottom: 14rpx;
}

.community-images {
  display: flex;
  gap: 10rpx;
  margin-bottom: 14rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.community-images.single {
  display: block;
}

.community-images.single .community-img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 16rpx;
}

.community-img {
  flex: 1;
  width: 100%;
  height: 200rpx;
  min-width: 0;
  border-radius: 12rpx;
  background: #F0F0F0;
}

.community-tags {
  display: flex;
  gap: 10rpx;
}

.community-tag {
  font-size: 20rpx;
  color: #666;
  padding: 6rpx 14rpx;
  background: #F5F8FC;
  border-radius: 999rpx;
}

.post-card {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.post-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.post-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}

.post-user {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.post-content {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.risk-tip {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #FFF9E6;
  font-size: 22rpx;
  color: #996600;
  line-height: 1.5;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.city-panel {
  width: 100%;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
}

.panel-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  color: #1A1A1A;
}

.city-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.city-item {
  padding: 16rpx 32rpx;
  background: #F5F8FC;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #1A1A1A;
}

.city-item:active {
  background: rgba(126, 200, 255, 0.35);
}

.pudding-col .tile-small {
  flex: 1;
}

/* 右列小卡文字与左侧大卡标题同一水平线 */
.pudding-col .tile-small {
  align-items: flex-start;
  padding: 20rpx 20rpx 16rpx;
  box-sizing: border-box;
}

.pudding-col .tile-small .tile-title-dark {
  font-size: 30rpx;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
}

/* 友好地图卡片右下角迷你地图 */
.tile-map-corner {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  width: 160rpx;
  height: 104rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
  background: #E8F2E8;
  z-index: 1;
}

.tile-map-img {
  width: 100%;
  height: 100%;
  display: block;
}

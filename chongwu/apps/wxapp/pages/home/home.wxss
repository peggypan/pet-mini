page {
  background: linear-gradient(180deg, #E8F4FF 0%, #F5F8FC 360rpx, #F5F8FC 100%);
}

.page {
  padding: 16rpx 28rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.top {
  margin-bottom: 20rpx;
}

.search-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.search {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 28rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 28rpx;
  opacity: 0.5;
}

.search-ph {
  font-size: 26rpx;
  color: #999999;
}

.city {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #1A1A1A;
  font-weight: 600;
  white-space: nowrap;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.city-locate {
  font-size: 22rpx;
}

/* 轮播 16:9 ≈ 设计稿 1600×900 */
.banner-wrap {
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.banner-wrap.aspect-169::before {
  display: block;
}

.banner {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
  overflow: hidden;
}

.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.banner-item:active {
  opacity: 0.92;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-title {
  position: absolute;
  left: 28rpx;
  bottom: 28rpx;
  z-index: 2;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.banner-campaign .banner-img-dim {
  filter: brightness(0.85);
}

.banner-campaign-overlay {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  background: linear-gradient(
    115deg,
    rgba(0, 145, 255, 0.88) 0%,
    rgba(30, 136, 229, 0.72) 42%,
    rgba(245, 158, 11, 0.55) 100%
  );
}

.banner-campaign-body {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 32rpx 36rpx;
  box-sizing: border-box;
}

.banner-campaign-tag {
  align-self: flex-start;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.banner-campaign-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.25;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.15);
}

.banner-campaign-sub {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  line-height: 1.45;
}

.banner-campaign-cta {
  margin-top: auto;
  align-self: flex-start;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  padding: 10rpx 0;
}

/* —— 服务宫格（参照上门洗护/喂遛高饱和卡片） —— */
.service-board {
  margin-bottom: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.service-row {
  display: flex;
  gap: 16rpx;
}

.service-card {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 208rpx;
  padding: 28rpx 22rpx 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-sizing: border-box;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.service-card:active {
  transform: scale(0.98);
  opacity: 0.94;
}

.service-card-wide {
  width: 100%;
  min-height: 168rpx;
}

.theme-svc-blue {
  background: linear-gradient(145deg, #3d9eff 0%, #2a7fe8 55%, #1f6fd4 100%);
  box-shadow: 0 14rpx 32rpx rgba(42, 127, 232, 0.38);
}

.theme-svc-orange {
  background: linear-gradient(145deg, #ffab4a 0%, #ff8c2e 50%, #ff7618 100%);
  box-shadow: 0 14rpx 32rpx rgba(255, 118, 24, 0.34);
}

.theme-svc-warm {
  background: linear-gradient(145deg, #ff9a8b 0%, #ff7e6b 45%, #ff6b57 100%);
  box-shadow: 0 14rpx 32rpx rgba(255, 107, 87, 0.28);
}

.svc-copy {
  position: relative;
  z-index: 2;
  max-width: 58%;
}

.service-card-wide .svc-copy,
.service-card-text-only .svc-copy {
  max-width: 100%;
}

.svc-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.28;
  margin-bottom: 10rpx;
  letter-spacing: 0.5rpx;
}

.service-card-wide .svc-title {
  font-size: 32rpx;
}

.svc-sub {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.45;
}

.section {
  margin-bottom: 28rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1A1A1A;
}

.section-more {
  font-size: 24rpx;
  color: #999999;
}

.buddy-load-more {
  width: 100%;
  margin-top: 8rpx;
  padding: 20rpx 16rpx 4rpx;
  text-align: center;
}

.buddy-load-more-text {
  font-size: 24rpx;
  color: #1E88E5;
  font-weight: 600;
}

.event-load-more {
  margin-top: 8rpx;
  padding: 24rpx 16rpx 8rpx;
  text-align: center;
}

.event-load-more-text {
  font-size: 26rpx;
  color: #1E88E5;
  font-weight: 600;
}

.h-scroll {
  white-space: nowrap;
}

.buddy-plaza-section {
  width: 100%;
}

.buddy-card {
  display: inline-block;
  width: 260rpx;
  margin-right: 16rpx;
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  vertical-align: top;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.buddy-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
}

.buddy-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.buddy-meta {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin: 6rpx 0 10rpx;
}

.buddy-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 20rpx;
  color: #1E88E5;
  background: rgba(126, 200, 255, 0.25);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.tag.soft {
  color: #999999;
  background: #F5F8FC;
  font-weight: 500;
}

.event-card-v2 {
  display: flex;
  align-items: stretch;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.08);
}

.event-card-media {
  width: 240rpx;
  flex-shrink: 0;
  background: #e8eef5;
  border-radius: 24rpx 0 0 24rpx;
  overflow: hidden;
}

.event-card-cover {
  background: #e8eef5;
}

.event-card-media-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 55%;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.72) 100%);
  pointer-events: none;
}

.event-card-media-foot {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 14rpx 18rpx;
  z-index: 1;
}

.event-card-avatars {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.event-card-av {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.95);
  margin-left: -12rpx;
  background: #ddd;
}

.event-card-av:first-child {
  margin-left: 0;
}

.event-card-stat {
  display: block;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.35;
  font-weight: 600;
}

.event-card-main {
  flex: 1;
  min-width: 0;
  padding: 20rpx 22rpx 18rpx 20rpx;
  display: flex;
  flex-direction: column;
}

.event-card-dateline {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.event-card-date {
  font-size: 40rpx;
  font-weight: 800;
  color: #2b2b2b;
  line-height: 1;
  letter-spacing: -1rpx;
}

.event-card-time {
  font-size: 24rpx;
  color: #9aa3ad;
  font-weight: 600;
}

.event-card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #111111;
  line-height: 1.35;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.event-card-loc {
  display: flex;
  align-items: flex-start;
  gap: 6rpx;
  margin-bottom: 12rpx;
}

.event-card-loc-icon {
  font-size: 22rpx;
  line-height: 1.4;
  flex-shrink: 0;
}

.event-card-loc-text {
  font-size: 22rpx;
  color: #9aa3ad;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-card-host {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.event-card-host-av {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #eee;
}

.event-card-host-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #1fb896;
}

.event-card-foot {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: auto;
}

.event-card-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  background: #22c55e;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.5;
}

.event-card-desc {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #333333;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.event-card-seats {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #b0b8c0;
}

.community-card {
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.035);
}

.community-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.community-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
  line-height: 1;
}

.community-info {
  flex: 1;
  min-width: 0;
}

.community-name {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
  color: #1A1A1A;
  line-height: 1.3;
}

.community-meta {
  display: block;
  font-size: 20rpx;
  color: #1E88E5;
  font-weight: 600;
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.community-preview {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 24rpx;
  color: #666;
  line-height: 1.45;
  margin-bottom: 10rpx;
}

.community-images {
  display: flex;
  gap: 8rpx;
  margin-bottom: 10rpx;
  border-radius: 14rpx;
  overflow: hidden;
  align-items: flex-start;
}

.community-images.single .community-img-wrap {
  width: 100%;
}

.community-img-wrap {
  border-radius: 14rpx;
  background: #F0F0F0;
}

.community-img {
  background: #F0F0F0;
}

.community-tags {
  display: flex;
  gap: 8rpx;
}

.community-tag {
  font-size: 18rpx;
  color: #888;
  padding: 4rpx 12rpx;
  background: #F5F8FC;
  border-radius: 999rpx;
}

.post-card {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.post-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.post-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}

.post-user {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.post-content {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.risk-tip {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #FFF9E6;
  font-size: 22rpx;
  color: #996600;
  line-height: 1.5;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.city-panel {
  width: 100%;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
}

.panel-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  color: #1A1A1A;
}

.city-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.city-item {
  padding: 16rpx 32rpx;
  background: #F5F8FC;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #1A1A1A;
}

.city-item:active {
  background: rgba(126, 200, 255, 0.35);
}


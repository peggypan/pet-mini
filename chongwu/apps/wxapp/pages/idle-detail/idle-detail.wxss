/* 轮播图 */
.item-swiper {
  height: 560rpx;
  margin: -20rpx -20rpx 28rpx;
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
}

.item-placeholder {
  height: 420rpx;
  margin: -20rpx -20rpx 28rpx;
  border-radius: 0 0 40rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #E8F5EE 0%, #D4EBE0 100%);
}

.placeholder-icon {
  font-size: 120rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

/* 价格和标题 */
.price-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.price {
  font-size: 56rpx;
  font-weight: 600;
  color: var(--primary);
}

.price::before {
  content: '¥';
  font-size: 36rpx;
  margin-right: 2rpx;
}

.original-price {
  font-size: 28rpx;
  color: var(--text-muted);
  text-decoration: line-through;
}

.item-title {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.item-meta {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.condition-tag {
  font-size: 24rpx;
  color: var(--secondary);
  background: var(--secondary-bg);
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  font-weight: 500;
}

.trade-type {
  font-size: 24rpx;
  color: var(--primary);
  background: var(--primary-bg);
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  font-weight: 500;
}

/* 卖家卡片 */
.seller-card {
  padding: 28rpx;
  background: var(--bg-warm);
  border-radius: 24rpx;
  border: 1rpx solid var(--border-color);
}

.seller-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.seller-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-primary);
  border: 3rpx solid rgba(255, 139, 123, 0.2);
}

.seller-info {
  flex: 1;
}

.seller-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.seller-location {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 区块标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  position: relative;
  padding-left: 16rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(to bottom, var(--primary), var(--primary-light));
  border-radius: 3rpx;
}

.description {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--border-color);
  font-size: 28rpx;
}

.detail-row .label {
  color: var(--text-secondary);
}

.detail-row .value {
  color: var(--text-primary);
  font-weight: 500;
}

/* 温馨底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-white);
  padding: 24rpx 30rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(199, 180, 168, 0.12);
  border-top: 1rpx solid var(--border-color);
}

.contact-btn {
  flex: 1;
  background: var(--bg-warm);
  color: var(--primary);
  border: 2rpx solid var(--primary);
}

.buy-btn {
  flex: 2;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  border: none;
}

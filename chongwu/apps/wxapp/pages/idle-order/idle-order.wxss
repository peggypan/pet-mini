/* 物品摘要 */
.item-summary {
  display: flex;
  gap: 20rpx;
  align-items: center;
  padding: 24rpx;
  background: var(--bg-warm);
  border-radius: 24rpx;
  border: 1rpx solid var(--border-color);
}

.item-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: var(--bg-white);
}

.item-info {
  flex: 1;
}

.item-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.item-price {
  font-size: 32rpx;
  color: var(--primary);
  font-weight: 600;
}

.item-price::before {
  content: '¥';
  font-size: 24rpx;
  margin-right: 2rpx;
}

/* 价格卡片 */
.price-card {
  padding: 28rpx;
  background: var(--bg-white);
  border-radius: 24rpx;
  border: 1rpx solid var(--border-color);
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border-color);
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.total-price {
  color: var(--primary);
  font-size: 40rpx;
}

.total-price::before {
  content: '¥';
  font-size: 26rpx;
  margin-right: 2rpx;
}

/* 表单样式 */
.form-item {
  margin-bottom: 28rpx;
}

.label {
  font-size: 28rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
}

input, .picker, textarea {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: var(--bg-white);
  transition: border-color 0.2s;
}

input:focus, .picker:focus, textarea:focus {
  border-color: var(--primary);
}

.picker {
  display: flex;
  align-items: center;
}

.placeholder {
  color: var(--text-muted);
}

textarea {
  height: 180rpx;
  padding: 20rpx 24rpx;
  line-height: 1.6;
}

/* 提交按钮 */
.submit-btn {
  margin-top: 40rpx;
  width: 100%;
}

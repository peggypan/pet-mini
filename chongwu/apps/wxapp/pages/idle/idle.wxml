<view class="page">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">闲置好物</text>
    <text class="page-subtitle">好物流转，让爱延续</text>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view class="filter-tabs">
      <view class="filter-tab {{currentCategory === null ? 'active' : ''}}" bindtap="onCategoryTap" data-id="">
        <text>全部</text>
      </view>
      <view class="filter-tab {{currentCategory === item.id ? 'active' : ''}}" wx:for="{{categories}}" wx:key="id" bindtap="onCategoryTap" data-id="{{item.id}}">
        <text class="tab-emoji">{{item.icon}}</text>
        <text>{{item.name}}</text>
      </view>
    </view>
    <view class="filter-more" bindtap="onFilterMore">
      <text>筛选</text>
      <text class="filter-icon">⚙</text>
    </view>
  </view>

  <!-- 商品网格 -->
  <view class="goods-grid" wx:if="{{items.length > 0}}">
    <view class="goods-card" wx:for="{{items}}" wx:key="id" bindtap="onItemTap" data-id="{{item.id}}">
      <image src="{{item.images[0] || '/assets/default-idle.png'}}" class="goods-image" mode="aspectFill"></image>
      <view class="goods-info">
        <text class="goods-title">{{item.title}}</text>
        <view class="goods-meta">
          <text class="goods-condition">{{['全新', '几乎新', '轻微使用', '明显使用'][item.conditionLevel - 1] || '未知'}}</text>
        </view>
        <view class="goods-footer">
          <text class="goods-price">¥{{item.price}}</text>
          <text class="goods-want">💬 {{item.wantCount || 0}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && items.length === 0}}">
    <text class="empty-icon">📭</text>
    <text class="empty-title">闲置区空空如也</text>
    <text class="empty-desc">来发布你的第一件闲置好物吧~</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text class="loading-icon">⟳</text>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 底部提示 -->
  <view class="bottom-tip" wx:if="{{!hasMore && items.length > 0}}">
    <text>— 已经到底啦 —</text>
  </view>

  <!-- 发布按钮 -->
  <view class="fab" bindtap="onPublishTap">
    <text class="fab-icon">✨</text>
    <text class="fab-text">发布</text>
  </view>
</view>

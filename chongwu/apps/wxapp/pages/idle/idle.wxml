<!-- 闲置市集：促销 Banner + 筛选 + 商品网格 + 宠物求助 -->
<view class="page">
  <!-- 促销 Banner：clap.png 作为背景 -->
  <view class="promo-banner">
    <image class="promo-bg" src="/assets/mock/clap.png" mode="aspectFill"></image>
    <view class="promo-text-wrap">
      <text class="promo-text">让爱意延续,</text>
      <text class="promo-text">把闲置变成新欢</text>
    </view>
  </view>

  <!-- 活体禁令提示 -->
  <view class="ban-tip">
    <text class="ban-tip-title">严禁售卖活体宠物</text>
    <text class="ban-tip-desc">仅支持宠物粮、笼具、玩具、洗护等用品；违规将下架并封号。建议走平台担保交易。</text>
  </view>

  <!-- 筛选 Tab -->
  <view class="filter-row">
    <view
      class="filter-pill {{currentMode === item.id ? 'active' : ''}}"
      wx:for="{{modes}}"
      wx:key="id"
      bindtap="onModeTap"
      data-id="{{item.id}}"
    >
      <text>{{item.name}}</text>
    </view>
  </view>

  <!-- 商品网格 -->
  <view class="goods-grid" wx:if="{{items.length > 0}}">
    <view
      class="goods-card"
      wx:for="{{items}}"
      wx:key="id"
      bindtap="onItemTap"
      data-id="{{item.id}}"
    >
      <view class="goods-visual">
        <image
          wx:if="{{item.images[0]}}"
          src="{{item.images[0]}}"
          class="goods-img"
          mode="aspectFill"
        ></image>
        <view class="goods-icon-wrap" wx:else>
          <text class="goods-icon">{{item.displayIcon}}</text>
        </view>
      </view>
      <view class="goods-info">
        <text class="goods-title">{{item.title}}</text>
        <text class="goods-condition">{{item.conditionText}}</text>
        <view class="condition-bar">
          <view class="condition-seg {{item.conditionLevel >= 1 ? 'on' : ''}}"></view>
          <view class="condition-seg {{item.conditionLevel >= 2 ? 'on' : ''}}"></view>
          <view class="condition-seg {{item.conditionLevel >= 3 ? 'on' : ''}}"></view>
          <view class="condition-seg {{item.conditionLevel >= 4 ? 'on' : ''}}"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="loading-box" wx:if="{{loading}}">
    <text class="loading-spinner">⟳</text>
    <text class="loading-txt">加载中...</text>
  </view>

  <!-- 宠物求助 -->
  <view class="help-section">
    <view class="help-header">
      <text class="help-title">宠物求助</text>
      <text class="help-more">›</text>
    </view>
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="help-scroll">
      <view class="help-card" wx:for="{{helpCards}}" wx:key="id">
        <image class="help-avatar" src="{{item.avatar}}" mode="aspectFill" wx:if="{{item.avatar}}"></image>
        <text class="help-emoji" wx:else>{{item.icon}}</text>
        <text class="help-card-title">{{item.title}}</text>
        <text class="help-card-desc">{{item.desc}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 发布 FAB -->
  <view class="post-fab" bindtap="onPublishTap">
    <text class="post-fab-icon">✎</text>
    <text class="post-fab-text">发布宝贝</text>
  </view>

  <view class="page-bottom-space"></view>
</view>

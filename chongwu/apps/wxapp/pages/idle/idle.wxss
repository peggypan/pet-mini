page {
  background: var(--bg-primary);
}

/* 页面头部 */
.page-header {
  padding: 40rpx 20rpx 24rpx;
  background: var(--bg-white);
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--text-muted);
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: var(--bg-white);
  margin-bottom: 16rpx;
}

.filter-tabs {
  display: flex;
  gap: 12rpx;
  flex: 1;
  white-space: nowrap;
  overflow-x: auto;
}

.filter-tab {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  border-radius: 32rpx;
  background: var(--bg-primary);
  font-size: 24rpx;
  color: var(--text-secondary);
  border: 2rpx solid transparent;
  flex-shrink: 0;
}

.filter-tab.active {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  border-color: transparent;
}

.tab-emoji {
  font-size: 28rpx;
}

.filter-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 16rpx;
  margin-left: 12rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  flex-shrink: 0;
}

.filter-icon {
  font-size: 28rpx;
}

/* 商品网格 */
.goods-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 0 20rpx 20rpx;
}

.goods-card {
  background: var(--bg-white);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: var(--shadow-soft);
  border: 1rpx solid var(--border-color);
}

.goods-image {
  width: 100%;
  height: 240rpx;
  background: var(--bg-primary);
}

.goods-info {
  padding: 16rpx;
}

.goods-title {
  font-size: 26rpx;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.goods-meta {
  margin-bottom: 12rpx;
}

.goods-condition {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-bg);
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.goods-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goods-price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
}

.goods-want {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
  margin: 20rpx;
  background: var(--bg-white);
  border-radius: 24rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 加载状态 */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 60rpx;
}

.loading-icon {
  font-size: 40rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-muted);
}

/* 底部提示 */
.bottom-tip {
  text-align: center;
  padding: 40rpx;
  color: var(--text-light);
  font-size: 24rpx;
}

/* 发布按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 180rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-float);
  z-index: 9998;
}

.fab-icon {
  font-size: 32rpx;
}

.fab-text {
  font-size: 22rpx;
  margin-top: 4rpx;
}

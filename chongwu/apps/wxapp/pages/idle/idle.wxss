page {
  background: #EEF4FA;
}

.page {
  min-height: 100vh;
  padding: 8rpx 28rpx 0;
  box-sizing: border-box;
}

/* 促销 Banner */
.promo-banner {
  position: relative;
  display: flex;
  align-items: center;
  height: 220rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(255, 155, 122, 0.18);
}

.promo-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.promo-text-wrap {
  position: relative;
  z-index: 1;
  flex: 1;
  max-width: 58%;
}

.promo-text {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #5A3D32;
  line-height: 1.45;
}

.ban-tip {
  margin-bottom: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: rgba(255, 107, 138, 0.08);
  border: 1rpx solid rgba(255, 107, 138, 0.2);
}

.ban-tip-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #E05570;
  margin-bottom: 6rpx;
}

.ban-tip-desc {
  display: block;
  font-size: 22rpx;
  color: #8A5A62;
  line-height: 1.45;
}

/* 筛选 */
.filter-row {
  display: flex;
  margin-bottom: 28rpx;
}

.filter-pill {
  padding: 16rpx 32rpx;
  border-radius: 36rpx;
  background: transparent;
  margin-right: 16rpx;
}

.filter-pill text {
  font-size: 26rpx;
  color: #8A8A8A;
  font-weight: 500;
}

.filter-pill.active {
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(42, 42, 42, 0.08);
}

.filter-pill.active text {
  color: #2A2A2A;
  font-weight: 700;
}

/* 商品网格 */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.goods-card {
  width: 48%;
  margin-bottom: 16rpx;
  background: #ECEAE6;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(42, 42, 42, 0.04);
}

.goods-visual {
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E8E6E2;
}

.goods-img {
  width: 100%;
  height: 100%;
}

.goods-icon-wrap {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-icon {
  font-size: 80rpx;
  opacity: 0.85;
}

.goods-info {
  padding: 20rpx 22rpx 24rpx;
  background: #F3F1ED;
}

.goods-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #2A2A2A;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-condition {
  display: block;
  font-size: 22rpx;
  color: #8A8A8A;
  margin-bottom: 12rpx;
}

.condition-bar {
  display: flex;
}

.condition-seg {
  flex: 1;
  height: 8rpx;
  border-radius: 4rpx;
  background: #D8D5CF;
  margin-right: 6rpx;
}

.condition-seg:last-child {
  margin-right: 0;
}

.condition-seg.on {
  background: #6FCF97;
}

/* 空 / 加载 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 60rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 28rpx;
  margin-bottom: 24rpx;
}

.empty-emoji {
  font-size: 100rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 22rpx;
  color: #999;
}

.loading-box {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.loading-spinner {
  font-size: 36rpx;
  margin-right: 12rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-txt {
  font-size: 24rpx;
  color: #999;
}

/* 宠物求助 */
.help-section {
  margin-bottom: 20rpx;
}

.help-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.help-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2A2A2A;
}

.help-more {
  font-size: 36rpx;
  color: #C5C5C5;
}

.help-scroll {
  white-space: nowrap;
}

.help-card {
  display: inline-flex;
  flex-direction: column;
  width: 240rpx;
  padding: 24rpx;
  margin-right: 16rpx;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 24rpx;
  white-space: normal;
  box-shadow: 0 6rpx 20rpx rgba(42, 42, 42, 0.04);
  vertical-align: top;
}

.help-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
  background: #EDE8E0;
}

.help-emoji {
  font-size: 36rpx;
  margin-bottom: 12rpx;
}

.help-card-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #2A2A2A;
  margin-bottom: 6rpx;
}

.help-card-desc {
  display: block;
  font-size: 22rpx;
  color: #9A9A9A;
  line-height: 1.4;
}

/* 发布 FAB */
.post-fab {
  position: fixed;
  right: 36rpx;
  bottom: 200rpx;
  display: flex;
  align-items: center;
  padding: 18rpx 28rpx;
  background: #6FCF97;
  border-radius: 40rpx;
  box-shadow: 0 12rpx 32rpx rgba(111, 207, 151, 0.4);
  z-index: 100;
}

.post-fab-icon {
  font-size: 28rpx;
  color: #fff;
  margin-right: 10rpx;
  font-weight: 700;
}

.post-fab-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

.page-bottom-space {
  height: 200rpx;
}

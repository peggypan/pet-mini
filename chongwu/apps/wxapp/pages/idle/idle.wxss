/* 页面头部 */
.page-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 20rpx;
  background: linear-gradient(135deg, #FFE8D6 0%, #FFD6C6 100%);
  border-radius: 24rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 139, 123, 0.15);
}

.page-icon {
  font-size: 64rpx;
}

.header-content {
  flex: 1;
}

.page-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 分类筛选 - 温馨带图标 */
.category-tabs {
  background: var(--bg-white);
  padding: 24rpx 0;
  margin-bottom: 28rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 4rpx 20rpx rgba(199, 180, 168, 0.1);
}

.tabs-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--bg-primary);
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
  min-width: 120rpx;
}

.tab-item.active {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  box-shadow: 0 6rpx 20rpx rgba(255, 139, 123, 0.35);
  border-color: transparent;
}

.tab-icon {
  font-size: 36rpx;
}

.tab-text {
  font-size: 24rpx;
}

/* 闲置列表 */
.idle-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.idle-card {
  background: var(--bg-white);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-soft);
  border: 1rpx solid var(--border-color);
  transition: all 0.3s ease;
}

.idle-card:active {
  transform: scale(0.96);
  box-shadow: var(--shadow-card);
}

.idle-image {
  width: 100%;
  height: 280rpx;
  background: var(--bg-primary);
}

.idle-content {
  padding: 20rpx;
}

.idle-title {
  font-size: 28rpx;
  color: var(--text-primary);
  display: block;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.idle-meta {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.condition {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-bg);
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.district {
  font-size: 22rpx;
  color: var(--text-muted);
}

.idle-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-info {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.price {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--primary);
}

.price::before {
  content: '¥';
  font-size: 24rpx;
  margin-right: 2rpx;
}

.original-price {
  font-size: 24rpx;
  color: var(--text-muted);
  text-decoration: line-through;
}

.seller-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.seller-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--bg-primary);
  border: 2rpx solid var(--border-color);
}

.seller-name {
  font-size: 22rpx;
  color: var(--text-muted);
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 温馨浮动按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-float);
  transition: all 0.3s ease;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  z-index: 9998;
}

.fab:active {
  transform: scale(0.9);
}

.fab-icon {
  font-size: 32rpx;
}

.fab-text {
  font-size: 24rpx;
  margin-top: 4rpx;
}

/* 温馨空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  background: var(--bg-warm);
  border-radius: 28rpx;
  border: 2rpx dashed var(--border-light);
}

.empty-icon {
  font-size: 140rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 22rpx;
  color: var(--text-light);
}

/* 加载状态 */
.loading-text {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 40rpx;
  color: var(--text-muted);
  font-size: 26rpx;
}

.loading-text::before {
  content: '';
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid var(--border-color);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.no-more {
  text-align: center;
  padding: 40rpx;
  color: var(--text-light);
  font-size: 24rpx;
}

<!-- 首页：宠物标签 + 搜索 + 快捷入口 + 瀑布流 -->
<view class="page">
  <!-- 顶部宠物身份 -->
  <view class="pet-header">
    <image class="pet-avatar" src="{{pet.avatar}}" mode="aspectFill"></image>
    <view class="pet-pill">
      <text class="pet-paw">🐾</text>
      <text class="pet-name">{{pet.name}}</text>
      <text class="pet-meta">（{{pet.breed}} · {{pet.age}}）</text>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-row">
    <view class="search-box">
      <text class="search-ph">搜索</text>
      <view class="search-btn" bindtap="onSearchTap">
        <text class="search-btn-icon">⌕</text>
      </view>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="quick-block">
    <text class="quick-title">快捷操作</text>
    <view class="quick-row">
      <view class="quick-item" wx:for="{{quickActions}}" wx:key="id" bindtap="onQuickAction" data-type="{{item.type}}">
        <view class="quick-icon" style="background: {{item.bg}}">
          <text>{{item.icon}}</text>
        </view>
        <text class="quick-label">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 瀑布流内容 -->
  <view class="masonry">
    <view class="masonry-left">
      <view class="feed-card tall" bindtap="onFeedTap" data-id="{{feedMain.id}}" data-kind="{{feedMain.kind}}">
        <image class="feed-img" src="{{feedMain.image}}" mode="aspectFill"></image>
        <view class="feed-paw">
          <text>🐾</text>
        </view>
      </view>
    </view>
    <view class="masonry-right">
      <view
        class="feed-card short"
        wx:for="{{feedSide}}"
        wx:key="id"
        bindtap="onFeedTap"
        data-id="{{item.id}}"
        data-kind="{{item.kind}}"
      >
        <image class="feed-img" src="{{item.image}}" mode="aspectFill"></image>
        <view class="feed-caption">
          <text class="feed-cap-title">{{item.title}}</text>
          <view class="feed-stars" wx:if="{{item.rating}}">
            <text class="star" wx:for="{{item.stars}}" wx:for-item="s" wx:key="*this">★</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 热门服务 -->
  <view class="section-block" wx:if="{{services.length}}">
    <view class="section-header">
      <text class="section-title">热门服务</text>
      <text class="section-more" bindtap="onMoreServices">更多 ›</text>
    </view>
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="h-scroll">
      <view class="h-scroll-content">
        <view class="service-card-mini" wx:for="{{services}}" wx:key="id" bindtap="onServiceTap" data-id="{{item.id}}">
          <image src="{{item.coverUrls[0]}}" class="service-img-mini" mode="aspectFill"></image>
          <text class="service-name-mini">{{item.name}}</text>
          <text class="service-price-mini">¥{{item.price}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="page-bottom-space"></view>
</view>

<!-- 首页：对齐页面优化方案 -->
<view class="page">
  <!-- 品牌区 -->
  <view class="brand-block">
    <view class="brand-row">
      <view class="brand-mark">
        <text class="brand-mark-icon">🐾</text>
      </view>
      <view class="brand-text">
        <text class="brand-name">宠头头</text>
        <text class="brand-slogan">养宠一站式服务社区</text>
      </view>
      <view class="pet-pill" bindtap="onFamilyTap">
        <image class="pet-avatar" src="{{pet.avatar}}" mode="aspectFill"></image>
        <text class="pet-name">{{pet.name}}</text>
        <text class="pet-meta">{{pet.breed}} · {{pet.age}}</text>
      </view>
    </view>
  </view>

  <!-- 核心功能 6 宫格 -->
  <view class="module-block">
    <view class="module-header">
      <text class="module-title">养宠一站式服务社区</text>
      <text class="module-desc">服务 · 闲置 · 健康 · 社交 · 商城</text>
    </view>
    <view class="module-grid">
      <view
        class="module-card"
        wx:for="{{modules}}"
        wx:key="id"
        bindtap="onModuleTap"
        data-type="{{item.type}}"
      >
        <text class="module-badge" wx:if="{{item.badge}}">{{item.badge}}</text>
        <view class="module-icon-wrap">
          <text class="module-icon">{{item.icon}}</text>
        </view>
        <view class="module-info">
          <text class="module-name">{{item.name}}</text>
          <text class="module-tip">{{item.tip}}</text>
        </view>
        <text class="module-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 邀请裂变到账提示 -->
  <view class="invite-toast" wx:if="{{inviteRewardVisible}}" bindtap="onCloseInviteReward">
    <text class="invite-toast-title">🎉 好友邀请礼到账</text>
    <text class="invite-toast-desc">{{inviteRewardText}}</text>
  </view>

  <!-- 宠物交友：首页精简入口 -->
  <view class="social-block social-entry">
    <view class="social-header">
      <view class="social-title-wrap">
        <text class="social-title">宠物交友广场</text>
        <text class="social-sub">同城宠友 · 活动 · 寻宠互助</text>
      </view>
      <text class="social-more" bindtap="goSocial">全部 ›</text>
    </view>

    <view class="social-entry-actions">
      <view class="entry-chip" bindtap="onCreatePost">发帖</view>
      <view class="entry-chip" bindtap="onLostTap">寻宠招领</view>
      <view class="entry-chip" bindtap="goSocialEvents">同城活动</view>
    </view>

    <view class="post-list">
      <view
        class="post-card"
        wx:for="{{previewPosts}}"
        wx:key="id"
        bindtap="onPostTap"
        data-id="{{item.id}}"
      >
        <view class="post-head">
          <image class="post-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
          <view class="post-user">
            <view class="post-name-row">
              <text class="post-user-name">{{item.userName}} · {{item.petName}}</text>
              <text class="essence-tag" wx:if="{{item.essence}}">精华</text>
            </view>
            <text class="post-time">{{item.time}}</text>
          </view>
          <text class="post-enter">详情 ›</text>
        </view>
        <text class="post-content">{{item.content}}</text>
      </view>
    </view>

    <view class="social-entry-footer" bindtap="goSocial">
      <text>进入交友广场，查看更多动态</text>
    </view>
  </view>

  <!-- 宠物商城：首页精简入口 -->
  <view class="mall-block mall-entry">
    <view class="mall-header">
      <view class="mall-title-wrap">
        <text class="mall-title">宠物商城</text>
        <text class="mall-sub">用品零售 · 送检 · 营养咨询</text>
      </view>
      <text class="mall-more" bindtap="goMall">进店 ›</text>
    </view>

    <view class="mall-service-row">
      <view
        class="mall-service-card"
        wx:for="{{mallServices}}"
        wx:key="id"
        bindtap="onMallService"
        data-id="{{item.id}}"
      >
        <text class="mall-service-icon">{{item.icon}}</text>
        <view class="mall-service-info">
          <view class="mall-service-name-row">
            <text class="mall-service-name">{{item.name}}</text>
            <text class="mall-service-tag">{{item.tag}}</text>
          </view>
          <text class="mall-service-tip">{{item.tip}}</text>
          <text class="mall-service-price">¥{{item.price}} 起</text>
        </view>
      </view>
    </view>

    <view class="mall-preview-grid">
      <view
        class="mall-card"
        wx:for="{{previewProducts}}"
        wx:key="id"
        bindtap="onMallProduct"
        data-id="{{item.id}}"
      >
        <view class="mall-cover-wrap">
          <image class="mall-cover" src="{{item.cover}}" mode="aspectFill"></image>
          <text class="mall-tag" wx:if="{{item.tag}}">{{item.tag}}</text>
        </view>
        <text class="mall-name">{{item.name}}</text>
        <view class="mall-price-row">
          <text class="mall-price">¥{{item.price}}</text>
        </view>
      </view>
    </view>

    <view class="mall-entry-footer" bindtap="goMall">
      <text>进入商城，查看全部分类与商品</text>
    </view>
  </view>

  <!-- 热门服务（带保障标签） -->
  <view class="section-block" wx:if="{{services.length}}">
    <view class="section-header">
      <view class="section-title-wrap">
        <text class="section-title">宠友服务精选</text>
        <text class="section-sub">实名认证 · 意外险 · 全程拍照</text>
      </view>
      <text class="section-more" bindtap="onMoreServices">更多 ›</text>
    </view>
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="h-scroll">
      <view class="h-scroll-content">
        <view class="service-card-mini" wx:for="{{services}}" wx:key="id" bindtap="onServiceTap" data-id="{{item.id}}">
          <image src="{{item.coverUrls[0]}}" class="service-img-mini" mode="aspectFill"></image>
          <text class="service-name-mini">{{item.name}}</text>
          <text class="service-price-mini">¥{{item.price}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="page-bottom-space"></view>
</view>

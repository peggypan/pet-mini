page {
  background: #EEF4FA;
}

.page {
  min-height: 100vh;
  padding: 8rpx 28rpx 0;
  box-sizing: border-box;
}

/* 品牌区 */
.brand-block {
  padding: 8rpx 0 24rpx;
}

.brand-row {
  display: flex;
  align-items: center;
}

.brand-mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #8FD4B0 0%, #6FCF97 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(111, 207, 151, 0.3);
}

.brand-mark-icon {
  font-size: 36rpx;
}

.brand-text {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
}

.brand-name {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #1F3D2E;
  letter-spacing: 2rpx;
  line-height: 1.2;
  margin-bottom: 6rpx;
}

.brand-slogan {
  display: block;
  font-size: 22rpx;
  color: #6B8A7A;
  line-height: 1.4;
}

.pet-pill {
  display: flex;
  align-items: center;
  max-width: 280rpx;
  padding: 8rpx 16rpx 8rpx 8rpx;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 40rpx;
  box-shadow: 0 6rpx 20rpx rgba(42, 42, 42, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  flex-shrink: 0;
}

.pet-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #E2EBF4;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.pet-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #2A2A2A;
  margin-right: 6rpx;
  flex-shrink: 0;
}

.pet-meta {
  font-size: 20rpx;
  color: #8A8A8A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 搜索 */
.search-row {
  margin-bottom: 28rpx;
}

.search-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 12rpx 0 36rpx;
  background: #fff;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 28rpx rgba(42, 42, 42, 0.05);
}

.search-ph {
  font-size: 26rpx;
  color: #B0B0B0;
}

.search-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #6FCF97;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(111, 207, 151, 0.4);
}

.search-btn-icon {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
}

/* 核心功能模块 */
.module-block {
  margin-bottom: 32rpx;
}

.module-header {
  margin-bottom: 20rpx;
}

.module-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-bottom: 6rpx;
}

.module-desc {
  display: block;
  font-size: 22rpx;
  color: #8A8A8A;
}

.module-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.module-card {
  position: relative;
  width: 48%;
  margin-bottom: 16rpx;
  padding: 22rpx 18rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 8rpx 24rpx rgba(42, 42, 42, 0.04);
  border: 1rpx solid rgba(111, 207, 151, 0.18);
}

.module-badge {
  position: absolute;
  right: 12rpx;
  top: 10rpx;
  font-size: 18rpx;
  color: #fff;
  background: #6FCF97;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
  z-index: 1;
}

.module-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: rgba(111, 207, 151, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.module-icon {
  font-size: 32rpx;
}

.module-info {
  flex: 1;
  min-width: 0;
}

.module-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-bottom: 4rpx;
}

.module-tip {
  display: block;
  font-size: 20rpx;
  color: #7A7A7A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.module-arrow {
  font-size: 28rpx;
  color: #C5C5C5;
  margin-left: 4rpx;
  flex-shrink: 0;
}

/* 宠物交友 */
.social-block {
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 42, 42, 0.04);
}

.social-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.social-title-wrap {
  flex: 1;
  min-width: 0;
}

.social-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-bottom: 6rpx;
}

.social-sub {
  display: block;
  font-size: 22rpx;
  color: #8A8A8A;
}

.social-more {
  font-size: 24rpx;
  color: #4DB87A;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.social-entry-actions {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.entry-chip {
  padding: 12rpx 22rpx;
  border-radius: 28rpx;
  background: rgba(111, 207, 151, 0.16);
  color: #3FA06C;
  font-size: 24rpx;
  font-weight: 600;
}

.social-entry .post-card:last-child {
  border-bottom: none;
  padding-bottom: 8rpx;
}

.social-entry-footer {
  margin-top: 8rpx;
  padding: 20rpx 0 4rpx;
  text-align: center;
  font-size: 24rpx;
  color: #4DB87A;
  font-weight: 600;
  border-top: 1rpx solid #EAF1F6;
}

.lost-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(111, 207, 151, 0.2), rgba(255, 255, 255, 0.9));
  border: 1rpx solid rgba(111, 207, 151, 0.28);
}

.lost-banner-icon {
  font-size: 36rpx;
  margin-right: 4rpx;
  flex-shrink: 0;
}

.lost-banner-text {
  flex: 1;
  min-width: 0;
}

.lost-banner-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-bottom: 4rpx;
}

.lost-banner-desc {
  display: block;
  font-size: 20rpx;
  color: #7A7A7A;
  line-height: 1.4;
}

.lost-banner-go {
  font-size: 22rpx;
  color: #4DB87A;
  font-weight: 600;
  flex-shrink: 0;
  white-space: nowrap;
  margin-left: 0;
}

.social-actions {
  display: flex;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.social-action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.social-action-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, rgba(184, 232, 207, 0.55), rgba(255, 255, 255, 0.95));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-bottom: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(111, 207, 151, 0.15);
}

.social-action-name {
  font-size: 20rpx;
  color: #555;
  font-weight: 500;
}

.zone-scroll {
  white-space: nowrap;
  margin-bottom: 18rpx;
}

.zone-pill {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
  border-radius: 28rpx;
  background: #F3F7F5;
}

.zone-pill text {
  font-size: 22rpx;
  color: #6B6B6B;
}

.zone-pill.on {
  background: rgba(111, 207, 151, 0.22);
}

.zone-pill.on text {
  color: #2A2A2A;
  font-weight: 700;
}

.event-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.event-card {
  display: inline-flex;
  width: 460rpx;
  margin-right: 16rpx;
  padding: 14rpx;
  background: #F5FAF7;
  border-radius: 22rpx;
  vertical-align: top;
  white-space: normal;
  box-sizing: border-box;
}

.event-cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: #E2EBF4;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.event-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.event-tag {
  display: inline-block;
  align-self: flex-start;
  font-size: 18rpx;
  color: #4DB87A;
  background: rgba(111, 207, 151, 0.18);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-bottom: 6rpx;
}

.event-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-meta {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 2rpx;
}

.event-meta-item {
  font-size: 18rpx;
  color: #8A8A8A;
  margin-right: 12rpx;
}

.event-meta-item.warn {
  color: #E08A5A;
}

.rule-tip {
  font-size: 20rpx;
  color: #9A9A9A;
  background: #F7F9F8;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.invite-toast {
  margin: 0 0 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #6FCF97 0%, #4DB87A 100%);
  box-shadow: 0 10rpx 28rpx rgba(77, 184, 122, 0.28);
}

.invite-toast-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 4rpx;
}

.invite-toast-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.invite-banner {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 18rpx;
  background: rgba(111, 207, 151, 0.14);
  border: 1rpx solid rgba(111, 207, 151, 0.28);
}

.invite-banner-text {
  flex: 1;
  min-width: 0;
  padding-right: 8rpx;
}

.invite-banner-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-bottom: 6rpx;
}

.invite-banner-desc {
  display: block;
  font-size: 22rpx;
  color: #5A7A68;
  line-height: 1.45;
}

.invite-share-btn {
  margin: 0;
  padding: 0 18rpx !important;
  min-width: 0 !important;
  width: 140rpx !important;
  height: 60rpx;
  line-height: 1;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: #6FCF97;
  border-radius: 30rpx;
  border: none;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.invite-share-btn::after {
  border: none;
}

.share-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.share-panel {
  width: 100%;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  box-sizing: border-box;
}

.share-panel-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-bottom: 12rpx;
}

.share-panel-desc {
  display: block;
  font-size: 24rpx;
  color: #6A6A6A;
  line-height: 1.5;
  margin-bottom: 28rpx;
}

.share-panel-btn {
  margin: 0 0 16rpx;
  background: #6FCF97;
  color: #fff;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.share-panel-btn::after {
  border: none;
}

.share-panel-cancel {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #9A9A9A;
  padding: 8rpx 0;
}

.post-share-btn {
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
  border: none;
  display: inline-flex;
  align-items: center;
}

.post-share-btn::after {
  border: none;
}

.event-desc {
  display: none;
}

.post-list {
  display: flex;
  flex-direction: column;
}

.post-card {
  padding: 20rpx 0;
  border-top: 1rpx solid #EAF1F6;
}

.post-card:first-child {
  border-top: none;
  padding-top: 4rpx;
}

.post-head {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.post-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #E2EBF4;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.post-user {
  flex: 1;
  min-width: 0;
}

.post-enter {
  font-size: 22rpx;
  color: #4DB87A;
  flex-shrink: 0;
  margin-left: 8rpx;
}

.post-user-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #2A2A2A;
  margin-bottom: 4rpx;
}

.post-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 4rpx;
}

.post-name-row .post-user-name {
  margin-bottom: 0;
  margin-right: 10rpx;
}

.essence-tag {
  font-size: 18rpx;
  color: #fff;
  background: #6FCF97;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.post-empty {
  padding: 32rpx 0 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9A9A9A;
}

.post-time {
  display: block;
  font-size: 20rpx;
  color: #9A9A9A;
}

.post-content {
  display: block;
  font-size: 26rpx;
  color: #3A3A3A;
  line-height: 1.55;
  margin-bottom: 14rpx;
  white-space: pre-wrap;
  word-break: break-word;
  max-height: 160rpx;
  overflow: hidden;
}

.post-image {
  width: 100%;
  height: 280rpx;
  border-radius: 20rpx;
  background: #E2EBF4;
  margin-bottom: 14rpx;
}

.post-footer {
  display: flex;
  align-items: center;
}

.post-btn {
  display: flex;
  align-items: center;
  margin-right: 36rpx;
  font-size: 24rpx;
  color: #6B6B6B;
}

.post-btn-num {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #8A8A8A;
}

/* 宠物商城 */
.mall-block {
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 42, 42, 0.04);
}

.mall-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.mall-title-wrap {
  flex: 1;
  min-width: 0;
}

.mall-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-bottom: 6rpx;
}

.mall-sub {
  display: block;
  font-size: 22rpx;
  color: #8A8A8A;
}

.mall-more {
  font-size: 24rpx;
  color: #4DB87A;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.mall-preview-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 0;
}

.mall-entry .mall-card {
  width: 48%;
  margin-bottom: 0;
}

.mall-entry .mall-cover-wrap {
  height: 180rpx;
}

.mall-entry .mall-name {
  padding: 12rpx 12rpx 4rpx;
}

.mall-entry .mall-price-row {
  padding: 0 12rpx 12rpx;
}

.mall-entry-footer {
  margin-top: 16rpx;
  padding: 16rpx 0 0;
  text-align: center;
  font-size: 24rpx;
  color: #4DB87A;
  font-weight: 600;
  border-top: 1rpx solid #EAF1F6;
}

.mall-service-row {
  margin-bottom: 20rpx;
}

.mall-service-card {
  display: flex;
  align-items: center;
  padding: 18rpx;
  margin-bottom: 12rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(111, 207, 151, 0.14), #F7FAF8);
  border: 1rpx solid rgba(111, 207, 151, 0.2);
}

.mall-service-icon {
  font-size: 40rpx;
  margin-right: 14rpx;
}

.mall-service-info {
  flex: 1;
  min-width: 0;
}

.mall-service-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 4rpx;
}

.mall-service-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-right: 10rpx;
}

.mall-service-tag {
  font-size: 18rpx;
  color: #fff;
  background: #6FCF97;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.mall-service-tip {
  display: block;
  font-size: 20rpx;
  color: #7A7A7A;
  margin-bottom: 4rpx;
}

.mall-service-price {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #4DB87A;
}

.mall-section-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-bottom: 14rpx;
}

.mall-cats {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.mall-cat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  border-radius: 18rpx;
}

.mall-cat.on {
  background: rgba(111, 207, 151, 0.16);
}

.mall-cat-icon {
  font-size: 32rpx;
  margin-bottom: 6rpx;
}

.mall-cat-name {
  font-size: 22rpx;
  color: #666;
  font-weight: 500;
}

.mall-cat.on .mall-cat-name {
  color: #2A2A2A;
  font-weight: 700;
}

.mall-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.mall-card {
  width: 48%;
  margin-bottom: 16rpx;
  background: #F7FAF8;
  border-radius: 20rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.mall-cover-wrap {
  position: relative;
  width: 100%;
  height: 200rpx;
  background: #E2EBF4;
}

.mall-cover {
  width: 100%;
  height: 100%;
}

.mall-tag {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  font-size: 18rpx;
  color: #fff;
  background: rgba(77, 184, 122, 0.92);
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.mall-name {
  display: block;
  padding: 14rpx 14rpx 6rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #2A2A2A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mall-price-row {
  display: flex;
  align-items: baseline;
  padding: 0 14rpx;
}

.mall-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #4DB87A;
  margin-right: 8rpx;
}

.mall-origin {
  font-size: 20rpx;
  color: #B0B0B0;
  text-decoration: line-through;
}

.mall-sales {
  display: block;
  padding: 4rpx 14rpx 14rpx;
  font-size: 20rpx;
  color: #9A9A9A;
}

/* 发现流标题 */
.feed-header {
  margin-bottom: 18rpx;
}

.feed-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-bottom: 6rpx;
}

.feed-sub {
  display: block;
  font-size: 22rpx;
  color: #8A8A8A;
}

/* 瀑布流 */
.masonry {
  display: flex;
  margin-bottom: 28rpx;
}

.masonry-left {
  flex: 1.15;
  margin-right: 16rpx;
}

.masonry-right {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.feed-card {
  position: relative;
  border-radius: 28rpx;
  overflow: hidden;
  background: #E2EBF4;
  box-shadow: 0 10rpx 28rpx rgba(42, 42, 42, 0.06);
}

.feed-card.tall {
  height: 520rpx;
}

.feed-card.short {
  height: 248rpx;
  margin-bottom: 16rpx;
}

.feed-card.short:last-child {
  margin-bottom: 0;
}

.feed-img {
  width: 100%;
  height: 100%;
}

.feed-paw {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #6FCF97;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  box-shadow: 0 6rpx 16rpx rgba(111, 207, 151, 0.45);
}

.feed-caption {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 18rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.45));
}

.feed-cap-title {
  display: block;
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

.feed-stars {
  margin-top: 4rpx;
}

.star {
  font-size: 18rpx;
  color: #FFD27D;
  margin-right: 2rpx;
}

/* 区块 */
.section-block {
  background: rgba(255, 255, 255, 0.7);
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 42, 42, 0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title-wrap {
  flex: 1;
  min-width: 0;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2A2A2A;
}

.section-sub {
  display: block;
  font-size: 20rpx;
  color: #9A9A9A;
  margin-top: 4rpx;
}

.section-more {
  font-size: 24rpx;
  color: #9A9A9A;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.h-scroll {
  white-space: nowrap;
}

.h-scroll-content {
  display: inline-flex;
}

.service-card-mini {
  width: 180rpx;
  margin-right: 16rpx;
  white-space: normal;
}

.service-img-mini {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  background: #E2EBF4;
  margin-bottom: 12rpx;
}

.service-name-mini {
  display: block;
  font-size: 24rpx;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-price-mini {
  font-size: 26rpx;
  color: #4DB87A;
  font-weight: 700;
}

.page-bottom-space {
  height: 180rpx;
}

/* 温馨欢迎区 */
.welcome-banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 28rpx;
  background: linear-gradient(135deg, #FFE8D6 0%, #FFD6C6 100%);
  border-radius: 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 139, 123, 0.15);
}

.welcome-emoji {
  font-size: 72rpx;
}

.welcome-content {
  flex: 1;
}

.welcome-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.welcome-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 分类入口 - 圆润可爱 */
.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
  padding: 8rpx 8rpx 32rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  transition: transform 0.3s ease;
}

.category-item:active {
  transform: scale(0.92);
}

.category-icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE8D6 0%, #FFD6C6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 139, 123, 0.2);
  border: 3rpx solid rgba(255, 255, 255, 0.8);
}

.category-name {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 400;
}

/* 区块标题 */
.section-header {
  margin-bottom: 24rpx;
}

.section-title-wrapper {
  flex: 1;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
}

.section-subtitle {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
  display: block;
}

.more-link {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 500;
  padding: 8rpx 16rpx;
  background: var(--primary-bg);
  border-radius: 24rpx;
}

/* 服务列表 - 温馨卡片 */
.service-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.service-item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: var(--bg-warm);
  border-radius: 20rpx;
  border: 1rpx solid var(--border-color);
  transition: all 0.3s ease;
}

.service-item:active {
  background: #FFF5ED;
  transform: scale(0.98);
}

.service-cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  background: var(--bg-primary);
}

.service-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 8rpx 0;
}

.service-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.4;
}

.service-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.service-merchant {
  font-size: 24rpx;
  color: var(--text-muted);
}

.service-price {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--primary);
}

.service-price::before {
  content: '¥';
  font-size: 24rpx;
  margin-right: 2rpx;
}

/* 闲置列表 */
.idle-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.idle-item {
  background: var(--bg-warm);
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--border-color);
  transition: all 0.3s ease;
}

.idle-item:active {
  transform: scale(0.96);
}

.idle-image {
  width: 100%;
  height: 240rpx;
  background: var(--bg-primary);
}

.idle-info {
  padding: 20rpx;
}

.idle-title {
  font-size: 28rpx;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.idle-price {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary);
}

.idle-price::before {
  content: '¥';
  font-size: 22rpx;
  margin-right: 2rpx;
}

/* 空状态 */
.empty-placeholder {
  padding: 60rpx 40rpx;
  text-align: center;
  background: var(--bg-warm);
  border-radius: 24rpx;
  border: 2rpx dashed var(--border-light);
}

.empty-placeholder-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
  display: block;
}

.empty-placeholder-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  display: block;
}

.empty-placeholder-tip {
  font-size: 24rpx;
  color: var(--text-muted);
  display: block;
}

/* 底部温馨语 */
.warm-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx;
  margin-top: 20rpx;
}

.warm-icon {
  font-size: 36rpx;
}

.warm-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

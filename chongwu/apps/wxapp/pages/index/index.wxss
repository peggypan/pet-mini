page {
  background: #EEF4FA;
}

.page {
  min-height: 100vh;
  padding: 8rpx 28rpx 0;
  box-sizing: border-box;
}

/* 顶部宠物身份 */
.pet-header {
  display: flex;
  align-items: center;
  padding: 12rpx 0 28rpx;
}

.pet-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #EDE8E0;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.pet-pill {
  display: flex;
  align-items: center;
  padding: 14rpx 28rpx;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 40rpx;
  box-shadow: 0 6rpx 20rpx rgba(42, 42, 42, 0.05);
}

.pet-paw {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.pet-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2A2A2A;
}

.pet-meta {
  font-size: 24rpx;
  color: #8A8A8A;
  margin-left: 4rpx;
}

/* 搜索 */
.search-row {
  margin-bottom: 36rpx;
}

.search-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 12rpx 0 36rpx;
  background: #fff;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 28rpx rgba(42, 42, 42, 0.05);
}

.search-ph {
  font-size: 28rpx;
  color: #B0B0B0;
}

.search-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #6FCF97;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(111, 207, 151, 0.4);
}

.search-btn-icon {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
}

/* 快捷操作 */
.quick-block {
  margin-bottom: 32rpx;
}

.quick-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-bottom: 28rpx;
}

.quick-row {
  display: flex;
  justify-content: space-between;
  padding: 0 8rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
}

.quick-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 6rpx 18rpx rgba(42, 42, 42, 0.05);
}

.quick-label {
  font-size: 24rpx;
  color: #555;
  font-weight: 500;
}

/* 瀑布流 */
.masonry {
  display: flex;
  margin-bottom: 28rpx;
}

.masonry-left {
  flex: 1.15;
  margin-right: 16rpx;
}

.masonry-right {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.feed-card {
  position: relative;
  border-radius: 28rpx;
  overflow: hidden;
  background: #E2EBF4;
  box-shadow: 0 10rpx 28rpx rgba(42, 42, 42, 0.06);
}

.feed-card.tall {
  height: 520rpx;
}

.feed-card.short {
  height: 248rpx;
  margin-bottom: 16rpx;
}

.feed-card.short:last-child {
  margin-bottom: 0;
}

.feed-img {
  width: 100%;
  height: 100%;
}

.feed-paw {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #6FCF97;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  box-shadow: 0 6rpx 16rpx rgba(111, 207, 151, 0.45);
}

.feed-caption {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 18rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.45));
}

.feed-cap-title {
  display: block;
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

.feed-stars {
  margin-top: 4rpx;
}

.star {
  font-size: 18rpx;
  color: #FFD27D;
  margin-right: 2rpx;
}

/* 区块 */
.section-block {
  background: rgba(255, 255, 255, 0.7);
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 42, 42, 0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2A2A2A;
}

.section-more {
  font-size: 24rpx;
  color: #9A9A9A;
}

.h-scroll {
  white-space: nowrap;
}

.h-scroll-content {
  display: inline-flex;
}

.service-card-mini {
  width: 180rpx;
  margin-right: 16rpx;
  white-space: normal;
}

.service-img-mini {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  background: #E2EBF4;
  margin-bottom: 12rpx;
}

.service-name-mini {
  display: block;
  font-size: 24rpx;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-price-mini {
  font-size: 26rpx;
  color: #4DB87A;
  font-weight: 700;
}

.page-bottom-space {
  height: 180rpx;
}

page {
  background: var(--bg-primary);
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx;
  background: var(--bg-white);
}

.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: var(--bg-primary);
  border-radius: 48rpx;
}

.search-icon {
  font-size: 32rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: var(--text-muted);
}

/* 分类图标滚动 */
.category-scroll {
  background: var(--bg-white);
  padding: 20rpx 0;
  margin-bottom: 16rpx;
}

.category-scroll-inner {
  display: flex;
  padding: 0 20rpx;
  white-space: nowrap;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 32rpx;
}

.category-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE8D6 0%, #FFD6C6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 139, 123, 0.15);
}

.category-name {
  font-size: 24rpx;
  color: var(--text-primary);
}

/* 横幅轮播 */
.banner-section {
  padding: 0 20rpx 20rpx;
}

.banner-swiper {
  height: 280rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.banner-item {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  padding: 40rpx;
  border-radius: 24rpx;
}

.banner-emoji {
  font-size: 120rpx;
  margin-right: 24rpx;
}

.banner-content {
  flex: 1;
}

.banner-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: white;
  margin-bottom: 8rpx;
}

.banner-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 区块 */
.section {
  background: var(--bg-white);
  margin: 0 20rpx 20rpx;
  border-radius: 24rpx;
  padding: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.section-more {
  font-size: 26rpx;
  color: var(--primary);
}

/* 服务横向滚动 */
.service-scroll {
  white-space: nowrap;
}

.service-scroll-inner {
  display: flex;
  gap: 20rpx;
}

.service-card-small {
  display: inline-block;
  width: 200rpx;
  white-space: normal;
}

.service-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  background: var(--bg-primary);
  margin-bottom: 12rpx;
}

.service-name-small {
  display: block;
  font-size: 26rpx;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-price-small {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 600;
}

.service-card-small.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 260rpx;
}

.empty-icon-small {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.empty-text-small {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 闲置网格 */
.idle-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.idle-card {
  background: var(--bg-warm);
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--border-color);
}

.idle-image {
  width: 100%;
  height: 220rpx;
  background: var(--bg-primary);
}

.idle-content {
  padding: 16rpx;
}

.idle-title {
  font-size: 26rpx;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.idle-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.idle-price {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 600;
}

.idle-likes {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 空状态 */
.empty-grid {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-muted);
}

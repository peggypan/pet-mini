page {
  background: linear-gradient(180deg, #E8F4FF 0%, #F5F8FC 280rpx, #F5F8FC 100%);
}

.page {
  padding: 20rpx 28rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.tabs {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.tab {
  display: inline-block;
  padding: 12rpx 28rpx 20rpx;
  margin-right: 8rpx;
  font-size: 28rpx;
  color: #999999;
  position: relative;
  background: transparent;
}

.tab.on {
  color: #1A1A1A;
  font-weight: 800;
}

.tab.on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  transform: translateX(-50%);
  width: 48rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #7EC8FF;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.act-btn {
  flex: 1;
  margin: 0;
  height: 80rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #5BB8FF 0%, #4DA7F8 100%);
  color: #1A1A1A;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(77, 167, 248, 0.3);
}

.act-btn.outline {
  background: #FFFFFF;
  color: #1A1A1A;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  font-weight: 600;
}

.act-btn::after {
  border: none;
}

.event-card {
  display: flex;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.cover {
  width: 128rpx;
  height: 128rpx;
  border-radius: 20rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.source {
  font-size: 20rpx;
  color: #1E88E5;
  font-weight: 600;
}

.title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin: 6rpx 0;
}

.meta {
  display: block;
  font-size: 22rpx;
  color: #999999;
}

.map-section {
  position: relative;
}

.map-fab {
  position: absolute;
  right: 8rpx;
  top: 248rpx;
  z-index: 6;
}

.map-fab-open {
  z-index: 30;
}

.map-filter-tip {
  font-size: 22rpx;
  color: #2e7d5b;
  font-weight: 600;
  margin: -8rpx 4rpx 12rpx;
}

.map-empty {
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  background: #ffffff;
  border-radius: 28rpx;
  margin-bottom: 16rpx;
}

.map-preview-wrap {
  position: relative;
  height: 360rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
}

.map-preview {
  width: 100%;
  height: 100%;
}

.map-preview-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.map-preview-tag {
  font-size: 22rpx;
  color: #fff;
  background: rgba(0, 145, 255, 0.85);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 700;
}

.map-preview-tip {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

.map-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.map-actions .act-btn {
  flex: 1;
}

.map-tip {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.map-card {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.map-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.map-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.map-type {
  font-size: 22rpx;
  color: #999999;
}

.map-meta {
  display: block;
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 10rpx;
}

.map-allow {
  font-size: 22rpx;
}

.map-allow.ok {
  color: #1E88E5;
  font-weight: 600;
}

.map-allow.no {
  color: #1E88E5;
}

.nav-btn {
  margin-top: 12rpx;
  background: #F5F8FC;
  color: #1A1A1A;
  border-radius: 999rpx;
}


.map-allow.danger {
  color: #E5484D;
  font-weight: 700;
}

<!-- 寻宠 / 招领发布页 -->
<view class="page">
  <view class="tip-card">
    <text class="tip-title">同城互助 · 禁止活体交易</text>
    <text class="tip-desc">请选择走失/发现地点，上传照片或视频，并分享给同城好友扩大寻找范围。</text>
  </view>

  <view class="card">
    <text class="label">信息类型</text>
    <view class="type-row">
      <view
        class="type-item {{postType === 'lost' ? 'on' : ''}}"
        bindtap="onType"
        data-type="lost"
      >
        <text class="type-name">寻宠</text>
        <text class="type-sub">我家毛孩子走失了</text>
      </view>
      <view
        class="type-item {{postType === 'found' ? 'on' : ''}}"
        bindtap="onType"
        data-type="found"
      >
        <text class="type-name">招领</text>
        <text class="type-sub">捡到待认领的宠物</text>
      </view>
    </view>

    <text class="label">宠物类型</text>
    <view class="zone-row">
      <view
        class="zone {{zone === item.id ? 'on' : ''}}"
        wx:for="{{zones}}"
        wx:key="id"
        bindtap="onZone"
        data-id="{{item.id}}"
      >{{item.name}}</view>
    </view>

    <text class="label">发生地点 *</text>
    <view class="loc-picker" bindtap="onChooseLocation">
      <view class="loc-main" wx:if="{{geoLocation}}">
        <text class="loc-name">{{geoLocation.name || '已选位置'}}</text>
        <text class="loc-addr">{{geoLocation.address}}</text>
        <text class="loc-tip">点击重新选择 · 点击查看地图</text>
      </view>
      <view class="loc-empty" wx:else>
        <text class="loc-empty-text">高德地图选点 · 走失/发现地点</text>
      </view>
    </view>
    <view class="loc-actions" wx:if="{{geoLocation}}">
      <text class="loc-action" catchtap="onOpenLocation">查看地图</text>
      <text class="loc-action danger" catchtap="onClearLocation">清除</text>
    </view>
    <input
      class="input"
      placeholder="补充描述（如：XX小区南门、靠近便利店）"
      placeholder-class="ph"
      value="{{location}}"
      bindinput="onField"
      data-field="location"
    />

    <text class="label">联系方式</text>
    <input
      class="input"
      type="number"
      maxlength="11"
      placeholder="手机号，方便同城联系"
      placeholder-class="ph"
      value="{{phone}}"
      bindinput="onField"
      data-field="phone"
    />

    <text class="label">详细描述 *</text>
    <textarea
      class="textarea"
      maxlength="500"
      placeholder="{{placeholder}}"
      placeholder-class="ph"
      value="{{content}}"
      bindinput="onField"
      data-field="content"
    ></textarea>
    <text class="count">{{content.length}}/500</text>

    <text class="label">照片 / 视频</text>
    <text class="label-tip">{{mediaLimitHint}}（{{mediaSummary}}）</text>

    <view class="media-grid" wx:if="{{mediaList.length}}">
      <view
        class="media-item"
        wx:for="{{mediaList}}"
        wx:key="index"
        data-index="{{index}}"
        bindtap="onPreviewMedia"
      >
        <image
          class="media-thumb"
          src="{{item.type === 'image' ? item.url : (item.poster || item.url)}}"
          mode="aspectFill"
        ></image>
        <view class="video-badge" wx:if="{{item.type === 'video'}}">
          <text>▶ 视频</text>
        </view>
        <view class="media-del" catchtap="onRemoveMedia" data-index="{{index}}">×</view>
      </view>
      <view class="media-add" wx:if="{{mediaCanAdd}}" bindtap="onChooseMedia">
        <text class="add-icon">＋</text>
      </view>
    </view>

    <view class="media-empty" wx:elif="{{mediaCanAdd}}" bindtap="onChooseMedia">
      <text class="empty-icon">📷</text>
      <text class="empty-text">添加宠物照片或视频</text>
    </view>
  </view>

  <view class="bottom">
    <button class="share-btn" open-type="share">分享给好友</button>
    <button class="submit" bindtap="onSubmit">发布到交友广场</button>
  </view>
</view>


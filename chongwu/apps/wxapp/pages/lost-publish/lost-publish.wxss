page {
  background: #EEF4FA;
}

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.tip-card {
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: rgba(126, 200, 255, 0.15);
  border: 1rpx solid rgba(77, 167, 248, 0.25);
}

.tip-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 6rpx;
}

.tip-desc {
  display: block;
  font-size: 22rpx;
  color: #5A7A68;
  line-height: 1.45;
}

.card {
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 28rpx rgba(42, 42, 42, 0.05);
}

.label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #4A5A52;
  margin-bottom: 12rpx;
}

.label-tip {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.type-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.type-item {
  flex: 1;
  padding: 20rpx 18rpx;
  border-radius: 18rpx;
  background: #F3F7F5;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.type-item.on {
  background: rgba(126, 200, 255, 0.2);
  border-color: rgba(77, 167, 248, 0.45);
}

.type-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 4rpx;
}

.type-sub {
  display: block;
  font-size: 20rpx;
  color: #8A9A90;
}

.zone-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.zone {
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  background: #F3F7F5;
  font-size: 24rpx;
  color: #666;
}

.zone.on {
  background: rgba(126, 200, 255, 0.25);
  color: #1A1A1A;
  font-weight: 600;
}

.loc-picker {
  padding: 24rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  background: #F3F7F5;
  border: 2rpx dashed rgba(77, 167, 248, 0.35);
}

.loc-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.loc-addr {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.loc-tip {
  display: block;
  font-size: 22rpx;
  color: #1E88E5;
  font-weight: 600;
}

.loc-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.loc-empty-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.loc-empty-text {
  font-size: 26rpx;
  color: #666;
}

.loc-actions {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.loc-action {
  font-size: 24rpx;
  color: #1E88E5;
  font-weight: 600;
}

.loc-action.danger {
  color: #E65100;
}

.input {
  width: 100%;
  height: 88rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 28rpx;
  border-radius: 16rpx;
  background: #F3F7F5;
  font-size: 28rpx;
  color: #1A1A1A;
  box-sizing: border-box;
  line-height: 36rpx;
}

.textarea {
  width: 100%;
  min-height: 220rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: #F3F7F5;
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.5;
  box-sizing: border-box;
}

.ph {
  color: #B0BEC5;
}

.count {
  display: block;
  text-align: right;
  font-size: 20rpx;
  color: #9A9A9A;
  margin: 8rpx 0 28rpx;
}

.tool-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tool-btn {
  flex: 1;
  margin: 0;
  height: 76rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  border: none;
  background: rgba(126, 200, 255, 0.25);
  color: #1A1A1A;
  font-size: 26rpx;
  font-weight: 600;
}

.tool-btn::after { border: none; }

.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.media-item {
  position: relative;
  width: 196rpx;
  height: 196rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.media-thumb {
  width: 100%;
  height: 100%;
  background: #E8F0F6;
}

.video-badge {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 8rpx 12rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
  font-size: 20rpx;
  color: #fff;
}

.media-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 28rpx;
}

.media-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 180rpx;
  margin-bottom: 8rpx;
  background: #F5F8FC;
  border-radius: 16rpx;
  border: 2rpx dashed rgba(77, 167, 248, 0.35);
}

.empty-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 24rpx;
  color: #999;
}

.bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(238, 244, 250, 0.96);
  box-shadow: 0 -8rpx 24rpx rgba(42, 42, 42, 0.04);
}

.share-btn,
.submit {
  flex: 1;
  margin: 0;
  height: 88rpx;
  line-height: 1;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.share-btn::after,
.submit::after {
  border: none;
}

.share-btn {
  background: #fff;
  color: #1A1A1A;
  border: 2rpx solid rgba(77, 167, 248, 0.45);
}

.submit {
  background: linear-gradient(135deg, #5BB8FF, #4DA7F8);
  color: #1A1A1A;
}

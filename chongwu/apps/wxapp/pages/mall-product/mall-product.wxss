page { background: #EEF4FA; }
.page { padding-bottom: 160rpx; }
.cover {
  width: 100%;
  height: 520rpx;
  background: #E2EBF4;
}
.card {
  margin: 20rpx 28rpx;
  padding: 24rpx;
  background: rgba(255,255,255,0.92);
  border-radius: 24rpx;
}
.tag-row { display: flex; align-items: center; margin-bottom: 10rpx; }
.tag {
  font-size: 20rpx;
  color: #fff;
  background: #6FCF97;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}
.sales { font-size: 22rpx; color: #9A9A9A; }
.name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-bottom: 12rpx;
}
.price-row { margin-bottom: 12rpx; }
.price { font-size: 40rpx; font-weight: 700; color: #4DB87A; margin-right: 12rpx; }
.origin { font-size: 24rpx; color: #B0B0B0; text-decoration: line-through; }
.desc { font-size: 24rpx; color: #6A6A6A; line-height: 1.5; }

/* 地址卡片 */
.address-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(111, 207, 151, 0.08) 0%, rgba(255, 255, 255, 1) 100%);
  border: 2rpx solid #6FCF97;
  cursor: pointer;
}

.address-header {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.address-info {
  flex: 1;
}

.contact-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.contact-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2A2A2A;
}

.contact-phone {
  font-size: 26rpx;
  color: #666;
}

.default-tag {
  background: linear-gradient(135deg, #6FCF97 0%, #4DB87A 100%);
  color: white;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.address-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.arrow {
  font-size: 40rpx;
  color: #9A9A9A;
  margin-left: 16rpx;
}

.address-empty {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 24rpx;
  gap: 8rpx;
}

.empty-icon {
  font-size: 48rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #2A2A2A;
  font-weight: 500;
}

.empty-tip {
  font-size: 24rpx;
  color: #9A9A9A;
}

.label { display: block; font-size: 24rpx; color: #666; margin-bottom: 10rpx; }
.input {
  padding: 16rpx 18rpx;
  background: #F5F8F6;
  border-radius: 14rpx;
  font-size: 26rpx;
  margin-bottom: 14rpx;
}
.input:last-child { margin-bottom: 0; }
.bottom {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.95);
  display: flex;
  align-items: center;
  box-shadow: 0 -8rpx 24rpx rgba(42,42,42,0.06);
}
.total { flex: 1; font-size: 32rpx; font-weight: 700; color: #4DB87A; }
.buy {
  margin: 0;
  padding: 0 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #6FCF97;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}
.buy::after { border: none; }

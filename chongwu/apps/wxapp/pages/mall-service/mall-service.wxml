<!-- 商城差异化服务：食品送检 / 营养咨询 -->
<view class="page">
  <view class="hero {{serviceType}}">
    <text class="hero-tag">{{service.tag}}</text>
    <text class="hero-icon">{{service.icon}}</text>
    <text class="hero-title">{{service.name}}</text>
    <text class="hero-desc">{{service.tip}}</text>
    <text class="hero-price">¥{{service.price}} 起</text>
  </view>

  <view class="card">
    <text class="card-title">服务说明</text>
    <view class="point" wx:for="{{service.points}}" wx:key="*this">
      <text class="point-dot">•</text>
      <text class="point-text">{{item}}</text>
    </view>
  </view>

  <view class="card">
    <text class="card-title">适用对象</text>
    <text class="card-body">{{service.audience}}</text>
  </view>

  <view class="card">
    <text class="card-title">预约信息</text>
    <view class="form-row">
      <text class="form-label">联系人</text>
      <input class="form-input" placeholder="怎么称呼您" value="{{contactName}}" bindinput="onInput" data-field="contactName" />
    </view>
    <view class="form-row">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" placeholder="便于回访确认" value="{{phone}}" bindinput="onInput" data-field="phone" />
    </view>
    <view class="form-row">
      <text class="form-label">备注</text>
      <textarea class="form-textarea" placeholder="例如：猫粮品牌、已有症状、期望咨询方向…" value="{{remark}}" bindinput="onInput" data-field="remark" />
    </view>
  </view>

  <view class="bottom-bar">
    <view class="price-wrap">
      <text class="price-label">预计费用</text>
      <text class="price-val">¥{{service.price}}</text>
    </view>
    <button class="book-btn" bindtap="onSubmit">立即预约</button>
  </view>
</view>

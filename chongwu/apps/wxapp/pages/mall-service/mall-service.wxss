page {
  background: #EEF4FA;
}

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 180rpx;
  box-sizing: border-box;
}

.hero {
  padding: 36rpx 28rpx;
  border-radius: 28rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(145deg, #B8E8CF 0%, #8FD4B0 100%);
  box-shadow: 0 12rpx 32rpx rgba(111, 207, 151, 0.25);
}

.hero.s2 {
  background: linear-gradient(145deg, #FFE0C8 0%, #FFC9A3 100%);
  box-shadow: 0 12rpx 32rpx rgba(255, 155, 122, 0.22);
}

.hero-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.18);
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  margin-bottom: 16rpx;
}

.hero-icon {
  display: block;
  font-size: 56rpx;
  margin-bottom: 10rpx;
}

.hero-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1F3D2E;
  margin-bottom: 8rpx;
}

.hero-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(31, 61, 46, 0.75);
  margin-bottom: 14rpx;
}

.hero-price {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1F3D2E;
}

.card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 42, 42, 0.04);
}

.card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-bottom: 14rpx;
}

.point {
  display: flex;
  margin-bottom: 10rpx;
}

.point-dot {
  color: #4DB87A;
  margin-right: 10rpx;
  font-size: 26rpx;
}

.point-text {
  flex: 1;
  font-size: 24rpx;
  color: #555;
  line-height: 1.5;
}

.card-body {
  font-size: 24rpx;
  color: #555;
  line-height: 1.5;
}

.form-row {
  margin-bottom: 18rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.form-input,
.form-textarea {
  width: 100%;
  padding: 16rpx 18rpx;
  background: #F5F8F6;
  border-radius: 14rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.form-textarea {
  min-height: 140rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  display: flex;
  align-items: center;
  box-shadow: 0 -8rpx 24rpx rgba(42, 42, 42, 0.06);
}

.price-wrap {
  flex: 1;
}

.price-label {
  display: block;
  font-size: 20rpx;
  color: #9A9A9A;
}

.price-val {
  font-size: 36rpx;
  font-weight: 700;
  color: #4DB87A;
}

.book-btn {
  margin: 0;
  padding: 0 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #6FCF97;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.book-btn::after {
  border: none;
}

@import "../adopt-publish/adopt-publish.wxss";
.picker { background: #F5F8FC; border-radius: 14rpx; margin-bottom: 8rpx; }
.switch-row { display: flex; justify-content: space-between; align-items: center; margin: 16rpx 0; font-size: 26rpx; }

.loc-pick {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: rgba(0, 145, 255, 0.08);
  border-radius: 16rpx;
  border: 2rpx dashed rgba(0, 145, 255, 0.35);
}

.loc-icon { font-size: 36rpx; margin-right: 16rpx; }
.loc-info { flex: 1; min-width: 0; }
.loc-title { display: block; font-size: 28rpx; font-weight: 700; color: #1A1A1A; margin-bottom: 6rpx; }
.loc-addr { display: block; font-size: 24rpx; color: #666; line-height: 1.4; }
.loc-arrow { font-size: 32rpx; color: #0091FF; }

.field-hint {
  display: block;
  margin: -4rpx 0 12rpx;
  font-size: 22rpx;
  color: #888888;
  line-height: 1.45;
}

.scene-grid {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.scene-item {
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
}

.scene-thumb {
  background: #e8f4ff;
}

.scene-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.scene-add {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f8fc;
  border-radius: 14rpx;
  border: 2rpx dashed rgba(77, 167, 248, 0.35);
  box-sizing: border-box;
}

.scene-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  margin-bottom: 16rpx;
  background: #f5f8fc;
  border-radius: 20rpx;
  border: 2rpx dashed rgba(77, 167, 248, 0.35);
}

.empty-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.empty-text {
  font-size: 24rpx;
  color: #888888;
}

.add-icon {
  font-size: 48rpx;
  color: #bbbbbb;
}

.points-tip {
  display: block;
  margin: 8rpx 0 20rpx;
  font-size: 22rpx;
  color: #888888;
  line-height: 1.5;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #f5f5f5;
  border-radius: 14rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.points-reward-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 9999;
  background: rgba(15, 23, 42, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.points-reward-card {
  position: relative;
  width: 100%;
  max-width: 520rpx;
  padding: 48rpx 32rpx 40rpx;
  border-radius: 32rpx;
  background: linear-gradient(160deg, #fff9e8 0%, #ffffff 45%, #e8f4ff 100%);
  text-align: center;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.18);
  transform: scale(0.72);
  opacity: 0;
}

.points-reward-card.active {
  animation: points-card-in 0.55s cubic-bezier(0.34, 1.4, 0.64, 1) forwards;
}

.points-ring {
  position: absolute;
  left: 50%;
  top: 88rpx;
  width: 200rpx;
  height: 200rpx;
  margin-left: -100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 193, 7, 0.35);
  opacity: 0;
}

.points-reward-card.active .points-ring {
  animation: points-ring 0.9s ease-out 0.15s forwards;
}

.points-spark {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ffc107;
  opacity: 0;
}

.points-reward-card.active .points-spark.s1 {
  left: 18%;
  top: 28%;
  animation: points-spark 0.85s ease-out 0.2s forwards;
}

.points-reward-card.active .points-spark.s2 {
  right: 16%;
  top: 22%;
  animation: points-spark 0.85s ease-out 0.35s forwards;
}

.points-reward-card.active .points-spark.s3 {
  left: 50%;
  top: 8%;
  margin-left: -8rpx;
  animation: points-spark 0.85s ease-out 0.45s forwards;
}

.points-icon {
  display: block;
  font-size: 56rpx;
  line-height: 1;
  margin-bottom: 8rpx;
}

.points-num {
  display: block;
  font-size: 88rpx;
  font-weight: 800;
  line-height: 1;
  color: #f59e0b;
  letter-spacing: -2rpx;
  transform: translateY(24rpx);
  opacity: 0;
}

.points-reward-card.active .points-num {
  animation: points-num-pop 0.65s cubic-bezier(0.34, 1.45, 0.64, 1) 0.12s forwards;
}

.points-label {
  display: block;
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  opacity: 0;
}

.points-reward-card.active .points-label {
  animation: points-fade-up 0.5s ease-out 0.35s forwards;
}

.points-sub {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #666666;
  opacity: 0;
}

.points-reward-card.active .points-sub {
  animation: points-fade-up 0.5s ease-out 0.48s forwards;
}

@keyframes points-card-in {
  0% {
    transform: scale(0.72);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes points-num-pop {
  0% {
    transform: translateY(24rpx) scale(0.6);
    opacity: 0;
  }
  70% {
    transform: translateY(-6rpx) scale(1.08);
    opacity: 1;
  }
  100% {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
}

@keyframes points-fade-up {
  0% {
    transform: translateY(12rpx);
    opacity: 0;
  }
  100% {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes points-ring {
  0% {
    transform: scale(0.4);
    opacity: 0.8;
  }
  100% {
    transform: scale(1.35);
    opacity: 0;
  }
}

@keyframes points-spark {
  0% {
    transform: scale(0);
    opacity: 0;
  }
  40% {
    opacity: 1;
  }
  100% {
    transform: scale(2.2) translateY(-24rpx);
    opacity: 0;
  }
}

page {
  background: #f5f8fc;
}

.page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.cover-wrap {
  width: 100%;
  background: #e8eef5;
}

.cover {
  width: 100%;
  height: 100%;
  display: block;
}

.card {
  margin: -40rpx 24rpx 0;
  padding: 32rpx 28rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 2;
}

.name {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.meta {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.price {
  font-size: 28rpx;
  font-weight: 700;
  color: #e85d3a;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 12rpx 0 4rpx;
}

.tag {
  font-size: 22rpx;
  color: #1e88e5;
  background: rgba(126, 200, 255, 0.25);
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.section {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.intro {
  display: block;
  font-size: 28rpx;
  color: #444;
  line-height: 1.65;
  white-space: pre-wrap;
}

.addr {
  display: block;
  font-size: 26rpx;
  color: #1e88e5;
  line-height: 1.5;
}

.bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.btn-primary,
.btn-secondary {
  flex: 1;
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #5bb8ff, #4da7f8);
  color: #1a1a1a;
}

.btn-secondary {
  background: #f5f8fc;
  color: #1a1a1a;
}

.btn-primary::after,
.btn-secondary::after {
  border: none;
}

.loading,
.empty {
  padding: 120rpx 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

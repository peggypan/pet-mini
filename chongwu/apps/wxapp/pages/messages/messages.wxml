<view class="page">
  <view class="tabs">
    <view class="tab {{tab === 'chat' ? 'on' : ''}}" bindtap="onTab" data-tab="chat">
      <text>私信</text>
      <text class="tab-badge" wx:if="{{chatUnread > 0}}">{{chatUnread > 99 ? '99+' : chatUnread}}</text>
    </view>
    <view class="tab {{tab === 'notice' ? 'on' : ''}}" bindtap="onTab" data-tab="notice">
      <text>通知</text>
      <text class="tab-badge" wx:if="{{noticeUnread > 0}}">{{noticeUnread > 99 ? '99+' : noticeUnread}}</text>
    </view>
  </view>

  <view wx:if="{{tab === 'chat'}}">
    <view
      class="chat-item"
      wx:for="{{chats}}"
      wx:key="id"
      bindtap="onChatTap"
      data-peerid="{{item.peerId}}"
      data-threadid="{{item.id}}"
    >
      <image class="avatar" src="{{item.avatar}}" mode="aspectFill"></image>
      <view class="chat-body">
        <view class="chat-top">
          <text class="chat-name">{{item.peerName}} · {{item.petName}}</text>
          <text class="chat-time">{{item.lastTime}}</text>
        </view>
        <text class="chat-msg">{{item.lastMessage || '打个招呼吧～'}}</text>
      </view>
      <view class="unread" wx:if="{{item.unread > 0}}">{{item.unread}}</view>
    </view>
    <view class="empty" wx:if="{{chats.length === 0}}">
      <text>还没有私信，去发现页找宠友吧</text>
      <button class="empty-btn" bindtap="onDiscoverTap">去发现</button>
    </view>
  </view>

  <view wx:if="{{tab === 'notice'}}">
    <view
      class="notice-item {{item.url ? 'notice-tap' : ''}} {{item.read ? '' : 'is-unread'}}"
      wx:for="{{notices}}"
      wx:key="id"
      bindtap="onNoticeTap"
      data-url="{{item.url}}"
    >
      <view class="notice-title-row">
        <text class="notice-title">{{item.title}}</text>
        <view class="notice-dot" wx:if="{{!item.read}}"></view>
      </view>
      <block wx:if="{{item.lines && item.lines.length}}">
        <text class="notice-line" wx:for="{{item.lines}}" wx:for-item="line" wx:key="*this">{{line}}</text>
      </block>
      <text class="notice-content" wx:else>{{item.content}}</text>
      <view class="notice-foot">
        <text class="notice-time">{{item.timeText}}</text>
        <text class="notice-link" wx:if="{{item.url}}">查看报名码</text>
      </view>
    </view>
    <view class="empty" wx:if="{{notices.length === 0}}">
      <text>暂无通知</text>
    </view>
  </view>

  <pet-profile-gate show="{{petProfileBlocked}}" />
</view>

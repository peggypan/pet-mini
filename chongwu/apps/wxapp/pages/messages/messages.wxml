<view class="page">
  <view class="tip">订单与健康提醒会汇总在这里（本地演示）</view>
  <view class="list">
    <view class="item {{item.read ? '' : 'unread'}}" wx:for="{{messages}}" wx:key="id">
      <view class="top">
        <text class="title">{{item.title}}</text>
        <text class="time">{{item.timeText}}</text>
      </view>
      <text class="content">{{item.content}}</text>
    </view>
  </view>
  <view class="empty" wx:if="{{messages.length === 0}}">
    <text>暂无消息</text>
    <text class="sub">预约服务、下单或开启提醒后会出现</text>
  </view>
</view>

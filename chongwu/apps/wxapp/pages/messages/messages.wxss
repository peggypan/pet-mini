page { background: #F5F8FC; }

.page {
  min-height: 100vh;
  padding: 20rpx 28rpx calc(130rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.tabs {
  display: flex;
  margin-bottom: 20rpx;
  padding: 6rpx;
  border-radius: 28rpx;
  background: #fff;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #999999;
}

.tab.on {
  background: rgba(126, 200, 255, 0.35);
  color: #1A1A1A;
  font-weight: 700;
}

.chat-item {
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
  margin-bottom: 12rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(30, 136, 229, 0.06);
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.chat-body {
  flex: 1;
  min-width: 0;
}

.chat-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.chat-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.chat-time {
  font-size: 20rpx;
  color: #B0BEC5;
}

.chat-msg {
  font-size: 24rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.unread {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #FF8A9B;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  margin-left: 8rpx;
}

.notice-item {
  padding: 24rpx;
  margin-bottom: 12rpx;
  border-radius: 20rpx;
  background: #fff;
}

.notice-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.notice-content {
  display: block;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.notice-time {
  font-size: 22rpx;
  color: #B0BEC5;
}

.empty {
  padding: 80rpx 20rpx;
  text-align: center;
  color: #999999;
  font-size: 26rpx;
}

.empty-btn {
  margin-top: 24rpx;
  background: #4DA7F8;
  color: #fff;
  border-radius: 40rpx;
  font-size: 26rpx;
  border: none;
}

.empty-btn::after { border: none; }

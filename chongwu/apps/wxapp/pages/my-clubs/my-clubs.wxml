<view class="page">
  <view class="tabs">
    <view class="tab {{tab === 'mine' ? 'on' : ''}}" data-tab="mine" bindtap="onTab">我的俱乐部</view>
    <view class="tab {{tab === 'joined' ? 'on' : ''}}" data-tab="joined" bindtap="onTab">加入的俱乐部</view>
  </view>

  <!-- 我的俱乐部（我是主理人） -->
  <block wx:if="{{tab === 'mine'}}">
    <view
      class="club-card-mine tap"
      wx:for="{{myClubs}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-pending="{{item.status === 'approved' ? '' : '1'}}"
      bindtap="onOpenMyClub"
    >
      <view class="mine-cover aspect-34">
        <image
          class="mine-cover-img"
          src="{{item.cover || '/assets/mock/real_hero.jpg'}}"
          mode="aspectFill"
        ></image>
        <view class="mine-cover-mask"></view>
        <view class="club-status mine-status {{item.status === 'approved' ? 'ok' : ''}}">
          <text class="mine-status-label">{{item.status === 'approved' ? '已上线' : '审核中'}}</text>
        </view>
      </view>
      <view class="mine-body">
        <text class="mine-name">{{item.name || item.clubName || '我的俱乐部'}}</text>
        <text class="mine-meta">{{item.city || '未选城市'}} · 我是主理人</text>
        <text class="mine-intro">{{item.intro || '暂无介绍，点击完善俱乐部信息'}}</text>
        <view class="mine-foot">
          <text class="mine-hint" wx:if="{{item.status !== 'approved'}}">审核通过后将展示在同城推荐</text>
          <text class="mine-hint ok" wx:else>点击进入管理俱乐部</text>
          <text class="mine-arrow">详情 ›</text>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{!myClubs.length}}">
      <text class="empty-icon">🏟</text>
      <text class="empty-text">还没有自己主理的俱乐部</text>
      <button class="empty-btn" bindtap="onGoApply">成为主理人</button>
    </view>
  </block>

  <!-- 加入的俱乐部 -->
  <block wx:if="{{tab === 'joined'}}">
    <view class="club-card tap" wx:for="{{joinedClubs}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpenClub">
      <view class="club-cover-wrap aspect-34">
        <image class="club-cover" src="{{item.cover}}" mode="aspectFill"></image>
      </view>
      <view class="club-body">
        <view class="club-head">
          <text class="club-name">{{item.name}}</text>
          <text class="club-badge">已加入</text>
        </view>
        <text class="club-meta">{{item.city}} · {{item.owner || '主理人'}} · {{item.members || 0}} 成员</text>
        <view class="club-actions">
          <text class="link-btn" data-id="{{item.id}}" catchtap="onChat">发消息</text>
          <text class="link-btn warn" data-id="{{item.id}}" catchtap="onLeave">退出</text>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{!joinedClubs.length}}">
      <text class="empty-icon">🐾</text>
      <text class="empty-text">还没有加入任何俱乐部</text>
    </view>

    <view class="section-head">
      <text class="section-title">同城俱乐部 · 推荐加入</text>
    </view>
    <view class="club-card tap" wx:for="{{recommendClubs}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpenClub">
      <view class="club-cover-wrap aspect-34">
        <image class="club-cover" src="{{item.cover}}" mode="aspectFill"></image>
      </view>
      <view class="club-body">
        <view class="club-head">
          <text class="club-name">{{item.name}}</text>
          <text class="club-join" data-id="{{item.id}}" catchtap="onJoin">＋ 加入</text>
        </view>
        <text class="club-meta">{{item.city}} · {{item.owner}} · {{item.members}} 成员</text>
        <text class="club-intro">{{item.intro}}</text>
      </view>
    </view>
    <view class="recommend-empty" wx:if="{{!recommendClubs.length}}">
      <text>暂无推荐俱乐部，请确认当前城市或稍后再来</text>
    </view>
  </block>
</view>

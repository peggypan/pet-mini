page { background: #F5F8FC; }

.page { padding: 24rpx; }

.tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #666666;
  border-radius: 18rpx;
}

.tab.on {
  background: #E8F4FF;
  color: #1A1A1A;
  font-weight: 800;
}

.club-card {
  display: flex;
  padding: 20rpx;
  margin-bottom: 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.club-card.tap:active {
  opacity: 0.92;
}

.recommend-empty {
  padding: 32rpx 16rpx 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
}

.club-cover-wrap {
  width: 176rpx;
  margin-right: 20rpx;
  border-radius: 18rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.club-cover {
  background: #e8eef5;
}

.club-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.club-card-mine {
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.06);
}

.mine-cover {
  position: relative;
  width: 100%;
  background: #e8eef5;
}

.mine-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.mine-cover-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 50%;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.35));
}

.club-status.mine-status {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  margin: 0;
  padding: 0 18rpx;
  height: 44rpx;
  min-width: 88rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mine-status-label {
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  color: inherit;
}

.mine-body {
  padding: 24rpx 24rpx 20rpx;
}

.mine-name {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.mine-meta {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.mine-intro {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.mine-foot {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.mine-hint {
  flex: 1;
  font-size: 22rpx;
  color: #ff9500;
}

.mine-hint.ok {
  color: #1e88e5;
}

.mine-arrow {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #1e88e5;
}

.club-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.club-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.club-status {
  flex-shrink: 0;
  align-self: center;
  margin-left: 12rpx;
  font-size: 20rpx;
  line-height: 1;
  color: #FF9500;
  background: #FFF4D0;
  padding: 0 14rpx;
  height: 36rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.club-status.ok {
  color: #1E88E5;
  background: #E8F4FF;
}

.club-badge {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #4DB87A;
  background: rgba(111, 207, 151, 0.15);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.club-join {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #1A1A1A;
  background: linear-gradient(135deg, #5BB8FF, #4DA7F8);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 700;
}

.club-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
}

.club-intro {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.club-actions {
  margin-top: 10rpx;
  display: flex;
  gap: 28rpx;
}

.link-btn.warn {
  color: #1E88E5;
}

.section-head {
  margin: 28rpx 4rpx 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1A1A1A;
}

.empty {
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
}

.empty-icon { font-size: 64rpx; }

.empty-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #999999;
}

.empty-btn {
  margin-top: 28rpx;
  background: linear-gradient(135deg, #5BB8FF, #4DA7F8);
  color: #1A1A1A;
}

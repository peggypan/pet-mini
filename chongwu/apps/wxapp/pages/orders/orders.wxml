<view class="container">
  <!-- Tab切换 -->
  <view class="tabs">
    <view class="tab {{activeTab === 'service' ? 'active' : ''}}" bindtap="onTabTap" data-tab="service">
      服务订单
    </view>
    <view class="tab {{activeTab === 'idle' ? 'active' : ''}}" bindtap="onTabTap" data-tab="idle">
      闲置订单
    </view>
  </view>

  <!-- 服务订单 -->
  <view wx:if="{{activeTab === 'service'}}">
    <view class="order-list">
      <view class="order-card" wx:for="{{serviceOrders}}" wx:key="id">
        <view class="order-header">
          <text class="order-no">{{item.orderNo}}</text>
          <text class="order-status">{{getStatusText(item.status)}}</text>
        </view>
        
        <view class="order-body">
          <image src="{{item.service?.coverUrls[0]}}" class="order-image"></image>
          <view class="order-info">
            <text class="order-title">{{item.serviceName}}</text>
            <text class="order-merchant">{{item.merchant?.name}}</text>
            <text class="order-time" wx:if="{{item.appointmentDate}}">预约: {{item.appointmentDate}}</text>
          </view>
        </view>
        
        <view class="order-footer">
          <text class="order-price">¥{{item.payAmount}}</text>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{serviceOrders.length === 0}}">
      <text>暂无服务订单</text>
      <button class="btn-primary" bindtap="goService">去预约</button>
    </view>
  </view>

  <!-- 闲置订单 -->
  <view wx:if="{{activeTab === 'idle'}}">
    <!-- 我购买的 -->
    <view class="section-title">我购买的</view>
    <view class="order-list">
      <view class="order-card" wx:for="{{idleOrders.buyOrders}}" wx:key="id">
        <view class="order-header">
          <text class="order-no">{{item.orderNo}}</text>
          <text class="order-status">{{getIdleStatusText(item.status)}}</text>
        </view>
        
        <view class="order-body">
          <image src="{{item.idleItem?.images[0]}}" class="order-image"></image>
          <view class="order-info">
            <text class="order-title">{{item.itemTitle}}</text>
            <text class="order-seller">卖家: {{item.seller?.nickname}}</text>
          </view>
        </view>
        
        <view class="order-footer">
          <text class="order-price">¥{{item.payAmount}}</text>
        </view>
      </view>
    </view>

    <!-- 我出售的 -->
    <view class="section-title">我出售的</view>
    <view class="order-list">
      <view class="order-card" wx:for="{{idleOrders.sellOrders}}" wx:key="id">
        <view class="order-header">
          <text class="order-no">{{item.orderNo}}</text>
          <text class="order-status">{{getIdleStatusText(item.status)}}</text>
        </view>
        
        <view class="order-body">
          <image src="{{item.idleItem?.images[0]}}" class="order-image"></image>
          <view class="order-info">
            <text class="order-title">{{item.itemTitle}}</text>
            <text class="order-buyer">买家: {{item.buyer?.nickname}}</text>
          </view>
        </view>
        
        <view class="order-footer">
          <text class="order-price">¥{{item.payAmount}}</text>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{idleOrders.buyOrders.length === 0 && idleOrders.sellOrders.length === 0}}">
      <text>暂无闲置订单</text>
      <button class="btn-primary" bindtap="goIdle">去逛逛</button>
    </view>
  </view>
</view>

.tabs {
  display: flex;
  background: var(--bg-white);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: var(--text-secondary);
  position: relative;
}

.tab.active {
  color: var(--primary);
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: var(--primary);
  border-radius: 2rpx;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  background: var(--bg-white);
  border-radius: 16rpx;
  padding: 24rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 24rpx;
  color: var(--text-muted);
}

.order-status {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 500;
}

.order-body {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.order-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #eee;
}

.order-info {
  flex: 1;
}

.order-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.order-merchant,
.order-seller,
.order-buyer,
.order-time {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 8rpx;
}

.order-footer {
  display: flex;
  justify-content: flex-end;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
}

.order-price {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--primary);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin: 24rpx 0 16rpx;
}

.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-state text {
  display: block;
  font-size: 30rpx;
  color: var(--text-muted);
  margin-bottom: 40rpx;
}

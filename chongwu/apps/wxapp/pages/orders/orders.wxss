/* 温馨Tab切换 */
.tabs {
  display: flex;
  background: var(--bg-white);
  border-radius: 24rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
  box-shadow: var(--shadow-soft);
  border: 1rpx solid var(--border-color);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: var(--text-secondary);
  position: relative;
  transition: all 0.3s ease;
}

.tab.active {
  color: var(--primary);
  font-weight: 600;
  background: linear-gradient(135deg, var(--primary-bg) 0%, transparent 100%);
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: var(--primary);
  border-radius: 3rpx;
}

/* 订单列表 */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.order-card {
  background: var(--bg-white);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-soft);
  border: 1rpx solid var(--border-color);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 24rpx;
  color: var(--text-muted);
}

.order-status {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 500;
  padding: 8rpx 20rpx;
  background: var(--primary-bg);
  border-radius: 28rpx;
}

.order-body {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.order-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  background: var(--bg-primary);
}

.order-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  background: #E8F5EE;
}

.order-info {
  flex: 1;
}

.order-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.order-merchant,
.order-seller,
.order-buyer,
.order-time,
.order-address {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 6rpx;
}

.order-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color);
}

.order-price {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--primary);
}

.order-price::before {
  content: '¥';
  font-size: 24rpx;
  margin-right: 2rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin: 24rpx 0 16rpx;
  position: relative;
  padding-left: 16rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(to bottom, var(--primary), var(--primary-light));
  border-radius: 3rpx;
}

/* 温馨空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 60rpx;
  background: var(--bg-warm);
  border-radius: 28rpx;
  border: 2rpx dashed var(--border-light);
}

.empty-icon {
  font-size: 140rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: var(--text-muted);
}

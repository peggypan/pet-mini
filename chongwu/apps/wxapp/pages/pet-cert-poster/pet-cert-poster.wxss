.page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef6ff 0%, #f8fafc 45%, #fff 100%);
}

.head {
  margin-bottom: 28rpx;
}

.head-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #0d2137;
}

.head-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.loading,
.error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #64748b;
  font-size: 28rpx;
}

.loading-dot {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 24rpx;
  border: 4rpx solid rgba(30, 136, 229, 0.2);
  border-top-color: #1e88e5;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.retry-btn {
  margin-top: 24rpx;
  font-size: 28rpx;
}

.poster-swiper {
  height: 920rpx;
}

.poster-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0 24rpx;
}

.poster-img {
  width: 520rpx;
  border-radius: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(15, 40, 80, 0.12);
}

.style-tag {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #1e88e5;
  font-weight: 600;
}

.tips {
  margin: 24rpx 8rpx 32rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 16rpx;
  border: 1rpx solid rgba(30, 136, 229, 0.12);
}

.tips text {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-primary,
.btn-secondary,
.btn-share {
  font-size: 30rpx;
  border-radius: 48rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #1e88e5, #42a5f5);
  color: #fff;
}

.btn-secondary {
  background: #fff;
  color: #1e88e5;
  border: 1rpx solid rgba(30, 136, 229, 0.35);
}

.btn-share {
  background: #f1f5f9;
  color: #334155;
}

.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 375px;
  height: 600px;
}

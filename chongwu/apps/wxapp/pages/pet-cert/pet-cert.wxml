<view class="page">
  <view class="audit-banner rejected" wx:if="{{profileComplete && auditStatus === 'rejected'}}">
    <text class="audit-title">档案未通过</text>
    <text class="audit-desc">{{auditBannerText || '请修改资料后重新保存'}}</text>
  </view>
  <view class="audit-banner hidden" wx:elif="{{profileComplete && auditStatus === 'hidden'}}">
    <text class="audit-title">档案已隐藏</text>
    <text class="audit-desc">{{auditBannerText || '请联系平台客服'}}</text>
  </view>

  <text class="section-title">电子宠证</text>
  <view class="cert-card">
    <image class="avatar" src="{{pet.avatar}}" mode="aspectFill"></image>
    <text class="name">{{pet.name}}</text>
    <text class="line">{{pet.breed}} · {{pet.age}} · {{pet.personality}}</text>
    <view class="healing-cert-badge" wx:if="{{pet.healingPet}}">💚 宠物疗愈 · {{pet.healingBuddyType || '疗愈搭子'}}</view>
    <text class="verified" wx:if="{{pet.vaccineStatus === 'immune' || pet.verified}}">已免疫 ✓</text>
    <text class="vaccine-tag vaccinating" wx:elif="{{pet.vaccineStatus === 'vaccinating'}}">免疫中</text>
    <text class="vaccine-tag none" wx:elif="{{pet.vaccineStatus === 'none'}}">未免疫</text>
    <view class="tag-row" wx:if="{{pet.socialTags && pet.socialTags.length}}">
      <text class="tag" wx:for="{{pet.socialTags}}" wx:key="*this">{{item}}</text>
    </view>
    <view
      class="activity-area"
      wx:if="{{pet.activityAreaName || pet.activityAreaAddress}}"
      bindtap="onOpenActivityArea"
    >
      <text class="activity-label">常活动区域</text>
      <text class="activity-name">{{pet.activityAreaName || pet.activityAreaAddress}}</text>
      <text class="activity-addr" wx:if="{{pet.activityAreaAddress && pet.activityAreaName && pet.activityAreaAddress !== pet.activityAreaName}}">{{pet.activityAreaAddress}}</text>
      <text class="activity-hint" wx:if="{{pet.activityAreaLatitude}}">点击查看地图 ›</text>
    </view>
    <text class="brand">宠头头 · 电子宠证</text>
  </view>

  <view class="qr-section" wx:if="{{profileComplete && auditStatus !== 'rejected' && auditStatus !== 'hidden'}}">
    <text class="qr-title">线下查验二维码</text>
    <text class="qr-sub">档案完善后自动生成，扫码可查看宠证信息与免疫证明</text>
    <view class="qr-canvas-wrap">
      <image
        wx:if="{{qrImageSrc}}"
        class="cert-qr-image"
        src="{{qrImageSrc}}"
        mode="aspectFit"
      ></image>
      <block wx:else>
        <canvas type="2d" id="petCertQr" class="cert-qr-canvas"></canvas>
        <view class="qr-loading-mask" wx:if="{{qrDrawing}}">二维码生成中…</view>
        <view class="qr-loading-mask qr-retry" wx:elif="{{qrFailed}}" bindtap="onRetryQr">点击重新生成</view>
      </block>
    </view>
    <text class="qr-tip">微信「扫一扫」或点击下方按钮查验其他宠物</text>
    <button class="btn-scan" bindtap="onScanVerify">扫码查验</button>
  </view>

  <view class="bottom-actions">
    <button class="btn" bindtap="onEdit">编辑档案</button>
    <button class="btn outline" bindtap="onShare">生成分享海报</button>
  </view>
</view>


page { background: #F5F8FC; }

.page { padding: 32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.section-title:not(:first-child) {
  margin-top: 32rpx;
}

.cert-card {
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #E8F4FF, #fff);
  border-radius: 28rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
  border: 6rpx solid #fff;
}

.name {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #1A1A1A;
}

.line {
  display: block;
  font-size: 24rpx;
  color: #666666;
  margin-top: 8rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: center;
  margin-top: 12rpx;
}

.tag {
  font-size: 20rpx;
  color: #1E88E5;
  background: rgba(126, 200, 255, 0.25);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.verified {
  display: block;
  font-size: 26rpx;
  color: #1E88E5;
  margin-top: 12rpx;
  font-weight: 600;
}

.brand {
  display: block;
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #999999;
}

.digital-card {
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.digital-preview {
  height: 240rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #E8F4FF 0%, #FFFFFF 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.photo-wrap {
  transition: transform 0.5s ease;
  transform-origin: center bottom;
}

.digital-photo {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.digital-emoji {
  font-size: 80rpx;
  margin-bottom: 12rpx;
}

.digital-tip {
  font-size: 24rpx;
  color: #999999;
}

.digital-info {
  margin-bottom: 20rpx;
}

.digital-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.digital-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #1A1A1A;
}

.digital-stage {
  font-size: 22rpx;
  color: #1E88E5;
  background: rgba(126, 200, 255, 0.25);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.growth-bar {
  height: 16rpx;
  background: #F0F0F0;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.growth-fill {
  height: 100%;
  background: linear-gradient(90deg, #5BB8FF, #4DA7F8);
  border-radius: 8rpx;
}

.growth-text {
  display: block;
  font-size: 22rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.dialogue {
  display: block;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
}

.digital-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.btn-mini {
  margin: 0;
  flex: 1;
  min-width: 180rpx;
  height: 72rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #F5F8FC;
  color: #1A1A1A;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
}

.btn-mini.primary {
  flex: 1 1 100%;
  background: linear-gradient(135deg, #5BB8FF, #4DA7F8);
  box-shadow: 0 6rpx 20rpx rgba(77, 167, 248, 0.25);
}

.btn-mini::after { border: none; }

.bottom-actions {
  margin-top: 32rpx;
}

.btn {
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, #5BB8FF, #4DA7F8);
  color: #1A1A1A;
  border-radius: 44rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 20rpx rgba(77, 167, 248, 0.3);
}

.btn.outline {
  background: #FFFFFF;
  color: #1A1A1A;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.btn::after { border: none; }

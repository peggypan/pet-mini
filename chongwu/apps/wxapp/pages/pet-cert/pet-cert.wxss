page { background: #F5F8FC; }

.page { padding: 32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }

.audit-banner {
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.audit-banner.pending {
  background: #FFF7E6;
  border: 1rpx solid #FFD591;
}

.audit-banner.rejected {
  background: #FFF1F0;
  border: 1rpx solid #FFA39E;
}

.audit-banner.hidden {
  background: #F5F5F5;
  border: 1rpx solid #D9D9D9;
}

.audit-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.audit-desc {
  display: block;
  font-size: 24rpx;
  color: #595959;
  line-height: 1.5;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.section-title:not(:first-child) {
  margin-top: 32rpx;
}

.cert-card {
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #E8F4FF, #fff);
  border-radius: 28rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.healing-cert-badge {
  display: inline-block;
  margin: 12rpx auto 8rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(45, 106, 79, 0.12);
  color: #2d6a4f;
  font-size: 22rpx;
  font-weight: 700;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
  border: 6rpx solid #fff;
}

.name {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #1A1A1A;
}

.line {
  display: block;
  font-size: 24rpx;
  color: #666666;
  margin-top: 8rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: center;
  margin-top: 12rpx;
}

.tag {
  font-size: 20rpx;
  color: #1E88E5;
  background: rgba(126, 200, 255, 0.25);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.verified {
  display: block;
  font-size: 26rpx;
  color: #1E88E5;
  margin-top: 12rpx;
  font-weight: 600;
}

.vaccine-tag {
  display: block;
  font-size: 26rpx;
  margin-top: 12rpx;
  font-weight: 600;
}

.vaccine-tag.vaccinating {
  color: #e08a5a;
}

.vaccine-tag.none {
  color: #999999;
}

.activity-area {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(0, 145, 255, 0.08);
  text-align: left;
}

.activity-label {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 6rpx;
}

.activity-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
}

.activity-addr {
  display: block;
  font-size: 24rpx;
  color: #666666;
  margin-top: 4rpx;
  line-height: 1.45;
}

.activity-hint {
  display: block;
  font-size: 22rpx;
  color: #1e88e5;
  margin-top: 8rpx;
}

.brand {
  display: block;
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #999999;
}

.digital-card {
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.digital-preview {
  height: 240rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #E8F4FF 0%, #FFFFFF 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.photo-wrap {
  transition: transform 0.5s ease;
  transform-origin: center bottom;
}

.digital-photo {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.digital-emoji {
  font-size: 80rpx;
  margin-bottom: 12rpx;
}

.digital-tip {
  font-size: 24rpx;
  color: #999999;
}

.digital-info {
  margin-bottom: 20rpx;
}

.digital-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.digital-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #1A1A1A;
}

.digital-stage {
  font-size: 22rpx;
  color: #1E88E5;
  background: rgba(126, 200, 255, 0.25);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.growth-bar {
  height: 16rpx;
  background: #F0F0F0;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.growth-fill {
  height: 100%;
  background: linear-gradient(90deg, #5BB8FF, #4DA7F8);
  border-radius: 8rpx;
}

.growth-text {
  display: block;
  font-size: 22rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.dialogue {
  display: block;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
}

.digital-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.btn-mini {
  margin: 0;
  flex: 1;
  min-width: 180rpx;
  height: 72rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #F5F8FC;
  color: #1A1A1A;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
}

.btn-mini.primary {
  flex: 1 1 100%;
  background: linear-gradient(135deg, #5BB8FF, #4DA7F8);
  box-shadow: 0 6rpx 20rpx rgba(77, 167, 248, 0.25);
}

.btn-mini::after { border: none; }

.qr-section {
  margin-top: 28rpx;
  padding: 32rpx 28rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  text-align: center;
}

.qr-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.qr-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
  line-height: 1.5;
}

.qr-canvas-wrap {
  display: flex;
  justify-content: center;
  margin: 24rpx 0 16rpx;
  padding: 20rpx;
  background: #f5f8fc;
  border-radius: 20rpx;
}

.cert-qr-canvas {
  width: 360rpx;
  height: 360rpx;
}

.qr-tip {
  display: block;
  font-size: 22rpx;
  color: #666666;
  line-height: 1.5;
}

.btn-scan {
  margin: 20rpx 0 0;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: rgba(30, 136, 229, 0.12);
  color: #1e88e5;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.btn-scan::after {
  border: none;
}

.bottom-actions {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.bottom-actions .btn {
  width: 100%;
  margin: 0;
  height: 96rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: linear-gradient(135deg, #5BB8FF, #4DA7F8);
  color: #1A1A1A;
  border-radius: 40rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 20rpx rgba(77, 167, 248, 0.3);
}

.bottom-actions .btn.outline {
  background: #FFFFFF;
  color: #1A1A1A;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.btn::after { border: none; }

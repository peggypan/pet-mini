page {
  background: #f5f8fc;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  width: 100%;
  height: 520rpx;
  display: block;
  background: #e8eef5;
}

.panel {
  margin: -40rpx 24rpx 0;
  padding: 28rpx 28rpx 32rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(30, 80, 140, 0.08);
  position: relative;
}

.healing-badge {
  display: inline-flex;
  margin-bottom: 16rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #2d6a4f, #40916c);
}

.title-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8rpx 12rpx;
  margin-bottom: 12rpx;
}

.pet-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #0f2942;
}

.breed {
  font-size: 26rpx;
  color: #64748b;
}

.score-box {
  margin-left: auto;
  text-align: right;
}

.score-label {
  display: block;
  font-size: 20rpx;
  color: #7a96b3;
}

.score-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #1e88e5;
}

.owner-line {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 20rpx;
}

.place-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #eef2f7;
  border-bottom: 1rpx solid #eef2f7;
  margin-bottom: 20rpx;
}

.place-label {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #7a96b3;
  width: 120rpx;
}

.place-val {
  flex: 1;
  min-width: 0;
}

.place-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
}

.place-addr {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.4;
}

.place-arrow {
  flex-shrink: 0;
  font-size: 32rpx;
  color: #cbd5e1;
  line-height: 1.2;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #1e88e5;
  background: #e8f4fd;
}

.tag.tag-healing {
  color: #2d6a4f;
  background: #e8f5ef;
}

.desc {
  display: block;
  font-size: 28rpx;
  line-height: 1.6;
  color: #334155;
  margin-bottom: 24rpx;
}

.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.media-thumb {
  width: calc(33.33% - 8rpx);
  height: 180rpx;
  border-radius: 16rpx;
  background: #eef2f7;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #eef2f7;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.footer-share {
  flex-shrink: 0;
  margin: 0;
  padding: 0 28rpx;
  height: 96rpx;
  min-width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border-radius: 40rpx;
  background: #f5f8fc;
  color: #1a1a1a;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
}

.footer-share::after {
  border: none;
}

.footer-share-icon {
  width: 40rpx;
  height: 40rpx;
}

.footer-chat {
  flex: 1;
  margin: 0;
  height: 96rpx;
  padding: 0 24rpx;
  border-radius: 40rpx;
  white-space: nowrap;
}

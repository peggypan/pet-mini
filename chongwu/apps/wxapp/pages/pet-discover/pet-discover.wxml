<view class="page">
  <view class="sky-deco"></view>

  <view class="header header-compact">
    <view class="header-tagline-wrap">
      <text class="header-tagline-main">让毛孩子</text>
      <text class="header-tagline-sub">遇到更好的伙伴</text>
    </view>
    <view class="header-right">
      <view class="like-pill" bindtap="onOpenLikes">
        <text class="pill-icon">💙</text>
        <text>喜欢列表 {{likedCount}}</text>
      </view>
      <text class="quota">今日剩余 {{likeLeft}}/{{likeLimit}}</text>
    </view>
  </view>

  <view class="stack-wrap">
    <view
      class="pet-card under"
      wx:if="{{deck.length > 1}}"
      style="transform: scale({{underScale}}) translateY(28rpx);"
    >
      <view class="card-photo-wrap aspect-34">
        <image class="card-photo aspect-34-fill" src="{{deck[1].cover}}" mode="aspectFill"></image>
      </view>
    </view>

    <view
      wx:if="{{deck.length}}"
      class="pet-card top {{fly === 'left' ? 'fly-left' : ''}} {{fly === 'right' ? 'fly-right' : ''}} {{!dragging && !fly ? 'spring' : ''}}"
      style="transform: translate3d({{dx}}px, {{dy}}px, 0) rotate({{rot}}deg) scale({{cardScale}});"
      bindtouchstart="onCardStart"
      catchtouchmove="onCardMove"
      bindtouchend="onCardEnd"
      bindtouchcancel="onCardEnd"
    >
      <view class="card-photo-wrap aspect-34">
        <view class="card-glow"></view>
        <image class="card-photo aspect-34-fill" src="{{deck[0].cover}}" mode="aspectFill"></image>
        <view class="card-tap-hint">点击查看</view>
        <view class="healing-badge" wx:if="{{deck[0].isHealing}}">
          <text class="healing-badge-icon">💚</text>
          <text>疗愈搭子</text>
        </view>
        <view class="stamp skip" style="opacity:{{skipOp}}; transform: rotate(-16deg) scale({{0.85 + skipOp * 0.2}});">不喜欢</view>
        <view class="stamp like" style="opacity:{{likeOp}}; transform: rotate(16deg) scale({{0.85 + likeOp * 0.2}});">喜欢</view>
        <view class="card-info card-info-overlay">
          <view class="name-row">
            <text class="pet-name">{{deck[0].petName}}</text>
            <text class="pet-breed">| {{deck[0].breed }}</text>
            <view class="score-box">
              <text class="score-label">缘分值</text>
              <text class="score-num">{{deck[0].score}}%</text>
            </view>
          </view>
          <view class="pet-meta">
            <text
              class="place-tap"
              catchtap="onOpenPlace"
              data-name="{{deck[0].expectPlace}}"
              data-place="{{deck[0].expectPlace}}"
              data-address="{{deck[0].expectPlaceAddress}}"
              data-lat="{{deck[0].placeLat}}"
              data-lng="{{deck[0].placeLng}}"
            >{{deck[0].expectPlace}}</text>
            <text wx:if="{{deck[0].distance}}"> · {{deck[0].distance}}</text>
          </view>
          <view class="tag-row">
            <text
              class="tag {{deck[0].isHealing ? 'tag-healing' : ''}}"
              wx:for="{{deck[0].tags}}"
              wx:key="*this"
            >{{item}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{!deck.length}}">
      <text class="empty-icon">{{discoverFilter === 'healing' ? '💚' : '🐾'}}</text>
      <text class="empty-text">{{discoverFilter === 'healing' ? '暂时没有更多疗愈搭子了' : '暂时没有更多毛孩子了'}}</text>
      <button class="empty-btn" bindtap="onReload">换一批</button>
    </view>
  </view>

  <view class="actions" wx:if="{{deck.length}}">
    <view
      class="pill-btn dislike {{actPulse === 'dislike' ? 'pulse' : ''}}"
      bindtap="onSkip"
    >
      <view class="pill-x"></view>
    </view>

    <view class="pill-like-wrap">
      <view class="like-burst" wx:if="{{likeBurst}}">
        <text class="spark s1">✦</text>
        <text class="spark s2">♥</text>
        <text class="spark s3">✦</text>
      </view>
      <view
        class="pill-btn like {{actPulse === 'like' ? 'pulse' : ''}} {{likeBurst ? 'glow' : ''}}"
        bindtap="onLike"
      >
        <text class="pill-heart">♥</text>
      </view>
    </view>
  </view>

  <view class="mask" wx:if="{{showShareQuota}}" bindtap="onCloseShareQuota">
    <view class="sheet share-quota-sheet" catchtap="noop">
      <text class="share-quota-title">次数用完了</text>
      <text class="share-quota-desc">分享链接，{{shareMax}} 次共 +{{shareBonusTotal}} 次</text>
      <text class="share-quota-tip" wx:if="{{likeBonus > 0 && shareLeft > 0}}">已 +{{likeBonus}} · 还可分享 {{shareLeft}} 次</text>
      <button class="share-quota-btn btn-action-main" open-type="share" wx:if="{{shareLeft > 0}}">去分享</button>
      <text class="share-quota-capped" wx:else>分享次数已满</text>
      <text class="share-quota-cancel btn-text-link" bindtap="onCloseShareQuota">关闭</text>
    </view>
  </view>

  <view class="mask" wx:if="{{showLikes}}" bindtap="onCloseLikes">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <view class="sheet-head-text">
          <text class="sheet-title">喜欢列表</text>
          <text class="sheet-sub">{{likedCount}} 位 · 剩余 {{likeLeft}} 次滑动</text>
        </view>
        <text class="sheet-close" bindtap="onCloseLikes">×</text>
      </view>
      <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="sheet-scroll">
        <view class="sheet-scroll-inner">
        <view class="liked-row" wx:for="{{likedList}}" wx:key="id" data-id="{{item.id}}" bindtap="onLikedTap">
          <image class="liked-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
          <view class="liked-info">
            <text class="liked-name">{{item.petName}} · {{item.breed}}</text>
            <text class="liked-meta">{{item.userName}} · {{item.distance}}</text>
          </view>
          <text class="liked-arrow">›</text>
        </view>
        <view class="liked-empty" wx:if="{{!likedList.length}}">
          <text>今天还没有喜欢的毛孩子，右滑试试吧</text>
        </view>
        </view>
      </scroll-view>
    </view>
  </view>

</view>

page {
  background: linear-gradient(180deg, #6ec8ff 0%, #4eb6f8 38%, #e8f4fc 72%, #f0f7ff 100%);
}

.page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 24rpx 28rpx calc(220rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sky-deco {
  position: absolute;
  left: -120rpx;
  top: 80rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.35) 0%, transparent 68%);
  pointer-events: none;
}

.header {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.header-compact {
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 88rpx;
  margin-bottom: 12rpx;
}

.header-tagline-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
  padding-right: 8rpx;
}

.header-tagline-main {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 2rpx;
  color: #ffffff;
  text-shadow: 0 2rpx 16rpx rgba(21, 88, 150, 0.28);
}

.header-tagline-sub {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.92);
  text-shadow: 0 1rpx 8rpx rgba(21, 88, 150, 0.18);
}

.header-compact .header-right {
  flex-shrink: 0;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  text-shadow: 0 2rpx 12rpx rgba(26, 95, 158, 0.25);
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}

.header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.like-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #1d6fbd;
  box-shadow: 0 8rpx 24rpx rgba(30, 120, 200, 0.18);
}

.pill-icon {
  font-size: 26rpx;
}

.quota {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.discover-filter-scroll {
  position: relative;
  z-index: 2;
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.healing-type-scroll {
  margin-top: -8rpx;
  margin-bottom: 18rpx;
}

.discover-filter {
  display: inline-block;
  padding: 12rpx 26rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  font-size: 24rpx;
  color: rgba(15, 41, 66, 0.72);
  box-shadow: 0 4rpx 16rpx rgba(30, 100, 180, 0.12);
}

.discover-filter.on {
  background: #ffffff;
  color: #0f2942;
  font-weight: 800;
  box-shadow: 0 6rpx 20rpx rgba(30, 100, 180, 0.2);
}

.discover-filter.healing-type.on {
  background: rgba(232, 250, 241, 0.95);
  color: #2d6a4f;
}

.stack-wrap {
  position: relative;
  flex: 1;
  min-height: 860rpx;
}

.pet-card {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  padding: 24rpx 28rpx 28rpx;
  box-sizing: border-box;
  border-radius: 36rpx;
  overflow: hidden;
  background: linear-gradient(165deg, #ffffff 0%, #eef6ff 55%, #e3efff 100%);
  box-shadow: 0 20rpx 56rpx rgba(30, 100, 180, 0.22);
}

.pet-card.top {
  z-index: 2;
}

.pet-card.top.spring {
  transition: transform 0.48s cubic-bezier(0.34, 1.45, 0.64, 1), opacity 0.35s ease;
}

.pet-card.fly-left {
  transition: transform 0.42s cubic-bezier(0.55, 0.06, 0.68, 0.19), opacity 0.38s ease;
  transform: translate3d(-165%, -60rpx, 0) rotate(-28deg) scale(0.92) !important;
  opacity: 0 !important;
}

.pet-card.fly-right {
  transition: transform 0.42s cubic-bezier(0.55, 0.06, 0.68, 0.19), opacity 0.38s ease;
  transform: translate3d(165%, -80rpx, 0) rotate(28deg) scale(1.05) !important;
  opacity: 0 !important;
}

.pet-card.under {
  z-index: 1;
  justify-content: flex-start;
  transition: transform 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.pet-card.under .card-photo-wrap {
  flex: none;
}

.card-photo-wrap {
  position: relative;
  flex: 1;
  min-height: 0;
  width: 100%;
  border-radius: 28rpx;
  overflow: hidden;
  border: 10rpx solid rgba(255, 255, 255, 0.48);
  box-shadow: 0 16rpx 40rpx rgba(30, 100, 180, 0.16);
  background: rgba(255, 255, 255, 0.22);
}

.card-glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 88%;
  height: 70%;
  transform: translate(-50%, -50%);
  border-radius: 28rpx;
  background: radial-gradient(circle, rgba(78, 182, 248, 0.18) 0%, transparent 72%);
  pointer-events: none;
  z-index: 0;
}

.card-photo {
  opacity: 0.88;
}

.stamp {
  position: absolute;
  top: 24rpx;
  z-index: 2;
  padding: 8rpx 24rpx;
  border: 5rpx solid;
  border-radius: 14rpx;
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  transition: opacity 0.12s ease;
}

.card-tap-hint {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  z-index: 3;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(15, 41, 66, 0.38);
  backdrop-filter: blur(8px);
  pointer-events: none;
}

.healing-badge {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  z-index: 4;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(45, 106, 79, 0.92), rgba(64, 145, 108, 0.88));
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 24rpx rgba(45, 106, 79, 0.35);
  border: 2rpx solid rgba(255, 255, 255, 0.45);
}

.healing-badge-icon {
  font-size: 22rpx;
  line-height: 1;
}

.stamp.skip {
  left: 36rpx;
  color: #64748b;
  border-color: #94a3b8;
  background: rgba(255, 255, 255, 0.75);
}

.stamp.like {
  right: 36rpx;
  color: #ff3d81;
  border-color: #ff3d81;
  background: rgba(255, 255, 255, 0.85);
}

.card-info {
  position: relative;
  flex-shrink: 0;
  padding: 8rpx 4rpx 0;
  color: #0f2942;
}

.card-info-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  padding: 72rpx 24rpx 28rpx;
  box-sizing: border-box;
  background: linear-gradient(
    180deg,
    rgba(15, 41, 66, 0) 0%,
    rgba(15, 41, 66, 0.35) 38%,
    rgba(15, 41, 66, 0.72) 100%
  );
  color: #ffffff;
  pointer-events: none;
}

.card-info-overlay .place-tap {
  pointer-events: auto;
}

.card-info-overlay .pet-name {
  color: #ffffff;
}

.card-info-overlay .pet-breed {
  color: rgba(255, 255, 255, 0.88);
}

.card-info-overlay .score-label {
  color: rgba(255, 255, 255, 0.78);
}

.card-info-overlay .score-num {
  color: #b8e4ff;
}

.card-info-overlay .pet-meta {
  color: rgba(255, 255, 255, 0.92);
}

.card-info-overlay .place-tap {
  color: #7ec8ff;
}

.card-info-overlay .tag {
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
}

.card-info-overlay .tag.tag-healing {
  background: rgba(183, 240, 210, 0.35);
  color: #e8fff3;
  border-color: rgba(183, 240, 210, 0.55);
  font-weight: 700;
}

.name-row {
  display: flex;
  align-items: flex-end;
}

.pet-name {
  font-size: 44rpx;
  font-weight: 900;
}

.pet-breed {
  margin: 0 0 6rpx 14rpx;
  font-size: 28rpx;
  color: #5b7a99;
}

.score-box {
  margin-left: auto;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.score-label {
  font-size: 20rpx;
  color: #7a96b3;
}

.score-num {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.1;
  color: #1d6fbd;
}

.pet-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5b7a99;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.tag {
  padding: 8rpx 20rpx;
  background: rgba(78, 182, 248, 0.18);
  color: #1d6fbd;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.empty {
  position: absolute;
  left: 0;
  right: 0;
  top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #5b7a99;
}

.empty-btn {
  margin-top: 12rpx;
  min-height: 96rpx;
  padding: 26rpx 72rpx;
  line-height: 1.35;
  background: #ffffff;
  color: #1E88E5;
  font-size: 32rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 32rpx rgba(15, 60, 120, 0.28);
}

.empty-btn::after {
  border: none;
}

/* 底部操作 — 胶囊按钮（参照划卡参考图） */
.actions {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-top: 16rpx;
}

.pill-like-wrap {
  position: relative;
}

.pill-btn {
  width: 176rpx;
  height: 108rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.12);
}

.pill-btn.dislike {
  background: #ffb800;
}

.pill-btn.like {
  background: #ff3d81;
}

.pill-btn.pulse.dislike {
  animation: btn-shrink 0.32s ease;
}

.pill-btn.pulse.like {
  animation: heart-bounce 0.52s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.pill-btn.like.glow {
  box-shadow: 0 10rpx 28rpx rgba(255, 61, 129, 0.45), 0 0 0 10rpx rgba(255, 61, 129, 0.18);
}

.pill-x {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

.pill-x::before,
.pill-x::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 44rpx;
  height: 6rpx;
  background: #ffffff;
  border-radius: 6rpx;
}

.pill-x::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.pill-x::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.pill-heart {
  font-size: 56rpx;
  line-height: 1;
  color: #ffffff;
  font-weight: 700;
}

.like-burst {
  position: absolute;
  left: 50%;
  top: 8rpx;
  width: 0;
  height: 0;
  pointer-events: none;
  z-index: 2;
}

.spark {
  position: absolute;
  left: -14rpx;
  top: 0;
  font-size: 28rpx;
  opacity: 0;
}

.spark.s1 {
  color: #ffb800;
  animation: spark-fly-1 0.55s ease-out forwards;
}

.spark.s2 {
  color: #ff3d81;
  font-size: 32rpx;
  animation: spark-fly-2 0.55s ease-out 0.05s forwards;
}

.spark.s3 {
  color: #ff8fab;
  animation: spark-fly-3 0.55s ease-out 0.08s forwards;
}

@keyframes spark-fly-1 {
  0% {
    opacity: 1;
    transform: translate(0, 0) scale(0.4);
  }
  100% {
    opacity: 0;
    transform: translate(-56rpx, -72rpx) scale(1.1);
  }
}

@keyframes spark-fly-2 {
  0% {
    opacity: 1;
    transform: translate(0, 0) scale(0.4);
  }
  100% {
    opacity: 0;
    transform: translate(0, -96rpx) scale(1.15);
  }
}

@keyframes spark-fly-3 {
  0% {
    opacity: 1;
    transform: translate(0, 0) scale(0.4);
  }
  100% {
    opacity: 0;
    transform: translate(56rpx, -68rpx) scale(1.1);
  }
}

@keyframes heart-bounce {
  0% {
    transform: scale(1);
  }
  40% {
    transform: scale(1.22);
  }
  100% {
    transform: scale(1);
  }
}

@keyframes btn-shrink {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(0.88);
  }
  100% {
    transform: scale(1);
  }
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
  background: rgba(15, 40, 80, 0.45);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 78vh;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-shrink: 0;
  margin-bottom: 16rpx;
  gap: 16rpx;
}

.sheet-head-text {
  flex: 1;
  min-width: 0;
}

.sheet-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #0f2942;
  line-height: 1.3;
}

.sheet-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7a96b3;
  line-height: 1.35;
}

.sheet-close {
  font-size: 44rpx;
  color: #999999;
  line-height: 1;
}

.sheet-scroll {
  flex: 1;
  width: 100%;
  height: 520rpx;
  max-height: calc(78vh - 200rpx);
  min-height: 280rpx;
  box-sizing: border-box;
}

.sheet-scroll-inner {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.liked-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  min-height: 112rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #eef2f7;
}

.liked-row:last-child {
  border-bottom: none;
}

.liked-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 3rpx solid #e0f0ff;
}

.liked-info {
  flex: 1;
  min-width: 0;
}

.liked-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f2942;
}

.liked-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #7a96b3;
}

.liked-arrow {
  font-size: 36rpx;
  color: #bbbbbb;
}

.liked-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #7a96b3;
}

.share-quota-sheet {
  padding: 36rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.share-quota-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #0f2942;
  margin-bottom: 16rpx;
}

.share-quota-desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.55;
  color: #4a6478;
  margin-bottom: 12rpx;
}

.share-quota-tip {
  display: block;
  font-size: 22rpx;
  color: #1e88e5;
  margin-bottom: 20rpx;
}

.share-quota-btn {
  margin-top: 16rpx;
  background: linear-gradient(135deg, #5bb8ff, #4da7f8);
  color: #1a1a1a;
  box-shadow: 0 10rpx 28rpx rgba(77, 167, 248, 0.35);
}

.share-quota-capped {
  display: block;
  margin-top: 8rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #8a9aaa;
}

.share-quota-hint {
  display: block;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #8a9aaa;
  line-height: 1.45;
  text-align: center;
}

.share-quota-cancel {
  display: flex;
  width: 100%;
  margin-top: 8rpx;
  justify-content: center;
}

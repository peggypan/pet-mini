.avatar-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, rgba(197, 255, 74, 0.12) 0%, #FFFFFF 100%);
  border-radius: 24rpx;
  border: 2rpx dashed rgba(76, 230, 0, 0.35);
}

.avatar-preview {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
}

.avatar-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.avatar-tip {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.avatar-sub {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
}

.avatar-change {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #2DB300;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item .label {
  font-size: 28rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
}

.form-item input,
.form-item .picker,
.form-item textarea {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.form-item .picker {
  display: flex;
  align-items: center;
}

.form-item textarea {
  height: 160rpx;
  padding: 20rpx 24rpx;
  line-height: 1.6;
}

.submit-btn {
  margin-top: 40rpx;
}

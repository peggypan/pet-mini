.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item .label {
  font-size: 28rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
}

.form-item input,
.form-item .picker,
.form-item textarea {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.form-item .picker {
  display: flex;
  align-items: center;
}

.form-item textarea {
  height: 160rpx;
  padding: 20rpx 24rpx;
}

.submit-btn {
  margin-top: 40rpx;
}

.avatar-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, rgba(126, 200, 255, 0.12) 0%, #FFFFFF 100%);
  border-radius: 24rpx;
  border: 2rpx dashed rgba(77, 167, 248, 0.35);
}

.avatar-preview {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
}

.avatar-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.avatar-tip {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.avatar-sub {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
}

.avatar-change {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #1E88E5;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item .label {
  font-size: 28rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
}

.form-item input,
.form-item .picker,
.form-item textarea {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.form-item .picker {
  display: flex;
  align-items: center;
}

.form-item textarea {
  height: 160rpx;
  padding: 20rpx 24rpx;
  line-height: 1.6;
}

.submit-btn {
  width: 100%;
  margin: 40rpx 0 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.field-hint {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.privacy-hint {
  color: #e08a5a;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f0f4f8;
}

.photo-thumb {
  width: 100%;
  height: 100%;
}

.photo-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 28rpx;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  border: 2rpx dashed rgba(77, 167, 248, 0.45);
  background: rgba(126, 200, 255, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #1e88e5;
}

.photo-add-icon {
  font-size: 48rpx;
  line-height: 1;
  font-weight: 300;
}

.photo-add-text {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.vaccine-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.vaccine-chip {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #666666;
  background: #f5f8fc;
  border: 2rpx solid #e8eef4;
}

.healing-section {
  padding: 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, rgba(232, 250, 241, 0.55) 0%, #ffffff 100%);
  border: 2rpx solid rgba(45, 106, 79, 0.12);
}

.healing-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.label.sub {
  display: block;
  margin-top: 20rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.healing-chips {
  margin-top: 4rpx;
}

.healing-chip.on {
  background: rgba(45, 106, 79, 0.12);
  color: #2d6a4f;
  border-color: rgba(45, 106, 79, 0.35);
  font-weight: 700;
}

.healing-intro {
  width: 100%;
  min-height: 140rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #ffffff;
  font-size: 26rpx;
  line-height: 1.5;
}

.healing-tip-inline {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #5a7a6a;
  line-height: 1.55;
}

.vaccine-chip.on {
  color: #1e88e5;
  background: rgba(126, 200, 255, 0.22);
  border-color: rgba(77, 167, 248, 0.55);
  font-weight: 600;
}

.proof-upload {
  padding: 24rpx;
  border-radius: 16rpx;
  border: 2rpx dashed rgba(77, 167, 248, 0.35);
  background: #fafcfe;
  text-align: center;
}

.proof-preview {
  width: 100%;
  max-height: 320rpx;
  border-radius: 12rpx;
}

.proof-placeholder {
  padding: 24rpx 0;
  color: #666666;
  font-size: 26rpx;
}

.proof-icon {
  display: block;
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.proof-change {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #1e88e5;
}

.loc-pick {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: rgba(0, 145, 255, 0.08);
  border-radius: 16rpx;
  border: 2rpx dashed rgba(0, 145, 255, 0.35);
  box-sizing: border-box;
}

.loc-info {
  flex: 1;
  min-width: 0;
}

.loc-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.loc-addr {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.45;
}

.loc-addr.sub {
  margin-top: 4rpx;
  color: var(--text-muted);
}

.loc-arrow {
  font-size: 32rpx;
  color: #0091ff;
  margin-left: 12rpx;
}

.loc-clear {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999999;
}

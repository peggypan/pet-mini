page {
  background: linear-gradient(180deg, #E8F8EF 0%, #F5F5F5 40%, #F5F5F5 100%);
}

.page {
  padding: 20rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.coin-box {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.coin-icon {
  font-size: 28rpx;
}

.coin-num {
  font-size: 28rpx;
  font-weight: 800;
  color: #1A1A1A;
}

.top-actions {
  display: flex;
  gap: 10rpx;
}

.top-btn {
  padding: 12rpx 18rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #666666;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.level-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.pet-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #1A1A1A;
}

.stage-tag {
  font-size: 22rpx;
  color: #2DB300;
  background: rgba(197, 255, 74, 0.3);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.growth-panel {
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.growth-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.growth-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.growth-val {
  font-size: 28rpx;
  font-weight: 800;
  color: #2DB300;
}

.growth-bar {
  height: 20rpx;
  background: #F0F0F0;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.growth-fill {
  height: 100%;
  background: linear-gradient(90deg, #A2EFD6, #4CE600);
  border-radius: 10rpx;
  transition: width 0.6s ease;
}

.feed-summary {
  display: block;
  font-size: 22rpx;
  color: #666666;
  margin-bottom: 4rpx;
}

.growth-hint {
  display: block;
  font-size: 20rpx;
  color: #999999;
}

.growth-hint.done {
  color: #2DB300;
  font-weight: 600;
}

.exp-bar {
  position: relative;
  height: 24rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.exp-fill {
  height: 100%;
  background: linear-gradient(90deg, #D4FF00, #4CE600);
  border-radius: 12rpx;
  transition: width 0.4s ease;
}

.exp-text {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: #666666;
  font-weight: 600;
}

.scene {
  position: relative;
  height: 420rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.scene-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, #D4FFAA 0%, #E8F8EF 50%, #FFFFFF 100%);
}

.dialogue {
  position: absolute;
  top: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  max-width: 80%;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #333333;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 2;
}

.dialogue.pop {
  animation: pop 0.4s ease;
}

.pet-stage {
  position: absolute;
  left: 50%;
  top: 52%;
  transform: translate(-50%, -50%);
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pet-stage.bounce {
  animation: bounce 0.6s ease;
}

.photo-shell {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-scale-wrap {
  transition: transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  transform-origin: center bottom;
}

.pet-photo {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
  background: #FFFFFF;
}

.photo-shell.hatching .pet-photo {
  opacity: 0.35;
  filter: blur(2rpx);
}

.egg-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation: wobble 2s ease-in-out infinite;
}

.egg-icon {
  font-size: 120rpx;
}

.egg-tip {
  font-size: 22rpx;
  color: #666666;
  margin-top: 8rpx;
}

.no-photo {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
}

.pet-emoji {
  font-size: 120rpx;
  line-height: 1;
  margin-bottom: 16rpx;
}

.no-photo-tip {
  font-size: 24rpx;
  color: #666666;
  text-align: center;
  margin-bottom: 20rpx;
}

.upload-btn {
  padding: 16rpx 36rpx;
  background: linear-gradient(135deg, #D4FF00, #4CE600);
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A1A;
  box-shadow: 0 6rpx 20rpx rgba(76, 230, 0, 0.35);
}

.mood-badge {
  position: absolute;
  right: -24rpx;
  top: -16rpx;
  font-size: 48rpx;
}

.photo-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.photo-sync {
  font-size: 24rpx;
  color: #666666;
  padding: 8rpx 16rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
}

.photo-gen-tag {
  font-size: 20rpx;
  color: #2DB300;
  background: rgba(197, 255, 74, 0.25);
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

.scene-deco {
  position: absolute;
  bottom: 24rpx;
  font-size: 40rpx;
  opacity: 0.6;
}

.deco-left { left: 32rpx; }
.deco-right { right: 32rpx; }

.stats-panel {
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.stat-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.stat-row:last-child {
  margin-bottom: 0;
}

.stat-label {
  width: 64rpx;
  font-size: 22rpx;
  color: #999999;
}

.stat-track {
  flex: 1;
  height: 16rpx;
  background: #F0F0F0;
  border-radius: 8rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.stat-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.stat-val {
  width: 48rpx;
  text-align: right;
  font-size: 22rpx;
  color: #666666;
  font-weight: 600;
}

.inventory {
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.inv-title {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

.inv-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.inv-item {
  padding: 8rpx 18rpx;
  background: #F5F5F5;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #333333;
}

.inv-empty {
  font-size: 24rpx;
  color: #CCCCCC;
}

.actions {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.action-btn:active {
  background: rgba(197, 255, 74, 0.2);
  transform: scale(0.96);
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 6rpx;
}

.action-label {
  font-size: 22rpx;
  color: #333333;
  font-weight: 600;
}

.action-sub {
  font-size: 18rpx;
  color: #2DB300;
  margin-top: 2rpx;
}

.feed-btn {
  background: linear-gradient(180deg, rgba(197, 255, 74, 0.2) 0%, #FFFFFF 100%);
}

.tip {
  text-align: center;
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.reset-link {
  text-align: center;
  font-size: 22rpx;
  color: #CCCCCC;
  padding: 12rpx;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.panel {
  width: 100%;
  max-height: 70vh;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
}

.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.panel-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #1A1A1A;
  margin-bottom: 20rpx;
}

.panel-head .panel-title {
  margin-bottom: 0;
}

.panel-coin {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.log-scroll {
  max-height: 50vh;
}

.log-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.log-time {
  display: block;
  font-size: 20rpx;
  color: #CCCCCC;
  margin-bottom: 4rpx;
}

.log-text {
  font-size: 26rpx;
  color: #333333;
}

.log-empty {
  padding: 40rpx;
  text-align: center;
  color: #CCCCCC;
  font-size: 26rpx;
}

.shop-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.shop-icon {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.shop-info {
  flex: 1;
  min-width: 0;
}

.shop-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.shop-desc {
  font-size: 22rpx;
  color: #999999;
}

.shop-right {
  text-align: right;
}

.shop-owned {
  display: block;
  font-size: 20rpx;
  color: #999999;
  margin-bottom: 4rpx;
}

.shop-price {
  font-size: 26rpx;
  font-weight: 700;
  color: #2DB300;
}

@keyframes bounce {
  0%, 100% { transform: translate(-50%, -50%) scale(1); }
  30% { transform: translate(-50%, -56%) scale(1.06); }
  60% { transform: translate(-50%, -48%) scale(0.97); }
}

@keyframes wobble {
  0%, 100% { transform: rotate(-3deg); }
  50% { transform: rotate(3deg); }
}

@keyframes pop {
  0% { transform: translateX(-50%) scale(0.8); opacity: 0; }
  60% { transform: translateX(-50%) scale(1.05); }
  100% { transform: translateX(-50%) scale(1); opacity: 1; }
}

<view class="page">
  <view class="action-row">
    <view class="action-card lost" bindtap="onPublishLost">
      <text class="action-icon">🐕‍🦺</text>
      <text class="action-name">寻宠 / 招领</text>
      <text class="action-tip">选点 · 图片 · 视频 · 分享</text>
    </view>
    <view class="action-card adopt" bindtap="onPublishAdopt">
      <text class="action-icon">🐱</text>
      <text class="action-name">领养救助</text>
      <text class="action-tip">选点 · 图片 · 视频 · 分享</text>
    </view>
  </view>

  <view class="tip-box">
    <text class="tip-text">🐾 {{riskAdopt}}</text>
  </view>

  <view class="filters">
    <view
      class="filter {{filter === item.id ? 'on' : ''}}"
      wx:for="{{filters}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onFilter"
    >{{item.name}}</view>
  </view>

  <view class="load-error" wx:if="{{loadError}}">{{loadError}}</view>

  <view class="list">
    <view
      class="item"
      wx:for="{{displayList}}"
      wx:key="id"
      bindtap="onItemTap"
      data-id="{{item.id}}"
    >
      <view class="cover-wrap aspect-34 aspect-34-sm">
        <image class="cover" src="{{item.cover}}" mode="aspectFill" lazy-load="{{true}}"></image>
      </view>
      <view class="body">
        <view class="item-head">
          <view class="item-tags">
            <text class="tag tag-lost" wx:if="{{item.kind === 'lost'}}">寻宠</text>
            <text class="tag tag-found" wx:if="{{item.kind === 'found'}}">招领</text>
            <text class="tag tag-rescue" wx:if="{{item.kind === 'rescue'}}">救助</text>
            <text class="tag tag-adopt" wx:if="{{item.kind === 'adopt'}}">领养</text>
          </view>
          <view class="item-head-right">
            <text class="time">{{item.time}}</text>
            <text
              class="item-delete"
              wx:if="{{item.canDelete}}"
              catchtap="onDeleteItem"
              data-id="{{item.id}}"
            >删除</text>
          </view>
        </view>
        <text class="preview preview-headline">{{item.preview}}</text>
        <text
          class="loc place-tap"
          wx:if="{{item.location}}"
          catchtap="onOpenPlace"
          data-name="{{item.locationName || item.location}}"
          data-place="{{item.location}}"
          data-address="{{item.locationAddress || item.location}}"
          data-lat="{{item.locationLat}}"
          data-lng="{{item.locationLng}}"
        >🐾 {{item.location}}</text>
        <text class="rescue-author" wx:if="{{item.authorLine}}">{{item.authorLine}}</text>
      </view>
    </view>

    <view class="empty" wx:if="{{!loadError && displayList.length === 0}}">
      <text class="empty-icon">🐾</text>
      <text class="empty-title">暂无同城信息</text>
      <text class="empty-desc">点击上方按钮发布寻宠、招领或领养</text>
    </view>
  </view>
</view>

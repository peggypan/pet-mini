page {
  background: #f5f5f5;
}

.page {
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.label + .field,
.label + .textarea {
  margin-top: 0;
}

.avatar-row {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: #eef4fc;
  flex-shrink: 0;
}

.avatar-meta {
  flex: 1;
  min-width: 0;
}

.avatar-tip {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.avatar-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
}

.arrow {
  font-size: 36rpx;
  color: #cccccc;
}

.field {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  margin-bottom: 28rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.55;
  box-sizing: border-box;
}

.count {
  display: block;
  text-align: right;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #bbbbbb;
}

.save {
  background: linear-gradient(135deg, #6ec8ff, #4da7f8);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
}

.save::after {
  border: none;
}

.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 24rpx 8rpx;
  font-size: 26rpx;
  color: #4da7f8;
}

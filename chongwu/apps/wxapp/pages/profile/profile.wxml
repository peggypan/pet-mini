<view class="page">
  <view class="hero">
    <image class="hero-bg" src="{{pet.cover || pet.avatar}}" mode="aspectFill"></image>
    <view class="hero-mask"></view>
    <view class="hero-content">
      <view class="pet-card">
        <image class="pet-avatar" src="{{pet.avatar}}" mode="aspectFill"></image>
        <view class="pet-info">
          <text class="pet-name">{{pet.name}}</text>
          <text class="pet-breed">{{pet.breed}} · {{pet.age}}</text>
          <text class="pet-personality" wx:if="{{pet.personality}}">性格 · {{pet.personality}}</text>
          <view class="tag-row" wx:if="{{pet.socialTags && pet.socialTags.length}}">
            <text class="tag" wx:for="{{pet.socialTags}}" wx:key="*this">{{item}}</text>
          </view>
        </view>
        <view class="edit-btn" bindtap="onEditPet">编辑</view>
      </view>
    </view>
  </view>

  <button
    class="login-bar"
    wx:if="{{!isLogin}}"
    open-type="getPhoneNumber|agreePrivacyAuthorization"
    bindgetphonenumber="onGetPhoneNumber"
    bindagreeprivacyauthorization="onAgreePrivacyAuthorization"
  >手机号登录，开启交友之旅 ›</button>

  <view class="stats">
    <view class="stat" bindtap="onMyPosts">
      <text class="stat-num">{{stats.posts}}</text>
      <text class="stat-lab">动态</text>
    </view>
    <view class="stat" bindtap="onMyEvents">
      <text class="stat-num">{{stats.events}}</text>
      <text class="stat-lab">约局</text>
    </view>
    <view class="stat" bindtap="onMyFriends">
      <text class="stat-num">{{stats.friends}}</text>
      <text class="stat-lab">宠友</text>
    </view>
    <view class="stat" bindtap="onMessagesTap">
      <text class="stat-num">{{unreadCount}}</text>
      <text class="stat-lab">消息</text>
    </view>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="onEditPet">
      <text class="menu-icon">🐾</text>
      <text class="menu-text">完善宠物交友名片</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMyFriends">
      <text class="menu-icon">📍</text>
      <text class="menu-text">附近宠友与关注</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onHelpTap">
      <text class="menu-icon">?</text>
      <text class="menu-text">新手指南</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onAboutTap">
      <text class="menu-icon">ⓘ</text>
      <text class="menu-text">关于宠头头</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <button class="logout" bindtap="onLogout" wx:if="{{isLogin}}">退出登录</button>
</view>

<!-- 个人中心：宠物 Hero + 窄玻璃身份卡 + 数据条 + 功能格 + 设置 -->
<view class="page">
  <!-- Hero 区域 -->
  <view class="hero">
    <image class="hero-img" src="{{pet.cover || pet.avatar}}" mode="aspectFill"></image>
    <view class="hero-mask"></view>
    <view class="hero-status" style="padding-top: {{statusBarHeight}}px">
      <view class="bell-btn" bindtap="onNotifyTap">
        <text class="bell-icon">🔔</text>
      </view>
    </view>

    <!-- 窄版身份卡：叠在 Hero 底部，液态玻璃质感 -->
    <view class="identity-wrap">
      <view class="identity-card">
        <view class="identity-card-inner">
          <view class="qr-box">
            <view class="qr-inner">
              <view class="qr-grid">
                <view class="qr-cell" wx:for="{{qrCells}}" wx:key="*this" style="opacity: {{item}}"></view>
              </view>
            </view>
          </view>
          <view class="identity-info">
            <text class="id-name">{{pet.name}}</text>
            <text class="id-age">年龄 · {{pet.age}}</text>
            <text class="id-days">已陪伴你 {{pet.days}} 天</text>
          </view>
        </view>
        <!-- 底部液态玻璃层 -->
        <view class="liquid-glass"></view>
      </view>
    </view>
  </view>

  <!-- 未登录提示 -->
  <view class="login-tip" wx:if="{{!isLogin}}" bindtap="onLogin">
    <text>点击登录，同步宠物档案 ›</text>
  </view>

  <!-- 数据统计 -->
  <view class="stats-bar">
    <view class="stat-cell">
      <text class="stat-val">{{pet.weight}}</text>
      <text class="stat-lab">体重</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-cell">
      <text class="stat-val">{{pet.recordDays}}</text>
      <text class="stat-lab">驱虫</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-cell">
      <text class="stat-val">{{pet.visits}}</text>
      <text class="stat-lab">洗澡</text>
    </view>
  </view>

  <!-- 2x2 功能格 -->
  <view class="action-grid">
    <view class="action-cell" bindtap="onOrdersTap">
      <text class="action-icon">⇄</text>
      <text class="action-label">订单/交换</text>
    </view>
    <view class="action-cell" bindtap="onHealthTap">
      <text class="action-icon">✚</text>
      <text class="action-label">医疗记录</text>
    </view>
    <view class="action-cell" bindtap="onFavoriteTap">
      <text class="action-icon">♡</text>
      <text class="action-label">我的收藏</text>
    </view>
    <view class="action-cell" bindtap="onFamilyTap">
      <text class="action-icon">☺</text>
      <text class="action-label">我的家庭</text>
    </view>
  </view>

  <!-- 设置列表 -->
  <view class="settings-list">
    <view class="setting-item" bindtap="onDarkModeTap">
      <view class="setting-left">
        <text class="setting-icon">☾</text>
        <text class="setting-text">深色模式</text>
      </view>
      <switch checked="{{false}}" color="#6FCF97" disabled />
    </view>
    <view class="setting-item" bindtap="onHelpTap">
      <view class="setting-left">
        <text class="setting-icon">?</text>
        <text class="setting-text">帮助中心</text>
      </view>
      <text class="setting-arrow">›</text>
    </view>
    <view class="setting-item" bindtap="onAboutTap">
      <view class="setting-left">
        <text class="setting-icon">ⓘ</text>
        <text class="setting-text">关于我们</text>
      </view>
      <text class="setting-arrow">›</text>
    </view>
  </view>

  <button class="logout-btn" bindtap="onLogout" wx:if="{{isLogin}}">退出登录</button>

  <view class="page-bottom-space"></view>
</view>

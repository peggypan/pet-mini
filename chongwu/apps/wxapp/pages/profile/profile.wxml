<view class="page">
  <view class="header">
    <image class="avatar" src="{{pet.avatar}}" mode="aspectFill"></image>
    <view class="info">
      <text class="name">{{isLogin ? (userInfo.nickname || '宠友') : '未登录'}}</text>
      <text class="tags" bindtap="onCityTap">宠物 {{stats.posts >= 0 ? 1 : 0}} · 信用良好 · 📍 {{city}}</text>
    </view>
  </view>

  <view class="login-block" wx:if="{{!isLogin}}">
    <button
      id="login-phone-btn"
      class="login-bar"
      open-type="getPhoneNumber|agreePrivacyAuthorization"
      bindgetphonenumber="onGetPhoneNumber"
      bindagreeprivacyauthorization="onAgreePrivacyForPhone"
    >微信授权手机号登录</button>
    <text class="login-hint">需公众平台开通「手机号快速验证」后才会弹出微信选号窗；未开通时会提示 no permission</text>
    <button class="login-bar login-bar-secondary" bindtap="onWxLogin">微信快捷登录（开发用）</button>
  </view>

  <view class="stats">
    <view class="stat"><text class="num">{{stats.buddies}}</text><text class="lab">宠友</text></view>
    <view class="stat"><text class="num">{{stats.posts}}</text><text class="lab">发布</text></view>
    <view class="stat"><text class="num">{{stats.events}}</text><text class="lab">活动</text></view>
    <view class="stat" bindtap="onMessages"><text class="num">{{unreadCount}}</text><text class="lab">消息</text></view>
  </view>

  <view class="group">
    <text class="group-title">我的宠物 · 电子宠证</text>
    <view class="menu-item raise-entry" bindtap="onPetCert">
      <view class="raise-left">
        <text>🪪 电子宠证 & 数字宠物</text>
        <text class="raise-sub">宠证信息 · 上传照片养成 · 喂食长大</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onEditPet"><text>🐾 管理宠物档案</text><text class="arrow">›</text></view>
  </view>

  <view class="group">
    <text class="group-title">我的俱乐部</text>
    <view class="menu-item raise-entry" bindtap="onClubApply">
      <view class="raise-left">
        <text>🏟 成为主理人</text>
        <text class="raise-sub">填写入驻信息 · 创建自己的俱乐部</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMyClubs"><text>👑 我的俱乐部</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="onJoinedClubs"><text>🐾 加入的俱乐部</text><text class="arrow">›</text></view>
  </view>

  <view class="group">
    <text class="group-title">消息中心</text>
    <view class="menu-item" bindtap="onMessages"><text>💬 私信 / 通知</text><text class="arrow">›</text></view>
  </view>

  <view class="group">
    <text class="group-title">我的业务</text>
    <view class="menu-item" bindtap="onMyBuddy"><text>我发布的搭子</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="onMyPosts"><text>我发布的动态</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="onMyEvents"><text>我发起/报名的活动</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="onMyHelp"><text>🐕‍🦺 寻宠·领养救助</text><text class="arrow">›</text></view>
  </view>

  <view class="group">
    <text class="group-title">订单与服务</text>
    <view class="menu-item" bindtap="onOrders"><text>商家服务预约订单</text><text class="arrow">›</text></view>
  </view>

  <view class="group">
    <view class="menu-item" bindtap="onAbout"><text>关于我们 / 用户协议</text><text class="arrow">›</text></view>
  </view>

  <button class="logout" wx:if="{{isLogin}}" bindtap="onLogout">退出登录</button>
</view>

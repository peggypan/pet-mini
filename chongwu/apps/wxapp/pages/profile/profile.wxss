page {
  background: #EEF4FA;
}

.page {
  min-height: 100vh;
  padding-bottom: 0;
}

/* Hero */
.hero {
  position: relative;
  height: 520rpx;
  overflow: visible;
  background: #D8E6F2;
}

.hero-img {
  width: 100%;
  height: 100%;
  display: block;
  box-sizing: border-box;
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 160rpx;
  background: linear-gradient(transparent, rgba(238, 244, 250, 0.55) 60%, #EEF4FA);
  pointer-events: none;
}

.hero-status {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: flex-end;
  padding-right: 28rpx;
  padding-bottom: 12rpx;
  box-sizing: border-box;
  z-index: 3;
}

.bell-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  backdrop-filter: blur(12px);
}

.bell-icon {
  font-size: 32rpx;
}

/* 窄版身份卡容器 —— 叠在 Hero 底部中央 */
.identity-wrap {
  position: absolute;
  left: 0;
  right: 0;
  bottom: -36rpx;
  z-index: 4;
  display: flex;
  justify-content: center;
  padding: 0 72rpx;
  box-sizing: border-box;
}

.identity-card {
  position: relative;
  width: 100%;
  max-width: 560rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow:
    0 16rpx 40rpx rgba(42, 42, 42, 0.1),
    0 2rpx 0 rgba(255, 255, 255, 0.7) inset;
}

.identity-card-inner {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.38);
  backdrop-filter: blur(24px);
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  border-radius: 28rpx;
  border-bottom: none;
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
}

/* 底部液态玻璃层 */
.liquid-glass {
  position: relative;
  z-index: 1;
  height: 28rpx;
  margin-top: -2rpx;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.42) 0%,
    rgba(200, 236, 220, 0.35) 40%,
    rgba(255, 255, 255, 0.18) 100%
  );
  backdrop-filter: blur(28px);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-top: none;
  border-radius: 0 0 28rpx 28rpx;
  box-shadow:
    0 12rpx 28rpx rgba(111, 207, 151, 0.12),
    inset 0 -6rpx 16rpx rgba(255, 255, 255, 0.35);
}

.liquid-glass::before {
  content: '';
  position: absolute;
  left: 12%;
  right: 12%;
  top: 4rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.7),
    transparent
  );
}

.qr-box {
  width: 96rpx;
  height: 96rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.92);
  padding: 8rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.qr-inner {
  width: 100%;
  height: 100%;
  background: #EEF4FA;
  border-radius: 6rpx;
  overflow: hidden;
}

.qr-grid {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  height: 100%;
}

.qr-cell {
  width: 16.66%;
  height: 16.66%;
  background: #2A2A2A;
}

.identity-info {
  flex: 1;
  min-width: 0;
}

.id-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-bottom: 4rpx;
}

.id-age {
  display: block;
  font-size: 24rpx;
  color: #6B6B6B;
  margin-bottom: 4rpx;
}

.id-days {
  display: block;
  font-size: 22rpx;
  color: #4DB87A;
  font-weight: 500;
}

.login-tip {
  position: relative;
  z-index: 10;
  margin: 72rpx 28rpx 12rpx;
  padding: 20rpx 28rpx;
  background: rgba(111, 207, 151, 0.14);
  border-radius: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #4DB87A;
  font-weight: 500;
  line-height: 1.4;
  border: none;
  box-sizing: border-box;
  width: auto;
  display: block;
}

.login-tip::after {
  border: none;
}

.login-tip-hover {
  opacity: 0.85;
}

/* 统计条 */
.stats-bar {
  display: flex;
  align-items: center;
  margin: 20rpx 28rpx 28rpx;
  padding: 28rpx 16rpx;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 42, 42, 0.04);
}

/* 登录后无提示条时，统计条需自己留出身份卡下沉空间 */
.hero + .stats-bar {
  margin-top: 56rpx;
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-val {
  font-size: 34rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-bottom: 6rpx;
}

.stat-lab {
  font-size: 22rpx;
  color: #9A9A9A;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #EDE8E0;
}

/* 功能格 */
.action-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin: 0 28rpx 28rpx;
}

.action-cell {
  width: 48%;
  margin-bottom: 16rpx;
  padding: 40rpx 20rpx;
  background: #fff;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(42, 42, 42, 0.04);
  box-sizing: border-box;
}

.action-icon {
  font-size: 44rpx;
  color: #4DB87A;
  margin-bottom: 16rpx;
  font-weight: 300;
}

.action-label {
  font-size: 26rpx;
  color: #2A2A2A;
  font-weight: 600;
}

/* 设置列表 */
.settings-list {
  margin: 0 28rpx 24rpx;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(42, 42, 42, 0.04);
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid #F0EBE4;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-left {
  display: flex;
  align-items: center;
}

.setting-icon {
  width: 48rpx;
  font-size: 32rpx;
  color: #6B6B6B;
  margin-right: 16rpx;
  text-align: center;
}

.setting-text {
  font-size: 28rpx;
  color: #2A2A2A;
}

.setting-arrow {
  font-size: 32rpx;
  color: #C5C5C5;
}

.logout-btn {
  margin: 0 28rpx 20rpx;
  padding: 24rpx;
  background: #fff;
  color: #FF6B8A;
  font-size: 28rpx;
  border-radius: 24rpx;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(42, 42, 42, 0.04);
}

.logout-btn::after {
  border: none;
}

.page-bottom-space {
  height: 200rpx;
}

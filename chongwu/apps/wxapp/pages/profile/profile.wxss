page {
  background: linear-gradient(180deg, #E8F8EF 0%, #F5F5F5 280rpx, #F5F5F5 100%);
}

.page {
  padding: 24rpx 28rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.name {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #1A1A1A;
}

.tags {
  font-size: 22rpx;
  color: #999999;
}

.login-bar {
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, rgba(197, 255, 74, 0.35) 0%, rgba(76, 230, 0, 0.15) 100%);
  color: #1A1A1A;
  border-radius: 999rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 700;
  height: 88rpx;
  padding: 0 24rpx;
}

.login-bar::after {
  border: none;
}

.stats {
  display: flex;
  padding: 24rpx 8rpx;
  margin-bottom: 20rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.stat {
  flex: 1;
  text-align: center;
}

.num {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #1A1A1A;
}

.lab {
  font-size: 22rpx;
  color: #999999;
}

.group {
  margin-bottom: 20rpx;
  padding: 8rpx 0;
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.group-title {
  display: block;
  padding: 20rpx 28rpx 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  border-top: 1rpx solid #F5F5F5;
  font-size: 28rpx;
  color: #1A1A1A;
}

.arrow {
  color: #CCCCCC;
}

.logout {
  margin-top: 12rpx;
  background: #FFFFFF;
  color: #999999;
  border-radius: 999rpx;
  border: none;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.logout::after {
  border: none;
}

.raise-entry {
  background: linear-gradient(135deg, rgba(197, 255, 74, 0.15) 0%, rgba(255, 255, 255, 0) 100%);
}

.raise-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.raise-sub {
  font-size: 22rpx;
  color: #999999;
}

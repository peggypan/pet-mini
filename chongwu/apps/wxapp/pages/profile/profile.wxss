page { background: #F7FAF5; }

.page {
  min-height: 100vh;
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
}

.hero {
  position: relative;
  height: 480rpx;
  overflow: hidden;
}

.hero-bg {
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(transparent 20%, rgba(47, 74, 56, 0.55) 100%);
}

.hero-content {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 32rpx;
}

.pet-card {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(12px);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
}

.pet-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  border: 4rpx solid #fff;
}

.pet-info {
  flex: 1;
  min-width: 0;
}

.pet-name {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #2D4A38;
  margin-bottom: 6rpx;
}

.pet-breed,
.pet-personality {
  display: block;
  font-size: 24rpx;
  color: #6B8575;
  margin-bottom: 8rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  font-size: 20rpx;
  color: #5BBF88;
  background: rgba(91, 191, 136, 0.12);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.edit-btn {
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(91, 191, 136, 0.16);
  color: #3D8F66;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.login-bar {
  margin: 20rpx 28rpx 0;
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(91, 191, 136, 0.14);
  color: #3D8F66;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  line-height: 1.4;
}

.login-bar::after { border: none; }

.stats {
  display: flex;
  margin: 24rpx 28rpx;
  padding: 24rpx 8rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(91, 140, 110, 0.06);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #2D4A38;
  margin-bottom: 4rpx;
}

.stat-lab {
  font-size: 22rpx;
  color: #9BA89E;
}

.menu {
  margin: 0 28rpx;
  border-radius: 24rpx;
  background: #fff;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(91, 140, 110, 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #EEF2EE;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 48rpx;
  font-size: 28rpx;
  text-align: center;
  margin-right: 16rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #2D4A38;
}

.menu-arrow {
  color: #C5D0C8;
  font-size: 32rpx;
}

.logout {
  margin: 32rpx 28rpx 0;
  background: #fff;
  color: #9BA89E;
  border-radius: 44rpx;
  font-size: 28rpx;
  border: none;
}

.logout::after { border: none; }

page {
  background: #ffffff;
  height: 100%;
}

.profile-root {
  height: 100%;
  position: relative;
}

.page-scroll {
  height: 100vh;
}

.page {
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.login-block-spacer {
  height: 200rpx;
}

.palette-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 72px;
  height: 72px;
  opacity: 0;
  pointer-events: none;
}

.hero {
  position: relative;
  padding: 8rpx 0 0;
  overflow: hidden;
  transition: background 0.45s ease;
}

.hero-bg-layer {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

.hero-bg {
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0.32;
  transform: scale(1.06);
  transition: opacity 0.35s ease;
}

.hero-glass {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    180deg,
    rgba(8, 32, 64, 0.52) 0%,
    rgba(8, 32, 64, 0.38) 38%,
    rgba(8, 32, 64, 0.45) 72%,
    rgba(8, 32, 64, 0.5) 100%
  );
  pointer-events: none;
}

.hero-deco {
  position: absolute;
  left: -100rpx;
  bottom: 120rpx;
  width: 280rpx;
  height: 280rpx;
  z-index: 1;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.12) 0%, transparent 70%);
  pointer-events: none;
}

.hero-toolbar,
.profile-row,
.play-links,
.tag-scroll,
.bio-line,
.activity-area-row,
.mood-bar,
.login-block,
.bento {
  position: relative;
  z-index: 2;
  padding-left: 28rpx;
  padding-right: 28rpx;
}

.tag-row {
  position: relative;
  z-index: 2;
}

.hero-toolbar {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-bottom: 12rpx;
  padding-top: 8rpx;
}

.hero-spacer {
  flex: 1;
}

.edit-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.65);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
}

.edit-icon {
  font-size: 22rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.avatar-wrap {
  position: relative;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 8rpx 24rpx rgba(0, 60, 120, 0.2);
  display: block;
}

.avatar-edit-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  color: #4da7f8;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}

.profile-meta {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
  min-width: 0;
}

.name {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.name-row .name {
  flex: 1;
  margin-bottom: 0;
  min-width: 0;
}

.name-input {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0;
  background: transparent;
}

.name-placeholder {
  color: rgba(255, 255, 255, 0.55);
  font-weight: 600;
}

.name-edit-hint {
  flex-shrink: 0;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.75);
}

.follow-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 20rpx 24rpx;
}

.follow-item {
  display: inline-block;
  padding: 4rpx 0;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  white-space: nowrap;
  padding: 4rpx 0;
}

.follow-item-wide {
  font-size: 24rpx;
}

.follow-num {
  font-weight: 700;
  margin-right: 4rpx;
}

.play-links {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 14rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.5;
}

.play-num {
  font-weight: 800;
  color: #ffffff;
}

.play-dot {
  opacity: 0.5;
}

.tag-scroll {
  width: 100%;
  margin-bottom: 12rpx;
  white-space: nowrap;
}

.tag-row {
  display: inline-flex;
  flex-wrap: nowrap;
  gap: 12rpx;
  padding-right: 28rpx;
}

.tag-chip {
  padding: 10rpx 22rpx;
  font-size: 22rpx;
  border-radius: 12rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
}

.tag-chip.on {
  background: rgba(255, 255, 255, 0.38);
  font-weight: 700;
}

.tag-chip.add {
  background: rgba(30, 100, 160, 0.35);
  border: 2rpx dashed rgba(255, 255, 255, 0.75);
}

.tag-chip.city {
  background: rgba(255, 255, 255, 0.22);
}

.bio-line {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
  padding: 16rpx 20rpx;
  background: rgba(0, 0, 0, 0.08);
  border-radius: 16rpx;
}

.bio-edit {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  flex-shrink: 0;
}

.activity-area-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
  padding: 14rpx 20rpx;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 16rpx;
}

.activity-pin {
  font-size: 28rpx;
  line-height: 1.3;
  flex-shrink: 0;
}

.activity-area-text {
  flex: 1;
  min-width: 0;
}

.activity-area-main {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.4;
}

.activity-area-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.bio-quote {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-right: 8rpx;
  line-height: 1.2;
}

.bio-text {
  flex: 1;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.55;
}

.mood-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.mood-emoji {
  font-size: 30rpx;
}

.mood-track {
  flex: 1;
  height: 10rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  overflow: hidden;
}

.mood-fill {
  width: 58%;
  height: 100%;
  background: linear-gradient(90deg, #5EB8FF 0%, #4DA7F8 100%);
  border-radius: 999rpx;
}

.login-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  z-index: 120;
  padding: 20rpx 28rpx 16rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, #ffffff 28%);
  box-sizing: border-box;
  pointer-events: auto;
}

.login-dock-primary,
.login-dock-secondary {
  display: block;
  width: 100%;
  margin-bottom: 12rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border: none;
}

.login-dock-primary::after,
.login-dock-secondary::after {
  border: none;
}

.login-dock-primary {
  background: linear-gradient(135deg, #5bb8ff, #4da7f8);
  color: #1a1a1a;
}

.login-dock-secondary {
  background: #f0f7ff;
  color: #2a8fd4;
  font-weight: 600;
}

.login-dock-hint {
  display: block;
  font-size: 20rpx;
  line-height: 1.45;
  color: #888;
  text-align: center;
  padding: 0 12rpx;
}

.bento {
  padding-bottom: 16rpx;
}

.bento-row-main {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.bento-card {
  position: relative;
  z-index: 2;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(12px);
  color: #ffffff;
  box-sizing: border-box;
}

.bento-lg {
  flex: 1.55;
  min-height: 148rpx;
  padding: 20rpx 24rpx;
}

.bento-sm {
  flex: 0.85;
  min-height: 148rpx;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.bento-kicker {
  display: block;
  font-size: 20rpx;
  opacity: 0.75;
  margin-bottom: 6rpx;
}

.bento-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 6rpx;
}

.bento-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.bento-arrow {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  font-size: 44rpx;
  font-weight: 300;
  opacity: 0.4;
}

.bento-title-sm {
  font-size: 28rpx;
  font-weight: 800;
}

.bento-sub-sm {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.72);
  font-weight: 500;
}

.bento-scroll {
  width: 100%;
  white-space: nowrap;
}

.bento-scroll-inner {
  display: inline-flex;
  gap: 16rpx;
  padding-right: 28rpx;
}

.bento-mini {
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  flex-shrink: 0;
  width: 220rpx;
  min-height: 104rpx;
  padding: 10rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  backdrop-filter: blur(10px);
  box-sizing: border-box;
  white-space: normal;
  vertical-align: top;
}

.bento-mini-contact-btn {
  display: inline-block;
  margin: 0;
  padding: 0;
  width: 220rpx;
  min-width: 220rpx;
  max-width: 220rpx;
  line-height: normal;
  font-size: inherit;
  font-weight: normal;
  text-align: left;
  color: inherit;
  background: transparent;
  border: none;
  border-radius: 0;
  vertical-align: top;
  flex-shrink: 0;
  overflow: visible;
}

.bento-mini-contact-btn::after {
  border: none;
}

.bento-mini-contact-btn .bento-mini {
  width: 100%;
  box-sizing: border-box;
}

.mini-icon {
  font-size: 30rpx;
  margin-bottom: 4rpx;
  line-height: 1;
}

.mini-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 2rpx;
  line-height: 1.25;
}

.mini-sub {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.68);
  line-height: 1.3;
}

.sheet {
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 0;
  box-shadow: 0 -12rpx 40rpx rgba(0, 40, 80, 0.08);
  margin-top: -4rpx;
}

.tabs {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx 8rpx;
  gap: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab {
  position: relative;
  padding-bottom: 14rpx;
  font-size: 28rpx;
  color: #999999;
  font-weight: 500;
  flex-shrink: 0;
}

.tab.on {
  color: #1a1a1a;
  font-weight: 800;
}

.tab.on::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 6rpx;
  border-radius: 999rpx;
  background: #4DA7F8;
}

.tab-more {
  margin-left: auto;
  font-size: 36rpx;
  color: #cccccc;
  padding: 0 8rpx 14rpx;
  line-height: 1;
}

.feed-list {
  padding: 12rpx 28rpx 0;
}

.feed-item {
  margin-bottom: 20rpx;
}

.feed-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.feed-date {
  font-size: 26rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.feed-badge {
  font-size: 22rpx;
  color: #ff9500;
  background: rgba(255, 149, 0, 0.12);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.feed-card {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 20rpx;
  border: 1rpx solid #f0f0f0;
}

.feed-cover-wrap {
  border-radius: 16rpx;
  overflow: hidden;
  background: #e8f4fc;
}

.feed-cover {
  background: #e8f4fc;
}

.feed-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.feed-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.feed-loc {
  font-size: 24rpx;
  color: #666666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-org {
  font-size: 22rpx;
  color: #999999;
}

.feed-empty {
  padding: 28rpx 0 12rpx;
  text-align: center;
}

.feed-empty-icon {
  display: block;
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.feed-empty-text {
  display: block;
  font-size: 26rpx;
  color: #bbbbbb;
  margin-bottom: 20rpx;
}

.feed-empty-actions {
  display: flex;
  justify-content: center;
  gap: 32rpx;
}

.feed-link {
  color: #4da7f8;
}

.sheet-footer {
  padding: 24rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #ffffff;
}

.stat-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 10050;
  background: rgba(0, 0, 0, 0.45);
}

.stat-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10051;
  min-height: 52vh;
  max-height: 82vh;
  background: #f5f8fc;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.28s ease;
}

.stat-sheet.show {
  transform: translateY(0);
}

.stat-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
}

.stat-sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a2a3a;
}

.stat-sheet-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 40rpx;
  color: #8a97a6;
}

.stat-sheet-summary {
  margin: 0 32rpx 16rpx;
  padding: 16rpx 20rpx;
  background: #ffffff;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #5c6b7a;
  line-height: 1.5;
}

.stat-sheet-scroll {
  flex: 1;
  height: 0;
  min-height: 320rpx;
  padding: 0 32rpx 8rpx;
  box-sizing: border-box;
}

.stat-peer-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.stat-peer-row:active {
  opacity: 0.88;
}

.stat-peer-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #e8eef5;
}

.stat-peer-body {
  flex: 1;
  min-width: 0;
}

.stat-peer-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a2a3a;
}

.stat-peer-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8a97a6;
}

.stat-peer-arrow {
  font-size: 36rpx;
  color: #c5ced8;
}

.stat-sheet-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8a97a6;
  box-sizing: border-box;
}

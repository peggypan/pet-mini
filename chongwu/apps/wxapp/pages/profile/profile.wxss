page {
  background: var(--bg-primary);
}

/* 用户信息区 */
.user-header {
  background: linear-gradient(135deg, #FFE8D6 0%, #FFD6C6 100%);
  padding: 40rpx 20rpx 32rpx;
  border-radius: 0 0 32rpx 32rpx;
  margin: -20rpx -20rpx 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--bg-white);
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 8rpx 24rpx rgba(255, 139, 123, 0.2);
}

.user-detail {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.user-tags {
  display: flex;
  gap: 8rpx;
}

.vip-tag {
  font-size: 22rpx;
  color: white;
  background: linear-gradient(135deg, var(--accent) 0%, #FFB347 100%);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.user-action {
  padding: 12rpx;
}

.action-icon {
  font-size: 32rpx;
  color: var(--text-secondary);
}

.login-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.user-avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--bg-white);
  opacity: 0.6;
}

.login-btn {
  padding: 20rpx 48rpx;
  background: var(--primary);
  color: white;
  font-size: 28rpx;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(255, 139, 123, 0.3);
}

.login-btn::after {
  border: none;
}

/* 数据统计 */
.stats-row {
  display: flex;
  background: var(--bg-white);
  margin: 0 20rpx 20rpx;
  border-radius: 24rpx;
  padding: 32rpx 20rpx;
  box-shadow: var(--shadow-soft);
  border: 1rpx solid var(--border-color);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 菜单区块 */
.menu-section {
  background: var(--bg-white);
  margin: 0 20rpx 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-soft);
  border: 1rpx solid var(--border-color);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--border-color);
  transition: background 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--bg-warm);
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon {
  font-size: 40rpx;
}

.menu-text {
  font-size: 30rpx;
  color: var(--text-primary);
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--text-light);
}

/* 退出按钮 */
.logout-btn {
  margin: 0 20rpx 20rpx;
  padding: 28rpx;
  background: var(--bg-white);
  color: var(--danger);
  font-size: 30rpx;
  border-radius: 24rpx;
  border: 2rpx solid var(--danger);
  box-shadow: var(--shadow-soft);
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  background: var(--danger-bg);
}

/* 底部温馨语 */
.warm-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 40rpx 20rpx 60rpx;
}

.warm-icon {
  font-size: 32rpx;
}

.warm-text {
  font-size: 26rpx;
  color: var(--text-muted);
}

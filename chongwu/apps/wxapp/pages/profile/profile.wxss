/* 用户卡片 */
.user-card {
  padding: 40rpx;
  background: linear-gradient(135deg, #FFE8D6 0%, #FFD6C6 100%);
  border-radius: 0 0 40rpx 40rpx;
  margin: -20rpx -20rpx 32rpx;
  position: relative;
  overflow: hidden;
}

.user-card::after {
  content: '💕';
  position: absolute;
  right: 40rpx;
  top: 40rpx;
  font-size: 80rpx;
  opacity: 0.15;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.user-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--bg-white);
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 8rpx 24rpx rgba(255, 139, 123, 0.2);
}

.user-detail {
  flex: 1;
}

.user-name {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.user-phone {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
}

.member-badge {
  display: inline-block;
  background: linear-gradient(135deg, var(--accent) 0%, #FFB347 100%);
  color: white;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(255, 179, 71, 0.3);
}

/* 登录区域 */
.login-section {
  text-align: center;
  padding: 80rpx 40rpx;
  background: linear-gradient(135deg, #FFE8D6 0%, #FFD6C6 100%);
  border-radius: 0 0 40rpx 40rpx;
  margin: -20rpx -20rpx 32rpx;
  position: relative;
  overflow: hidden;
}

.login-section::after {
  content: '🐾';
  position: absolute;
  right: 40rpx;
  bottom: 40rpx;
  font-size: 100rpx;
  opacity: 0.1;
}

.login-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--bg-white);
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 139, 123, 0.2);
}

.login-tip {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 32rpx;
}

.login-btn {
  width: 400rpx;
  margin: 0 auto;
}

/* 温馨统计卡片 */
.stats-card {
  display: flex;
  justify-content: space-around;
  padding: 36rpx 20rpx;
  background: var(--bg-warm);
  border-radius: 24rpx;
  border: 1rpx solid var(--border-color);
  margin-bottom: 24rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 温馨问候 */
.greeting-card {
  background: linear-gradient(135deg, var(--bg-warm) 0%, #FFE8D6 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-color);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.greeting-icon {
  font-size: 64rpx;
}

.greeting-content {
  flex: 1;
}

.greeting-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 菜单列表 */
.menu-list {
  padding: 0;
  background: var(--bg-white);
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid var(--border-color);
  box-shadow: var(--shadow-soft);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--border-color);
  transition: background 0.2s;
}

.menu-item:active {
  background: var(--bg-warm);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--text-light);
}

/* 温馨问候 */
.greeting-card {
  background: linear-gradient(135deg, var(--bg-warm) 0%, #FFE8D6 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-color);
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: var(--shadow-soft);
}

.greeting-icon {
  font-size: 64rpx;
}

.greeting-content {
  flex: 1;
}

.greeting-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 退出按钮 */
.logout-btn {
  margin-top: 40rpx;
  background: var(--bg-white);
  color: var(--danger);
  border: 2rpx solid var(--danger);
  border-radius: 56rpx;
}

.logout-btn:active {
  background: var(--danger-bg);
}

/* 底部温馨语 */
.warm-footer {
  text-align: center;
  padding: 40rpx;
}

.warm-text {
  font-size: 26rpx;
  color: var(--text-muted);
}

.warm-emoji {
  font-size: 32rpx;
  margin-right: 8rpx;
}


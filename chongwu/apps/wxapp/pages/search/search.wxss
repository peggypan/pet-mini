page {
  background: #F5F8FC;
}

.page {
  padding: 20rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(30, 136, 229, 0.08);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.55;
}

.search-input {
  flex: 1;
  height: 80rpx;
  min-height: 80rpx;
  font-size: 28rpx;
}

.search-clear {
  font-size: 36rpx;
  color: #999;
  padding: 0 8rpx;
}

.type-tabs {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.type-tab {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #fff;
  font-size: 24rpx;
  color: #666;
}

.type-tab.on {
  background: rgba(126, 200, 255, 0.45);
  color: #1E88E5;
  font-weight: 700;
}

.hint-block {
  padding: 24rpx 8rpx;
}

.hint-title {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.hint-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hint-chip {
  padding: 14rpx 28rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #333;
  box-shadow: 0 4rpx 12rpx rgba(30, 136, 229, 0.06);
}

.block {
  margin-bottom: 28rpx;
}

.block-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #666;
  margin-bottom: 12rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 12rpx;
  background: #fff;
  border-radius: 20rpx;
}

.row-avatar,
.row-cover {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #E8F4FF;
}

.row-avatar {
  border-radius: 50%;
}

.row-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #4DA7F8;
  margin: 0 28rpx 0 12rpx;
}

.row-body {
  flex: 1;
  min-width: 0;
}

.row-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.row-sub {
  font-size: 24rpx;
  color: #999;
}

.empty {
  padding: 80rpx 20rpx;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

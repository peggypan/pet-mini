/* 服务摘要 */
.service-summary {
  display: flex;
  gap: 20rpx;
  align-items: center;
  padding: 24rpx;
  background: var(--bg-warm);
  border-radius: 24rpx;
  border: 1rpx solid var(--border-color);
}

.service-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: var(--bg-white);
}

.service-info {
  flex: 1;
}

.service-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.service-price {
  font-size: 32rpx;
  color: var(--primary);
  font-weight: 600;
}

/* 区块标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  position: relative;
  padding-left: 16rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(to bottom, var(--primary), var(--primary-light));
  border-radius: 3rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 28rpx;
}

.label {
  font-size: 28rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
}

input, .picker, textarea {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: var(--bg-white);
  transition: border-color 0.2s;
}

input:focus, .picker:focus, textarea:focus {
  border-color: var(--primary);
}

.picker {
  display: flex;
  align-items: center;
}

.placeholder {
  color: var(--text-muted);
}

textarea {
  height: 180rpx;
  padding: 20rpx 24rpx;
  line-height: 1.6;
}

/* 温馨底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-white);
  padding: 24rpx 30rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgba(199, 180, 168, 0.12);
  border-top: 1rpx solid var(--border-color);
}

.total-price {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.total-price .price {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--primary);
}

.total-price .price::before {
  content: '¥';
  font-size: 28rpx;
  margin-right: 2rpx;
}

.submit-btn {
  width: 320rpx;
  margin: 0;
}

<!-- 服务页：分类 Tab + 一键预约卡 + 服务商列表 -->
<view class="page">
  <!-- 分类标签 -->
  <view class="tabs-wrap">
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="tabs-scroll">
      <view
        class="tab-item {{currentCategory === item.id ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        bindtap="onCategoryTap"
        data-id="{{item.id}}"
      >
        <text class="tab-text">{{item.name}}</text>
        <image
          class="tab-paw"
          src="/assets/icons/tab-paw.png"
          mode="aspectFit"
          wx:if="{{currentCategory === item.id}}"
        ></image>
      </view>
    </scroll-view>
  </view>

  <!-- 一键预约卡片 -->
  <view class="book-card">
    <view class="book-glass">
      <view class="book-icon-box">
        <text class="book-icon">🐾</text>
      </view>
      <view class="book-info">
        <text class="book-title">一键快速预约</text>
        <text class="book-desc">精选同城服务 · 专业宠物护理</text>
      </view>
    </view>
    <button class="book-now-btn" bindtap="onQuickBook">立即预约</button>
    <view class="book-dots">
      <view class="dot active"></view>
      <view class="dot"></view>
      <view class="dot"></view>
    </view>
  </view>

  <!-- 服务商列表 -->
  <view class="provider-list" wx:if="{{services.length > 0}}">
    <view
      class="provider-card"
      wx:for="{{services}}"
      wx:key="id"
      bindtap="onServiceTap"
      data-id="{{item.id}}"
    >
      <image
        class="provider-avatar"
        src="{{item.merchantLogoUrl || item.coverUrls[0]}}"
        mode="aspectFill"
      ></image>
      <view class="provider-body">
        <text class="provider-name">{{item.merchantName || item.name}}</text>
        <view class="provider-stars">
          <text class="star" wx:for="{{[1,2,3,4,5]}}" wx:for-item="s" wx:key="*this">★</text>
        </view>
        <text class="provider-desc">{{item.subtitle || item.name || '专业宠物服务，品质保障'}}</text>
      </view>
      <view class="provider-arrow">›</view>
    </view>
  </view>

  <view class="loading-box" wx:if="{{loading}}">
    <text class="loading-spinner">⟳</text>
    <text class="loading-txt">加载中...</text>
  </view>

  <view class="bottom-hint" wx:if="{{!hasMore && services.length > 0 && !isMock}}">
    <text>— 已经到底啦 —</text>
  </view>

  <!-- 地图视图切换 -->
  <view class="map-fab" bindtap="onMapView">
    <text class="map-fab-icon">◎</text>
    <text class="map-fab-text">地图模式</text>
  </view>

  <view class="page-bottom-space"></view>
</view>

page {
  background: #EEF4FA;
}

.page {
  min-height: 100vh;
  padding: 8rpx 28rpx 0;
  box-sizing: border-box;
  position: relative;
}

/* 分类 Tab */
.tabs-wrap {
  margin-bottom: 28rpx;
}

.tabs-scroll {
  white-space: nowrap;
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 40rpx;
  padding: 12rpx 4rpx 16rpx;
  position: relative;
}

.tab-text {
  position: relative;
  z-index: 1;
  font-size: 28rpx;
  color: #9A9A9A;
  font-weight: 500;
  line-height: 1.3;
}

.tab-item.active .tab-text {
  color: #2A2A2A;
  font-weight: 700;
}

/* 小猫爪：浅淡色，叠在文字上像踩上去 */
.tab-paw {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 52rpx;
  height: 52rpx;
  margin-left: -18rpx;
  margin-top: -6rpx;
  z-index: 2;
  opacity: 0.65;
  pointer-events: none;
  transform: rotate(-14deg);
}

/* 一键预约卡 */
.book-card {
  position: relative;
  border-radius: 36rpx;
  padding: 36rpx 32rpx 28rpx;
  margin-bottom: 28rpx;
  background: linear-gradient(145deg, #B8E8CF 0%, #8FD4B0 45%, #A8DCC4 100%);
  box-shadow: 0 16rpx 40rpx rgba(111, 207, 151, 0.28);
  overflow: hidden;
}

.book-card::before {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
}

.book-glass {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  position: relative;
  z-index: 1;
}

.book-icon-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

.book-icon {
  font-size: 48rpx;
}

.book-info {
  flex: 1;
}

.book-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1F3D2E;
  margin-bottom: 8rpx;
}

.book-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(31, 61, 46, 0.65);
  line-height: 1.4;
}

.book-now-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #4DB87A;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: none;
  margin: 0;
  padding: 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 8rpx 20rpx rgba(77, 184, 122, 0.35);
}

.book-now-btn::after {
  border: none;
}

.book-dots {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
  position: relative;
  z-index: 1;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.45);
  margin: 0 6rpx;
}

.dot.active {
  background: #fff;
  width: 22rpx;
  border-radius: 6rpx;
}

/* 服务商列表 */
.provider-list {
  display: flex;
  flex-direction: column;
}

.provider-card {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 42, 42, 0.04);
}

.provider-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #D8F0E4, #B8E0CC);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.provider-body {
  flex: 1;
  overflow: hidden;
}

.provider-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-bottom: 6rpx;
}

.provider-stars {
  margin-bottom: 8rpx;
}

.star {
  font-size: 20rpx;
  color: #FFB347;
  margin-right: 2rpx;
}

.provider-desc {
  display: block;
  font-size: 22rpx;
  color: #9A9A9A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.provider-arrow {
  font-size: 36rpx;
  color: #C5C5C5;
  margin-left: 12rpx;
}

/* 空 / 加载 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 60rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 28rpx;
}

.empty-emoji {
  font-size: 100rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 22rpx;
  color: #999;
}

.loading-box {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.loading-spinner {
  font-size: 36rpx;
  margin-right: 12rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-txt {
  font-size: 24rpx;
  color: #999;
}

.bottom-hint {
  text-align: center;
  padding: 40rpx;
  color: #ccc;
  font-size: 22rpx;
}

/* 地图 FAB */
.map-fab {
  position: fixed;
  right: 36rpx;
  bottom: 200rpx;
  display: flex;
  align-items: center;
  padding: 18rpx 28rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 40rpx;
  box-shadow: 0 12rpx 32rpx rgba(42, 42, 42, 0.12);
  z-index: 100;
}

.map-fab-icon {
  font-size: 28rpx;
  color: #4DB87A;
  margin-right: 10rpx;
}

.map-fab-text {
  font-size: 24rpx;
  color: #2A2A2A;
  font-weight: 600;
}

.page-bottom-space {
  height: 200rpx;
}

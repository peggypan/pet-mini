page {
  background: var(--bg-primary);
}

/* 页面头部 */
.page-header {
  padding: 40rpx 20rpx 24rpx;
  background: var(--bg-white);
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--text-muted);
}

/* 分类标签 */
.category-tabs {
  background: var(--bg-white);
  padding: 20rpx 0;
  margin-bottom: 16rpx;
}

.tabs-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  border-radius: 48rpx;
  background: var(--bg-primary);
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  border-color: transparent;
}

.tab-item.active .tab-text {
  color: white;
}

.tab-icon {
  font-size: 32rpx;
}

.tab-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 服务列表 */
.service-list {
  padding: 0 20rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.service-card {
  display: flex;
  background: var(--bg-white);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-soft);
  border: 1rpx solid var(--border-color);
}

.service-image {
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
  background: var(--bg-primary);
}

.service-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
}

.service-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.service-subtitle {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: auto;
  line-height: 1.5;
}

.service-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.merchant-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.merchant-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--bg-primary);
}

.merchant-name {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.rating-info {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: var(--warning);
}

.star {
  font-size: 20rpx;
}

.rating {
  font-size: 24rpx;
  font-weight: 500;
}

.service-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}

.price-area {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.price {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
}

.price::before {
  content: '¥';
  font-size: 24rpx;
  margin-right: 2rpx;
}

.unit {
  font-size: 22rpx;
  color: var(--text-muted);
}

.book-btn-mini {
  padding: 12rpx 28rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  font-size: 24rpx;
  border-radius: 32rpx;
  border: none;
}

.book-btn-mini::after {
  border: none;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 加载状态 */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 60rpx;
}

.loading-icon {
  font-size: 40rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-muted);
}

/* 底部提示 */
.bottom-tip {
  text-align: center;
  padding: 40rpx;
  color: var(--text-light);
  font-size: 24rpx;
}

<view class="page">
  <view class="card">
    <text class="label">分区</text>
    <view class="zone-row">
      <view
        class="zone {{zone === item.id ? 'on' : ''}}"
        wx:for="{{zones}}"
        wx:key="id"
        bindtap="onZone"
        data-id="{{item.id}}"
      >{{item.icon}} {{item.name}}</view>
    </view>

    <text class="label"># 话题</text>
    <scroll-view scroll-x class="topic-scroll">
      <view
        class="topic-pill {{selectedTopic === item ? 'on' : ''}}"
        wx:for="{{hotTopics}}"
        wx:key="*this"
        data-topic="{{item}}"
        bindtap="onPickTopic"
      >{{item}}</view>
    </scroll-view>
    <view class="selected-topic-row" wx:if="{{selectedTopic}}">
      <text class="selected-topic">{{selectedTopic}}</text>
      <text class="clear-topic" bindtap="onClearTopic">清除</text>
    </view>

    <text class="label">标题</text>
    <input
      class="title-input"
      placeholder="给动态起个标题（选填）"
      placeholder-class="title-ph"
      value="{{title}}"
      bindinput="onTitleInput"
      maxlength="40"
    />
    <text class="title-count">{{title.length}}/40</text>

    <text class="label">内容</text>
    <view class="textarea-wrap">
      <view class="textarea-mirror" wx:if="{{content}}">
        <block wx:for="{{contentParts}}" wx:key="index" wx:for-item="part">
          <text class="mirror-hashtag" wx:if="{{part.tag && part.type === 'hashtag'}}">{{part.text}}</text>
          <text class="mirror-bracket" wx:elif="{{part.tag}}">{{part.text}}</text>
          <text wx:else>{{part.text}}</text>
        </block>
      </view>
      <textarea
        class="textarea {{content ? 'textarea-overlay' : ''}}"
        maxlength="300"
        placeholder="分享养宠日常、图片或视频…输入 #话题 可高亮（禁止活体交易与私下诊疗）"
        value="{{content}}"
        bindinput="onInput"
        auto-height
        show-confirm-bar="{{false}}"
        cursor-spacing="24"
      ></textarea>
    </view>

    <text class="label">相册 / 视频</text>
    <text class="label-tip">{{mediaLimitHint}}（{{mediaSummary}}）</text>
    <view class="media-grid" wx:if="{{mediaList.length}}">
      <view
        class="media-item aspect-34 aspect-34-third"
        wx:for="{{mediaList}}"
        wx:key="index"
        data-index="{{index}}"
        bindtap="onPreviewMedia"
      >
        <image class="media-thumb" src="{{item.type === 'image' ? item.url : (item.poster || item.url)}}" mode="aspectFill"></image>
        <text class="video-flag" wx:if="{{item.type === 'video'}}">▶ 视频</text>
        <view class="remove-media" data-index="{{index}}" catchtap="onRemoveMedia">×</view>
      </view>
      <view class="media-add aspect-34 aspect-34-third" wx:if="{{mediaCanAdd}}" bindtap="onChooseMedia">
        <text class="add-icon">＋</text>
      </view>
    </view>
    <view class="media-empty" wx:elif="{{mediaCanAdd}}" bindtap="onChooseMedia">
      <text class="empty-icon">📷</text>
      <text class="empty-text">添加图片或视频</text>
    </view>

    <text class="label">宠物表情包</text>
    <scroll-view scroll-x class="emoji-tabs">
      <view
        class="emoji-tab {{emojiTab === item.id ? 'on' : ''}}"
        wx:for="{{emojiTabs}}"
        wx:key="id"
        data-tab="{{item.id}}"
        bindtap="onEmojiTab"
      >{{item.name}}</view>
    </scroll-view>
    <view class="emoji-wrap">
      <view class="emoji-cell" wx:for="{{emojiList}}" wx:key="*this" bindtap="onPickEmoji" data-emoji="{{item}}">{{item}}</view>
    </view>

    <button class="submit" bindtap="onSubmit">发布动态</button>
  </view>

  <pet-profile-gate show="{{petProfileBlocked}}" />
</view>


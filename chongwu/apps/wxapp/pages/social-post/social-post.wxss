page { background: #EEF4FA; }
.page { padding: 24rpx 28rpx; }
.card {
  background: rgba(255,255,255,0.92);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(42,42,42,0.04);
}
.label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #555;
  margin-bottom: 12rpx;
}
.zone-row { display: flex; margin-bottom: 24rpx; }
.zone {
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
  border-radius: 28rpx;
  background: #F5F8F6;
  font-size: 24rpx;
  color: #666;
}
.zone.on {
  background: rgba(111,207,151,0.25);
  color: #2A2A2A;
  font-weight: 600;
}
.textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 18rpx;
  background: #F5F8F6;
  border-radius: 14rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 28rpx;
}

.tool-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.tool-btn {
  margin: 0;
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  border: none;
  background: rgba(111, 207, 151, 0.16);
  color: #2A2A2A;
  font-size: 24rpx;
}

.tool-btn::after {
  border: none;
}

.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.media-item {
  position: relative;
  width: 196rpx;
  height: 196rpx;
}

.media-thumb {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
  background: #E2EBF4;
}

.video-thumb {
  position: relative;
  width: 100%;
  height: 100%;
}

.video-flag {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.52);
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
}

.remove-media {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.65);
  color: #fff;
  font-size: 24rpx;
  text-align: center;
  line-height: 34rpx;
}

.emoji-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 26rpx;
}

.emoji-cell {
  width: 74rpx;
  height: 74rpx;
  border-radius: 16rpx;
  background: #F5F8F6;
  text-align: center;
  line-height: 74rpx;
  font-size: 34rpx;
}

.submit {
  background: #6FCF97;
  color: #fff;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}
.submit::after { border: none; }

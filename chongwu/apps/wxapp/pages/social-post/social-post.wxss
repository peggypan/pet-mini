page { background: #F5F8FC; }
.page { padding: 24rpx 28rpx; }
.card {
  background: rgba(255,255,255,0.92);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(42,42,42,0.04);
}
.label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #555;
  margin-bottom: 12rpx;
}
.topic-scroll {
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.topic-pill {
  display: inline-block;
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #1E88E5;
  background: rgba(126, 200, 255, 0.15);
  font-weight: 600;
}

.topic-pill.on {
  background: linear-gradient(135deg, #5BB8FF, #4DA7F8);
  color: #1A1A1A;
}

.selected-topic-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.selected-topic {
  font-size: 26rpx;
  color: #1E88E5;
  font-weight: 700;
}

.clear-topic {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.zone-row { display: flex; margin-bottom: 24rpx; }
.zone {
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
  border-radius: 28rpx;
  background: #F5F8FC;
  font-size: 24rpx;
  color: #666;
}
.zone.on {
  background: rgba(126, 200, 255, 0.35);
  color: #2A2A2A;
  font-weight: 600;
}
.textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 18rpx;
  background: #F5F8FC;
  border-radius: 14rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 28rpx;
}

.tool-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.tool-btn {
  margin: 0;
  flex: 1;
  height: 72rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  border: none;
  background: rgba(126, 200, 255, 0.25);
  color: #1A1A1A;
  font-size: 26rpx;
  font-weight: 600;
}

.tool-btn::after {
  border: none;
}

.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.media-item {
  position: relative;
  width: 196rpx;
  height: 196rpx;
}

.media-thumb {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
  background: #E2EBF4;
}

.video-thumb {
  position: relative;
  width: 100%;
  height: 100%;
}

.video-flag {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.52);
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
}

.remove-media {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.65);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.label-tip {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin: -12rpx 0 16rpx;
}

.media-add {
  width: 196rpx;
  height: 196rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F8FC;
  border-radius: 14rpx;
  border: 2rpx dashed rgba(77, 167, 248, 0.35);
  box-sizing: border-box;
}

.add-icon {
  font-size: 48rpx;
  color: #BBBBBB;
}

.media-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  margin-bottom: 20rpx;
  background: #F5F8FC;
  border-radius: 20rpx;
  border: 2rpx dashed rgba(77, 167, 248, 0.35);
}

.empty-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 24rpx;
  color: #999999;
}

.emoji-tabs {
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.emoji-tab {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #999;
  background: #F5F8FC;
}

.emoji-tab.on {
  background: rgba(126, 200, 255, 0.35);
  color: #1A1A1A;
  font-weight: 700;
}

.emoji-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 26rpx;
}

.emoji-cell {
  width: 74rpx;
  height: 74rpx;
  border-radius: 16rpx;
  background: #F5F8FC;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  font-size: 34rpx;
}

.submit {
  background: linear-gradient(135deg, #5BB8FF, #4DA7F8);
  color: #1A1A1A;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
}
.submit::after { border: none; }

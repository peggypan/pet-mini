<view class="page">
  <view class="city-bar" bindtap="onCityTap">
    <text class="city-bar-icon">📍</text>
    <text class="city-bar-text">{{city}} · 宠友圈</text>
    <text class="city-bar-arrow">切换 ›</text>
  </view>
  <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="tabs">
    <view class="tab {{innerTab === item.id ? 'on' : ''}}" wx:for="{{innerTabs}}" wx:key="id" data-id="{{item.id}}" bindtap="onInnerTab">{{item.name}}</view>
  </scroll-view>

  <view wx:if="{{innerTab === 'all'}}">
    <view class="post-card" wx:for="{{displayPosts}}" wx:key="id" bindtap="onPostTap" data-id="{{item.id}}">
      <view class="head">
        <image class="avatar" src="{{item.avatar}}" mode="aspectFill"></image>
        <view class="user">
          <text class="name">{{item.userName}} · {{item.petName}}</text>
          <text class="meta">{{item.time}} · {{item.location || '同城'}}</text>
        </view>
      </view>
      <text class="topic" wx:if="{{item.topic}}">{{item.topic}}</text>
      <text class="content">{{item.content}}</text>
      <image class="cover" wx:if="{{item.mediaList.length && item.mediaList[0].type === 'image'}}" src="{{item.mediaList[0].url}}" mode="aspectFill"></image>
      <view class="footer">
        <view class="btn" catchtap="onLikeTap" data-id="{{item.id}}">{{item.liked ? '❤️' : '♡'}} {{item.likes}}</view>
        <view class="btn">💬 {{item.comments}}</view>
        <button class="btn share-btn" open-type="share" catchtap="onSharePost" data-id="{{item.id}}">↗ 分享</button>
      </view>
    </view>
  </view>

  <view wx:if="{{innerTab === 'featured'}}">
    <view class="featured-card" wx:for="{{featuredCommunities}}" wx:key="id" bindtap="onEnterCircle" data-id="{{item.id}}">
      <view class="featured-head">
        <text class="featured-icon">{{item.icon}}</text>
        <view class="featured-info">
          <text class="featured-name">{{item.name}}</text>
          <text class="featured-meta">{{item.members}} 成员 · {{item.active}}</text>
        </view>
        <text class="featured-enter">进入 ›</text>
      </view>
      <text class="featured-topic">{{item.lastTopic}}</text>
      <text class="featured-preview">{{item.lastPreview}}</text>
      <view class="featured-images {{item.previewImages.length === 1 ? 'single' : ''}}" wx:if="{{item.previewImages.length}}">
        <image
          class="featured-img"
          wx:for="{{item.previewImages}}"
          wx:for-item="imgUrl"
          wx:key="*this"
          src="{{imgUrl}}"
          mode="aspectFill"
        ></image>
      </view>
      <view class="featured-tags">
        <text class="featured-tag">💬 私聊</text>
        <text class="featured-tag">↗ 分享</text>
        <text class="featured-tag"># 话题</text>
      </view>
    </view>
  </view>

  <view wx:if="{{innerTab === 'circle'}}" class="grid">
    <view class="circle-card" wx:for="{{circles}}" wx:key="id" bindtap="onCircleTap" data-id="{{item.id}}">
      <text class="icon">{{item.icon}}</text>
      <text class="c-name">{{item.name}}</text>
      <text class="c-num">{{item.members}} 成员</text>
    </view>
  </view>

  <view wx:if="{{innerTab === 'topic'}}">
    <view class="topic-row" wx:for="{{topics}}" wx:key="id" bindtap="onTopicTap" data-name="{{item.name}}">
      <text class="t-name">{{item.name}}</text>
      <text class="t-num">{{item.posts}} 讨论</text>
    </view>
  </view>

  <view wx:if="{{innerTab === 'qa'}}">
    <view class="qa-card" wx:for="{{qaList}}" wx:key="id">
      <text class="q-title">{{item.title}}</text>
      <text class="q-meta">{{item.userName}} · {{item.answers}} 回答</text>
    </view>
  </view>

  <view class="fab" bindtap="onCreatePost">+</view>
</view>

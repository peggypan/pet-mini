<view class="page">
  <view class="top-bar">
    <view class="brand">
      <text class="brand-name">宠头头</text>
      <text class="brand-tag">借宠交友 · 同城广场</text>
    </view>
    <view class="msg-btn" bindtap="onMessagesTap">
      <text>💬</text>
      <view class="badge" wx:if="{{unreadCount > 0}}">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
    </view>
  </view>

  <view class="invite-card" bindtap="onInviteTap">
    <view class="invite-text">
      <text class="invite-title">{{invite.rewardTitle}}</text>
      <text class="invite-desc">{{invite.rewardDesc}}</text>
    </view>
    <button class="invite-btn" open-type="share">分享</button>
  </view>

  <view class="action-grid">
    <view
      class="action-item"
      wx:for="{{socialActions}}"
      wx:key="id"
      bindtap="onSocialAction"
      data-type="{{item.id}}"
    >
      <view class="action-icon">{{item.icon}}</view>
      <text class="action-name">{{item.name}}</text>
      <text class="action-desc">{{item.desc}}</text>
    </view>
  </view>

  <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="filter-scroll">
    <view
      class="filter-pill {{socialFilter === item.id ? 'on' : ''}}"
      wx:for="{{socialFilters}}"
      wx:key="id"
      bindtap="onSocialFilter"
      data-id="{{item.id}}"
    >{{item.name}}</view>
  </scroll-view>

  <scroll-view
    scroll-x
    enhanced
    show-scrollbar="{{false}}"
    class="event-scroll"
    wx:if="{{displayEvents.length && socialFilter !== 'cat' && socialFilter !== 'dog' && socialFilter !== 'other'}}"
  >
    <view class="event-card" wx:for="{{displayEvents}}" wx:key="id" bindtap="onEventTap" data-id="{{item.id}}">
      <image class="event-cover" src="{{item.cover}}" mode="aspectFill"></image>
      <view class="event-body">
        <text class="event-tag">{{item.tag}}</text>
        <text class="event-title">{{item.title}}</text>
        <text class="event-meta">{{item.place}} · {{item.seats}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="feed">
    <view class="post-card" wx:for="{{displayPosts}}" wx:key="id" bindtap="onPostTap" data-id="{{item.id}}">
      <view class="post-head">
        <image class="post-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
        <view class="post-user">
          <text class="post-name">{{item.userName}} · {{item.petName}}</text>
          <text class="post-meta">{{item.time}}<text wx:if="{{item.topic}}"> · {{item.topic}}</text></text>
        </view>
        <text class="essence" wx:if="{{item.essence}}">精华</text>
      </view>
      <text class="post-content">{{item.content}}</text>
      <image class="post-image" src="{{item.mediaList[0].url}}" mode="aspectFill" wx:if="{{item.mediaList.length && item.mediaList[0].type === 'image'}}"></image>
      <view class="post-video-wrap" wx:if="{{item.mediaList.length && item.mediaList[0].type === 'video'}}">
        <video class="post-video" src="{{item.mediaList[0].url}}" show-center-play-btn objectFit="cover"></video>
      </view>
      <view class="post-footer">
        <view class="post-btn" catchtap="onLikeTap" data-id="{{item.id}}">
          <text>{{item.liked ? '❤️' : '♡'}}</text>
          <text class="num">{{item.likes}}</text>
        </view>
        <view class="post-btn" catchtap="onCommentTap" data-id="{{item.id}}">
          <text>💬</text>
          <text class="num">{{item.comments}}</text>
        </view>
        <button class="post-btn share-btn" open-type="share" catchtap="onShareTap" data-id="{{item.id}}">
          <text>↗ {{item.shares || 0}}</text>
        </button>
      </view>
    </view>
    <view class="empty" wx:if="{{displayPosts.length === 0}}">
      <text>这里还没有动态，发一条让毛孩子露个脸吧～</text>
    </view>
  </view>

  <view class="fab" bindtap="onCreatePost">+</view>
</view>

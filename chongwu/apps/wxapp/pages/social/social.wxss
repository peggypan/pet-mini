page {
  background: linear-gradient(180deg, #E8F4FF 0%, #F5F8FC 280rpx, #F5F8FC 100%);
}

.page {
  padding: 20rpx 28rpx calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.tabs {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.tab {
  display: inline-block;
  padding: 12rpx 28rpx 20rpx;
  margin-right: 8rpx;
  font-size: 28rpx;
  color: #999999;
  position: relative;
  background: transparent;
}

.tab.on {
  color: #1A1A1A;
  font-weight: 800;
}

.tab.on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  transform: translateX(-50%);
  width: 48rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #7EC8FF;
}

.post-card {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.head {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}

.name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.meta {
  font-size: 22rpx;
  color: #999999;
}

.topic {
  display: block;
  font-size: 24rpx;
  color: #1E88E5;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.content {
  display: block;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  margin-bottom: 14rpx;
}

.media-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 14rpx;
  align-items: center;
}

.media-row.single .media-thumb-wrap {
  width: 100%;
  height: 360rpx;
}

.media-thumb-wrap {
  position: relative;
  width: calc((100% - 20rpx) / 3);
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #E8F4FF;
}

.media-thumb {
  width: 100%;
  height: 100%;
}

.media-thumb-video-placeholder {
  background: linear-gradient(135deg, #d8ecff, #b8dcff);
}

.media-video-mask {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.18);
}

.media-video-tag {
  font-size: 44rpx;
  color: #ffffff;
  line-height: 1;
  margin-bottom: 6rpx;
}

.media-video-dur {
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.45);
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
}

.media-more {
  width: 80rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #eef6ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999999;
}

.footer {
  display: flex;
  gap: 32rpx;
}

.btn {
  font-size: 24rpx;
  color: #999999;
}

.share-btn {
  margin: 0;
  padding: 0;
  line-height: 1;
  background: transparent;
  border: none;
  font-size: 24rpx;
  color: #999999;
}

.share-btn::after { border: none; }

.featured-card {
  padding: 28rpx;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.featured-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.featured-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.featured-info {
  flex: 1;
  min-width: 0;
}

.featured-name {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #1A1A1A;
}

.featured-meta {
  font-size: 22rpx;
  color: #999;
}

.featured-enter {
  font-size: 26rpx;
  color: #1E88E5;
  font-weight: 700;
}

.featured-topic {
  display: block;
  font-size: 24rpx;
  color: #1E88E5;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.featured-preview {
  display: block;
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.featured-images {
  display: flex;
  gap: 10rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.featured-images.single {
  display: block;
}

.featured-images.single .featured-img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 16rpx;
}

.featured-img {
  flex: 1;
  width: 100%;
  height: 200rpx;
  min-width: 0;
  border-radius: 12rpx;
  background: #F0F0F0;
}

.featured-tags {
  display: flex;
  gap: 12rpx;
}

.featured-tag {
  font-size: 20rpx;
  color: #666;
  padding: 6rpx 14rpx;
  background: #F5F8FC;
  border-radius: 999rpx;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.circle-card {
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  text-align: center;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.icon {
  font-size: 44rpx;
  display: block;
  margin-bottom: 10rpx;
}

.c-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.c-num {
  font-size: 22rpx;
  color: #999999;
}

.topic-row {
  display: flex;
  justify-content: space-between;
  padding: 24rpx;
  margin-bottom: 12rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.t-name {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 600;
}

.t-num {
  font-size: 22rpx;
  color: #999999;
}

.qa-card {
  padding: 24rpx;
  margin-bottom: 12rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.q-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.q-meta {
  font-size: 22rpx;
  color: #999999;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #5BB8FF 0%, #4DA7F8 100%);
  color: #1A1A1A;
  font-size: 52rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(77, 167, 248, 0.4);
  z-index: 20;
}

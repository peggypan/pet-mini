page {
  background: #F7FAF5;
}

.page {
  min-height: 100vh;
  padding: 20rpx 28rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.brand-name {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #2D4A38;
  letter-spacing: 1rpx;
}

.brand-tag {
  font-size: 22rpx;
  color: #8A9A90;
}

.msg-btn {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(91, 140, 110, 0.12);
}

.badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #FF8A9B;
  color: #fff;
  font-size: 18rpx;
  text-align: center;
  line-height: 32rpx;
}

.invite-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #E8F8EF, #FFF6EE);
  border: 1rpx solid rgba(91, 191, 136, 0.2);
}

.invite-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #2D4A38;
  margin-bottom: 4rpx;
}

.invite-desc {
  font-size: 22rpx;
  color: #6B8575;
  line-height: 1.4;
}

.invite-text {
  flex: 1;
  min-width: 0;
}

.invite-btn {
  margin: 0;
  padding: 0 24rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  background: #5BBF88;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
  flex-shrink: 0;
}

.invite-btn::after {
  border: none;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 8rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(91, 140, 110, 0.06);
}

.action-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(91, 191, 136, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.action-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #2D4A38;
}

.action-desc {
  font-size: 18rpx;
  color: #9BA89E;
  margin-top: 2rpx;
}

.filter-scroll,
.event-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.filter-pill {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 28rpx;
  background: #fff;
  font-size: 24rpx;
  color: #6B8575;
}

.filter-pill.on {
  background: rgba(91, 191, 136, 0.18);
  color: #2D4A38;
  font-weight: 700;
}

.event-card {
  display: inline-flex;
  width: 440rpx;
  margin-right: 14rpx;
  padding: 12rpx;
  border-radius: 20rpx;
  background: #fff;
  vertical-align: top;
  box-shadow: 0 6rpx 18rpx rgba(91, 140, 110, 0.08);
}

.event-cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 14rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.event-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.event-tag {
  font-size: 20rpx;
  color: #5BBF88;
  margin-bottom: 4rpx;
}

.event-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #2D4A38;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-meta {
  font-size: 20rpx;
  color: #9BA89E;
}

.feed {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.post-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(91, 140, 110, 0.06);
}

.post-head {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.post-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  background: #E8F0EA;
}

.post-user {
  flex: 1;
  min-width: 0;
}

.post-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #2D4A38;
}

.post-meta {
  font-size: 20rpx;
  color: #9BA89E;
}

.essence {
  font-size: 18rpx;
  color: #fff;
  background: #FFB87A;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

.post-content {
  display: block;
  font-size: 28rpx;
  color: #3A4F42;
  line-height: 1.6;
  margin-bottom: 14rpx;
  white-space: pre-wrap;
}

.post-image {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  margin-bottom: 14rpx;
  background: #E8F0EA;
}

.post-video-wrap {
  margin-bottom: 14rpx;
}

.post-video {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
}

.post-footer {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.post-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #7A8A80;
}

.num {
  font-size: 22rpx;
}

.share-btn {
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  line-height: inherit;
  font-size: 24rpx;
  color: #7A8A80;
}

.share-btn::after {
  border: none;
}

.empty {
  padding: 60rpx 20rpx;
  text-align: center;
  color: #9BA89E;
  font-size: 26rpx;
}

.fab {
  position: fixed;
  right: 36rpx;
  bottom: calc(130rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #8FD9B0, #5BBF88);
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(91, 191, 136, 0.45);
  z-index: 20;
}

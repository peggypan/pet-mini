page {
  background: #EEF4FA;
  min-height: 100vh;
}

.page {
  padding: 20rpx 28rpx calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 宠物交友 */
.social-block {
  margin-bottom: 0;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 42, 42, 0.04);
}

.social-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.social-title-wrap {
  flex: 1;
  min-width: 0;
}

.social-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-bottom: 6rpx;
}

.social-sub {
  display: block;
  font-size: 22rpx;
  color: #8A8A8A;
}

.social-more {
  font-size: 24rpx;
  color: #4DB87A;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.lost-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(111, 207, 151, 0.2), rgba(255, 255, 255, 0.9));
  border: 1rpx solid rgba(111, 207, 151, 0.28);
}

.lost-banner-icon {
  font-size: 36rpx;
  margin-right: 4rpx;
  flex-shrink: 0;
}

.lost-banner-text {
  flex: 1;
  min-width: 0;
}

.lost-banner-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-bottom: 4rpx;
}

.lost-banner-desc {
  display: block;
  font-size: 20rpx;
  color: #7A7A7A;
  line-height: 1.4;
}

.lost-banner-go {
  font-size: 22rpx;
  color: #4DB87A;
  font-weight: 600;
  flex-shrink: 0;
  white-space: nowrap;
  margin-left: 0;
}

.social-actions {
  display: flex;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.social-action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.social-action-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, rgba(184, 232, 207, 0.55), rgba(255, 255, 255, 0.95));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-bottom: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(111, 207, 151, 0.15);
}

.social-action-name {
  font-size: 20rpx;
  color: #555;
  font-weight: 500;
}

.zone-scroll {
  white-space: nowrap;
  margin-bottom: 18rpx;
}

.zone-pill {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
  border-radius: 28rpx;
  background: #F3F7F5;
}

.zone-pill text {
  font-size: 22rpx;
  color: #6B6B6B;
}

.zone-pill.on {
  background: rgba(111, 207, 151, 0.22);
}

.zone-pill.on text {
  color: #2A2A2A;
  font-weight: 700;
}

.event-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.event-card {
  display: inline-flex;
  width: 460rpx;
  margin-right: 16rpx;
  padding: 14rpx;
  background: #F5FAF7;
  border-radius: 22rpx;
  vertical-align: top;
  white-space: normal;
  box-sizing: border-box;
}

.event-cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: #E2EBF4;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.event-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.event-tag {
  display: inline-block;
  align-self: flex-start;
  font-size: 18rpx;
  color: #4DB87A;
  background: rgba(111, 207, 151, 0.18);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-bottom: 6rpx;
}

.event-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-meta {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 2rpx;
}

.event-meta-item {
  font-size: 18rpx;
  color: #8A8A8A;
  margin-right: 12rpx;
}

.event-meta-item.warn {
  color: #E08A5A;
}

.rule-tip {
  font-size: 20rpx;
  color: #9A9A9A;
  background: #F7F9F8;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.invite-toast {
  margin: 0 0 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #6FCF97 0%, #4DB87A 100%);
  box-shadow: 0 10rpx 28rpx rgba(77, 184, 122, 0.28);
}

.invite-toast-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 4rpx;
}

.invite-toast-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.invite-banner {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 18rpx;
  background: rgba(111, 207, 151, 0.14);
  border: 1rpx solid rgba(111, 207, 151, 0.28);
}

.invite-banner-text {
  flex: 1;
  min-width: 0;
  padding-right: 8rpx;
}

.invite-banner-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-bottom: 6rpx;
}

.invite-banner-desc {
  display: block;
  font-size: 22rpx;
  color: #5A7A68;
  line-height: 1.45;
}

.invite-share-btn {
  margin: 0;
  padding: 0 18rpx !important;
  min-width: 0 !important;
  width: 140rpx !important;
  height: 60rpx;
  line-height: 1;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: #6FCF97;
  border-radius: 30rpx;
  border: none;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.invite-share-btn::after {
  border: none;
}

.share-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.share-panel {
  width: 100%;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  box-sizing: border-box;
}

.share-panel-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-bottom: 12rpx;
}

.share-panel-desc {
  display: block;
  font-size: 24rpx;
  color: #6A6A6A;
  line-height: 1.5;
  margin-bottom: 28rpx;
}

.share-panel-btn {
  margin: 0 0 16rpx;
  background: #6FCF97;
  color: #fff;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.share-panel-btn::after {
  border: none;
}

.share-panel-cancel {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #9A9A9A;
  padding: 8rpx 0;
}

.post-share-btn {
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
  border: none;
  display: inline-flex;
  align-items: center;
}

.post-share-btn::after {
  border: none;
}

.event-desc {
  display: none;
}

.post-list {
  display: flex;
  flex-direction: column;
}

.post-card {
  padding: 20rpx 0;
  border-top: 1rpx solid #EAF1F6;
}

.post-card:first-child {
  border-top: none;
  padding-top: 4rpx;
}

.post-head {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.post-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #E2EBF4;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.post-user {
  flex: 1;
  min-width: 0;
}

.post-enter {
  font-size: 22rpx;
  color: #4DB87A;
  flex-shrink: 0;
  margin-left: 8rpx;
}

.post-user-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #2A2A2A;
  margin-bottom: 4rpx;
}

.post-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 4rpx;
}

.post-name-row .post-user-name {
  margin-bottom: 0;
  margin-right: 10rpx;
}

.essence-tag {
  font-size: 18rpx;
  color: #fff;
  background: #6FCF97;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.post-empty {
  padding: 32rpx 0 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9A9A9A;
}

.post-time {
  display: block;
  font-size: 20rpx;
  color: #9A9A9A;
}

.post-content {
  display: block;
  font-size: 26rpx;
  color: #3A3A3A;
  line-height: 1.55;
  margin-bottom: 14rpx;
  white-space: pre-wrap;
  word-break: break-word;
  max-height: 160rpx;
  overflow: hidden;
}

.post-image {
  width: 100%;
  height: 280rpx;
  border-radius: 20rpx;
  background: #E2EBF4;
  margin-bottom: 14rpx;
}

.post-video-wrap {
  position: relative;
  margin-bottom: 14rpx;
}

.post-video {
  width: 100%;
  height: 280rpx;
  border-radius: 20rpx;
  background: #E2EBF4;
}

.post-video-tag {
  position: absolute;
  left: 12rpx;
  bottom: 12rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.52);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.media-tip {
  margin-bottom: 12rpx;
  font-size: 20rpx;
  color: #8A9A90;
}

.post-footer {
  display: flex;
  align-items: center;
}

.post-btn {
  display: flex;
  align-items: center;
  margin-right: 36rpx;
  font-size: 24rpx;
  color: #6B6B6B;
}

.post-btn-num {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #8A8A8A;
}

/* 宠物商城 */

.fab-post {
  position: fixed;
  right: 36rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  padding: 0 28rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(145deg, #8FD9B0, #4DB87A);
  box-shadow: 0 12rpx 32rpx rgba(77, 184, 122, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

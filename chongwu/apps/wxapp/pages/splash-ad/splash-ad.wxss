.splash {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: #000;
  z-index: 9999;
}

.splash-img {
  width: 100%;
  height: 100%;
}

.splash-top {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 24rpx);
  right: 24rpx;
  z-index: 2;
}

.skip-btn {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 26rpx;
}

.skip-btn.disabled {
  opacity: 0.65;
}
